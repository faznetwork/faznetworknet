# Local V-SOL OLT collector settings. Never commit real secrets.
OLT_HOST=172.21.21.2
OLT_SNMP_PORT=161
OLT_SNMP_COMMUNITY=replace-with-read-only-community
OLT_ID=V-SOL-V1601E04-DP
COLLECTOR_ID=faz-local-collector
RENDER_INGEST_URL=https://faznetwork-web.onrender.com/api/olt/sync-telemetry
OLT_COLLECTOR_TOKEN=replace-with-the-same-long-random-secret-as-Render-OLT_COLLECTOR_TOKEN
POLL_INTERVAL_SECONDS=300
SNMP_TIMEOUT=2.5
SNMP_RETRIES=1
HTTP_TIMEOUT=15
MAX_OID_ROWS=10000

# Verified table roots from the V-SOL SNMP walk; confirm these against this firmware before running.
OID_ONU_MAC=1.3.6.1.4.1.37950.1.1.5.12.1.12.1.6
OID_ONU_STATUS=1.3.6.1.4.1.37950.1.1.5.12.1.12.1.5
OID_ONU_PON_PORT=1.3.6.1.4.1.37950.1.1.5.12.1.12.1.3
OID_ONU_ID=1.3.6.1.4.1.37950.1.1.5.12.1.12.1.4
OID_ONU_RX_POWER=1.3.6.1.4.1.37950.1.1.5.12.2.1.8.1.7.1
OID_ONU_TX_POWER=1.3.6.1.4.1.37950.1.1.5.12.2.1.8.1.6.1

# Leave blank until status code values are confirmed from the exact OLT firmware.
ONU_STATUS_ONLINE_VALUE=
ONU_STATUS_OFFLINE_VALUE=
ONU_STATUS_LOS_VALUE=
# Explicit dBm strings are parsed directly. Scale applies only to plain numeric values.
RX_POWER_SCALE=1
TX_POWER_SCALE=1
LOG_LEVEL=INFO

# Optional exact table-index or PON/ONU-ID -> panel PPPoE username mapping. Do not guess.
ONU_CUSTOMER_MAP_JSON={}
