<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1">
<title>FAZ NETWORK · Platform Owner Console</title>
<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
<link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" rel="stylesheet">
<style>
:root{color-scheme:light;--ink:#122b27;--muted:#64748b;--line:#dce7e3;--green:#087f5b;--bg:#f4f7f6}
body{background:var(--bg);color:var(--ink);font-family:Inter,system-ui,-apple-system,Segoe UI,sans-serif}.shell{max-width:1440px;margin:auto;padding:28px}.hero{background:linear-gradient(120deg,#073b2e,#0c6950);color:#fff;border-radius:20px;padding:28px;box-shadow:0 14px 35px #083d2e20}.eyebrow{text-transform:uppercase;letter-spacing:.14em;font-size:.72rem;font-weight:800;opacity:.75}.section-card{background:#fff;border:1px solid var(--line);border-radius:16px;box-shadow:0 5px 20px #0c30240a}.section-head{font-weight:800;display:flex;gap:10px;align-items:center}.section-head i{color:var(--green)}.form-label{font-size:.82rem;font-weight:700;color:#40534d}.form-control{min-height:42px}.status-pill{border-radius:999px;padding:5px 10px;font-size:.75rem;font-weight:800}.table td,.table th{vertical-align:middle}.module-check{display:inline-flex;gap:5px;align-items:center;margin-right:10px;font-size:.8rem}.muted{color:var(--muted)}.token-box{font-family:ui-monospace,monospace}.tenant-actions{display:flex;gap:6px;flex-wrap:wrap}.tiny{font-size:.78rem}
@media(max-width:767px){.shell{padding:14px}.hero{padding:20px}.table-responsive{font-size:.85rem}}
</style>
</head>
<body>
<div class="shell">
<header class="hero mb-4">
<div class="d-flex flex-wrap justify-content-between align-items-start gap-3">
<div><div class="eyebrow mb-2">FAZ NETWORK · Private control plane</div><h1 class="h3 fw-bold mb-2">Platform Owner Console</h1><p class="mb-0 opacity-75">Global platform settings and ISP tenant lifecycle. Separate from daily tenant operations.</p></div>
<div class="d-flex gap-2"><a href="/admin" class="btn btn-light btn-sm fw-semibold"><i class="bi bi-arrow-left me-1"></i>Admin Dashboard</a><form method="POST" action="/logout"><button class="btn btn-outline-light btn-sm">Sign out</button></form></div>
</div></header>
<div id="globalMessage" class="alert d-none" role="status" aria-live="polite"></div>
<section class="section-card p-3 p-md-4 mb-4">
<div class="section-head h5 mb-1"><i class="bi bi-shield-lock"></i>Section A · Platform API &amp; Webhook Gateways</div><p class="muted small mb-3">Tokens are returned once at creation; only SHA-256 hashes are stored. Generating a replacement invalidates the previous token hash.</p>
<div class="row g-3">
<div class="col-lg-6"><div class="border rounded-3 p-3 h-100"><div class="fw-bold mb-2">Master Inbound Webhook Token</div><p class="tiny muted">For platform inbound integrations.</p><div id="masterTokenResult" class="alert d-none py-2 tiny"></div><div id="masterTokenReveal" class="input-group mb-2 d-none"><input id="masterTokenValue" class="form-control token-box" type="password" readonly><button class="btn btn-outline-secondary" data-reveal="masterTokenValue" type="button"><i class="bi bi-eye"></i></button><button class="btn btn-outline-secondary" data-copy="masterTokenValue" type="button">Copy</button></div><button class="btn btn-success" data-generate="master"><i class="bi bi-key me-1"></i>Generate Master Token</button></div></div>
<div class="col-lg-6"><div class="border rounded-3 p-3 h-100"><div class="fw-bold mb-2">Android SMS App Gateway Token</div><p class="tiny muted">For the future custom Android SMS gateway APK.</p><div id="androidTokenResult" class="alert d-none py-2 tiny"></div><div id="androidTokenReveal" class="input-group mb-2 d-none"><input id="androidTokenValue" class="form-control token-box" type="password" readonly><button class="btn btn-outline-secondary" data-reveal="androidTokenValue" type="button"><i class="bi bi-eye"></i></button><button class="btn btn-outline-secondary" data-copy="androidTokenValue" type="button">Copy</button></div><button class="btn btn-outline-success" data-generate="android"><i class="bi bi-phone me-1"></i>Generate Android Token</button></div></div>
</div></section>
<section class="section-card p-3 p-md-4 mb-4">
<div class="section-head h5 mb-1"><i class="bi bi-router"></i>Section B · Router &amp; Server Core</div><p class="muted small">Saved here as database configuration only. Saving these fields does not connect to or change RouterOS.</p>
<form id="coreForm"><div class="row g-3">
<div class="col-md-6"><label class="form-label" for="coreHost">MikroTik Core Host</label><input id="coreHost" name="mikrotik_core_host" class="form-control" placeholder="router hostname or IP"></div>
<div class="col-md-6"><label class="form-label" for="corePort">API Port</label><input id="corePort" name="mikrotik_core_api_port" class="form-control" type="number" min="1" max="65535" value="8728"></div>
<div class="col-md-6"><label class="form-label" for="coreUser">API Username</label><input id="coreUser" name="mikrotik_core_username" class="form-control" autocomplete="off"></div>
<div class="col-md-6"><label class="form-label" for="corePassword">API Password <span class="muted fw-normal">(leave blank to retain saved password)</span></label><input id="corePassword" name="mikrotik_core_password" class="form-control" type="password" autocomplete="new-password"></div>
</div><div class="d-flex flex-wrap align-items-center gap-3 mt-3"><button class="btn btn-success" type="submit" id="saveCoreBtn">Save Core Settings</button><span id="coreStatus" class="tiny muted" role="status"></span></div></form>
</section>
<section class="section-card p-3 p-md-4 mb-4">
<div class="d-flex flex-wrap justify-content-between gap-3 align-items-start mb-3"><div><div class="section-head h5 mb-1"><i class="bi bi-buildings"></i>Section C · Tenant &amp; Subscription Management</div><p class="muted small mb-0">New client ISPs start with a 30-day subscription. Tenant lifecycle is recorded separately from existing customer billing.</p></div><button id="refreshTenants" class="btn btn-outline-secondary btn-sm"><i class="bi bi-arrow-clockwise me-1"></i>Refresh</button></div>
<form id="tenantForm" class="border rounded-3 p-3 mb-4"><div class="fw-bold mb-3">Register Client ISP</div><div class="row g-2"><div class="col-md-4"><label class="form-label" for="tenantName">ISP / Tenant Name</label><input id="tenantName" class="form-control" required maxlength="200"></div><div class="col-md-3"><label class="form-label" for="tenantSlug">Unique Slug</label><input id="tenantSlug" class="form-control" required maxlength="100" pattern="[A-Za-z0-9-]+" placeholder="client-isp"></div><div class="col-md-3"><label class="form-label" for="tenantEmail">Contact Email</label><input id="tenantEmail" class="form-control" type="email"></div><div class="col-md-2"><label class="form-label" for="tenantPhone">Contact Phone</label><input id="tenantPhone" class="form-control"></div></div><button class="btn btn-success btn-sm mt-3" type="submit">Create Tenant · 30 Days</button></form>
<div id="tenantStatus" class="tiny muted mb-2" role="status">Loading tenants…</div>
<div class="table-responsive"><table class="table table-hover"><thead class="table-light"><tr><th>Client ISP</th><th>Subscription</th><th>Days left</th><th>Modules</th><th>Actions</th></tr></thead><tbody id="tenantRows"><tr><td colspan="5" class="muted">Loading…</td></tr></tbody></table></div>
</section>
<section class="section-card p-3 p-md-4"><div class="section-head h5 mb-2"><i class="bi bi-journal-text"></i>Configuration Inventory</div><p class="muted small">Secret values are never returned in plaintext.</p><div class="table-responsive"><table class="table table-sm"><thead><tr><th>Key</th><th>Value / Status</th><th>Updated</th></tr></thead><tbody id="settingsRows"><tr><td colspan="3" class="muted">Loading…</td></tr></tbody></table></div></section>
</div>
<script>
const $=id=>document.getElementById(id);
function message(id,text,error=false){const el=$(id);if(!el)return;el.textContent=text;el.className='alert py-2 tiny '+(error?'alert-danger':'alert-success');}
async function api(url,options={}){const response=await fetch(url,{credentials:'same-origin',cache:'no-store',headers:{'Content-Type':'application/json','Accept':'application/json',...(options.headers||{})},...options});const data=await response.json().catch(()=>({message:'Invalid server response'}));if(!response.ok||data.success===false)throw new Error(data.message||('Request failed ('+response.status+')'));return data;}
async function loadSettings(){const d=await api('/api/server-settings');const map=Object.fromEntries((d.settings||[]).map(s=>[s.key,s]));$('coreHost').value=map.mikrotik_core_host?.value||'';$('corePort').value=map.mikrotik_core_api_port?.value||'8728';$('coreUser').value=map.mikrotik_core_username?.value||'';$('corePassword').value='';const body=$('settingsRows');body.replaceChildren();(d.settings||[]).forEach(s=>{const tr=document.createElement('tr');for(const value of [s.key,s.isSecret?(s.configured?'Configured · masked':'Not configured'):(s.value||'—'),s.updatedAt?new Date(s.updatedAt).toLocaleString():'—']){const td=document.createElement('td');td.textContent=value;tr.append(td);}body.append(tr);});if(!body.children.length)body.innerHTML='<tr><td colspan="3" class="muted">No settings stored yet.</td></tr>';}
async function generate(which){const isMaster=which==='master',result=isMaster?'masterTokenResult':'androidTokenResult',reveal=isMaster?'masterTokenReveal':'androidTokenReveal',input=isMaster?'masterTokenValue':'androidTokenValue';if(!confirm('Generate a replacement token? Existing token hash will be replaced.'))return;try{const d=await api('/api/server-settings/'+(isMaster?'generate-token':'generate-android-token'),{method:'POST',body:'{}'});$(input).value=d.token;$(reveal).classList.remove('d-none');message(result,d.message||'Token generated. Copy it now.');await loadSettings();}catch(e){message(result,e.message,true);}}
document.querySelectorAll('[data-generate]').forEach(b=>b.addEventListener('click',()=>generate(b.dataset.generate)));
document.querySelectorAll('[data-reveal]').forEach(b=>b.addEventListener('click',()=>{const i=$(b.dataset.reveal);i.type=i.type==='password'?'text':'password';}));
document.querySelectorAll('[data-copy]').forEach(b=>b.addEventListener('click',async()=>{const i=$(b.dataset.copy);try{await navigator.clipboard.writeText(i.value);message(b.dataset.copy.startsWith('master')?'masterTokenResult':'androidTokenResult','Token copied. Store it securely.');}catch(e){i.type='text';i.select();message(b.dataset.copy.startsWith('master')?'masterTokenResult':'androidTokenResult','Clipboard blocked; token selected for manual copy.',true);}}));
$('coreForm').addEventListener('submit',async e=>{e.preventDefault();$('saveCoreBtn').disabled=true;$('coreStatus').textContent='Saving…';try{const body={mikrotik_core_host:$('coreHost').value,mikrotik_core_api_port:$('corePort').value,mikrotik_core_username:$('coreUser').value,mikrotik_core_password:$('corePassword').value};const d=await api('/api/server-settings/core-settings',{method:'PUT',body:JSON.stringify(body)});$('coreStatus').textContent=d.message; $('corePassword').value='';await loadSettings();}catch(err){$('coreStatus').textContent=err.message;}finally{$('saveCoreBtn').disabled=false;}});
function safe(text){return String(text??'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));}
async function loadTenants(){const d=await api('/api/server-settings/tenants');const body=$('tenantRows');body.replaceChildren();(d.tenants||[]).forEach(t=>{const tr=document.createElement('tr');const status=String(t.subscription_status||t.status||'unknown');const moduleBox=['hotspot','sms_gateway','whatsapp'].map(k=>'<label class="module-check"><input type="checkbox" data-module="'+k+'" '+(t.modules?.[k]?'checked':'')+'> '+({hotspot:'Hotspot',sms_gateway:'SMS',whatsapp:'WhatsApp'}[k])+'</label>').join('');tr.innerHTML='<td><strong>'+safe(t.name)+'</strong><div class="tiny muted">'+safe(t.slug)+'</div><div class="tiny muted">'+safe(t.contact_email||'')+'</div></td><td><span class="status-pill '+(status==='active'?'bg-success-subtle text-success':'bg-warning-subtle text-warning-emphasis')+'">'+safe(status)+'</span><div class="tiny muted">'+(t.ends_at?'Until '+safe(new Date(t.ends_at).toLocaleDateString()):'No subscription')+'</div></td><td><strong>'+safe(t.days_remaining??0)+'</strong></td><td>'+moduleBox+'<button class="btn btn-sm btn-outline-success mt-1" data-action="modules" data-id="'+t.id+'">Save modules</button></td><td><div class="tenant-actions"><button class="btn btn-sm btn-outline-success" data-action="activate" data-id="'+t.id+'">Activate</button><button class="btn btn-sm btn-outline-primary" data-action="extend" data-id="'+t.id+'">+30 days</button><button class="btn btn-sm btn-outline-danger" data-action="suspend" data-id="'+t.id+'">Suspend</button></div></td>';body.append(tr);});$('tenantStatus').textContent=(d.tenants||[]).length+' tenant(s) · subscription countdown uses server time';if(!body.children.length)body.innerHTML='<tr><td colspan="5" class="muted">No tenants registered yet.</td></tr>';}
$('tenantRows').addEventListener('click',async e=>{const b=e.target.closest('button[data-action]');if(!b)return;const action=b.dataset.action,id=b.dataset.id;try{let body={action};if(action==='extend'&&!confirm('Extend this tenant subscription by 30 days?'))return;if(action==='suspend'&&!confirm('Suspend this tenant?'))return;if(action==='modules'){const tr=b.closest('tr');body.modules=Object.fromEntries([...tr.querySelectorAll('[data-module]')].map(i=>[i.dataset.module,i.checked]));}await api('/api/server-settings/tenants/'+encodeURIComponent(id),{method:'PATCH',body:JSON.stringify(body)});await loadTenants();}catch(err){$('tenantStatus').textContent=err.message;}});
$('tenantForm').addEventListener('submit',async e=>{e.preventDefault();try{await api('/api/server-settings/tenants',{method:'POST',body:JSON.stringify({name:$('tenantName').value,slug:$('tenantSlug').value,contact_email:$('tenantEmail').value,contact_phone:$('tenantPhone').value})});e.target.reset();await loadTenants();}catch(err){$('tenantStatus').textContent=err.message;}});
$('refreshTenants').addEventListener('click',()=>loadTenants().catch(e=>$('tenantStatus').textContent=e.message));
Promise.all([loadSettings(),loadTenants()]).catch(e=>{ $('globalMessage').textContent=e.message;$('globalMessage').className='alert alert-danger';});
</script>
</body></html>