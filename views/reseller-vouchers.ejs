<%
const brand=typeof brandSettings!=='undefined'&&brandSettings?brandSettings:{};
const brandName=String(brand.company_name||'FAZ NETWORK');
const safeResellerName=String(resellerName||'Reseller');
const activePath=String(currentPath||'');
%>
<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><meta name="robots" content="noindex,nofollow"><title><%= title||brandName %></title>
<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet"><link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css"><link rel="stylesheet" href="/css/reseller-workspace.css?v=20261101-1">
<% if(pageMode==='generate'){ %><script src="https://cdnjs.cloudflare.com/ajax/libs/qrcodejs/1.0.0/qrcode.min.js" defer></script>
<style>
.pos-terminal{display:grid;grid-template-columns:minmax(0,1.5fr) minmax(300px,.85fr);gap:18px;align-items:start}.pos-panel{background:#fff;border:1px solid #e2e8f0;border-radius:16px;padding:22px}.pos-summary{position:sticky;top:16px;background:#0f172a;color:#f8fafc;border-radius:16px;padding:22px}.pos-kicker{font-size:.72rem;letter-spacing:.1em;text-transform:uppercase;font-weight:800;color:#64748b}.pos-summary .pos-kicker,.pos-summary .muted{color:#cbd5e1}.pos-field{width:100%;border:1px solid #cbd5e1;border-radius:10px;padding:11px;background:#fff}.pos-package-scroll{max-height:380px;overflow-y:auto;padding-right:8px;overscroll-behavior:contain}.pos-packages{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:10px}.package-card.is-selected{border:2px solid #15803d;background:rgba(240,253,244,.5);box-shadow:0 0 0 2px rgba(22,163,74,.18)}.pos-issue.is-ready{background:#15803d;box-shadow:0 4px 12px rgba(21,128,61,.22)}.pos-package{width:100%;height:100%;text-align:left;background:#fff;border:1px solid #e2e8f0;border-radius:12px;padding:13px}.pos-package[aria-pressed=true]{border:2px solid #15803d;background:#f0fdf4}.pos-chip{border:1px solid #cbd5e1;background:#fff;border-radius:9px;padding:8px 13px;font-weight:700}.pos-balance{border:1px solid #e2e8f0;background:#f8fafc;border-radius:12px;padding:13px}.pos-line{display:flex;justify-content:space-between;gap:10px;border-bottom:1px solid #334155;padding:11px 0}.pos-amount{font-size:1.45rem;font-weight:800}.pos-issue{width:100%;padding:14px;border:0;border-radius:11px;background:#16a34a;color:#fff;font-weight:800}.pos-issue:disabled{background:#94a3b8}.pos-error{padding:13px;border-radius:10px;border:1px solid #fecaca;background:#fef2f2;color:#991b1b}.pos-voucher-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(220px,1fr));gap:10px}.pos-voucher{display:grid;grid-template-columns:88px 1fr;gap:10px;border:1px dashed #64748b;border-radius:10px;padding:10px;break-inside:avoid}.pos-qr{width:88px;height:88px}.pos-qr img{max-width:88px}.pos-credential{font:600 .82rem ui-monospace,monospace;overflow-wrap:anywhere}.pos-preview{background:#f8fafc;border:1px solid #e2e8f0;border-radius:10px;padding:12px;max-height:55vh;overflow:auto}
@media(max-width:991px){.pos-terminal{grid-template-columns:1fr}.pos-summary{position:static}}@media(max-width:575px){.pos-panel,.pos-summary{padding:15px}.pos-packages{grid-template-columns:1fr}}
@page thermal58{size:58mm auto;margin:2mm}@page thermal80{size:80mm auto;margin:3mm}@media print{@page{size:A4;margin:8mm}body *{visibility:hidden!important}#voucherBatchResultModal,#voucherBatchResultModal *{visibility:visible!important}#voucherBatchResultModal{position:absolute!important;inset:0!important;display:block!important;background:#fff!important}#voucherBatchResultModal .modal-dialog{max-width:none!important;margin:0!important}#voucherBatchResultModal .modal-content{border:0!important}#voucherBatchResultModal .modal-header,#voucherBatchResultModal .modal-footer,.pos-no-print{display:none!important}#voucherBatchResultModal .modal-body{padding:0!important}.pos-preview{max-height:none;overflow:visible;border:0;padding:0}.pos-voucher-grid{grid-template-columns:repeat(4,minmax(0,1fr))!important;gap:4mm}.pos-voucher{display:block;border-radius:0;padding:5px;min-height:30mm;font-size:8pt}.pos-qr{margin:3px auto;width:66px;height:66px}.pos-qr img{max-width:66px}body.print-thermal-58{page:thermal58}body.print-thermal-80{page:thermal80}body.print-thermal-58 .pos-voucher-grid,body.print-thermal-80 .pos-voucher-grid{display:block!important}body.print-thermal-58 .pos-voucher,body.print-thermal-80 .pos-voucher{display:grid!important;grid-template-columns:54px 1fr!important;border:0;border-bottom:1px dashed #64748b;min-height:0;padding:6px 0}body.print-thermal-58 .pos-qr{width:52px;height:52px}body.print-thermal-80 .pos-qr{width:68px;height:68px}}
</style><% } %></head><body>
<%- include('partials/reseller-sidebar',{brandName,safeResellerName,activePath}) %><div class="reseller-main"><%- include('partials/reseller-topbar',{brandName,safeResellerName,title,activePath}) %><main class="reseller-content">
<% if(pageMode==='generate'){ %>
<section class="reseller-panel mb-3"><div class="reseller-section-heading"><div><h2>Generate Hotspot Vouchers</h2><div class="pos-kicker">POS Voucher Issuance Terminal</div><p>Live package pricing, reseller margin and secure voucher issuance</p></div><span class="badge badge-soft">Server-verified billing</span></div>
<div id="issuanceErrorBanner" class="pos-error d-none mb-3" role="alert" aria-live="assertive"></div><div id="voucherReadinessWarning" class="alert alert-warning d-none" role="alert" aria-live="assertive"></div><div id="issuanceSuccessBanner" class="alert alert-success d-none" role="status" aria-live="polite"></div>
<div class="pos-terminal"><section class="pos-panel"><div class="d-flex justify-content-between flex-wrap gap-2"><span class="pos-kicker">01 / Issuance station</span><span id="popSyncBadge" class="badge text-bg-success">Waiting for POP sync</span></div><h3 class="h5 fw-bold mt-2">Select POP &amp; package</h3>
<label class="form-label fw-semibold" for="voucherPop">Assigned Hotspot POP</label><select id="voucherPop" class="pos-field mb-3"><option>Loading POPs…</option></select>
<div class="d-flex justify-content-between mb-2"><strong>Active packages</strong><span id="packageCount" class="small text-secondary"></span></div><input id="voucherPackage" type="hidden"><div class="pos-package-scroll mb-3"><div id="voucherPackageGrid" class="pos-packages">Select a POP to load packages.</div></div>
<div class="row g-3"><div class="col-md-6"><label for="voucherQuantity" class="form-label fw-semibold">Quantity (1–500)</label><input id="voucherQuantity" class="pos-field" type="number" min="1" max="500" step="1" value="10"></div></div>
<div class="d-flex flex-wrap gap-2 my-3"><button type="button" class="pos-chip" data-quantity-add="1">+1</button><button type="button" class="pos-chip" data-quantity-add="5">+5</button><button type="button" class="pos-chip" data-quantity-add="10">+10</button><button type="button" class="pos-chip" data-quantity-add="25">+25</button><button type="button" class="pos-chip" data-quantity-add="50">+50</button></div>
<div class="pos-balance"><div class="pos-kicker">Reseller wallet / account</div><div id="voucherAccount" class="small mt-1">Loading billing account…</div></div></section>
<aside class="pos-summary"><div class="pos-kicker">02 / Live terminal receipt</div><h3 class="h5 fw-bold text-white mt-2">Financial summary</h3><div class="pos-line"><span class="muted">Total retail value</span><strong id="summaryRetail">৳—</strong></div><div class="pos-line"><span class="muted">Reseller margin discount</span><strong id="summaryMargin">৳—</strong></div><div class="pos-line"><span class="muted">Net wallet debit / cost</span><strong id="summaryDebit">৳—</strong></div><div class="mt-3 p-3 rounded" style="background:#263449"><div class="muted small">Balance / available credit after issue</div><div id="summaryAfter" class="pos-amount mt-1">৳—</div><div id="summaryGuard" class="small muted mt-2">Select a package.</div></div><button id="btnIssueVouchers" class="pos-issue mt-3" type="button" disabled><i class="bi bi-lightning-charge-fill me-2"></i>Issue voucher batch</button><div id="voucherImpact" class="small muted mt-3" aria-live="polite">Choose an eligible POP and package.</div></aside></div></section>
<div class="modal fade" id="voucherBatchResultModal" tabindex="-1" aria-labelledby="voucherBatchResultTitle" aria-hidden="true"><div class="modal-dialog modal-xl modal-dialog-scrollable"><div class="modal-content"><div class="modal-header"><div><h2 class="modal-title fs-5" id="voucherBatchResultTitle">Voucher batch receipt</h2><div id="resultBatchReference" class="small text-secondary"></div></div><button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button></div><div class="modal-body"><div class="d-flex flex-wrap gap-2 justify-content-between mb-3 pos-no-print"><span id="resultBatchSummary" class="small text-secondary"></span><div class="d-flex flex-wrap gap-2"><button type="button" class="btn btn-outline-secondary btn-sm" data-print-format="thermal-58">Print 58mm</button><button type="button" class="btn btn-outline-secondary btn-sm" data-print-format="thermal-80">Print 80mm</button><button type="button" class="btn btn-success btn-sm" data-print-format="a4">Print A4 Sheet</button><button type="button" class="btn btn-outline-primary btn-sm" id="exportVoucherCsv">Export CSV</button></div></div><div class="pos-preview"><div id="printBatchMeta" class="text-center small mb-3"></div><div id="voucherResultGrid" class="pos-voucher-grid"></div></div></div><div class="modal-footer pos-no-print"><a id="serverPrintLink" class="btn btn-outline-success" target="_blank" rel="noopener">Open consolidated print page</a><button type="button" class="btn btn-light" data-bs-dismiss="modal">Close</button></div></div></div></div>
<% }else{ %><section class="reseller-panel"><div class="reseller-section-heading"><div><h2>Voucher Batch History &amp; Reprint</h2><p>Issued batches · read-only history</p></div><button id="refreshVoucherHistory" class="btn btn-sm btn-outline-success" type="button">Refresh history</button></div><div id="voucherHistoryError" class="alert alert-danger d-none" role="alert"></div><div class="table-responsive"><table class="table table-hover align-middle"><thead><tr><th>Date</th><th>Batch</th><th>POP</th><th>Package</th><th>Quantity</th><th>Total cost</th><th>Margin</th><th>Action</th></tr></thead><tbody id="voucherHistoryRows"><tr><td colspan="8">Loading history…</td></tr></tbody></table></div></section><% } %>
</main><footer class="reseller-footer">© <%= new Date().getFullYear() %> <%= brandName %> · Reseller Workspace</footer></div><%- include('partials/reseller-scripts', { activePath }) %></body></html>