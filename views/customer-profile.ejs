<!doctype html>
<% const brand=typeof brandSettings!=="undefined"&&brandSettings?brandSettings:{}; const brandName=String(brand.company_name||"FAZ NETWORK"); %>
<html lang="en"><head>
<meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1">
<title><%= brandName %> · Customer 360</title><% if(brand.favicon_url){ %><link rel="icon" href="<%= brand.favicon_url %>"><% } %>
<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
<style>
body{background:#f8fafc;font-family:Segoe UI,Arial,sans-serif;color:#0f172a}.hero{background:linear-gradient(135deg,#0a3d2e,#0d4d3a);color:#fff}.card{box-shadow:0 .125rem .25rem rgba(0,0,0,.075)}.label{font-size:.75rem;text-transform:uppercase;letter-spacing:.05em;color:#64748b}.metric{font-size:1.45rem;font-weight:700}.mono{font-family:ui-monospace,SFMono-Regular,Menlo,monospace}.live-dot{width:9px;height:9px;border-radius:50%;display:inline-block;background:#94a3b8}.live-dot.online{background:#34d399;animation:pulse 1.7s infinite}@keyframes pulse{70%{box-shadow:0 0 0 8px rgba(52,211,153,0)}}.sticky{position:sticky;top:0;z-index:1020;background:rgba(248,250,252,.95);backdrop-filter:blur(8px)}.topology-chain{display:grid;grid-template-columns:repeat(5,minmax(0,1fr));gap:1.8rem}.topology-node{position:relative;min-width:0;min-height:118px;border:1px solid #dbe5e1;border-radius:14px;padding:14px;background:linear-gradient(160deg,#fff,#f6fbf8);overflow-wrap:anywhere}.topology-node:not(:last-child):after{content:"➜";position:absolute;right:-1.45rem;top:42%;font-size:1.2rem;font-weight:800;color:#10b981}.topology-step{font-size:.68rem;font-weight:800;letter-spacing:.08em;text-transform:uppercase;color:#0d6b50}.topology-value{font-weight:700;margin-top:8px;color:#0f172a}.topology-detail{font-size:.78rem;color:#64748b;margin-top:5px}.topology-health{display:inline-flex;align-items:center;border-radius:999px;padding:3px 9px;font-size:.72rem;font-weight:700;background:#e2e8f0;color:#334155}.topology-health.good{background:#d1fae5;color:#065f46}.topology-health.warning{background:#fef3c7;color:#92400e}.topology-health.bad{background:#fee2e2;color:#991b1b}@media(max-width:1199px){.topology-chain{grid-template-columns:repeat(3,minmax(0,1fr))}.topology-node:not(:last-child):after{display:none}}@media(max-width:767px){.sticky .container-fluid{flex-direction:column;align-items:stretch;gap:.65rem}.sticky .container-fluid>a{align-self:flex-start;white-space:normal}.sticky .container-fluid>span{display:block;white-space:normal;line-height:1.35;font-size:.875rem!important}.topology-chain{grid-template-columns:minmax(0,1fr);gap:.75rem}.topology-node{min-height:auto;padding:16px}.topology-node .topology-value{font-size:1rem;line-height:1.4}.topology-node .topology-detail{overflow-wrap:anywhere}.hero .d-flex.gap-2.flex-wrap{gap:.5rem!important}.hero button{max-width:100%;white-space:normal}}

/* Active Customer 360 page: mobile-only compact management dock and topology strip. */
@media (max-width: 767.98px) {
  #app { padding-left: .65rem !important; padding-right: .65rem !important; }
  .hero { padding: .8rem !important; border-radius: 12px !important; }
  .hero #name { font-size: 1.15rem; line-height: 1.3; overflow-wrap: anywhere; }
  .hero > .d-flex { gap: .65rem !important; }
  .hero .small.mt-2 { gap: .4rem .75rem !important; font-size: .78rem; }
  .hero #liveIp { overflow-wrap: anywhere; word-break: break-word; }
  .customer360-action-dock {
    display: grid !important;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: .45rem !important;
    width: 100%;
  }
  .customer360-action-dock .btn {
    min-width: 0;
    min-height: 44px;
    padding: .45rem .3rem;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: .25rem;
    font-size: .72rem;
    line-height: 1.2;
    overflow-wrap: anywhere;
    white-space: normal;
    touch-action: manipulation;
  }
  .topology-chain {
    display: flex !important;
    flex-wrap: nowrap !important;
    gap: .55rem !important;
    overflow-x: auto;
    overflow-y: hidden;
    padding: .2rem .1rem .65rem;
    margin: 0 -.15rem;
    scroll-snap-type: x proximity;
    -webkit-overflow-scrolling: touch;
    overscroll-behavior-x: contain;
    scrollbar-width: none;
  }
  .topology-chain::-webkit-scrollbar { display: none; }
  .topology-node {
    flex: 0 0 148px;
    width: 148px;
    min-height: 82px !important;
    padding: .6rem !important;
    border-radius: 10px !important;
    scroll-snap-align: start;
  }
  .topology-node:not(:last-child):after { display: block !important; right: -.52rem; top: 42%; font-size: .7rem; z-index: 1; }
  .topology-step { font-size: .61rem; letter-spacing: .035em; line-height: 1.3; }
  .topology-value { margin-top: .35rem; font-size: .82rem; line-height: 1.3; overflow-wrap: anywhere; word-break: break-word; }
  .topology-detail { margin-top: .25rem; font-size: .68rem; line-height: 1.25; overflow-wrap: anywhere; }
  main#app > section.card { margin-bottom: .65rem !important; }
  main#app > section.card > .card-body { padding: .8rem; }
  .metric { font-size: 1.15rem; }
  .mono, code, [id="liveIp"] { overflow-wrap: anywhere; word-break: break-word; }
}

/* Keep customer key/value panels inside the mobile viewport. */
@media (max-width: 767.98px) {
  #app .customer-info-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: .75rem !important;
    margin-left: 0;
    margin-right: 0;
  }
  #app .customer-info-grid > .customer-info-panel {
    width: 100%;
    max-width: 100%;
    min-width: 0;
    padding-left: 0;
    padding-right: 0;
  }
  #app .customer-info-grid h5 { overflow-wrap: anywhere; }
  #app .customer-info-grid .row {
    --bs-gutter-x: .75rem;
    --bs-gutter-y: .7rem;
    min-width: 0;
  }
  #app .customer-info-grid .label {
    line-height: 1.35;
    overflow-wrap: anywhere;
  }
  #app .customer-info-grid [id="fullName"],
  #app .customer-info-grid [id="phone2"],
  #app .customer-info-grid [id="alt"],
  #app .customer-info-grid [id="nid"],
  #app .customer-info-grid [id="address"],
  #app .customer-info-grid [id="area"],
  #app .customer-info-grid [id="connection"],
  #app .customer-info-grid [id="contactEmail"],
  #app .customer-info-grid [id="contactWhatsapp"],
  #app .customer-info-grid [id="user2"],
  #app .customer-info-grid [id="onu"],
  #app .customer-info-grid [id="routerMac"],
  #app .customer-info-grid [id="box"],
  #app .customer-info-grid [id="core"],
  #app .customer-info-grid [id="olt"],
  #app .customer-info-grid [id="remote"],
  #app .customer-info-grid .mono,
  #app .customer-info-grid code {
    display: block;
    max-width: 100%;
    min-width: 0;
    white-space: normal;
    overflow-wrap: anywhere;
    word-break: break-word;
  }
  #app .customer-info-grid .input-group { min-width: 0; max-width: 100%; }
  #app .customer-info-grid .form-control { min-width: 0; }
}

.customer-info-accordions{display:grid;grid-template-columns:minmax(0,1fr);gap:12px;width:100%}.customer-info-accordion{min-width:0;border:1px solid #e2e8f0;border-radius:14px;background:#fff;overflow:hidden;box-shadow:0 3px 12px rgba(15,23,42,.035)}.customer-info-accordion-wide{grid-column:auto}.customer-info-accordion>summary{display:flex;align-items:center;justify-content:space-between;gap:12px;min-height:54px;padding:14px 16px;list-style:none;cursor:pointer;color:#0f172a;font-size:.92rem;font-weight:750;line-height:1.35}.customer-info-heading{display:inline-flex;align-items:center;gap:0;min-width:0}.customer-info-heading-icon{width:1rem;height:1rem;flex:0 0 1rem;margin-right:.5rem;color:#64748b;display:block}.customer-info-accordion>summary::-webkit-details-marker{display:none}.customer-info-accordion>summary:focus-visible{outline:3px solid rgba(16,185,129,.35);outline-offset:-3px}.customer-info-chevron{flex:0 0 auto;color:#64748b;transition:transform .22s ease}.customer-info-accordion[open]>summary{border-bottom:1px solid #edf2f7;background:linear-gradient(100deg,#fff,#f8fffb)}.customer-info-accordion[open]>summary .customer-info-chevron{transform:rotate(180deg)}.customer-info-accordion-body{display:grid;grid-template-rows:0fr;transition:grid-template-rows .24s ease}.customer-info-accordion[open]>.customer-info-accordion-body{grid-template-rows:1fr}.customer-info-content{min-height:0;overflow:hidden;padding:0 14px}.customer-info-accordion[open]>.customer-info-accordion-body>.customer-info-content{padding:14px}@media(min-width:768px){.customer-info-accordions{grid-template-columns:repeat(3,minmax(0,1fr));gap:16px}.customer-info-accordion-wide{grid-column:auto}.customer-info-accordion>summary{cursor:default}.customer-info-chevron{display:none}.customer-info-accordion .customer-info-accordion-body{grid-template-rows:1fr!important;transition:none}.customer-info-accordion .customer-info-content{padding:14px!important}}.customer-info-kv-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:9px}.customer-info-kv{min-width:0;padding:10px;border:1px solid #edf2f7;border-radius:10px;background:#fbfdff;font-family:ui-monospace,SFMono-Regular,Menlo,monospace;font-size:.75rem;line-height:1.4}.customer-info-kv-wide{grid-column:1/-1}.customer-info-kv .label{font-family:system-ui,-apple-system,Segoe UI,sans-serif;font-size:.65rem;font-weight:750;letter-spacing:.04em;margin-bottom:5px}.customer-info-kv>div:not(.label),.customer-info-kv code,.customer-info-kv .form-control{min-width:0;max-width:100%;overflow-wrap:anywhere;word-break:break-word;white-space:normal}.customer-info-kv .input-group{min-width:0;max-width:100%;flex-wrap:nowrap}.customer-info-kv .input-group .form-control{width:1%;flex:1 1 auto}
@media(max-width:767.98px){.customer-info-accordions{display:flex;flex-direction:column;gap:12px;width:100%}.customer-info-accordion-wide{grid-column:auto}.customer-info-accordion:not([open])>summary{border-bottom:0}.customer-info-accordion>summary{min-height:52px;padding:13px 14px;font-size:.86rem;cursor:pointer}.customer-info-kv-grid{grid-template-columns:repeat(2,minmax(0,1fr));gap:7px}.customer-info-kv{padding:9px;font-size:.7rem;overflow-wrap:anywhere}.customer-info-kv .label{font-size:.62rem}.customer-info-content{padding-left:10px;padding-right:10px}.customer-info-accordion[open]>.customer-info-accordion-body>.customer-info-content{padding:10px}}
@media(max-width:350px){.customer-info-kv-grid{grid-template-columns:minmax(0,1fr)}.customer-info-kv-wide{grid-column:auto}}
/* Readable field typography and a self-contained horizontal scroller for observation data. */
.customer-info-accordion>summary{font-size:.95rem;font-weight:700;padding:12px 16px;min-height:54px}
.customer-info-kv{font-size:.875rem;line-height:1.5}
.customer-info-kv .label{font-size:.75rem;font-weight:700;letter-spacing:.075em;color:#64748b;line-height:1.35}
.customer-info-kv>div:not(.label),.customer-info-kv code,.customer-info-kv .form-control{font-size:.875rem;font-weight:700;color:#0f172a;overflow-wrap:anywhere;word-break:break-word}
.customer-info-kv .mono,.customer-info-kv [id="user2"],.customer-info-kv [id="onu"],.customer-info-kv [id="routerMac"],.customer-info-kv [id="remote"]{font-family:ui-monospace,SFMono-Regular,Menlo,monospace;font-size:.875rem;font-weight:700}
.network-map-table-scroll{width:100%;max-width:100%;overflow-x:auto;padding-bottom:.5rem;margin-left:-.25rem;margin-right:-.25rem;padding-left:.25rem;padding-right:.25rem;-webkit-overflow-scrolling:touch;overscroll-behavior-x:contain}
.network-map-table-scroll table{min-width:660px;width:100%;table-layout:auto}
.network-map-table-scroll th,.network-map-table-scroll td{white-space:nowrap;vertical-align:middle}
.network-map-table-scroll td{overflow-wrap:normal;word-break:normal}
@media(max-width:767.98px){
 .customer-info-accordion>summary{font-size:.95rem;padding:12px 14px;min-height:52px}
 .customer-info-kv{font-size:.875rem;padding:10px;line-height:1.5}
 .customer-info-kv .label{font-size:.75rem;letter-spacing:.075em}
 .customer-info-kv>div:not(.label),.customer-info-kv code,.customer-info-kv .form-control{font-size:.875rem}
 .network-map-table-scroll table{min-width:660px}
}
/* Mobile-only compact layout for package, billing and live session cards.
   Desktop Bootstrap columns remain unchanged. */
@media (max-width: 767.98px) {
  #app > section.row.g-3.mb-3 {
    display: grid !important;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: .625rem !important;
    margin: 0 0 .8rem !important;
  }
  #app > section.row.g-3.mb-3 > .col-xl-4 {
    width: auto !important;
    max-width: none !important;
    min-width: 0;
    padding: 0 !important;
  }
  #app > section.row.g-3.mb-3 > .col-xl-4 > .card {
    height: 100% !important;
    min-width: 0;
    border: 1px solid #e2e8f0 !important;
    border-radius: 12px !important;
    box-shadow: 0 2px 7px rgba(15,23,42,.045);
  }
  #app > section.row.g-3.mb-3 > .col-xl-4 > .card > .card-body {
    padding: .7rem !important;
    min-width: 0;
  }
  #app > section.row.g-3.mb-3 .label {
    font-size: .7rem;
    font-weight: 750;
    letter-spacing: .055em;
    line-height: 1.3;
    overflow-wrap: anywhere;
  }
  #app > section.row.g-3.mb-3 .metric {
    margin-top: .3rem !important;
    font-size: 1.05rem;
    line-height: 1.3;
    overflow-wrap: anywhere;
    word-break: break-word;
  }
  #app > section.row.g-3.mb-3 #rate,
  #app > section.row.g-3.mb-3 .text-muted,
  #app > section.row.g-3.mb-3 .small {
    font-size: .75rem;
    line-height: 1.4;
    overflow-wrap: anywhere;
    word-break: break-word;
  }
  #app > section.row.g-3.mb-3 #changePkg {
    margin-top: .6rem !important;
    padding: .25rem .5rem;
    font-size: .75rem;
    line-height: 1.3;
    border-radius: .5rem;
  }
  #app > section.row.g-3.mb-3 #expiry,
  #app > section.row.g-3.mb-3 #cycle,
  #app > section.row.g-3.mb-3 #pool,
  #app > section.row.g-3.mb-3 #rx,
  #app > section.row.g-3.mb-3 #tx,
  #app > section.row.g-3.mb-3 #reason {
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size: .75rem;
    font-weight: 700;
    overflow-wrap: anywhere;
    word-break: break-word;
  }
}
@media (max-width: 390px) {
  #app > section.row.g-3.mb-3 { gap: .5rem !important; }
  #app > section.row.g-3.mb-3 > .col-xl-4 > .card > .card-body { padding: .6rem !important; }
  #app > section.row.g-3.mb-3 .label { font-size: .66rem; }
  #app > section.row.g-3.mb-3 .metric { font-size: 1rem; }
}

/* Final responsive summary-card layout: mobile swipe rail, desktop three-column grid. */
@media (max-width: 767.98px) {
  #app > section.row.g-3.mb-3 {
    display: flex !important;
    flex-wrap: nowrap !important;
    overflow-x: auto;
    overflow-y: hidden;
    gap: .75rem !important;
    margin: 0 -.15rem .9rem !important;
    padding: .15rem .15rem .65rem;
    scroll-snap-type: x mandatory;
    -webkit-overflow-scrolling: touch;
    overscroll-behavior-x: contain;
    scrollbar-width: none;
  }
  #app > section.row.g-3.mb-3::-webkit-scrollbar { display: none; }
  #app > section.row.g-3.mb-3 > .col-xl-4 {
    flex: 0 0 min(82%, 330px) !important;
    width: min(82%, 330px) !important;
    max-width: min(82%, 330px) !important;
    min-width: 0;
    padding: 0 !important;
    scroll-snap-align: start;
  }
  #app > section.row.g-3.mb-3 > .col-xl-4 > .card { height: 100% !important; }
}
@media (min-width: 1200px) {
  #app > section.row.g-3.mb-3 {
    display: grid !important;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    align-items: stretch;
    gap: 1rem !important;
    margin-left: 0 !important;
    margin-right: 0 !important;
  }
  #app > section.row.g-3.mb-3 > .col-xl-4 {
    width: auto !important;
    max-width: none !important;
    min-width: 0;
    padding: 0 !important;
  }
  #app > section.row.g-3.mb-3 > .col-xl-4 > .card { height: 100% !important; }
}
/* Topology Bridge: three equal OLT telemetry cards, no horizontal overflow. */
.topology-chain{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:.75rem;width:100%;min-width:0}
.topology-node{width:auto;min-width:0;min-height:110px;flex:initial;overflow-wrap:anywhere}
.topology-node:not(:last-child):after{display:none!important}
.topology-step{overflow-wrap:anywhere;word-break:break-word}
.topology-value,.topology-detail{overflow-wrap:anywhere;word-break:break-word;min-width:0}
@media(max-width:767.98px){.topology-chain{display:grid!important;grid-template-columns:minmax(0,1fr)!important;gap:.65rem!important;overflow:visible!important;margin:0!important;padding:.1rem 0!important}.topology-node{width:100%!important;max-width:100%;min-height:0!important;padding:.85rem!important;flex:none!important}.topology-step{font-size:.68rem;letter-spacing:.05em}.topology-value{font-size:1rem;line-height:1.4}.topology-detail{font-size:.8rem;line-height:1.4}}
</style><script src="/js/date-format.js"></script>
</head>
<body>
<div class="sticky border-bottom py-2 mb-3"><div class="container-fluid px-3 px-lg-4 d-flex flex-column flex-sm-row align-items-sm-center justify-content-sm-between gap-2"><a href="/admin" class="btn btn-sm btn-outline-secondary align-self-start"><i class="bi bi-arrow-left me-1"></i>Back to Customers</a><span class="small text-muted text-sm-end">Customer 360 / Master Management Hub</span></div></div>
<main id="app" class="container-fluid px-3 px-lg-4 pb-5" data-id="<%= customerId %>">
<section class="hero rounded-3 p-3 p-lg-4 mb-3"><div class="d-flex flex-column flex-xl-row justify-content-between gap-3 align-items-xl-center">
<div><div class="d-flex gap-2 align-items-center flex-wrap"><h2 id="name" class="mb-0">Loading…</h2><span id="status" class="badge bg-secondary">Loading billing</span><span id="routerStatus" class="badge bg-secondary"><span class="live-dot me-1"></span>Checking router</span></div><div class="small mt-2 d-flex gap-3 flex-wrap"><span><i class="bi bi-telephone me-1"></i><span id="phone">—</span></span><span class="mono"><i class="bi bi-person-badge me-1"></i><span id="username">—</span></span><span id="liveIp" class="mono">IP — · MAC —</span></div></div>
<div class="customer360-action-dock d-flex gap-2 flex-wrap"><button id="syncMikrotik" class="btn btn-light text-success fw-semibold"><i class="bi bi-arrow-repeat me-1"></i>Sync to MikroTik</button><button id="usageRecord" class="btn btn-outline-info"><i class="bi bi-bar-chart-line me-1"></i>Usage Record</button><button id="kick" class="btn btn-outline-warning"><i class="bi bi-lightning-charge me-1"></i>Kick / Restart Session</button><button id="renew" class="btn btn-success"><i class="bi bi-credit-card me-1"></i>Add Payment / Renew</button><button id="edit" class="btn btn-outline-primary"><i class="bi bi-pencil-square me-1"></i>Edit Info</button><button id="suspend" class="btn btn-outline-danger"><i class="bi bi-slash-circle me-1"></i>Suspend Line</button></div>
</div></section>
<section class="card border-0 rounded-3 mb-3"><div class="card-body">
<div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-3"><div><h5 class="mb-1"><i class="bi bi-diagram-3 me-2 text-success"></i>Network Topology Bridge</h5><div class="small text-muted">Customer-to-OLT connection path · live values appear only when verified</div></div><span id="topologyOverall" class="topology-health">Awaiting telemetry</span></div>
<div class="topology-chain" aria-label="OLT telemetry cards">
<div class="topology-node"><div class="topology-step">01 · OLT PON Port</div><div id="topoPon" class="topology-value">Auto-detecting...</div><div class="topology-detail">OLT uplink / PON mapping</div></div>
<div class="topology-node"><div class="topology-step">02 · ONU Identity</div><div id="topoOnu" class="topology-value">Auto-detecting...</div><div id="topoOnuMac" class="topology-detail mono">ONU MAC: Auto-mapping...</div></div>
<div class="topology-node"><div class="topology-step">03 · Optical Health</div><div id="topoRx" class="topology-value">— dBm</div><div id="topoHealth" class="topology-detail"><span class="topology-health">Awaiting live reading</span></div></div>
</div>
</div></section>
<section class="row g-3 mb-3">
<div class="col-xl-4"><div class="card border-0 rounded-3 h-100"><div class="card-body"><div class="label">Package & Bandwidth</div><div id="pkg" class="metric mt-1">—</div><div id="rate" class="text-muted mt-2">Bandwidth —</div><div class="small mt-2">IP Pool: <strong id="pool">—</strong></div><button id="changePkg" class="btn btn-sm btn-outline-primary mt-3">Change Package</button></div></div></div>
<div class="col-xl-4"><div class="card border-0 rounded-3 h-100"><div class="card-body"><div class="label">Billing Status & Expiry</div><div id="days" class="metric mt-1">—</div><div class="text-muted mt-2">Expiry: <strong id="expiry">—</strong></div><div class="small mt-2">Billing cycle: <strong id="cycle">1 month</strong></div></div></div></div>
<div class="col-xl-4"><div class="card border-0 rounded-3 h-100"><div class="card-body"><div class="label">Real-time Session</div><div id="uptime" class="metric mt-1">Offline</div><div class="small text-muted mt-2">Download rate <strong id="rx" title="Live receive rate">—</strong> · Upload rate <strong id="tx" title="Live transmit rate">—</strong></div><div class="small text-muted mt-1" id="trafficStatus">Checking live traffic…</div><div id="liveStatusBanner" class="alert alert-warning py-2 px-3 mt-2 mb-0 small d-none" role="status" aria-live="polite">Live router status temporarily unavailable; saved customer records remain available.</div><div class="small mt-2">Last disconnect: <span id="reason">—</span></div></div></div></div>
</section>
