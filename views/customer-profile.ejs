<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
<script>
(()=>{const root=document.getElementById('app'),id=root.dataset.id,$=x=>document.getElementById(x);let state={};
let livePollBusy=false,networkMapBusy=false,profileLoadBusy=false;
const hasValue=v=>v!==null&&v!==undefined&&String(v).trim()!==''&&String(v).trim()!=='—';
const savedOnuMac=()=>hasValue(state?.customer?.onuMac)?String(state.customer.onuMac).trim():'';
function mergeCustomerState(incoming){const previous=state||{},next=incoming||{},oldLive=previous.live||{},newLive=next.live||{};state={...previous,...next,customer:{...(previous.customer||{}),...(next.customer||{})},package:{...(previous.package||{}),...(next.package||{})},live:{...oldLive,...newLive,mac:hasValue(newLive.mac)?newLive.mac:(oldLive.mac||''),ip:hasValue(newLive.ip)?newLive.ip:(oldLive.ip||''),poolName:hasValue(newLive.poolName)?newLive.poolName:(oldLive.poolName||'')}};render();renderRouterIdentity();}
function renderRouterIdentity(){const c=state?.customer||{},l=state?.live||{},p=state?.package||{},mac=(hasValue(l.mac)?l.mac:'')||(hasValue(c.routerMac)?c.routerMac:'')||'—',pool=hasValue(l.poolName)?l.poolName:(hasValue(p.poolName)?p.poolName:'');$('networkMapRouterMac').textContent=mac;$('routerMac').textContent=hasValue(c.routerMac)?c.routerMac:'—';$('liveIp').textContent=(hasValue(l.ip)?'IP '+l.ip:'IP —')+' · Router MAC '+mac;$('pool').textContent=pool||'Pool not resolved';}
const api=async(url,o={})=>{const c=new AbortController(),t=setTimeout(()=>c.abort(),8000);try{const r=await fetch(url,{...o,signal:c.signal,headers:{Accept:'application/json',...(o.headers||{})}}),d=await r.json().catch(()=>({}));if(!r.ok||d.success===false)throw Error(d.message||'Request failed');return d}catch(e){if(e.name==='AbortError')throw Error('Request timed out after 8 seconds.');throw e}finally{clearTimeout(t)}};
const toast=(m,type='success')=>{const e=$('toast');e.className='toast text-bg-'+type;e.querySelector('.toast-body').textContent=m;bootstrap.Toast.getOrCreateInstance(e,{delay:3500}).show()};
const esc=v=>String(v??'').replace(/[&<>'"]/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;',"'":'&#39;','"':'&quot;'}[c]));
const bytes=v=>{const n=Number(v||0);if(!n)return'0 B';const u=['B','KB','MB','GB','TB'],i=Math.min(Math.floor(Math.log(n)/Math.log(1024)),4);return(n/Math.pow(1024,i)).toFixed(i?1:0)+' '+u[i]};
const date=v=>v?FazDate.formatDate(v):'—';
const open=x=>bootstrap.Modal.getOrCreateInstance($(x)).show();
function render(){const c=state.customer,l=state.live,p=state.package||{},online=!!l.isLive,billingStatus=String(c.billing_status||'unpaid').toLowerCase(),billingLabel=String(c.billing_label||'Unpaid / Expired'),billingClass=String(c.billing_badge_class||'badge bg-danger'),s=String(c.status||'active').toLowerCase(),suspended=s==='suspended'||s==='inactive';
$('name').textContent=c.name||'Customer';$('phone').textContent=c.phone||'—';$('username').textContent=c.username||'—';$('liveIp').textContent=(online?'IP '+(l.ip||'—'):'Offline · IP '+(l.ip||'—'))+' · Router MAC '+(hasValue(l.mac)?l.mac:(hasValue(c.routerMac)?c.routerMac:'—'));$('status').textContent='Billing: '+(billingStatus==='expired'?'Expired':billingLabel);$('status').className=billingStatus==='expired'?'badge bg-danger':billingClass;$('routerStatus').innerHTML=l.routerStatusUnavailable?'<span class="live-dot me-1"></span>Router: Unavailable':!l.routerStatusVerified?'<span class="live-dot me-1"></span>Checking router':'<span class="live-dot me-1 '+(online?'online':'')+'"></span>Router: '+(online?'Online':'Offline');$('routerStatus').className='badge '+(l.routerStatusUnavailable?'bg-warning text-dark':!l.routerStatusVerified?'bg-secondary':online?'bg-success':'bg-secondary');
$('pkg').textContent=p.name||c.packageName||'—';$('rate').textContent='Bandwidth '+(p.rateLimit||'Not set');const resolvedPool=hasValue(l.poolName)?l.poolName:(hasValue(p.poolName)?p.poolName:'');$('pool').textContent=resolvedPool||'Pool not resolved';$('days').textContent=billingLabel;$('expiry').textContent=date(c.expirationDate);$('cycle').textContent=String(c.billingCycle||'monthly')==='custom_days'?'Custom Days ('+Number(c.billingDurationDays||0)+' days)':'Monthly';$('uptime').textContent=online?(l.uptime||'Connected'):'Offline';$('rx').textContent=online?'Waiting for live rate…':'Offline';$('tx').textContent=online?'Waiting for live rate…':'Offline';$('trafficStatus').textContent=online?'Connected · sampling traffic…':'Offline · no active PPPoE session';$('reason').textContent=l.lastDisconnectReason||c.lastDisconnectReason||'Not available';
[['fullName',c.fullName],['phone2',c.phone],['alt',c.alternativePhone],['nid',c.nid],['address',c.installationAddress],['area',c.areaZone],['connection',date(c.connectionDate)],['user2',c.username],['onu',savedOnuMac()],['routerMac',c.routerMac||''],['box',c.splitterBox],['core',c.fiberCore],['olt',c.oltPonPort],['remote',c.remoteAddress],['contactEmail',c.email],['contactWhatsapp',c.whatsapp_phone||c.phone],].forEach(([k,v])=>$(k).textContent=v||'—');$('onu').textContent=savedOnuMac()||'Awaiting ONU MAC';delete $('onu').dataset.oltVerified;delete $('onu').dataset.oltStale;$('pass').value=c.password||'';$('renewPkg').value=p.name||c.packageName||'';$('amount').value=Number(p.price||0).toFixed(2);$('suspend').innerHTML='<i class="bi '+(suspended?'bi-check-circle':'bi-slash-circle')+' me-1"></i>'+(suspended?'Reactivate Line':'Suspend Line');$('pkgSelect').innerHTML=(state.plans||[]).map(x=>'<option value="'+esc(x.id)+'">'+esc(x.name)+' · ৳'+Number(x.price||0).toFixed(2)+'</option>').join('')||'<option>No packages</option>';
