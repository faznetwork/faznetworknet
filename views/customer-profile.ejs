<!doctype html>
<% const brand=typeof brandSettings!=="undefined"&&brandSettings?brandSettings:{}; const brandName=String(brand.company_name||"FAZ NETWORK"); %>
<html lang="en"><head>
<meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1">
<title><%= brandName %> · Customer 360</title><% if(brand.favicon_url){ %><link rel="icon" href="<%= brand.favicon_url %>"><% } %>
<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
<style>
body{background:#f8fafc;font-family:Segoe UI,Arial,sans-serif;color:#0f172a}.hero{background:linear-gradient(135deg,#0a3d2e,#0d4d3a);color:#fff}.card{box-shadow:0 .125rem .25rem rgba(0,0,0,.075)}.label{font-size:.75rem;text-transform:uppercase;letter-spacing:.05em;color:#64748b}.metric{font-size:1.45rem;font-weight:700}.mono{font-family:ui-monospace,SFMono-Regular,Menlo,monospace}.live-dot{width:9px;height:9px;border-radius:50%;display:inline-block;background:#94a3b8}.live-dot.online{background:#34d399;animation:pulse 1.7s infinite}@keyframes pulse{70%{box-shadow:0 0 0 8px rgba(52,211,153,0)}}.sticky{position:sticky;top:0;z-index:1020;background:rgba(248,250,252,.95);backdrop-filter:blur(8px)}.topology-chain{display:grid;grid-template-columns:repeat(5,minmax(0,1fr));gap:1.8rem}.topology-node{position:relative;min-width:0;min-height:118px;border:1px solid #dbe5e1;border-radius:14px;padding:14px;background:linear-gradient(160deg,#fff,#f6fbf8);overflow-wrap:anywhere}.topology-node:not(:last-child):after{content:"➜";position:absolute;right:-1.45rem;top:42%;font-size:1.2rem;font-weight:800;color:#10b981}.topology-step{font-size:.68rem;font-weight:800;letter-spacing:.08em;text-transform:uppercase;color:#0d6b50}.topology-value{font-weight:700;margin-top:8px;color:#0f172a}.topology-detail{font-size:.78rem;color:#64748b;margin-top:5px}.topology-health{display:inline-flex;align-items:center;border-radius:999px;padding:3px 9px;font-size:.72rem;font-weight:700;background:#e2e8f0;color:#334155}.topology-health.good{background:#d1fae5;color:#065f46}.topology-health.warning{background:#fef3c7;color:#92400e}.topology-health.bad{background:#fee2e2;color:#991b1b}@media(max-width:1199px){.topology-chain{grid-template-columns:repeat(3,minmax(0,1fr))}.topology-node:not(:last-child):after{display:none}}@media(max-width:767px){.sticky .container-fluid{flex-direction:column;align-items:stretch;gap:.65rem}.sticky .container-fluid>a{align-self:flex-start;white-space:normal}.sticky .container-fluid>span{display:block;white-space:normal;line-height:1.35;font-size:.875rem!important}.topology-chain{grid-template-columns:minmax(0,1fr);gap:.75rem}.topology-node{min-height:auto;padding:16px}.topology-node .topology-value{font-size:1rem;line-height:1.4}.topology-node .topology-detail{overflow-wrap:anywhere}.hero .d-flex.gap-2.flex-wrap{gap:.5rem!important}.hero button{max-width:100%;white-space:normal}}

/* Customer 360 mobile: compact action grid, telemetry and readable record cards. */
@media (max-width: 767.98px) {
  body { font-size: 14px; }
  #app { padding-left: 12px !important; padding-right: 12px !important; }
  .hero { padding: 14px !important; border-radius: 14px !important; }
  .hero h2 { max-width: 100%; overflow-wrap: anywhere; font-size: 1.15rem; line-height: 1.35; }
  .hero > .d-flex.flex-column.flex-xl-row > .d-flex.gap-2.flex-wrap:last-child {
    display: grid !important; grid-template-columns: repeat(3,minmax(0,1fr));
    gap: 8px !important; width: 100%;
  }
  .hero > .d-flex.flex-column.flex-xl-row > .d-flex.gap-2.flex-wrap:last-child > button {
    display: flex; flex-direction: column; align-items: center; justify-content: center;
    gap: 4px; min-width: 0; min-height: 62px; margin: 0 !important;
    padding: 8px 4px; border-radius: 10px; font-size: 10px; line-height: 1.25;
    text-align: center; overflow-wrap: anywhere;
  }
  .hero > .d-flex.flex-column.flex-xl-row > .d-flex.gap-2.flex-wrap:last-child > button i {
    margin: 0 !important; font-size: 17px;
  }
  .hero > .d-flex.flex-column.flex-xl-row > .d-flex.gap-2.flex-wrap:last-child > button:nth-child(3) { border-color: rgba(255,255,255,.4); }
  .topology-chain { grid-template-columns: repeat(2,minmax(0,1fr)) !important; gap: 8px !important; }
  .topology-node { min-width: 0; min-height: 0; padding: 10px !important; border-radius: 10px; }
  .topology-step { font-size: 9px; letter-spacing: .035em; line-height: 1.3; }
  .topology-value { margin-top: 5px !important; font-size: 12px !important; line-height: 1.3; overflow-wrap: anywhere; }
  .topology-detail { margin-top: 3px !important; font-size: 10px !important; line-height: 1.35; overflow-wrap: anywhere; }
  #topologyFootnote { margin-top: 8px !important; font-size: 10px; }
  #topologyOnuMissing { padding: 8px 10px !important; font-size: 12px; }
  #topologyOnuMissing .small { font-size: 10px; }
  .metric { font-size: 1.05rem; line-height: 1.25; overflow-wrap: anywhere; }
  .label { font-size: 9px; letter-spacing: .04em; }
  #app > section.row.g-3.mb-3 { display: grid; grid-template-columns: repeat(2,minmax(0,1fr)); gap: 8px; margin-left: 0; margin-right: 0; }
  #app > section.row.g-3.mb-3 > [class*="col-"] { width: auto; padding: 0; min-width: 0; }
  #app > section.row.g-3.mb-3 > [class*="col-"]:last-child { grid-column: 1 / -1; }
  #app > section.row.g-3.mb-3 .card-body { padding: 12px; min-width: 0; }
  #app > section.row.g-3.mb-3 .card-body .btn { max-width: 100%; white-space: normal; font-size: 11px; }
  #app .card-body { min-width: 0; }
  #app .table-responsive { overflow-x: visible; }
  #app .table-responsive table { width: 100%; min-width: 0 !important; margin-bottom: 0; }
  #app .table-responsive table thead { display: none; }
  #app .table-responsive table tbody { display: grid; gap: 8px; }
  #app .table-responsive table tbody tr {
    display: grid; min-width: 0; padding: 5px 10px;
    border: 1px solid #e2e8f0; border-radius: 10px; background: #fff;
  }
  #app .table-responsive table tbody tr td {
    display: grid; grid-template-columns: minmax(88px, 36%) minmax(0,1fr);
    align-items: start; gap: 8px; min-width: 0; padding: 7px 0;
    border: 0; border-bottom: 1px solid #f1f5f9; background: transparent;
    font-size: 11px; line-height: 1.35; white-space: normal;
    overflow-wrap: anywhere; word-break: break-word;
  }
  #app .table-responsive table tbody tr td:last-child { border-bottom: 0; }
  #app .table-responsive table tbody tr td::before {
    content: "Details"; color: #64748b; font-size: 9px; font-weight: 800;
    letter-spacing: .04em; text-transform: uppercase;
  }
  #networkMapRows tr td:nth-child(1)::before { content: "Observation"; }
  #networkMapRows tr td:nth-child(2)::before { content: "Identity"; }
  #networkMapRows tr td:nth-child(3)::before { content: "Match"; }
  #networkMapRows tr td:nth-child(4)::before { content: "Source"; }
  #networkMapRows tr td:nth-child(5)::before { content: "Observed at"; }
  #ledger tr td:nth-child(1)::before { content: "Entry"; }
  #ledger tr td:nth-child(2)::before { content: "Date"; }
  #ledger tr td:nth-child(3)::before { content: "Package"; }
  #ledger tr td:nth-child(4)::before { content: "Amount paid"; }
  #ledger tr td:nth-child(5)::before { content: "Method"; }
  #ledger tr td:nth-child(6)::before { content: "Receipt / Trx ID"; }
  #ledger tr td:nth-child(7)::before { content: "Status"; }
  #auditLedger tr td:nth-child(1)::before { content: "Timestamp"; }
  #auditLedger tr td:nth-child(2)::before { content: "Action"; }
  #auditLedger tr td:nth-child(3)::before { content: "Description"; }
  #auditLedger tr td:nth-child(4)::before { content: "Performed by"; }
  #auditLedger tr td:nth-child(5)::before { content: "IP address"; }
  #usageRows tr td:nth-child(1)::before { content: "Date"; }
  #usageRows tr td:nth-child(2)::before { content: "Download"; }
  #usageRows tr td:nth-child(3)::before { content: "Upload"; }
  #usageRows tr td:nth-child(4)::before { content: "Total"; }
  #app .table-responsive .text-center[colspan] { display: block; padding: 12px !important; }
  #app .table-responsive td[colspan]::before { content: none !important; }
  #app .nav.nav-pills { flex-wrap: nowrap; overflow-x: auto; white-space: nowrap; scrollbar-width: none; }
  #app .nav.nav-pills::-webkit-scrollbar { display: none; }
  #app .nav.nav-pills .nav-link { font-size: 11px; padding: 8px 10px; }
  #app h5 { font-size: 1rem; }
}
@media (max-width: 360px) {
  .topology-chain { grid-template-columns: minmax(0,1fr) !important; }
  .hero > .d-flex.flex-column.flex-xl-row > .d-flex.gap-2.flex-wrap:last-child { grid-template-columns: repeat(2,minmax(0,1fr)); }
  #app > section.row.g-3.mb-3 { grid-template-columns: minmax(0,1fr); }
  #app > section.row.g-3.mb-3 > [class*="col-"]:last-child { grid-column: auto; }
}
</style><script src="/js/date-format.js"></script>
</head>
<body>
<div class="sticky border-bottom py-2 mb-3"><div class="container-fluid px-3 px-lg-4 d-flex flex-column flex-sm-row align-items-sm-center justify-content-sm-between gap-2"><a href="/admin" class="btn btn-sm btn-outline-secondary align-self-start"><i class="bi bi-arrow-left me-1"></i>Back to Customers</a><span class="small text-muted text-sm-end">Customer 360 / Master Management Hub</span></div></div>
<main id="app" class="container-fluid px-3 px-lg-4 pb-5" data-id="<%= customerId %>">
<section class="hero rounded-3 p-3 p-lg-4 mb-3"><div class="d-flex flex-column flex-xl-row justify-content-between gap-3 align-items-xl-center">
<div><div class="d-flex gap-2 align-items-center flex-wrap"><h2 id="name" class="mb-0">Loading…</h2><span id="status" class="badge bg-secondary">Loading billing</span><span id="routerStatus" class="badge bg-secondary"><span class="live-dot me-1"></span>Checking router</span></div><div class="small mt-2 d-flex gap-3 flex-wrap"><span><i class="bi bi-telephone me-1"></i><span id="phone">—</span></span><span class="mono"><i class="bi bi-person-badge me-1"></i><span id="username">—</span></span><span id="liveIp" class="mono">IP — · MAC —</span></div></div>
<div class="d-flex gap-2 flex-wrap"><button id="syncMikrotik" class="btn btn-light text-success fw-semibold"><i class="bi bi-arrow-repeat me-1"></i>Sync to MikroTik</button><button id="usageRecord" class="btn btn-outline-info"><i class="bi bi-bar-chart-line me-1"></i>Usage Record</button><button id="kick" class="btn btn-outline-warning"><i class="bi bi-lightning-charge me-1"></i>Kick / Restart Session</button><button id="renew" class="btn btn-success"><i class="bi bi-credit-card me-1"></i>Add Payment / Renew</button><button id="edit" class="btn btn-outline-primary"><i class="bi bi-pencil-square me-1"></i>Edit Info</button><button id="suspend" class="btn btn-outline-danger"><i class="bi bi-slash-circle me-1"></i>Suspend Line</button></div>
</div></section>
<section class="card border-0 rounded-3 mb-3"><div class="card-body">
<div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-3"><div><h5 class="mb-1"><i class="bi bi-diagram-3 me-2 text-success"></i>Network Topology Bridge</h5><div class="small text-muted">Customer-to-OLT connection path · live values appear only when verified</div></div><span id="topologyOverall" class="topology-health">Awaiting telemetry</span></div>
<div class="topology-chain" aria-label="Network connection topology">
<div class="topology-node"><div class="topology-step">01 · MikroTik IP Pool</div><div id="topoPool" class="topology-value">—</div><div class="topology-detail">Assigned subscriber pool</div></div>
<div class="topology-node"><div class="topology-step">02 · Customer endpoint</div><div id="topoIp" class="topology-value mono">IP —</div><div id="topoRouterMac" class="topology-detail mono">Router MAC —</div></div>
<div class="topology-node"><div class="topology-step">03 · OLT PON Port</div><div id="topoPon" class="topology-value">EPON —</div><div class="topology-detail">OLT uplink / PON mapping</div></div>
<div class="topology-node"><div class="topology-step">04 · ONU identity</div><div id="topoOnu" class="topology-value">ONU —</div><div id="topoOnuMac" class="topology-detail mono">ONU MAC —</div></div>
<div class="topology-node"><div class="topology-step">05 · Optical health</div><div id="topoRx" class="topology-value">RX — dBm</div><div id="topoHealth" class="topology-detail"><span class="topology-health">No verified reading</span></div></div>
</div>
<div id="topologyFootnote" class="small text-muted mt-3">Router MAC and ONU MAC are separate identifiers. Missing values are not inferred.</div><div id="topologyOnuMissing" class="alert alert-warning d-none mt-3 mb-0 py-2"><div class="fw-semibold">No ONU MAC assigned.</div><div class="small">Please edit customer info to map ONU.</div><button id="mapOnuQuick" type="button" class="btn btn-sm btn-outline-dark mt-2"><i class="bi bi-pencil-square me-1"></i>Edit customer info</button></div>
</div></section>
<section class="row g-3 mb-3">
<div class="col-xl-4"><div class="card border-0 rounded-3 h-100"><div class="card-body"><div class="label">Package & Bandwidth</div><div id="pkg" class="metric mt-1">—</div><div id="rate" class="text-muted mt-2">Bandwidth —</div><div class="small mt-2">IP Pool: <strong id="pool">—</strong></div><button id="changePkg" class="btn btn-sm btn-outline-primary mt-3">Change Package</button></div></div></div>
<div class="col-xl-4"><div class="card border-0 rounded-3 h-100"><div class="card-body"><div class="label">Billing Status & Expiry</div><div id="days" class="metric mt-1">—</div><div class="text-muted mt-2">Expiry: <strong id="expiry">—</strong></div><div class="small mt-2">Billing cycle: <strong id="cycle">1 month</strong></div></div></div></div>
<div class="col-xl-4"><div class="card border-0 rounded-3 h-100"><div class="card-body"><div class="label">Real-time Session</div><div id="uptime" class="metric mt-1">Offline</div><div class="small text-muted mt-2">Download rate <strong id="rx" title="Live receive rate">—</strong> · Upload rate <strong id="tx" title="Live transmit rate">—</strong></div><div class="small text-muted mt-1" id="trafficStatus">Checking live traffic…</div><div class="small mt-2">Last disconnect: <span id="reason">—</span></div></div></div></div>
</section>
<section class="card border-0 rounded-3 mb-3"><div class="card-body"><div class="row g-4">
<div class="col-lg-6"><h5>Personal & Compliance</h5><div class="row g-3 mt-1"><div class="col-md-6"><div class="label">Full Name</div><div id="fullName">—</div></div><div class="col-md-6"><div class="label">Phone</div><div id="phone2">—</div></div><div class="col-md-6"><div class="label">Alternative Phone</div><div id="alt">—</div></div><div class="col-md-6"><div class="label">NID Number</div><div id="nid">—</div></div><div class="col-12"><div class="label">Installation Address</div><div id="address">—</div></div><div class="col-md-6"><div class="label">Area / Zone</div><div id="area">—</div></div><div class="col-md-6"><div class="label">Connection Date</div><div id="connection">—</div></div></div><div class="border rounded-3 p-3 mt-4 bg-light-subtle"><div class="d-flex align-items-center gap-2 mb-3"><i class="bi bi-chat-dots fs-5 text-success"></i><div><h6 class="mb-0 fw-bold">Contact &amp; Notification Channels</h6><div class="small text-muted">Saved customer contact details</div></div></div><div class="row g-3"><div class="col-md-6"><div class="label">Email</div><div id="contactEmail" class="text-break">—</div></div><div class="col-md-6"><div class="label">WhatsApp</div><div id="contactWhatsapp" class="text-break">—</div></div><div class="col-md-6"><div class="label">Telegram</div><div id="contactTelegram" class="text-break">—</div></div><div class="col-md-6"><div class="label">Facebook / Messenger</div><div id="contactFacebook" class="text-break">—</div></div></div><div class="small text-muted mt-3"><i class="bi bi-info-circle me-1"></i>Contact information does not send messages by itself. SMS/email or messaging providers must be configured separately.</div></div></div>
<div class="col-lg-6"><h5>Network & Fiber</h5><div class="row g-3 mt-1"><div class="col-md-6"><div class="label">PPPoE Username</div><div id="user2" class="mono">—</div></div><div class="col-md-6"><div class="label">PPPoE Password</div><div class="input-group input-group-sm"><input id="pass" class="form-control mono" type="password" readonly><button id="showPass" class="btn btn-outline-secondary"><i class="bi bi-eye"></i></button></div></div><div class="col-md-6"><div class="label">ONU MAC</div><div id="onu" class="mono">—</div></div><div class="col-md-6"><div class="label">ONU RX Power (dBm)</div><div id="onuRxPowerValue" class="metric mono">Waiting for OLT…</div><div id="onuRxPowerSource" class="small text-muted mt-1">Waiting for local OLT collector…</div><div id="onuTelemetryStatus" class="small mt-1 text-muted">ONU status: —</div><div id="onuTxPowerValue" class="small mono mt-1">TX power: —</div></div><div class="col-md-6"><div class="label">Router MAC (MikroTik session)</div><div id="routerMac" class="mono">—</div><div class="small text-muted">Source: PPPoE caller-id; may be unavailable while offline.</div></div><div class="col-md-6"><div class="label">Splitter / Box</div><div id="box">—</div></div><div class="col-md-6"><div class="label">Fiber Core / Port</div><div id="core">—</div></div><div class="col-md-6"><div class="label">OLT PON Port</div><div id="olt">—</div></div><div class="col-md-6"><div class="label">Remote IP / Pool</div><div id="remote" class="mono">—</div></div></div></div>
</div></div></section>
<section class="card border-0 rounded-3 mb-3"><div class="card-body">
<div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-3"><div><h5 class="mb-1"><i class="bi bi-diagram-3 me-2"></i>Universal Network Mapping</h5><div class="small text-muted">Cached read-only observations · reload does not trigger a new router scan</div></div><button id="refreshNetworkMap" class="btn btn-sm btn-outline-success"><i class="bi bi-arrow-repeat me-1"></i>Reload Observations</button></div>
<div class="row g-3"><div class="col-md-4"><div class="label">Mapping Status</div><div id="networkMapStatus" class="fw-semibold">Checking…</div></div><div class="col-md-4"><div class="label">Last Observation</div><div id="networkMapLastSeen">—</div></div><div class="col-md-4"><div class="label">Observed Router MAC</div><div id="networkMapRouterMac" class="mono">—</div></div></div>
<div class="table-responsive mt-3"><table class="table table-sm align-middle mb-0"><thead><tr><th>Observation</th><th>Identity</th><th>Match</th><th>Source</th><th>Observed At</th></tr></thead><tbody id="networkMapRows"><tr><td colspan="5" class="text-muted text-center py-3">Loading network observations…</td></tr></tbody></table></div>
<div id="networkMapNote" class="small text-muted mt-2">OLT/PON/ONU live discovery is not reported as active unless a supported adapter has actually supplied observations.</div>
</div></section>
<section class="card border-0 rounded-3"><div class="card-body"><div class="d-flex justify-content-between align-items-center mb-3"><div><h5 class="mb-1">Billing & Payment History</h5><div class="small text-muted">Recent subscriber ledger</div></div><button id="firstPayment" class="btn btn-sm btn-success">Record First Payment</button></div><div class="table-responsive"><table class="table align-middle mb-0"><thead><tr><th>#</th><th>Date</th><th>Package Billed</th><th>Amount Paid (৳)</th><th>Method</th><th>Trx ID / Receipt</th><th>Status</th></tr></thead><tbody id="ledger"><tr><td colspan="7" class="text-center text-muted py-4">Loading…</td></tr></tbody></table></div></div></section>
<section class="card border-0 rounded-3 mt-3"><div class="card-body">
<div class="d-flex justify-content-between align-items-center mb-3"><div><h5 class="mb-1"><i class="bi bi-clock-history me-2"></i>Audit & Activity Log</h5><div class="small text-muted">Critical administrative actions for this subscriber</div></div><button id="refreshAudit" class="btn btn-sm btn-outline-secondary"><i class="bi bi-arrow-clockwise"></i></button></div>
<div class="table-responsive"><table class="table align-middle mb-0"><thead><tr><th>Timestamp</th><th>Action</th><th>Description / Details</th><th>Performed By</th><th>IP Address</th></tr></thead><tbody id="auditLedger"><tr><td colspan="5" class="text-center text-muted py-4">Loading activity…</td></tr></tbody></table></div>
</div></section>
</main>
<div class="modal fade" id="usageModal" tabindex="-1" aria-labelledby="usageModalTitle" aria-hidden="true"><div class="modal-dialog modal-xl modal-dialog-scrollable"><div class="modal-content"><div class="modal-header"><div><h5 class="modal-title" id="usageModalTitle"><i class="bi bi-bar-chart-line me-2"></i>Usage Record</h5><div class="small text-muted" id="usagePeriodLabel">Package-cycle usage</div></div><button class="btn-close" data-bs-dismiss="modal" type="button" aria-label="Close"></button></div><div class="modal-body"><div id="usageError" class="alert alert-warning d-none"></div><div class="row g-3 mb-3"><div class="col-md-4"><div class="border rounded-3 p-3 h-100"><div class="small text-muted">Total Download</div><div id="usageDownload" class="fs-4 fw-bold">—</div></div></div><div class="col-md-4"><div class="border rounded-3 p-3 h-100"><div class="small text-muted">Total Upload</div><div id="usageUpload" class="fs-4 fw-bold">—</div></div></div><div class="col-md-4"><div class="border rounded-3 p-3 h-100"><div class="small text-muted">Combined Usage</div><div id="usageTotal" class="fs-4 fw-bold">—</div><div id="usageRecordedDays" class="small text-muted">—</div></div></div></div><div class="d-flex justify-content-between align-items-center gap-2 flex-wrap mb-2"><h6 class="mb-0">Daily Usage Records</h6><button id="usageRefresh" class="btn btn-sm btn-outline-secondary"><i class="bi bi-arrow-clockwise me-1"></i>Refresh</button></div><div class="table-responsive"><table class="table table-sm table-hover align-middle"><thead><tr><th>Date</th><th class="text-end">Download</th><th class="text-end">Upload</th><th class="text-end">Total</th></tr></thead><tbody id="usageRows"><tr><td colspan="4" class="text-center text-muted py-4">Loading usage records…</td></tr></tbody></table></div><div class="small text-muted mt-2">Usage is collected from MikroTik PPPoE interface counters approximately every 5 minutes. Records begin after this feature is deployed; missed/offline sampling periods may not be recoverable.</div></div><div class="modal-footer"><button class="btn btn-secondary" data-bs-dismiss="modal" type="button">Close</button></div></div></div></div>
<div class="modal fade" id="renewModal" tabindex="-1"><div class="modal-dialog"><form id="renewForm" class="modal-content"><div class="modal-header"><h5 class="modal-title">Add Payment / Renew</h5><button class="btn-close" data-bs-dismiss="modal" type="button"></button></div><div class="modal-body"><div class="alert alert-info small">The amount must exactly match the package price.</div><label class="form-label">Package</label><input id="renewPkg" class="form-control mb-3" readonly><label class="form-label">Exact Amount (৳)</label><input id="amount" type="number" step="0.01" class="form-control mb-3" required><label class="form-label">Payment Method</label><select id="method" class="form-select mb-3"><option value="cash">Cash</option><option value="bkash">bKash</option><option value="nagad">Nagad</option><option value="rocket">Rocket</option></select><label class="form-label">Trx ID / Receipt</label><input id="trx" class="form-control" placeholder="Required for mobile banking"></div><div class="modal-footer"><button class="btn btn-light" data-bs-dismiss="modal" type="button">Cancel</button><button class="btn btn-success">Confirm Renewal</button></div></form></div></div>
<div class="modal fade" id="editModal" tabindex="-1"><div class="modal-dialog modal-lg"><form id="editForm" class="modal-content"><div class="modal-header"><h5 class="modal-title">Edit Customer Information</h5><button class="btn-close" data-bs-dismiss="modal" type="button"></button></div><div class="modal-body"><div class="row g-3"><div class="col-md-6"><label class="form-label">Full Name</label><input name="fullName" id="eName" class="form-control" required></div><div class="col-md-6"><label class="form-label">Phone</label><input name="phone" id="ePhone" class="form-control" required></div><div class="col-md-6"><label class="form-label">Alternative Phone</label><input name="alternativePhone" id="eAlt" class="form-control"></div><div class="col-md-6"><label class="form-label">Email Address</label><input name="email" id="eEmail" type="email" maxlength="254" class="form-control" placeholder="customer@example.com"></div><div class="col-md-6"><label class="form-label">WhatsApp Number (optional override)</label><input name="whatsappPhone" id="eWhatsapp" type="tel" maxlength="40" class="form-control" placeholder="Default: primary phone"></div><div class="col-md-6"><label class="form-label">Telegram Username / Link</label><input name="telegramLink" id="eTelegram" maxlength="255" class="form-control" placeholder="@username or https://t.me/username"></div><div class="col-md-6"><label class="form-label">Facebook / Messenger Link</label><input name="facebookLink" id="eFacebook" maxlength="500" class="form-control" placeholder="https://facebook.com/..."></div><div class="col-md-6"><label class="form-label">NID</label><input name="nid" id="eNid" class="form-control"></div><div class="col-md-6"><label class="form-label">Area / Zone</label><input name="areaZone" id="eArea" class="form-control"></div><div class="col-md-6"><label class="form-label">Connection Date</label><input name="connectionDate" id="eConnection" type="date" class="form-control"></div><div class="col-md-6"><label class="form-label">Billing Expiry Date / Next Due Date</label><input name="billing_expiry_date" id="eExpiry" type="date" class="form-control"><div class="form-text">Any past, present, or future date is allowed for migration.</div></div><div class="col-md-6"><label class="form-label">Billing Duration / Cycle</label><select name="billing_cycle" id="eBillingCycle" class="form-select"><option value="monthly">Monthly</option><option value="custom_days">Custom Days</option></select></div><div class="col-md-6" id="eCustomDaysWrap"><label class="form-label">Custom Duration (Days)</label><input name="billing_duration_days" id="eBillingDays" type="number" min="1" max="3650" step="1" class="form-control" placeholder="e.g. 45"></div><div class="col-12"><div class="form-check form-switch border rounded-3 bg-light p-3 ps-5"><input name="autoExpire" id="eAutoExpire" type="checkbox" class="form-check-input"><label class="form-check-label fw-semibold" for="eAutoExpire">Automatically enforce expiry</label><div class="small text-muted">When enabled, overdue accounts move to EXPIRED profile and the session is disconnected. Turn off to preserve connectivity for migration overrides.</div></div></div><div class="col-12"><label class="form-label">Installation Address</label><textarea name="installationAddress" id="eAddress" class="form-control"></textarea></div><div class="col-md-6"><label class="form-label">Splitter / Box</label><input name="distributionBox" id="eBox" class="form-control"></div><div class="col-md-6"><label class="form-label">ONU MAC</label><input name="onuMac" id="eOnu" class="form-control"></div><div class="col-md-6"><label class="form-label">Fiber Core / Port</label><input name="fiberDropCore" id="eCore" class="form-control"></div><div class="col-md-6"><label class="form-label">OLT PON Port</label><input name="oltPonPort" id="eOlt" class="form-control"></div><div class="col-md-6"><label class="form-label">PPPoE Password</label><input name="password" id="ePass" class="form-control"></div></div></div><div class="modal-footer"><button class="btn btn-light" data-bs-dismiss="modal" type="button">Cancel</button><button class="btn btn-primary">Save Customer</button></div></form></div></div>
<div class="modal fade" id="pkgModal" tabindex="-1"><div class="modal-dialog"><form id="pkgForm" class="modal-content"><div class="modal-header"><h5 class="modal-title">Change Package</h5><button class="btn-close" data-bs-dismiss="modal" type="button"></button></div><div class="modal-body"><select id="pkgSelect" class="form-select"></select></div><div class="modal-footer"><button class="btn btn-light" data-bs-dismiss="modal" type="button">Cancel</button><button class="btn btn-primary">Change Package</button></div></form></div></div>
<div class="toast-container position-fixed bottom-0 end-0 p-3"><div id="toast" class="toast"><div class="toast-body"></div></div></div>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
<script>
(()=>{const root=document.getElementById('app'),id=root.dataset.id,$=x=>document.getElementById(x);let state;
const api=async(url,o={})=>{const c=new AbortController(),t=setTimeout(()=>c.abort(),8000);try{const r=await fetch(url,{...o,signal:c.signal,headers:{Accept:'application/json',...(o.headers||{})}}),d=await r.json().catch(()=>({}));if(!r.ok||d.success===false)throw Error(d.message||'Request failed');return d}catch(e){if(e.name==='AbortError')throw Error('Request timed out after 8 seconds.');throw e}finally{clearTimeout(t)}};
const toast=(m,type='success')=>{const e=$('toast');e.className='toast text-bg-'+type;e.querySelector('.toast-body').textContent=m;bootstrap.Toast.getOrCreateInstance(e,{delay:3500}).show()};
const esc=v=>String(v??'').replace(/[&<>'"]/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;',"'":'&#39;','"':'&quot;'}[c]));
const bytes=v=>{const n=Number(v||0);if(!n)return'0 B';const u=['B','KB','MB','GB','TB'],i=Math.min(Math.floor(Math.log(n)/Math.log(1024)),4);return(n/Math.pow(1024,i)).toFixed(i?1:0)+' '+u[i]};
const date=v=>v?FazDate.formatDate(v):'—';
const open=x=>bootstrap.Modal.getOrCreateInstance($(x)).show();
function render(){const c=state.customer,l=state.live,p=state.package||{},online=!!l.isLive,billingStatus=String(c.billing_status||'unpaid').toLowerCase(),billingLabel=String(c.billing_label||'Unpaid / Expired'),billingClass=String(c.billing_badge_class||'badge bg-danger'),s=String(c.status||'active').toLowerCase(),suspended=s==='suspended'||s==='inactive';
$('name').textContent=c.name||'Customer';$('phone').textContent=c.phone||'—';$('username').textContent=c.username||'—';$('liveIp').textContent=online?'IP '+(l.ip||'—')+' · Router MAC '+(l.mac||'—'):'Offline · Last Router MAC '+(l.mac||'—');$('status').textContent='Billing: '+(billingStatus==='expired'?'Expired':billingLabel);$('status').className=billingStatus==='expired'?'badge bg-danger':billingClass;$('routerStatus').innerHTML='<span class="live-dot me-1 '+(online?'online':'')+'"></span>Router: '+(online?'Online':'Offline');$('routerStatus').className='badge '+(online?'bg-success':'bg-secondary');
$('pkg').textContent=p.name||c.packageName||'—';$('rate').textContent='Bandwidth '+(p.rateLimit||'Not set');$('pool').textContent=p.poolName||'—';$('days').textContent=billingLabel;$('expiry').textContent=date(c.expirationDate);$('cycle').textContent=String(c.billingCycle||'monthly')==='custom_days'?'Custom Days ('+Number(c.billingDurationDays||0)+' days)':'Monthly';$('uptime').textContent=online?(l.uptime||'Connected'):'Offline';$('rx').textContent=online?'Waiting for live rate…':'Offline';$('tx').textContent=online?'Waiting for live rate…':'Offline';$('trafficStatus').textContent=online?'Connected · sampling traffic…':'Offline · no active PPPoE session';$('reason').textContent=l.lastDisconnectReason||c.lastDisconnectReason||'Not available';
[['fullName',c.fullName],['phone2',c.phone],['alt',c.alternativePhone],['nid',c.nid],['address',c.installationAddress],['area',c.areaZone],['connection',date(c.connectionDate)],['user2',c.username],['routerMac',l.mac||c.routerMac||''],['box',c.splitterBox],['core',c.fiberCore],['olt',c.oltPonPort],['remote',c.remoteAddress],['contactEmail',c.email],['contactWhatsapp',c.whatsapp_phone||c.phone],['contactTelegram',c.telegram_link],['contactFacebook',c.facebook_link]].forEach(([k,v])=>$(k).textContent=v||'—');if(!$('onu').dataset.oltVerified)$('onu').textContent='Awaiting live OLT MAC';$('pass').value=c.password||'';$('renewPkg').value=p.name||c.packageName||'';$('amount').value=Number(p.price||0).toFixed(2);$('suspend').innerHTML='<i class="bi '+(suspended?'bi-check-circle':'bi-slash-circle')+' me-1"></i>'+(suspended?'Reactivate Line':'Suspend Line');$('pkgSelect').innerHTML=(state.plans||[]).map(x=>'<option value="'+esc(x.id)+'">'+esc(x.name)+' · ৳'+Number(x.price||0).toFixed(2)+'</option>').join('')||'<option>No packages</option>';
const rows=state.payments||[];$('ledger').innerHTML=rows.length?rows.map((x,i)=>'<tr><td>'+(i+1)+'</td><td>'+date(x.date)+'</td><td>'+esc(x.packageName||p.name||'—')+'</td><td>৳'+Number(x.amount||0).toFixed(2)+'</td><td>'+esc(x.method||'—')+'</td><td class="mono">'+esc(x.trxId||'—')+'</td><td><span class="badge '+(String(x.status||'').toUpperCase()==='PAID'?'bg-success':'bg-secondary')+'">'+esc(x.status||'—')+'</span></td></tr>').join(''):'<tr><td colspan="7" class="text-center text-muted py-4">No transactions. Record the first payment above.</td></tr>'}
async function loadNetworkMap(){
 const status=$('networkMapStatus'),last=$('networkMapLastSeen'),mac=$('networkMapRouterMac'),rows=$('networkMapRows');
 let hasFreshCollectorTelemetry=false;
 try{
  const d=await api('/api/network-map/customers/'+encodeURIComponent(id));
  const customer=state?.customer||{}, live=state?.live||{}, pkg=state?.package||{};
  $('topoPool').textContent=pkg.poolName||'Not assigned';
  $('topoIp').textContent='IP '+(live.ip||'—');
  $('topoRouterMac').textContent='Router MAC '+(live.mac||customer.routerMac||'—');
  // Keep the last known ONU/PON/RX values visible while the next poll runs.
  if(!$('topoPon').dataset.loaded) $('topoPon').textContent=customer.oltPonPort||'EPON —';
  if(!$('topoOnu').dataset.loaded) $('topoOnu').textContent='ONU —';
  if(!$('topoOnuMac').dataset.loaded) $('topoOnuMac').textContent='ONU MAC — (awaiting live OLT data)';
  $('topologyOnuMissing').classList.remove('d-none');
  if(!$('topoRx').dataset.loaded) $('topoRx').textContent='RX — dBm';
  $('topoHealth').innerHTML='<span class="topology-health">Awaiting verified reading</span>';
  $('topologyOverall').textContent='Partial mapping';
  $('topologyOverall').className='topology-health';
  $('topologyFootnote').textContent='Customer IP, router MAC, saved PON and ONU identity are shown separately; live OLT values are added only from the authenticated collector.';

  // Real OLT readings are served separately from the local push collector; never substitute router MAC for ONU MAC.
  try {
   const td=await api('/api/olt/telemetry?username='+encodeURIComponent(state.customer?.username||''));
   const t=td.telemetry;
   if(t){
    $('topologyOnuMissing').classList.toggle('d-none',Boolean(!t.stale&&String(t.onuMac||'').trim()));
    hasFreshCollectorTelemetry=!t.stale;
    $('topoPon').textContent=t.ponPort||customer.oltPonPort||'EPON —';
    $('topoOnu').textContent=t.onuId||'ONU —';
    $('topoOnuMac').textContent='ONU MAC '+(!t.stale&&t.onuMac?t.onuMac:(t.stale?'Not verified · telemetry stale':'Not verified by live OLT'));
    $('topoRx').textContent='RX '+(t.rxPowerDbm!==null&&t.rxPowerDbm!==undefined?Number(t.rxPowerDbm).toFixed(2)+' dBm':'— dBm');
    const health=t.stale?'Telemetry Stale':t.signalLevel==='critical'?'High Loss Alert':t.signalLevel==='warning'?'Marginal Warning':t.signalLevel==='high'?'High RX':t.signalLevel==='good'?'Optimal':String(t.status||'Unknown');
    const healthClass=t.stale?'warning':t.signalLevel==='critical'?'bad':t.signalLevel==='warning'||t.signalLevel==='high'?'warning':t.signalLevel==='good'?'good':'';
    $('topoHealth').innerHTML='<span class="topology-health '+healthClass+'">'+esc(health)+'</span>';
    $('topologyOverall').textContent=t.stale?'Telemetry stale':(t.signalLevel==='critical'?'High Loss Alert':t.signalLevel==='warning'?'Marginal Warning':t.signalLevel==='high'?'High RX':t.signalLevel==='good'?'Optical Optimal':String(t.status||'Telemetry received'));
    $('topologyOverall').className='topology-health '+healthClass;
    $('topologyFootnote').textContent='OLT '+(t.oltId||'—')+' · last observed '+(t.observedAt?new Date(t.observedAt).toLocaleString():'—')+'. ONU MAC is shown only from fresh, authenticated OLT telemetry; saved fields and PPPoE caller-id are not treated as live ONU MAC.';

    if(!t.stale&&t.onuMac){$('onu').textContent=t.onuMac;$('onu').dataset.oltVerified='true';}else{$('onu').textContent=t.stale?'Not verified · telemetry stale':'Awaiting live OLT MAC';delete $('onu').dataset.oltVerified;}
    if(t.ponPort)$('topoPon').dataset.loaded='true';
    if(t.onuId)$('topoOnu').dataset.loaded='true';
    if(!t.stale&&t.onuMac)$('topoOnuMac').dataset.loaded='true';
    if(t.rxPowerDbm!==null&&t.rxPowerDbm!==undefined)$('topoRx').dataset.loaded='true';
    $('onuRxPowerValue').textContent=t.rxPowerDbm!==null&&t.rxPowerDbm!==undefined?Number(t.rxPowerDbm).toFixed(2)+' dBm':'—';
    $('onuRxPowerValue').className='metric mono '+(t.stale||t.signalLevel==='critical'?'text-danger':t.signalLevel==='warning'||t.signalLevel==='high'?'text-warning':t.signalLevel==='good'?'text-success':'');
    $('onuRxPowerSource').textContent=(t.stale?'STALE · ':'')+'OLT '+(t.oltId||'—')+' · PON '+(t.ponPort||'—')+' · ONU '+(t.onuId||'—')+' · observed '+(t.observedAt?new Date(t.observedAt).toLocaleString():'—');
    $('onuTelemetryStatus').textContent='ONU status: '+String(t.status||'unknown').toUpperCase()+(t.stale?' · telemetry stale':'');
    $('onuTelemetryStatus').className='small mt-1 '+(t.stale?'text-warning':t.status==='online'?'text-success':'text-danger');
    $('onuTxPowerValue').textContent='TX power: '+(t.txPowerDbm===null||t.txPowerDbm===undefined?'—':Number(t.txPowerDbm).toFixed(2)+' dBm');
   } else {
    $('onuTelemetryStatus').textContent='ONU status: awaiting verified OLT telemetry';
   }
  } catch(telemetryError) { $('onuTelemetryStatus').textContent='OLT telemetry unavailable · retrying'; }
  status.textContent=d.discoveryStatus==='observations_available'?'Observations available':'Awaiting first discovery';
  status.className='fw-semibold '+(d.discoveryStatus==='observations_available'?'text-success':'text-muted');
  last.textContent=d.lastObservedAt?new Date(d.lastObservedAt).toLocaleString():'No observations yet';
  mac.textContent=d.routerMac||'—';
  // Legacy customer-column readings must not overwrite fresher collector telemetry.
  if(!hasFreshCollectorTelemetry){
   const rx=d.rxPower||{};
   const validRx=rx.dbm!==null&&rx.dbm!==undefined&&Number.isFinite(Number(rx.dbm));
   $('onuRxPowerValue').textContent=validRx?Number(rx.dbm).toFixed(2)+' dBm':'—';
   $('onuRxPowerSource').textContent=rx.observedAt?'Saved customer OLT reading · '+(rx.sourceDevice||'OLT')+' · '+new Date(rx.observedAt).toLocaleString():'Awaiting verified OLT reading';
  }
  const list=Array.isArray(d.observations)?d.observations:[];
  rows.innerHTML=list.length?list.map(o=>'<tr><td>'+esc(o.observationType||'—')+'</td><td class="mono">'+esc(o.identityValue||'—')+'</td><td>'+esc(o.matchStatus||'—')+'</td><td>'+esc(o.sourceDevice||'—')+'</td><td>'+esc(o.observedAt?new Date(o.observedAt).toLocaleString():'—')+'</td></tr>').join(''):'<tr><td colspan="5" class="text-muted text-center py-3">No network observations recorded yet. Run read-only discovery from Device Management.</td></tr>';
 }catch(e){
  status.textContent='Unavailable';status.className='fw-semibold text-warning';
  last.textContent='—';mac.textContent='—';
  rows.innerHTML='<tr><td colspan="5" class="text-muted text-center py-3">'+esc(e.message||'Network mapping unavailable')+'</td></tr>';
 }
}
async function load(){try{state=await api('/api/customers/'+encodeURIComponent(id)+'/profile');render();await loadAuditLogs()}catch(e){toast(e.message,'danger')}}
let livePollBusy=false;
$('refreshNetworkMap')?.addEventListener('click',loadNetworkMap);

async function loadLiveSession(){
 if(livePollBusy)return;livePollBusy=true;
 try{
  const d=await api('/api/customers/'+encodeURIComponent(id)+'/live-session');
  const l=d.live||{},online=Boolean(l.online);
  $('uptime').textContent=online?(l.uptime||'Connected'):'Offline';
  $('rx').textContent=online?(l.download||'0 bps'):'Offline';
  $('tx').textContent=online?(l.upload||'0 bps'):'Offline';
  $('trafficStatus').textContent=online?'Live · '+(l.ip||'IP unavailable')+(l.interface?' · '+l.interface:''):'Offline · no active PPPoE session';
  $('liveIp').textContent=online?'IP '+(l.ip||'—')+' · MAC '+(l.mac||'—'):'Offline · Last MAC '+(l.mac||'—');
  $('routerStatus').innerHTML='<span class="live-dot me-1 '+(online?'online':'')+'"></span>Router: '+(online?'Online':'Offline');
  $('routerStatus').className='badge '+(online?'bg-success':'bg-secondary');
 }catch(error){
  // Keep the last good sample on brief router/API failures; the next poll retries.
  $('trafficStatus').textContent='Live traffic temporarily unavailable · retrying';
  console.warn('[Customer live traffic]',error.message);
 }finally{livePollBusy=false;}
}
async function loadAuditLogs(){try{const d=await api('/api/customers/'+encodeURIComponent(id)+'/audit-logs');const logs=Array.isArray(d.logs)?d.logs:[];$('auditLedger').innerHTML=logs.length?logs.map(x=>{const action=String(x.action||'UPDATE').toUpperCase();const cls=action==='RENEW'?'bg-success':action==='KICK'?'bg-warning text-dark':action==='SUSPEND'?'bg-danger':action==='REACTIVATE'?'bg-info text-dark':'bg-primary';let detail=x.details||'';try{const j=JSON.parse(detail);detail=j.message||detail}catch(_){}return '<tr><td class="text-nowrap">'+FazDate.formatDateTime(x.created_at)+'</td><td><span class="badge '+cls+'">'+esc(action)+'</span></td><td>'+esc(detail)+'</td><td><span class="badge bg-light text-dark border">'+esc(x.admin_id||'admin')+'</span></td><td class="mono small">'+esc(x.ip_address||'—')+'</td></tr>'}).join(''):'<tr><td colspan="5" class="text-center text-muted py-4">No activity logs recorded yet.</td></tr>'}catch(e){$('auditLedger').innerHTML='<tr><td colspan="5" class="text-center text-danger py-4">'+esc(e.message)+'</td></tr>'}}
async function act(url,body,msg){try{await api(url,{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify(body||{})});toast(msg);await load()}catch(e){toast(e.message,'danger')}}
$('syncMikrotik').onclick=()=>{if(confirm('Sync this customer’s saved panel details to MikroTik? This will create or update the PPPoE secret without deleting the panel customer record.'))act('/api/customers/'+encodeURIComponent(id)+'/sync-mikrotik',{},'Customer synced to MikroTik.')};
$('kick').onclick=()=>{if(confirm('Disconnect this active PPPoE session?'))act('/api/customers/'+id+'/kick',{},'Session disconnected.')};
$('renew').onclick=$('firstPayment').onclick=()=>open('renewModal');
$('renewForm').onsubmit=async e=>{e.preventDefault();const method=$('method').value,trx=$('trx').value.trim(),amount=Number($('amount').value);if(method!=='cash'&&!trx)return toast('Trx ID is required for mobile banking.','danger');if(!confirm('Confirm exact payment of ৳'+amount.toFixed(2)+' and renew +1 month?'))return;try{await api('/api/customers/'+id+'/renew',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({amount,method,trxId:trx})});bootstrap.Modal.getInstance($('renewModal'))?.hide();toast('Payment recorded and customer renewed.');await load()}catch(e){toast(e.message,'danger')}};
$('suspend').onclick=()=>{const off=['suspended','inactive'].includes(String(state.customer.status).toLowerCase())||state.customer.disabled;if(confirm(off?'Reactivate this line?':'Suspend this line and move it to EXPIRED profile?'))act('/api/customers/'+id+'/toggle-status',{suspend:!off},off?'Customer reactivated.':'Customer suspended.')};
$('changePkg').onclick=()=>open('pkgModal');$('pkgForm').onsubmit=async e=>{e.preventDefault();const packageId=$('pkgSelect').value;if(!confirm('Change this customer to the selected package?'))return;try{await api('/api/customers/'+id+'/change-package',{method:'PUT',headers:{'Content-Type':'application/json'},body:JSON.stringify({packageId})});bootstrap.Modal.getInstance($('pkgModal'))?.hide();toast('Package changed successfully.');await load()}catch(e){toast(e.message,'danger')}};
$('mapOnuQuick').onclick=()=>{$('edit').click();};
$('edit').onclick=()=>{const c=state.customer;[['eName',c.fullName],['ePhone',c.phone],['eAlt',c.alternativePhone],['eEmail',c.email],['eWhatsapp',c.whatsapp_phone],['eTelegram',c.telegram_link],['eFacebook',c.facebook_link],['eNid',c.nid],['eArea',c.areaZone],['eConnection',String(c.connectionDate||'').slice(0,10)],['eExpiry',String(c.expirationDate||'').slice(0,10)],['eBillingCycle',c.billingCycle||'monthly'],['eBillingDays',c.billingDurationDays??''],['eAddress',c.installationAddress],['eBox',c.splitterBox],['eOnu',c.onuMac],['eCore',c.fiberCore],['eOlt',c.oltPonPort],['ePass',c.password]].forEach(([k,v])=>$(k).value=v??'');$('eAutoExpire').checked=!c.billingExpiryOverride;$('eCustomDaysWrap').classList.toggle('d-none',$('eBillingCycle').value!=='custom_days');open('editModal')};
$('eBillingCycle').onchange=()=>{$('eCustomDaysWrap').classList.toggle('d-none',$('eBillingCycle').value!=='custom_days');$('eAutoExpire').checked=false};
$('eExpiry').onchange=()=>{$('eAutoExpire').checked=false};
$('editForm').onsubmit=async e=>{e.preventDefault();try{const payload=Object.fromEntries(new FormData(e.target).entries());payload.billing_expiry_override=!$('eAutoExpire').checked;delete payload.autoExpire;await api('/api/customers/'+id,{method:'PUT',headers:{'Content-Type':'application/json'},body:JSON.stringify(payload)});bootstrap.Modal.getInstance($('editModal'))?.hide();toast('Customer information saved.');await load()}catch(e){toast(e.message,'danger')}};
async function loadUsageRecords(){
 const error=$('usageError'),rows=$('usageRows');
 error.classList.add('d-none');rows.innerHTML='<tr><td colspan="4" class="text-center text-muted py-4">Loading usage records…</td></tr>';
 try{
  const d=await api('/api/customers/'+encodeURIComponent(id)+'/usage-records');
  const cycle=d.cycle||{},summary=d.summary||{},daily=Array.isArray(d.daily)?d.daily:[];
  $('usagePeriodLabel').textContent='Package cycle: '+date(cycle.startDate)+' – '+date(cycle.endDate)+' · collected through '+date(cycle.throughDate);
  $('usageDownload').textContent=bytes(summary.downloadBytes);
  $('usageUpload').textContent=bytes(summary.uploadBytes);
  $('usageTotal').textContent=bytes(summary.totalBytes);
  $('usageRecordedDays').textContent=Number(summary.recordedDays||0)+' days with records in this cycle';
  rows.innerHTML=daily.length?daily.map(r=>'<tr><td>'+esc(date(r.date))+'</td><td class="text-end">'+esc(bytes(r.downloadBytes))+'</td><td class="text-end">'+esc(bytes(r.uploadBytes))+'</td><td class="text-end fw-semibold">'+esc(bytes(r.totalBytes))+'</td></tr>').join(''):'<tr><td colspan="4" class="text-center text-muted py-4">No usage records yet. Daily collection will start after the service is online and the first counter samples are available.</td></tr>';
 }catch(e){
  error.textContent=e.message||'Unable to load usage records.';error.classList.remove('d-none');
  rows.innerHTML='<tr><td colspan="4" class="text-center text-muted py-4">Usage records are temporarily unavailable.</td></tr>';
 }
}
$('usageRecord').onclick=()=>{open('usageModal');loadUsageRecords()};
$('usageRefresh').onclick=loadUsageRecords;
$('refreshAudit').onclick=loadAuditLogs;$('showPass').onclick=()=>{$('pass').type=$('pass').type==='password'?'text':'password'};// Avoid overlapping background refreshes: profile + audit every 60s, live RouterOS status every 3s, topology every 60s.
load();loadLiveSession();loadNetworkMap();setInterval(load,60000);setInterval(loadLiveSession,3000);setInterval(loadNetworkMap,60000)})();
</script></body></html>