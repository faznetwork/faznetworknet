<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <meta name="robots" content="noindex,nofollow">
  <title><%= title %></title>
  <style>
    *{box-sizing:border-box}body{margin:0;min-height:100vh;display:grid;place-items:center;padding:24px;background:#f1f5f9;font-family:Inter,Arial,sans-serif;color:#0f172a}
    main{width:min(100%,520px);padding:32px;background:#fff;border:1px solid #e2e8f0;border-radius:18px;box-shadow:0 18px 50px #0f172a12}
    h1{margin:0;color:#0a3d2e;font-size:25px}p{color:#64748b;line-height:1.6}
    button{margin-top:18px;padding:12px 18px;border:0;border-radius:9px;background:#0a3d2e;color:#fff;font-weight:700;cursor:pointer}
    #message{margin-top:14px;color:#9f1239}
  </style>
</head>
<body>
  <main>
    <h1>FAZ NETWORK Reseller Portal</h1>
    <p>Welcome, <strong><%= resellerName %></strong>. Your reseller session is active.</p>
    <p>The reseller workspace will show your assigned POP and customer tools here.</p>
    <button id="logoutButton" type="button">Sign out</button>
    <div id="message" role="status" aria-live="polite"></div>
  </main>
  <script>
    document.getElementById('logoutButton').addEventListener('click',async()=>{
      const button=document.getElementById('logoutButton');
      const message=document.getElementById('message');
      button.disabled=true;
      try{
        const response=await fetch('/api/resellers/logout',{method:'POST'});
        const result=await response.json();
        if(!response.ok||!result.success)throw new Error(result.message||'Sign out failed.');
        window.location.assign('/reseller/login');
      }catch(error){message.textContent=error.message;button.disabled=false;}
    });
  </script>
</body>
</html>
