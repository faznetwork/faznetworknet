<header class="reseller-topbar">
  <div class="d-flex align-items-center gap-3 min-w-0">
    <button id="resellerSidebarToggle" class="btn btn-outline-success d-lg-none" type="button" aria-label="Open navigation" aria-controls="resellerSidebar" aria-expanded="false"><i class="bi bi-list"></i></button>
    <div class="min-w-0"><div class="reseller-topbar-eyebrow"><%= brandName %></div><h1 class="reseller-page-title"><%= title %></h1></div>
  </div>
  <div class="d-flex align-items-center gap-3">
    <span class="reseller-user-chip"><i class="bi bi-person-circle"></i><span><%= safeResellerName %></span></span>
    <button id="logoutButton" class="btn btn-sm btn-outline-success" type="button"><i class="bi bi-box-arrow-right me-1"></i><span class="d-none d-sm-inline">Sign out</span></button>
  </div>
</header>
