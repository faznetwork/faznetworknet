}
function triggerNativeCameraCapture(){$("qr-file-input").click();}
async function handleQrImageFile(file){
  showResult("info","QR কোড ছবি থেকে পড়া হচ্ছে…");
  try{
    if(!("BarcodeDetector" in window))throw new Error("unsupported");
    var bitmap=await createImageBitmap(file);
    var detector=new BarcodeDetector({formats:["qr_code"]});
    var codes=await detector.detect(bitmap);
    if(codes.length&&codes[0].rawValue){applyScannedCredentials(codes[0].rawValue);return;}
    showResult("err","QR কোডটি স্পষ্ট নয়। কোডটি PIN ঘরে সরাসরি লিখুন।");
  }catch(error){showResult("err","ক্যামেরা ছবি থেকে QR পড়া যায়নি। অনুগ্রহ করে পিনটি টাইপ করুন।");}
}
async function openQrScanner(){
  if(!window.isSecureContext||!navigator.mediaDevices||!navigator.mediaDevices.getUserMedia){triggerNativeCameraCapture();return;}
  var button=$("qr-scan-button");
  button.disabled=true;
  $("qr-scanner-modal").classList.remove("hidden");
  $("qr-scanner-status").textContent="ক্যামেরা চালু হচ্ছে…";
  try{
    scannerStream=await navigator.mediaDevices.getUserMedia({video:{facingMode:{ideal:"environment"}},audio:false});
    var video=$("qr-scanner-video");
    video.srcObject=scannerStream;
    await video.play();
    if("BarcodeDetector" in window){
      var detector=new BarcodeDetector({formats:["qr_code"]});
      $("qr-scanner-status").textContent="ভাউচার QR কোড ক্যামেরার সামনে ধরুন।";
      scannerTimer=setInterval(async function(){
        if(scannerBusy||!scannerStream||video.readyState<video.HAVE_ENOUGH_DATA)return;
        scannerBusy=true;
        try{
          var codes=await detector.detect(video);
          if(codes.length&&codes[0].rawValue){var raw=codes[0].rawValue;stopQrScanner();applyScannedCredentials(raw);}
        }catch(e){}
        finally{scannerBusy=false;}
      },250);
    }else{
      $("qr-scanner-status").textContent="এই ব্রাউজারে লাইভ স্ক্যান হচ্ছে না — নিচের বাটনে চাপ দিয়ে QR কোডের ছবি তুলুন।";
    }
  }catch(error){stopQrScanner();triggerNativeCameraCapture();}
}
$("qr-scan-button").addEventListener("click",function(){openQrScanner();});
$("qr-close-button").addEventListener("click",function(){stopQrScanner();});
$("qr-photo-button").addEventListener("click",function(){triggerNativeCameraCapture();});
$("qr-file-input").addEventListener("change",function(e){if(e.target.files&&e.target.files[0])handleQrImageFile(e.target.files[0]);e.target.value="";});
resolveDeviceMac();
fetch("/api/public/portal-config",{headers:{Accept:"application/json"},cache:"no-store"}).then(async function(response){var config=await response.json();if(!response.ok||!config.success)throw new Error(config.error||"Portal configuration unavailable");renderPortalConfig(config);}).catch(function(error){$("portal-packages").innerHTML='<p style="border-radius:12px;background:#fef2f2;padding:12px;text-align:center;font-size:13px;color:#b91c1c">'+escHtml(error.message||"Hotspot packages could not be loaded.")+'</p>';$("pay-row").innerHTML='<p style="text-align:center;font-size:13px;color:#64748b;width:100%">Payment settings unavailable.</p>';}).finally(function(){runDeviceLookup();});
</script></body></html>
