function escHtml(value){return String(value??"").replace(/[&<>"']/g,function(ch){return {"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;","'":"&#39;"}[ch];});}
function toBn(value){return String(value).replace(/[0-9]/g,function(d){return "০১২৩৪৫৬৭৮৯"[Number(d)];});}
function mfsColor(name){var n=String(name||"").toLowerCase();if(n.indexOf("bkash")!==-1)return"#e2136e";if(n.indexOf("nagad")!==-1)return"#f6921e";if(n.indexOf("rocket")!==-1)return"#8c3494";return"#1d4ed8";}
function mfsDisplayName(item){return String(item.name||"MFS").replace(/\s*\([^)]*\)\s*$/,"");}
function normalizePhoneInput(value){var bangla="০১২৩৪৫৬৭৮৯";var digits=String(value||"").replace(/[০-৯]/g,function(ch){return String(bangla.indexOf(ch));}).replace(/\D/g,"");if(digits.indexOf("880")===0&&digits.length===13)digits="0"+digits.slice(3);return digits;}
function normalizePortalMac(value){var compact=String(value||"").trim().replace(/[:-]/g,"");return /^[0-9a-fA-F]{12}$/.test(compact)?compact.match(/.{2}/g).join(":").toUpperCase():"";}
function validPhone(value){return /^01[0-9]{9}$/.test(normalizePhoneInput(value||""));}
