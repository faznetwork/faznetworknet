function friendlyError(code,fallback){return FRIENDLY_ERRORS[code]||fallback||"কিছু একটা ভুল হয়েছে। আবার চেষ্টা করুন।";}
function resolveDeviceMac(){
  var params=new URLSearchParams(window.location.search);
  var fromQuery=normalizePortalMac(params.get("mac")||"");
  var hidden=$("portal-router-mac");
  var fromHidden=normalizePortalMac(hidden?hidden.value:"");
  deviceMac=fromQuery||fromHidden||"";
  if(hidden&&deviceMac)hidden.value=deviceMac;
  return deviceMac;
}
function postMikrotikLogin(mac){$("portal-mt-user").value=mac;$("portal-mt-pass").value=mac;$("portal-mikrotik-login").submit();}
function switchTab(name){
  if(name==="buy"){var pkgs=$("pkgs");if(pkgs)pkgs.scrollIntoView({behavior:"smooth"});return;}
  document.querySelectorAll(".tab-btn").forEach(function(btn){btn.classList.toggle("on",btn.dataset.tab===name&&!btn.dataset.scan);});
  var ex=$("existing-login-form"),vo=$("voucher-login-form");
  if(name==="existing"){if(ex)ex.classList.remove("hidden");if(vo)vo.classList.add("hidden");}
  else if(name==="voucher"){if(vo)vo.classList.remove("hidden");if(ex)ex.classList.add("hidden");}
}
document.querySelectorAll(".tab-btn").forEach(function(btn){btn.addEventListener("click",function(){
  var tab=btn.dataset.tab;
  if(tab==="buy"){switchTab("buy");return;}
  if(btn.dataset.scan==="1"){switchTab("voucher");openQrScanner();return;}
  switchTab(tab);
});});
var promoSlides=document.querySelectorAll(".promo .slide"),promoDots=document.querySelectorAll(".dots i"),promoCur=0;
function showSlide(i){promoCur=i;promoSlides.forEach(function(s,k){s.classList.toggle("on",k===i);});promoDots.forEach(function(d,k){d.classList.toggle("on",k===i);});}
setInterval(function(){if(promoSlides.length)showSlide((promoCur+1)%promoSlides.length);},3000);
function setPill(kind,text){var pill=$("status-pill");pill.className="status-pill"+(kind?" "+kind:"");pill.textContent=text;}
async function runDeviceLookup(){
  if(!deviceMac){setPill("","সংযুক্ত নয় — FAZ NETWORK Wi-Fi-তে যুক্ত হয়ে এই পেজটি খুলুন");return;}
  try{
    var response=await fetch("/api/hotspot-auth/device-lookup",{method:"POST",headers:{"Content-Type":"application/json",Accept:"application/json"},body:JSON.stringify({mac:deviceMac})});
    var data=await response.json();
    if(!response.ok||!data.success){setPill("","স্ট্যাটাস জানা যাচ্ছে না — নিচে লগইন করতে পারবেন");return;}
    if(!data.found){setPill("","সংযুক্ত নয় — FAZ NETWORK Wi-Fi-তে যুক্ত হয়ে এই পেজটি খুলুন");return;}
    if(data.requires_claim_secret){setPill("warn","প্যাকেজ কেনা আছে — claim করা বাকি");switchTab("existing");showClaimCodeBox("");return;}
    if(data.status==="expired"||data.can_recharge){setPill("warn","প্যাকেজের মেয়াদ শেষ — নতুন প্যাকেজ কিনুন");var buyBtn=document.querySelector('[data-tab="buy"]');if(buyBtn&&!buyBtn.classList.contains("hidden"))switchTab("buy");return;}
    setPill("ok","সংযুক্ত — প্যাকেজ সক্রিয় আছে");switchTab("existing");
  }catch(error){setPill("","স্ট্যাটাস জানা যাচ্ছে না — নিচে লগইন করতে পারবেন");}
}
