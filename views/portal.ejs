<!doctype html>
<% const brand=typeof brandSettings!=="undefined"&&brandSettings?brandSettings:{}; const brandName=String(brand.company_name||"FAZ NETWORK"); const supportPhone=String(brand.support_phone||"01339932887"); %>
<html lang="bn"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title><%= brandName %> Hotspot</title><% if(brand.favicon_url){ %><link rel="icon" href="<%= brand.favicon_url %>"><% } %><style>
*{box-sizing:border-box;margin:0;padding:0}
html{-webkit-text-size-adjust:100%}
body{font-family:system-ui,-apple-system,"Segoe UI",Roboto,sans-serif;background:#fff;color:#111827;font-size:15px;line-height:1.5}
.hidden{display:none!important}
.wrap{max-width:480px;margin:0 auto;overflow:hidden}
.banner{line-height:0}
.banner img{display:block;width:100%;height:auto}
.notice-bar{padding:11px 14px;background:#fffbeb;border-bottom:1px solid #fde68a;color:#92400e;font-size:13px;text-align:center}
/* 1. customer-care banner */
.care{display:flex;min-height:86px}
.care .left{flex:1;background:#fff8e6;padding:12px;display:flex;align-items:center;gap:10px;min-width:0}
.care .logo{width:44px;height:44px;border-radius:10px;background:#1d4ed8;color:#fff;display:flex;align-items:center;justify-content:center;font-weight:900;font-size:15px;flex:none;overflow:hidden}
.care .logo img{width:100%;height:100%;object-fit:contain;background:#fff;display:block}
.care .logo:has(img) #brand-logo-fn{display:none}
.care .left b{font-size:15px;color:#1d4ed8}
.care .left p{font-size:11px;color:#444;margin-top:2px;line-height:1.4}
.care .right{background:#1d4ed8;color:#fff;padding:12px 14px;display:flex;flex-direction:column;justify-content:center;flex:none;min-width:132px;text-decoration:none}
.care .right small{font-size:11px;opacity:.9}
.care .right b{font-size:16px;letter-spacing:.02em}
/* 2. ticker */
.ticker{background:#dc2626;color:#fff;overflow:hidden;white-space:nowrap;padding:6px 0;font-size:13px;font-weight:700}
.ticker span{display:inline-block;padding-left:100%;animation:tick 14s linear infinite}
@keyframes tick{from{transform:translateX(0)}to{transform:translateX(-100%)}}
/* 3. hero */
.hero{background:linear-gradient(135deg,#dbeafe 0%,#bfdbfe 55%,#93c5fd 100%);padding:18px 16px 20px;position:relative;overflow:hidden}
.hero .sw{position:absolute;right:-70px;top:-40px;width:260px;height:260px;border-radius:50%;background:rgba(255,255,255,.45);pointer-events:none}
.hero .sw2{position:absolute;right:30px;bottom:-90px;width:220px;height:220px;border-radius:50%;background:rgba(29,78,216,.12);pointer-events:none}
.status-pill{display:inline-flex;align-items:center;gap:8px;max-width:100%;padding:8px 14px;border-radius:999px;font-size:13px;font-weight:700;background:rgba(255,255,255,.9);border:1px solid #fff;color:#1e3a8a;position:relative}
.status-pill::before{content:"";flex:none;width:8px;height:8px;border-radius:50%;background:#3b82f6;box-shadow:0 0 0 3px rgba(59,130,246,.2)}
.status-pill.ok{background:#dcfce7;border-color:#86efac;color:#065f46}
.status-pill.ok::before{background:#16a34a;box-shadow:0 0 0 3px rgba(22,163,74,.2)}
.status-pill.warn{background:#fef3c7;border-color:#fde68a;color:#92400e}
.status-pill.warn::before{background:#d97706;box-shadow:0 0 0 3px rgba(217,119,6,.2)}
.status-pill.bad{background:#fee2e2;border-color:#fecaca;color:#b91c1c}
.status-pill.bad::before{background:#dc2626;box-shadow:0 0 0 3px rgba(220,38,38,.2)}
.hero h2{font-size:24px;line-height:1.25;color:#1e3a8a;font-weight:900;position:relative;margin-top:14px}
.hero h2 svg{vertical-align:-2px}
.hero .price{display:inline-block;background:#f97316;color:#fff;font-weight:900;font-size:15px;border-radius:999px;padding:7px 16px;margin-top:12px;position:relative;box-shadow:0 6px 14px rgba(249,115,22,.4)}
.hero .pay{display:flex;gap:8px;margin-top:12px;align-items:center;position:relative;flex-wrap:wrap}
.hero .pay small{font-weight:800;color:#1e3a8a;font-size:12px}
.hero .pay i{font-style:normal;font-weight:900;font-size:12px;border-radius:999px;padding:5px 10px;color:#fff}
.hero .speed{position:relative;margin-top:14px;background:rgba(255,255,255,.75);border-radius:14px;padding:12px 14px;display:flex;align-items:center;gap:12px}
.hero .speed svg{flex:none}
.hero .speed b{font-size:15px;color:#1e3a8a}
.hero .speed p{font-size:12px;color:#444;margin-top:2px}
/* 4. login ribbon */
.ribbon{background:#1d4ed8;color:#fff;padding:12px 16px;font-size:17px;font-weight:900;display:flex;justify-content:space-between;align-items:center;gap:10px}
.ribbon .tab{background:#f97316;font-size:11px;font-weight:800;border-radius:999px;padding:6px 10px;white-space:nowrap}
/* 5. login pills */
.login{padding:16px 16px 6px}
.pill{display:flex;border-radius:999px;overflow:hidden;background:#eef1f5;margin-bottom:12px}
.pill input{flex:1;border:0;background:transparent;padding:16px 18px;font-size:16px;font-family:inherit;outline:none;min-width:0}
.pill input::placeholder{color:#8a94a6}
.pill .go{border:0;background:#16a34a;color:#fff;font-weight:900;font-size:17px;padding:0 26px;cursor:pointer;font-family:inherit;flex:none}
.pill .go:disabled{opacity:.6;cursor:wait}
.pill.single input{text-align:left}
.qr-btn{display:flex;align-items:center;justify-content:center;gap:6px;width:100%;border:1.5px solid #a7f3d0;background:#f0fdf4;color:#065f46;border-radius:999px;padding:0 16px;min-height:48px;font-size:14px;font-weight:800;cursor:pointer;font-family:inherit;margin-bottom:12px}
.claim-box{border:1px solid #fde68a;background:#fffbeb;border-radius:18px;padding:16px;margin-top:4px;margin-bottom:12px}
.claim-box h2{margin:0;font-size:16px;font-weight:800}
.claim-box .helper{margin:6px 0 0;font-size:13px;color:#64748b}
.claim-box .field{margin-top:14px}
.claim-box .field label{display:block;font-size:13px;font-weight:700;margin-bottom:2px}
.claim-box .field label .opt{color:#64748b;font-weight:400}
.claim-box .field input{width:100%;font-size:16px;padding:11px 2px;min-height:48px;border:0;border-bottom:2px solid #cbd5e1;border-radius:0;background:transparent;font-family:inherit}
.claim-box .field input:focus{outline:none;border-bottom-color:#1d4ed8}
.claim-box .btn{display:block;width:100%;min-height:52px;border:0;border-radius:999px;font-size:16px;font-weight:800;font-family:inherit;cursor:pointer;padding:12px 18px;text-align:center;background:#16a34a;color:#fff;margin-top:16px}
.claim-box .btn:disabled{opacity:.6;cursor:wait}
#result{margin-top:4px;margin-bottom:8px;border-radius:14px;padding:12px 14px;font-size:14px}
#result:empty{display:none}
.msg-ok{background:#ecfdf5;color:#065f46;border:1px solid #a7f3d0}
.msg-err{background:#fef2f2;color:#b91c1c;border:1px solid #fecaca}
.msg-info{background:#f1f5f9;color:#334155;border:1px solid #e2e8f0}
.msg-warn{background:#fffbeb;color:#92400e;border:1px solid #fde68a}
/* 6. alternative services */
.alt{padding:10px 16px 4px}
.alt h3{font-size:19px;font-weight:900}
.icons{display:flex;gap:14px;margin:14px 0 6px;overflow-x:auto;padding-bottom:6px}
.icobtn{flex:none;width:74px;text-align:center;cursor:pointer;background:none;border:0;font-family:inherit;text-decoration:none}
.icobtn .c{width:64px;height:64px;border-radius:50%;margin:0 auto;display:flex;align-items:center;justify-content:center;color:#fff;box-shadow:0 8px 16px rgba(29,78,216,.3)}
.icobtn .c.b{background:linear-gradient(135deg,#3b82f6,#1d4ed8)}
.icobtn .c.g{background:linear-gradient(135deg,#22c55e,#15803d)}
.icobtn .c.o{background:linear-gradient(135deg,#fb923c,#ea580c)}
.icobtn small{display:block;margin-top:6px;font-size:12px;font-weight:800;color:#111827}
.icobtn.on .c{outline:3px solid #f97316;outline-offset:2px}
/* 7. promo carousel */
.promo{margin:12px 16px 0;border-radius:16px;overflow:hidden;box-shadow:0 10px 24px rgba(20,40,80,.18)}
.promo .slide{display:none;padding:20px 18px;min-height:170px;color:#fff;position:relative;background-size:cover;background-position:center}
.promo .slide.on{display:block}
.promo .s1{background-image:linear-gradient(rgba(10,30,90,.62),rgba(10,30,90,.78)),url('/img/portal/photo-gaming-s.jpg')}
.promo .s2{background:linear-gradient(135deg,#065f46,#10b981)}
.promo .s3{background:linear-gradient(135deg,#7c2d12,#f97316)}
.promo .s4{background-image:linear-gradient(rgba(6,60,25,.55),rgba(6,60,25,.75)),url('/img/portal/photo-football-s.jpg')}
.promo h4{font-size:20px;line-height:1.3;font-weight:900}
.promo p{font-size:13px;margin-top:8px;opacity:.95;line-height:1.5}
.promo .tag{display:inline-block;background:rgba(255,255,255,.25);border-radius:999px;padding:4px 10px;font-size:11px;font-weight:800;margin-top:10px}
.promo .foot{background:#1e3a8a;color:#fff;text-align:center;font-size:12px;font-weight:700;padding:8px}
.dots{text-align:center;padding:8px 0 2px}
.dots i{display:inline-block;width:8px;height:8px;border-radius:50%;background:#cbd5e1;margin:0 3px}
.dots i.on{background:#1d4ed8}
/* 8. packages */
.pkgs{padding:14px 16px 4px}
.pkgs h3{font-size:19px;font-weight:900}
.pkgs .hint{font-size:12px;color:#64748b;margin:4px 0 10px}
.group-label{display:flex;align-items:center;gap:10px;margin:14px 0 4px;font-size:12px;font-weight:800;letter-spacing:.08em;text-transform:uppercase;color:#64748b}
.group-label::after{content:"";flex:1;height:1px;background:#e2e8f0}
.grid{display:grid;grid-template-columns:1fr 1fr;gap:10px}
.tile{border-radius:14px;padding:14px 12px;color:#fff;cursor:pointer;position:relative;box-shadow:0 6px 14px rgba(20,40,80,.18);border:0;text-align:left;font-family:inherit}
.tile b{font-size:16px}
.tile span{display:block;font-size:11px;opacity:.92;margin-top:3px}
.tile .pr{font-size:20px;font-weight:900;margin-top:8px}
.tile.t1{background:linear-gradient(135deg,#1d4ed8,#3b82f6)}
.tile.t2{background:linear-gradient(135deg,#ea580c,#fb923c)}
.tile.t3{background:linear-gradient(135deg,#15803d,#22c55e)}
.tile.t4{background:linear-gradient(135deg,#7c3aed,#a78bfa)}
.tile.selected{outline:3px solid #111827;outline-offset:2px}
.sel-line{font-size:13px;font-weight:800;color:#1d4ed8;margin:10px 2px 0}
/* 9. payment */
.paysec{padding:14px 16px 4px}
.paysec h3{font-size:19px;font-weight:900}
.payrow{display:flex;gap:10px;margin-top:12px}
.paybtn{flex:1;border:0;border-radius:14px;padding:15px 8px;cursor:pointer;font-family:inherit;color:#fff}
.paybtn .ic{font-size:18px;font-weight:900}
.paybtn small{display:block;font-size:11px;opacity:.92;margin-top:3px}
.paybtn.sel{outline:3px solid #111827;outline-offset:2px}
.paypanel{margin-top:14px;border:2px solid #1d4ed8;border-radius:14px;padding:15px;background:#eff6ff}
.paypanel .mname{font-size:15px;font-weight:800}
.paypanel .mname i{display:inline-block;width:10px;height:10px;border-radius:3px;margin-right:6px}
.paypanel .num{font-size:23px;font-weight:900;margin:8px 0 2px}
.paypanel .num .copybtn{vertical-align:middle}
.copybtn{border:1.5px solid #1d4ed8;background:#fff;color:#1d4ed8;border-radius:999px;padding:6px 15px;font-size:13px;font-weight:700;cursor:pointer;font-family:inherit}
.paypanel label{display:block;font-size:12px;font-weight:800;margin:12px 0 6px}
.paypanel input{width:100%;border:1.5px solid #cbd5e1;border-radius:12px;padding:13px 14px;font-size:16px;font-family:inherit;outline:none;background:#fff}
.paypanel input:focus{border-color:#1d4ed8}
.paypanel input[readonly]{border:0;background:transparent;padding:0;font-weight:800;color:#1e3a8a;font-size:15px}
.paypanel .cta{width:100%;border:0;border-radius:12px;padding:15px;font-size:16px;font-weight:900;color:#fff;background:#16a34a;cursor:pointer;margin-top:16px;font-family:inherit}
.paypanel .cta:disabled{opacity:.6;cursor:wait}
.spinner{display:inline-block;width:16px;height:16px;border:2px solid rgba(255,255,255,.4);border-top-color:#fff;border-radius:50%;vertical-align:-3px;margin-right:8px;animation:spin .7s linear infinite}
.paypanel .cta .spinner{display:inline-block;width:16px;height:16px;border:2px solid rgba(255,255,255,.4);border-top-color:#fff;border-radius:50%;vertical-align:-3px;margin-right:8px;animation:spin .7s linear infinite}
@keyframes spin{to{transform:rotate(360deg)}}
#receipt-card{margin-top:16px;border:1.5px dashed #6ee7b7;border-radius:18px;padding:14px 16px;background:#f0fdf4}
#receipt-card h2{margin:0 0 4px;font-size:15px;font-weight:800}
.receipt-row{display:flex;justify-content:space-between;gap:10px;padding:8px 0;border-bottom:1px solid #dcfce7;font-size:14px}
.receipt-row:last-of-type{border-bottom:0}
.receipt-row span{color:#64748b}
.receipt-status{margin:10px 0 0;font-size:13px;font-weight:700}
/* 10. bottom */
.strip{background:#1d4ed8;color:#fff;text-align:center;font-size:13px;font-weight:700;line-height:1.6;padding:12px 16px;margin-top:18px}
.ficons{display:flex;justify-content:center;gap:16px;padding:16px 0 22px}
.ficons a{width:52px;height:52px;border-radius:50%;display:flex;align-items:center;justify-content:center;color:#fff;text-decoration:none}
.ficons .wa{background:#25d366}.ficons .ph{background:#1d4ed8}
.footer{text-align:center;font-size:12px;color:#64748b;margin-top:0;padding:0 16px 22px}
.qr-modal{position:fixed;inset:0;background:rgba(15,23,42,.75);display:flex;align-items:center;justify-content:center;padding:20px;z-index:50}
.qr-modal-card{background:#fff;border-radius:20px;padding:16px;width:100%;max-width:420px;text-align:center}
.qr-modal-card video{display:block;width:100%;max-height:52vh;object-fit:cover;border-radius:12px;background:#020617;margin-top:10px}
.qr-modal-card p{font-size:13px;color:#64748b;margin:10px 0}
.qr-modal-card .btn{display:block;width:100%;min-height:52px;border:0;border-radius:999px;font-size:16px;font-weight:800;font-family:inherit;cursor:pointer;padding:12px 18px;text-align:center}
.qr-modal-card .btn-primary{background:#16a34a;color:#fff}
.qr-modal-card .btn-secondary{background:#fff;color:#065f46;border:1.5px solid #a7f3d0}
.qr-modal-card .btn:disabled{opacity:.6;cursor:wait}
</style></head>
<body><main class="wrap">
<div id="banner-area" class="banner hidden"><picture><source id="banner-mobile-src" media="(max-width: 767px)"><img id="banner-img" alt=""></picture></div>
<div id="custom-html-area" class="hidden"></div>
<div class="care">
<div class="left"><div class="logo" id="brand-logo-slot"><span id="brand-logo-fn">FN</span><% if(brand.logo_url){ %><img id="brand-logo-img" src="<%= brand.logo_url %>" alt="<%= brandName %>" onerror="this.style.display='none';document.getElementById('brand-logo-fn').style.display='';"><% } %></div><div><b id="brand-title"><%= brandName %></b><p id="brand-subtitle">স্বয়ংক্রিয় হাই-স্পিড হটস্পট জোন</p></div></div>
<a class="right" id="helpline-call" href="tel:<%= supportPhone %>"><small>কাস্টমার কেয়ার</small><b id="helpline-number"><%= supportPhone %></b></a>
</div>
<div class="ticker"><span>FAZ NETWORK &nbsp;•&nbsp; স্বয়ংক্রিয় হাই-স্পিড হটস্পট জোন &nbsp;•&nbsp; 1GB মাত্র ৳10 — ডেটা কোটা only, মেয়াদ নেই &nbsp;•&nbsp; FAZ NETWORK &nbsp;•&nbsp; স্বয়ংক্রিয় হাই-স্পিড হটস্পট জোন &nbsp;•&nbsp;</span></div>
<div class="hero">
<div class="sw"></div><div class="sw2"></div>
<div id="status-pill" class="status-pill" aria-live="polite">যাচাই হচ্ছে…</div>
<h2><svg viewBox="0 0 24 24" width="22" height="22" fill="#dc2626" aria-hidden="true"><path d="M12 2C8.1 2 5 5.1 5 9c0 5.2 7 13 7 13s7-7.8 7-13c0-3.9-3.1-7-7-7zm0 9.5A2.5 2.5 0 1 1 12 6.5a2.5 2.5 0 0 1 0 5z"/></svg> চলে আসুন<br>সব চেয়ে দ্রুত গতির<br>সেরা ইন্টারনেট</h2>
<div class="price" id="hero-price">৩০ দিন &nbsp;৳১৫০</div>
<div class="pay hidden" id="hero-pay"><small>পেমেন্ট করুন</small><span id="hero-pay-pills"></span></div>
<div class="speed">
<svg width="64" height="64" viewBox="0 0 64 64"><circle cx="32" cy="32" r="26" fill="none" stroke="#dbeafe" stroke-width="7"/><path d="M32 6 A26 26 0 0 1 58 32" fill="none" stroke="#7c3aed" stroke-width="7" stroke-linecap="round"/><text x="32" y="36" text-anchor="middle" font-size="13" font-weight="900" fill="#1e3a8a">100</text><text x="32" y="48" text-anchor="middle" font-size="8" fill="#64748b">Mbps</text></svg>
<div><b>Wi-Fi 6 · সুপার ফাস্ট</b><p>গেমিং, স্ট্রিমিং, পড়ালেখা — সব বাফার ফ্রি</p></div>
</div>
</div>
<div id="notice-bar" class="notice-bar hidden" role="status"></div>
<div class="ribbon"><span>আপনার ফোন নাম্বারটি দিন</span><span class="tab">তারপর প্রবেশ বাটনে ক্লিক করুন</span></div>
<div class="login">
<div id="existing-login-form">
<div class="pill single"><input id="existing-name" type="text" autocomplete="name" maxlength="120" required placeholder="আপনার নাম"></div>
<div class="pill"><input id="existing-phone" type="tel" inputmode="numeric" autocomplete="tel" maxlength="11" required placeholder="মোবাইল নাম্বার"><button type="button" id="existing-login-submit" class="go">প্রবেশ</button></div>
</div>
<div id="voucher-login-form" class="hidden">
<div class="pill single"><input id="voucher-pin" type="text" autocomplete="off" autocapitalize="characters" placeholder="ভাউচার PIN"></div>
<div class="pill single"><input id="voucher-password" type="password" autocomplete="current-password" placeholder="ভাউচার পাসওয়ার্ড"></div>
<div class="pill single"><input id="voucher-name" type="text" autocomplete="name" maxlength="120" required placeholder="আপনার নাম"></div>
<div class="pill"><input id="voucher-phone" type="tel" inputmode="numeric" autocomplete="tel" maxlength="11" required placeholder="মোবাইল নাম্বার"><button type="button" id="voucher-claim-submit" class="go">প্রবেশ</button></div>
<button type="button" id="qr-scan-button" class="qr-btn"><svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor" aria-hidden="true"><path d="M3 3h8v8H3zM5 5v4h4V5zM13 3h8v8h-8zM15 5v4h4V5zM3 13h8v8H3zM5 15v4h4v-4zM13 13h4v4h-4zM19 13h2v2h-2zM13 19h4v2h-4zM19 19h2v2h-2z"/></svg>Scan QR</button>
</div>
<div id="claim-code-box" class="hidden"><div class="claim-box"><h2>প্যাকেজ Claim করুন</h2><p class="helper">এই প্যাকেজটি claim করতে পেমেন্টের TrxID দিন। TrxID পাবেন bKash / Nagad পেমেন্টের SMS-এ। TrxID হারিয়ে গেলে হেল্পলাইন 01339932887-এ যোগাযোগ করুন।</p><div class="field"><label for="claim-phone">ফোন নম্বর <span class="opt">(আবশ্যক)</span></label><input id="claim-phone" type="tel" inputmode="numeric" autocomplete="tel" maxlength="11" required placeholder="01712345678"></div><div class="field"><label for="claim-name">আপনার নাম <span class="opt">(আবশ্যক)</span></label><input id="claim-name" type="text" autocomplete="name" maxlength="120" required placeholder="আপনার নাম"></div><div class="field"><label for="claim-code">Payment TrxID</label><input id="claim-code" type="text" inputmode="text" autocomplete="off" autocapitalize="characters" placeholder="যেমন: 8A7B6C5D"></div><div class="field"><button type="button" id="claim-code-submit" class="btn">Claim &amp; Login</button></div></div></div>
<div id="result" aria-live="polite"></div>
</div>
<div class="alt">
