  if(logo){
    if(!logoImg){logoImg=document.createElement("img");logoImg.id="brand-logo-img";logoImg.alt=title;logoSlot.appendChild(logoImg);}
    logoImg.src=logo;logoImg.style.display="";
    if(logoFn)logoFn.style.display="none";
    logoImg.onerror=function(){logoImg.style.display="none";if(logoFn)logoFn.style.display="";};
  }else{
    if(logoImg)logoImg.style.display="none";
    if(logoFn)logoFn.style.display="";
