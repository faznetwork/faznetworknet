function parseQrCredentials(raw){
  var value=String(raw||"").trim();if(!value)return null;
  try{var parsed=JSON.parse(value);if(parsed&&typeof parsed==="object"){var username=String(parsed.username||parsed.user||parsed.pin||parsed.voucher_code||"").trim(),password=String(parsed.password||parsed.pass||parsed.voucher_password||"").trim();if(username)return{username:username,password:password};}}catch(e){}
  try{var url=new URL(value);var u=url.searchParams.get("username")||url.searchParams.get("user")||url.searchParams.get("pin"),p=url.searchParams.get("password")||url.searchParams.get("pass");if(u)return{username:u,password:p||""};}catch(e){}
  var match=value.match(/^([^:|\s]+)\s*[:|]\s*(.+)$/);if(match)return{username:match[1].trim(),password:match[2].trim()};
  return{username:value,password:""};
}
function applyScannedCredentials(raw){
  var credentials=parseQrCredentials(raw);
  if(!credentials||!credentials.username){showResult("err","QR কোডে ভাউচার ইউজারনেম পাওয়া যায়নি।");return;}
  $("voucher-pin").value=credentials.username.toUpperCase();
  if(credentials.password)$("voucher-password").value=credentials.password;
  showResult("ok",credentials.password?"QR থেকে ভাউচার তথ্য পড়া হয়েছে।":"QR থেকে ইউজারনেম পড়া হয়েছে; পাসওয়ার্ড লিখুন।");
}
