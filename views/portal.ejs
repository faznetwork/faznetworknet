<!doctype html><% const brand=typeof brandSettings!=="undefined"&&brandSettings?brandSettings:{}; const brandName=String(brand.company_name||"FAZ NETWORK"); %>
<html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title><%= brandName %> Hotspot</title><% if(brand.favicon_url){ %><link rel="icon" href="<%= brand.favicon_url %>"><% } %><script src="https://cdn.tailwindcss.com"></script><style>body{background:radial-gradient(circle at top,#ecfdf5,#f8fafc 48%,#f1f5f9);font-family:system-ui,sans-serif}.glass{background:rgba(255,255,255,.9);backdrop-filter:blur(12px)}.tab.active{background:#047857;color:#fff}.pkg{transition:.18s}.pkg:hover{transform:translateY(-3px);box-shadow:0 12px 25px rgba(6,95,70,.12)}</style><script src="/js/date-format.js"></script>
</head>
<body class="min-h-screen text-slate-800"><main class="max-w-3xl mx-auto px-4 py-6">
<header class="text-center mb-5"><% if(brand.logo_url){ %><img src="<%= brand.logo_url %>" alt="<%= brandName %>" class="mx-auto mb-2 max-h-16 max-w-48 object-contain"><% } else { %><div class="text-4xl">☪️</div><% } %><h1 class="text-3xl font-black text-emerald-800"><%= brandName %></h1><p class="text-sm text-slate-500">Islamic-themed Hotspot Portal • Fast & Secure Internet</p></header>
<section class="glass rounded-3xl border border-emerald-100 shadow-xl p-5">
<div class="rounded-2xl bg-emerald-50 border border-emerald-100 p-4"><p class="text-xs font-bold uppercase tracking-widest text-emerald-700 text-center">Personal MFS Send Money Accounts</p><div class="grid grid-cols-2 gap-3 mt-3"><% [["bKash","bkash"],["Nagad","nagad"],["Rocket","rocket"],["Upay","upay"]].forEach(([label,key])=>{const number=String(paymentAccounts?.[key]||"").trim(); %><div class="rounded-xl border border-emerald-100 bg-white p-3 text-center"><p class="text-xs font-bold text-slate-500"><%= label %></p><p class="text-lg font-black mt-1 break-all"><%= number||"Not configured" %></p><% if(number){ %><button type="button" class="copy-mfs-number mt-1 text-xs font-bold text-emerald-700" data-number="<%= number %>">Copy number</button><% } %></div><% }) %></div><p class="text-xs text-slate-500 text-center mt-3">Send the exact package amount, then enter your phone number and TrxID. Device MAC is bound on first Wi-Fi login; username and password will both be that MAC.</p></div>
<div class="grid grid-cols-2 gap-2 mt-5"><button class="tab active rounded-xl px-4 py-3 font-bold" data-tab="voucher">🎟️ Voucher</button><button class="tab rounded-xl px-4 py-3 font-bold bg-slate-100" data-tab="recharge">💳 Recharge</button></div>
<section id="voucher" class="mt-5"><div class="grid grid-cols-2 sm:grid-cols-3 gap-3">
<button class="pkg rounded-2xl border border-slate-200 bg-white p-4 text-left" data-price="10" data-profile-id="1-hour"><span class="text-xs text-emerald-700 font-bold">1 Hour</span><strong class="block text-2xl mt-1">৳10</strong><span class="text-xs text-slate-400">Select package</span></button><button class="pkg rounded-2xl border border-slate-200 bg-white p-4 text-left" data-price="15" data-profile-id="12-hours"><span class="text-xs text-emerald-700 font-bold">12 Hours</span><strong class="block text-2xl mt-1">৳15</strong><span class="text-xs text-slate-400">Select package</span></button><button class="pkg rounded-2xl border border-slate-200 bg-white p-4 text-left" data-price="20" data-profile-id="1-day"><span class="text-xs text-emerald-700 font-bold">1 Day</span><strong class="block text-2xl mt-1">৳20</strong><span class="text-xs text-slate-400">Select package</span></button><button class="pkg rounded-2xl border border-slate-200 bg-white p-4 text-left" data-price="40" data-profile-id="3-days"><span class="text-xs text-emerald-700 font-bold">3 Days</span><strong class="block text-2xl mt-1">৳40</strong><span class="text-xs text-slate-400">Select package</span></button><button class="pkg rounded-2xl border border-slate-200 bg-white p-4 text-left" data-price="60" data-profile-id="7-days"><span class="text-xs text-emerald-700 font-bold">7 Days</span><strong class="block text-2xl mt-1">৳60</strong><span class="text-xs text-slate-400">Select package</span></button><button class="pkg rounded-2xl border border-slate-200 bg-white p-4 text-left" data-price="90" data-profile-id="15-days"><span class="text-xs text-emerald-700 font-bold">15 Days</span><strong class="block text-2xl mt-1">৳90</strong><span class="text-xs text-slate-400">Select package</span></button><button class="pkg rounded-2xl border border-slate-200 bg-white p-4 text-left" data-price="150" data-profile-id="30-days"><span class="text-xs text-emerald-700 font-bold">30 Days</span><strong class="block text-2xl mt-1">৳150</strong><span class="text-xs text-slate-400">Select package</span></button><button class="pkg rounded-2xl border border-slate-200 bg-white p-4 text-left" data-price="200" data-profile-id="100gb"><span class="text-xs text-emerald-700 font-bold">100GB</span><strong class="block text-2xl mt-1">৳200</strong><span class="text-xs text-slate-400">Select package</span></button><button class="pkg rounded-2xl border border-slate-200 bg-white p-4 text-left" data-price="350" data-profile-id="300gb"><span class="text-xs text-emerald-700 font-bold">300GB</span><strong class="block text-2xl mt-1">৳350</strong><span class="text-xs text-slate-400">Select package</span></button>
</div></section>
<section id="recharge" class="hidden mt-5"><form id="verify-form" class="space-y-4"><p class="rounded-xl bg-emerald-50 p-3 text-sm text-emerald-800">পেমেন্ট যাচাই হওয়ার পর Wi-Fi-তে সংযোগ দিয়ে captive login পেজে একই ফোন নম্বর দিন। প্রথম login-এ ডিভাইসের MAC স্বয়ংক্রিয়ভাবে bind হবে।</p><div><label class="text-sm font-bold">Customer Phone Number (11 digits)</label><input id="phone" type="tel" inputmode="numeric" autocomplete="tel" required pattern="01[0-9]{9}" maxlength="11" class="mt-1 w-full rounded-xl border px-4 py-3" placeholder="01712345678"></div><div><label class="text-sm font-bold">TrxID / TxnID</label><input id="trx" required class="mt-1 w-full rounded-xl border px-4 py-3" placeholder="e.g. 8A7B6C5D"></div><div><label class="text-sm font-bold">Selected package</label><input id="amount" readonly class="mt-1 w-full rounded-xl border px-4 py-3 bg-slate-50" placeholder="Choose a package first"></div><button class="w-full rounded-xl bg-emerald-700 text-white py-3 font-black">Verify Payment & Save Package</button><button type="button" id="existing-mac-login" class="block w-full text-center rounded-xl border py-3 font-bold">Existing Customer Login</button></form><div id="result" class="hidden mt-4 rounded-2xl p-4"></div></section>
</section></main>
<form id="portal-mikrotik-login" action="$(link-login-only)" method="post" style="display:none"><input type="hidden" name="username" id="portal-mt-user" value="$(mac)"><input type="hidden" name="password" id="portal-mt-pass" value="$(mac)"><input type="hidden" name="dst" value="$(link-orig)"><input type="hidden" name="popup" value="true"></form><input type="hidden" id="portal-router-mac" value="$(mac)">
<script>
let selected=0,selectedProfile="";
function normalizePhoneInput(value){const bangla="০১২৩৪৫৬৭৮৯";let digits=String(value||"").replace(/[০-৯]/g,ch=>String(bangla.indexOf(ch))).replace(/\D/g,"");if(digits.startsWith("880")&&digits.length===13)digits="0"+digits.slice(3);return digits;}
function normalizePortalMac(value){const compact=String(value||"").trim().replace(/[:-]/g,"");return /^[0-9a-fA-F]{12}$/.test(compact)?compact.match(/.{2}/g).join(":").toUpperCase():"";}
function submitMacLogin(mac){const normalized=normalizePortalMac(mac||document.getElementById("portal-router-mac").value);if(!normalized){const box=document.getElementById("result");box.className="mt-4 rounded-2xl p-4 bg-amber-50 text-amber-800";box.textContent="RouterOS device MAC পাওয়া যায়নি। অনুগ্রহ করে FAZ NETWORK Wi-Fi captive login page থেকে চেষ্টা করুন।";return false;}document.getElementById("portal-mt-user").value=normalized;document.getElementById("portal-mt-pass").value=normalized;document.getElementById("portal-mikrotik-login").submit();return true;}
document.getElementById("existing-mac-login").addEventListener("click",()=>submitMacLogin());
const tabs=document.querySelectorAll(".tab");tabs.forEach(b=>b.onclick=()=>{tabs.forEach(x=>x.classList.remove("active"));b.classList.add("active");document.getElementById("voucher").classList.toggle("hidden",b.dataset.tab!=="voucher");document.getElementById("recharge").classList.toggle("hidden",b.dataset.tab!=="recharge")});
document.querySelectorAll(".pkg").forEach(b=>b.onclick=()=>{selected=Number(b.dataset.price);selectedProfile=String(b.dataset.profileId||"");document.getElementById("amount").value="৳"+selected+" package";document.querySelector('[data-tab="recharge"]').click();document.getElementById("trx").focus()});
document.querySelectorAll(".copy-mfs-number").forEach(button=>button.addEventListener("click",async()=>{try{await navigator.clipboard.writeText(button.dataset.number||"");const old=button.textContent;button.textContent="Copied";setTimeout(()=>button.textContent=old,1200);}catch(_){}}));
document.getElementById("verify-form").onsubmit=async e=>{
  e.preventDefault();
  const phone=normalizePhoneInput(document.getElementById("phone").value),trxId=document.getElementById("trx").value.trim(),box=document.getElementById("result"),deviceMac=normalizePortalMac(document.getElementById("portal-router-mac").value);
  if(!/^01[0-9]{9}$/.test(phone)){box.className="mt-4 rounded-2xl p-4 bg-red-50 text-red-700";box.textContent="সঠিক ১১ ডিজিটের বাংলাদেশি মোবাইল নম্বর দিন।";return;}
  if(!selected||!selectedProfile){box.className="mt-4 rounded-2xl p-4 bg-red-50 text-red-700";box.textContent="আগে একটি প্যাকেজ নির্বাচন করুন।";return;}
  document.getElementById("phone").value=phone;box.className="mt-4 rounded-2xl p-4 bg-slate-100";box.textContent="পেমেন্ট যাচাই হচ্ছে…";
  try{
    const r=await fetch("https://faznetwork-web.onrender.com/api/verify-trx",{method:"POST",headers:{"Content-Type":"application/json"},body:JSON.stringify({service_type:"hotspot",phone,account_phone:phone,trxId,amount:selected,package_id:selectedProfile,profile_id:selectedProfile,mac:deviceMac})});
    const d=await r.json();
    if(!r.ok||!d.success){
      const messages={NOT_FOUND_OR_DELAYED:"SMS এখনো সার্ভারে আসেনি। কিছুক্ষণ অপেক্ষা করে আবার চেষ্টা করুন।",ALREADY_CLAIMED:"এই TrxID ইতিমধ্যে ব্যবহার করা হয়েছে।",TRANSACTION_IN_PROCESS:"এই TrxID অন্য একটি অনুরোধে যাচাই হচ্ছে।",AMOUNT_MISMATCH:"পেমেন্টের পরিমাণ নির্বাচিত প্যাকেজের দামের সঙ্গে মিলছে না।",INVALID_ACCOUNT_PHONE:"সঠিক ১১ ডিজিটের বাংলাদেশি মোবাইল নম্বর দিন।",PROFILE_NOT_FOUND_OR_AMBIGUOUS:"প্যাকেজটি সঠিকভাবে শনাক্ত করা যায়নি। অন্য প্যাকেজ নির্বাচন করুন।",MULTIPLE_LIVE_PACKAGES:"এই নম্বরে একাধিক সক্রিয় প্যাকেজ আছে। Support-এর সঙ্গে যোগাযোগ করুন."};
      throw Error(messages[d.code]||d.message||d.error||"পেমেন্ট যাচাই করা যায়নি।");
    }
    const activation=await fetch("https://faznetwork-web.onrender.com/api/hotspot-auth/activate",{method:"POST",headers:{"Content-Type":"application/json"},body:JSON.stringify({phone,mac:deviceMac})});
    const activated=await activation.json();
    if(!activation.ok||!activated.success)throw Error(activated.message||activated.error||"Hotspot activation failed.");
    box.className="mt-4 rounded-2xl p-4 bg-emerald-50 text-emerald-800";
    box.textContent="পেমেন্ট যাচাই ও ডিভাইস অ্যাক্টিভেশন সফল। ইন্টারনেট চালু হচ্ছে…";
    document.getElementById("portal-mt-user").value=activated.username||deviceMac;
    document.getElementById("portal-mt-pass").value=activated.password||deviceMac;
    setTimeout(()=>document.getElementById("portal-mikrotik-login").submit(),350);
  }catch(err){box.className="mt-4 rounded-2xl p-4 bg-red-50 text-red-700";box.textContent=err.message;}
};
</script></body></html>