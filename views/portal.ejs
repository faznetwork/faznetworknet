<!doctype html><% const brand=typeof brandSettings!=="undefined"&&brandSettings?brandSettings:{}; const brandName=String(brand.company_name||"FAZ NETWORK"); %>
<html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title><%= brandName %> Hotspot</title><% if(brand.favicon_url){ %><link rel="icon" href="<%= brand.favicon_url %>"><% } %><script src="https://cdn.tailwindcss.com"></script><style>body{background:radial-gradient(circle at top,#ecfdf5,#f8fafc 48%,#f1f5f9);font-family:system-ui,sans-serif}.glass{background:rgba(255,255,255,.9);backdrop-filter:blur(12px)}.tab.active{background:#047857;color:#fff}.pkg{transition:.18s}.pkg:hover{transform:translateY(-3px);box-shadow:0 12px 25px rgba(6,95,70,.12)}</style><script src="/js/date-format.js"></script>
</head>
<body class="min-h-screen text-slate-800"><main class="max-w-3xl mx-auto px-4 py-6">
<header class="text-center mb-5"><% if(brand.logo_url){ %><img src="<%= brand.logo_url %>" alt="<%= brandName %>" class="mx-auto mb-2 max-h-16 max-w-48 object-contain"><% } else { %><div class="text-4xl">☪️</div><% } %><h1 class="text-3xl font-black text-emerald-800"><%= brandName %></h1><p class="text-sm text-slate-500">Islamic-themed Hotspot Portal • Fast & Secure Internet</p></header>
<section class="glass rounded-3xl border border-emerald-100 shadow-xl p-5">
<div class="rounded-2xl bg-emerald-50 border border-emerald-100 p-4"><p class="text-xs font-bold uppercase tracking-widest text-emerald-700 text-center">Personal MFS Send Money Accounts</p><div class="grid grid-cols-2 gap-3 mt-3"><% [["bKash","bkash"],["Nagad","nagad"],["Rocket","rocket"],["Upay","upay"]].forEach(([label,key])=>{const number=String(paymentAccounts?.[key]||"").trim(); %><div class="rounded-xl border border-emerald-100 bg-white p-3 text-center"><p class="text-xs font-bold text-slate-500"><%= label %></p><p class="text-lg font-black mt-1 break-all"><%= number||"Not configured" %></p><% if(number){ %><button type="button" class="copy-mfs-number mt-1 text-xs font-bold text-emerald-700" data-number="<%= number %>">Copy number</button><% } %></div><% }) %></div><p class="text-xs text-slate-500 text-center mt-3">Send the exact package amount, then enter your TrxID / TxnID below.</p></div>
<div class="grid grid-cols-2 gap-2 mt-5"><button class="tab active rounded-xl px-4 py-3 font-bold" data-tab="voucher">🎟️ Voucher</button><button class="tab rounded-xl px-4 py-3 font-bold bg-slate-100" data-tab="recharge">💳 Recharge</button></div>
<section id="voucher" class="mt-5"><div class="grid grid-cols-2 sm:grid-cols-3 gap-3">
<button class="pkg rounded-2xl border border-slate-200 bg-white p-4 text-left" data-price="10"><span class="text-xs text-emerald-700 font-bold">1 Hour</span><strong class="block text-2xl mt-1">৳10</strong><span class="text-xs text-slate-400">Select package</span></button><button class="pkg rounded-2xl border border-slate-200 bg-white p-4 text-left" data-price="15"><span class="text-xs text-emerald-700 font-bold">12 Hours</span><strong class="block text-2xl mt-1">৳15</strong><span class="text-xs text-slate-400">Select package</span></button><button class="pkg rounded-2xl border border-slate-200 bg-white p-4 text-left" data-price="20"><span class="text-xs text-emerald-700 font-bold">1 Day</span><strong class="block text-2xl mt-1">৳20</strong><span class="text-xs text-slate-400">Select package</span></button><button class="pkg rounded-2xl border border-slate-200 bg-white p-4 text-left" data-price="40"><span class="text-xs text-emerald-700 font-bold">3 Days</span><strong class="block text-2xl mt-1">৳40</strong><span class="text-xs text-slate-400">Select package</span></button><button class="pkg rounded-2xl border border-slate-200 bg-white p-4 text-left" data-price="60"><span class="text-xs text-emerald-700 font-bold">7 Days</span><strong class="block text-2xl mt-1">৳60</strong><span class="text-xs text-slate-400">Select package</span></button><button class="pkg rounded-2xl border border-slate-200 bg-white p-4 text-left" data-price="90"><span class="text-xs text-emerald-700 font-bold">15 Days</span><strong class="block text-2xl mt-1">৳90</strong><span class="text-xs text-slate-400">Select package</span></button><button class="pkg rounded-2xl border border-slate-200 bg-white p-4 text-left" data-price="150"><span class="text-xs text-emerald-700 font-bold">30 Days</span><strong class="block text-2xl mt-1">৳150</strong><span class="text-xs text-slate-400">Select package</span></button><button class="pkg rounded-2xl border border-slate-200 bg-white p-4 text-left" data-price="200"><span class="text-xs text-emerald-700 font-bold">100GB</span><strong class="block text-2xl mt-1">৳200</strong><span class="text-xs text-slate-400">Select package</span></button><button class="pkg rounded-2xl border border-slate-200 bg-white p-4 text-left" data-price="350"><span class="text-xs text-emerald-700 font-bold">300GB</span><strong class="block text-2xl mt-1">৳350</strong><span class="text-xs text-slate-400">Select package</span></button>
</div></section>
<section id="recharge" class="hidden mt-5"><form id="verify-form" class="space-y-4"><div><label class="text-sm font-bold">Phone Number / Username</label><input id="phone" type="tel" inputmode="numeric" autocomplete="tel" required pattern="01[0-9]{9}" maxlength="11" class="mt-1 w-full rounded-xl border px-4 py-3" placeholder="01712345678"></div><div><label class="text-sm font-bold">TrxID / TxnID</label><input id="trx" required class="mt-1 w-full rounded-xl border px-4 py-3" placeholder="e.g. 8A7B6C5D"></div><div><label class="text-sm font-bold">Selected package</label><input id="amount" readonly class="mt-1 w-full rounded-xl border px-4 py-3 bg-slate-50" placeholder="Choose a package first"></div><button class="w-full rounded-xl bg-emerald-700 text-white py-3 font-black">Verify Payment & Get Login</button><a href="$(link-login-only)" class="block text-center rounded-xl border py-3 font-bold">Existing Customer Login</a></form><div id="result" class="hidden mt-4 rounded-2xl p-4"></div></section>
</section></main>
<script>
let selected=0;const tabs=document.querySelectorAll(".tab");tabs.forEach(b=>b.onclick=()=>{tabs.forEach(x=>x.classList.remove("active"));b.classList.add("active");document.getElementById("voucher").classList.toggle("hidden",b.dataset.tab!=="voucher");document.getElementById("recharge").classList.toggle("hidden",b.dataset.tab!=="recharge")});
document.querySelectorAll(".pkg").forEach(b=>b.onclick=()=>{selected=Number(b.dataset.price);document.getElementById("amount").value="৳"+selected+" package";document.querySelector('[data-tab="recharge"]').click();document.getElementById("trx").focus()});
document.querySelectorAll(".copy-mfs-number").forEach(button=>button.addEventListener("click",async()=>{try{await navigator.clipboard.writeText(button.dataset.number||"");const old=button.textContent;button.textContent="Copied";setTimeout(()=>button.textContent=old,1200);}catch(_){}}));
document.getElementById("verify-form").onsubmit=async e=>{e.preventDefault();const box=document.getElementById("result");box.className="mt-4 rounded-2xl p-4 bg-slate-100";box.textContent="Verifying…";try{const r=await fetch("https://faznetwork-web.onrender.com/api/verify-trx",{method:"POST",headers:{"Content-Type":"application/json"},body:JSON.stringify({username:document.getElementById("phone").value.trim(),trxId:document.getElementById("trx").value.trim(),amount:selected,loginUrl:"$(link-login-only)"})});const d=await r.json();if(!r.ok||!d.success)throw Error(d.error||"Verification failed");box.className="mt-4 rounded-2xl p-4 bg-emerald-50 text-emerald-800";box.innerHTML="<b>Payment verified.</b><br>Username: <b>"+d.username+"</b><br>Password: <b>"+d.password+"</b><br><span class='text-xs'>Opening login…</span>";setTimeout(()=>{const u="$(link-login-only)";if(u&&u!=="$(link-login-only)")location.href=u+"?username="+encodeURIComponent(d.username)+"&password="+encodeURIComponent(d.password);},800)}catch(err){box.className="mt-4 rounded-2xl p-4 bg-red-50 text-red-700";box.textContent=err.message}};
</script></body></html>