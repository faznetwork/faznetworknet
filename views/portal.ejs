<!doctype html>
<% const brand=typeof brandSettings!=="undefined"&&brandSettings?brandSettings:{}; const brandName=String(brand.company_name||"FAZ NETWORK"); %>
<html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title><%= brandName %> Hotspot</title><% if(brand.favicon_url){ %><link rel="icon" href="<%= brand.favicon_url %>"><% } %><script src="https://cdn.tailwindcss.com"></script><style>body{background:radial-gradient(circle at top,#ecfdf5,#f8fafc 48%,#f1f5f9);font-family:system-ui,sans-serif}.glass{background:rgba(255,255,255,.9);backdrop-filter:blur(12px)}.tab.active{background:#047857;color:#fff}.pkg{transition:.18s}.pkg:hover{transform:translateY(-3px);box-shadow:0 12px 25px rgba(6,95,70,.12)}</style></head>
<body class="min-h-screen text-slate-800"><main class="max-w-3xl mx-auto px-4 py-6">
<header class="text-center mb-5"><% if(brand.logo_url){ %><img src="<%= brand.logo_url %>" alt="<%= brandName %>" class="mx-auto mb-2 max-h-16 max-w-48 object-contain"><% } else { %><div class="text-4xl">☪️</div><% } %><h1 class="text-3xl font-black text-emerald-800"><%= brandName %></h1><p class="text-sm text-slate-500">Islamic-themed Hotspot Portal • Fast &amp; Secure Internet</p></header>
<section class="glass rounded-3xl border border-emerald-100 shadow-xl p-5">
<div class="rounded-2xl bg-emerald-50 border border-emerald-100 p-4"><p class="text-xs font-bold uppercase tracking-widest text-emerald-700 text-center">Personal MFS Send Money Accounts</p><div id="portal-mfs" class="grid grid-cols-2 gap-3 mt-3"><p class="col-span-2 text-center text-sm text-slate-500">Loading payment accounts…</p></div><p class="text-xs text-slate-500 text-center mt-3">Send the exact package amount, then enter your TrxID. Phone number is optional. Device MAC is bound on first Wi-Fi login; username and password will both be that MAC.</p></div>
<div class="grid grid-cols-2 gap-2 mt-5"><button class="tab active rounded-xl px-4 py-3 font-bold" data-tab="voucher">🎟️ Voucher</button><button class="tab rounded-xl px-4 py-3 font-bold bg-slate-100" data-tab="recharge">💳 Recharge</button></div>
<section id="voucher" class="mt-5"><div id="portal-packages" class="grid grid-cols-2 sm:grid-cols-3 gap-3"><p class="col-span-full text-center text-sm text-slate-500">Loading Hotspot packages…</p></div></section>
<section id="recharge" class="hidden mt-5"><form id="verify-form" class="space-y-4"><p class="rounded-xl bg-emerald-50 p-3 text-sm text-emerald-800">পেমেন্ট যাচাই হওয়ার পর Wi-Fi-তে সংযোগ দিয়ে captive login পেজে একই ফোন নম্বর দিন। প্রথম login-এ ডিভাইসের MAC স্বয়ংক্রিয়ভাবে bind হবে।</p><div><label class="text-sm font-bold">Customer Phone Number (optional)</label><input id="phone" type="tel" inputmode="numeric" autocomplete="tel" maxlength="11" class="mt-1 w-full rounded-xl border px-4 py-3" placeholder="01712345678"></div><div><label class="text-sm font-bold">Your Name (optional)</label><input id="customer-name" type="text" autocomplete="name" maxlength="120" class="mt-1 w-full rounded-xl border px-4 py-3" placeholder="আপনার নাম"></div><div><label class="text-sm font-bold">TrxID / TxnID</label><input id="trx" required class="mt-1 w-full rounded-xl border px-4 py-3" placeholder="e.g. 8A7B6C5D"></div><div><label class="text-sm font-bold">Selected package</label><input id="amount" readonly class="mt-1 w-full rounded-xl border px-4 py-3 bg-slate-50" placeholder="Choose a package first"></div><button class="w-full rounded-xl bg-emerald-700 text-white py-3 font-black">Verify Payment &amp; Save Package</button><div class="rounded-xl border"><button type="button" id="existing-mac-login" class="block w-full text-center rounded-xl py-3 font-bold">Existing Customer Login</button><div id="existing-login-form" class="hidden px-4 pb-4 space-y-3"><div><label class="text-sm font-bold">Customer Phone Number (optional)</label><input id="existing-phone" type="tel" inputmode="numeric" autocomplete="tel" maxlength="11" class="mt-1 w-full rounded-xl border px-4 py-3" placeholder="01712345678"></div><div><label class="text-sm font-bold">Your Name (optional)</label><input id="existing-name" type="text" autocomplete="name" maxlength="120" class="mt-1 w-full rounded-xl border px-4 py-3" placeholder="আপনার নাম"></div><button type="button" id="existing-login-submit" class="w-full rounded-xl bg-emerald-700 text-white py-3 font-black">Login</button></div></div></form><div id="claim-code-box" class="hidden mt-4 rounded-2xl border p-4 space-y-3"><p class="text-sm font-bold">এই প্যাকেজটি claim করতে claim code লাগবে। আপনার রেজিস্টার্ড ফোন নম্বরে কোড পাঠানো যাবে।</p><div class="flex gap-2"><input id="claim-code" type="text" inputmode="numeric" maxlength="6" class="w-full rounded-xl border px-4 py-3" placeholder="6-digit code"><button type="button" id="claim-code-send" class="rounded-xl border px-4 py-3 font-bold whitespace-nowrap">Send code</button></div><button type="button" id="claim-code-submit" class="w-full rounded-xl bg-emerald-700 text-white py-3 font-black">Claim with code</button></div><div id="result" class="hidden mt-4 rounded-2xl p-4"></div></section>
</section></main>
<form id="portal-mikrotik-login" action="$(link-login-only)" method="post" style="display:none"><input type="hidden" name="username" id="portal-mt-user" value="$(mac)"><input type="hidden" name="password" id="portal-mt-pass" value="$(mac)"><input type="hidden" name="dst" value="$(link-orig)"><input type="hidden" name="popup" value="true"></form><input type="hidden" id="portal-router-mac" value="$(mac)">
<script>
let selected=0,selectedProfile="";
function escHtml(value){return String(value??"").replace(/[&<>"']/g,char=>({"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;","'":"&#39;"}[char]));}
function normalizePhoneInput(value){const bangla="০১২৩৪৫৬৭৮৯";let digits=String(value||"").replace(/[০-৯]/g,ch=>String(bangla.indexOf(ch))).replace(/\D/g,"");if(digits.startsWith("880")&&digits.length===13)digits="0"+digits.slice(3);return digits;}
function normalizePortalMac(value){const compact=String(value||"").trim().replace(/[:-]/g,"");return /^[0-9a-fA-F]{12}$/.test(compact)?compact.match(/.{2}/g).join(":").toUpperCase():"";}
function postMikrotikLogin(mac){document.getElementById("portal-mt-user").value=mac;document.getElementById("portal-mt-pass").value=mac;document.getElementById("portal-mikrotik-login").submit();}
function showClaimCodeBox(phone,mac,customerName){const claimBox=document.getElementById("claim-code-box");claimBox.classList.remove("hidden");claimBox.dataset.phone=phone||"";claimBox.dataset.mac=mac||"";claimBox.dataset.customerName=customerName||"";const box=document.getElementById("result");box.className="mt-4 rounded-2xl p-4 bg-amber-50 text-amber-800";box.textContent="এই প্যাকেজটি claim করতে payment TrxID বা আপনার ফোনে পাঠানো claim code লাগবে।";}
async function submitMacLogin(mac,phone,customerName){
  const normalized=normalizePortalMac(mac||document.getElementById("portal-router-mac").value);
  const box=document.getElementById("result");
  if(!normalized){box.className="mt-4 rounded-2xl p-4 bg-amber-50 text-amber-800";box.textContent="RouterOS device MAC পাওয়া যায়নি। অনুগ্রহ করে FAZ NETWORK Wi-Fi captive login page থেকে চেষ্টা করুন।";return false;}
  const optionalPhone=/^01[0-9]{9}$/.test(normalizePhoneInput(phone||""))?normalizePhoneInput(phone||""):"";
  const name=String(customerName||"").trim();
  box.className="mt-4 rounded-2xl p-4 bg-slate-100";box.textContent="লগইন হচ্ছে…";
  try{
    const response=await fetch("/api/hotspot-auth/activate",{method:"POST",headers:{"Content-Type":"application/json",Accept:"application/json"},body:JSON.stringify({phone:optionalPhone,mac:normalized,customer_name:name})});
    const data=await response.json();
    if(!response.ok||!data.success){
      if(data.code==="CLAIM_SECRET_REQUIRED"||data.code==="OTP_NOT_FOUND_OR_EXPIRED"){showClaimCodeBox(optionalPhone,normalized,name);return false;}
      throw Error(data.message||data.error||"Login failed.");
    }
    box.className="mt-4 rounded-2xl p-4 bg-emerald-50 text-emerald-800";box.textContent="লগইন সফল। ইন্টারনেট চালু হচ্ছে…";
    setTimeout(()=>postMikrotikLogin(data.username||normalized),350);return true;
  }catch(error){box.className="mt-4 rounded-2xl p-4 bg-red-50 text-red-700";box.textContent=error.message;return false;}
}
function renderPortalConfig(config){
  const labels={bkash:"bKash",nagad:"Nagad",rocket:"Rocket",upay:"Upay"},accounts={bkash:"",nagad:"",rocket:"",upay:""};
  (Array.isArray(config.mfs)?config.mfs:[]).forEach(item=>{const key=String(item.name||"").trim().toLowerCase().replace(/[^a-z]/g,"");if(item.enabled===true&&Object.prototype.hasOwnProperty.call(accounts,key))accounts[key]=String(item.number||"").trim();});
  const mfs=document.getElementById("portal-mfs");mfs.innerHTML=Object.keys(labels).map(key=>{const number=accounts[key];return `<div class="rounded-xl border border-emerald-100 bg-white p-3 text-center"><p class="text-xs font-bold text-slate-500">${labels[key]}</p><p class="text-lg font-black mt-1 break-all">${escHtml(number||"Not configured")}</p>${number?`<button type="button" class="copy-mfs-number mt-1 text-xs font-bold text-emerald-700" data-number="${escHtml(number)}">Copy number</button>`:""}</div>`;}).join("");
  mfs.querySelectorAll(".copy-mfs-number").forEach(button=>button.addEventListener("click",async()=>{try{await navigator.clipboard.writeText(button.dataset.number||"");const old=button.textContent;button.textContent="Copied";setTimeout(()=>button.textContent=old,1200);}catch(_){}}));
  const packages=(Array.isArray(config.packages)?config.packages:[]).filter(pkg=>String(pkg.profileId||pkg.name||"").trim()&&!/(expired|ex-|disabled|block|default|vpn)/i.test(String(pkg.profileId||pkg.name||""))&&Number(pkg.price)>0);
  const container=document.getElementById("portal-packages");container.innerHTML=packages.length?packages.map(pkg=>{const name=String(pkg.name||pkg.profileId),profile=String(pkg.profileId||pkg.profile||name),price=Number(pkg.price),validity=String(pkg.validity||"Internet access");return `<button type="button" class="pkg rounded-2xl border border-slate-200 bg-white p-4 text-left" data-price="${price}" data-profile-id="${escHtml(profile)}"><span class="text-xs text-emerald-700 font-bold">${escHtml(validity)}</span><strong class="block text-2xl mt-1">৳${price.toLocaleString("en-BD")}</strong><span class="text-xs text-slate-400">${escHtml(name)} · Select package</span></button>`;}).join(""):`<p class="col-span-full rounded-xl bg-amber-50 p-4 text-center text-sm text-amber-800">কোনো সক্রিয় Hotspot package পাওয়া যায়নি।</p>`;
  container.querySelectorAll(".pkg").forEach(button=>button.addEventListener("click",()=>{selected=Number(button.dataset.price);selectedProfile=String(button.dataset.profileId||"");document.getElementById("amount").value="৳"+selected+" package";document.querySelector('[data-tab="recharge"]').click();document.getElementById("trx").focus();}));
}
const tabs=document.querySelectorAll(".tab");tabs.forEach(button=>button.onclick=()=>{tabs.forEach(item=>item.classList.remove("active"));button.classList.add("active");document.getElementById("voucher").classList.toggle("hidden",button.dataset.tab!=="voucher");document.getElementById("recharge").classList.toggle("hidden",button.dataset.tab!=="recharge");});
document.getElementById("existing-mac-login").addEventListener("click",()=>{document.getElementById("existing-login-form").classList.toggle("hidden");});
document.getElementById("existing-login-submit").addEventListener("click",()=>{submitMacLogin(null,document.getElementById("existing-phone").value,document.getElementById("existing-name").value);});
document.getElementById("claim-code-send").addEventListener("click",async()=>{
  const claimBox=document.getElementById("claim-code-box"),box=document.getElementById("result"),phone=claimBox.dataset.phone||"";
  if(!/^01[0-9]{9}$/.test(phone)){box.className="mt-4 rounded-2xl p-4 bg-red-50 text-red-700";box.textContent="Claim code পেতে সঠিক ফোন নম্বর দিন।";return;}
  box.className="mt-4 rounded-2xl p-4 bg-slate-100";box.textContent="Claim code পাঠানো হচ্ছে…";
  try{const response=await fetch("/api/hotspot-auth/request-claim-otp",{method:"POST",headers:{"Content-Type":"application/json",Accept:"application/json"},body:JSON.stringify({phone})});const data=await response.json();if(!response.ok||!data.success)throw Error(data.message||"Claim code পাঠানো যায়নি।");box.className="mt-4 rounded-2xl p-4 bg-emerald-50 text-emerald-800";box.textContent="Claim code পাঠানো হয়েছে। আপনার ফোনে আসা ৬ ডিজিটের কোডটি দিন।";document.getElementById("claim-code").focus();}
  catch(error){box.className="mt-4 rounded-2xl p-4 bg-red-50 text-red-700";box.textContent=error.message;}
});
document.getElementById("claim-code-submit").addEventListener("click",async()=>{
  const claimBox=document.getElementById("claim-code-box"),box=document.getElementById("result"),code=document.getElementById("claim-code").value.trim();
  if(!/^\d{6}$/.test(code)){box.className="mt-4 rounded-2xl p-4 bg-red-50 text-red-700";box.textContent="সঠিক ৬ ডিজিটের claim code দিন।";return;}
  box.className="mt-4 rounded-2xl p-4 bg-slate-100";box.textContent="Claim code যাচাই হচ্ছে…";
  try{
    const response=await fetch("/api/hotspot-auth/activate",{method:"POST",headers:{"Content-Type":"application/json",Accept:"application/json"},body:JSON.stringify({phone:claimBox.dataset.phone||"",mac:claimBox.dataset.mac||"",otp:code,customer_name:claimBox.dataset.customerName||""})});
    const data=await response.json();if(!response.ok||!data.success)throw Error(data.message||data.error||"Claim code যাচাই করা যায়নি।");
    claimBox.classList.add("hidden");box.className="mt-4 rounded-2xl p-4 bg-emerald-50 text-emerald-800";box.textContent="প্যাকেজ claim সফল। ইন্টারনেট চালু হচ্ছে…";setTimeout(()=>postMikrotikLogin(data.username||claimBox.dataset.mac),350);
  }catch(error){box.className="mt-4 rounded-2xl p-4 bg-red-50 text-red-700";box.textContent=error.message;}
});
fetch("/api/public/portal-config",{headers:{Accept:"application/json"},cache:"no-store"}).then(async response=>{const config=await response.json();if(!response.ok||!config.success)throw new Error(config.error||"Portal configuration unavailable");renderPortalConfig(config);}).catch(error=>{document.getElementById("portal-packages").innerHTML=`<p class="col-span-full rounded-xl bg-red-50 p-4 text-center text-sm text-red-700">${escHtml(error.message||"Hotspot packages could not be loaded.")}</p>`;document.getElementById("portal-mfs").innerHTML="<p class=\"col-span-2 text-center text-sm text-slate-500\">Payment settings unavailable.</p>";});
document.getElementById("verify-form").onsubmit=async event=>{
  event.preventDefault();const phone=normalizePhoneInput(document.getElementById("phone").value),trxId=document.getElementById("trx").value.trim(),customerName=document.getElementById("customer-name").value.trim(),box=document.getElementById("result"),deviceMac=normalizePortalMac(document.getElementById("portal-router-mac").value);
  if(!deviceMac){box.className="mt-4 rounded-2xl p-4 bg-amber-50 text-amber-800";box.textContent="RouterOS device MAC পাওয়া যায়নি। অনুগ্রহ করে captive login page থেকে পেমেন্ট যাচাই করুন।";return;}
  const optionalPhone=/^01[0-9]{9}$/.test(phone)?phone:"";if(!selected||!selectedProfile){box.className="mt-4 rounded-2xl p-4 bg-red-50 text-red-700";box.textContent="আগে একটি প্যাকেজ নির্বাচন করুন।";return;}
  document.getElementById("phone").value=phone;box.className="mt-4 rounded-2xl p-4 bg-slate-100";box.textContent="পেমেন্ট যাচাই হচ্ছে…";
  try{
    const response=await fetch("/api/verify-trx",{method:"POST",headers:{"Content-Type":"application/json",Accept:"application/json"},body:JSON.stringify({service_type:"hotspot",phone:optionalPhone,account_phone:optionalPhone,customer_name:customerName,trxId,amount:selected,package_id:selectedProfile,profile_id:selectedProfile,mac:deviceMac})});const data=await response.json();
    if(!response.ok||!data.success){const messages={NOT_FOUND_OR_DELAYED:"SMS এখনো সার্ভারে আসেনি। কিছুক্ষণ অপেক্ষা করে আবার চেষ্টা করুন।",ALREADY_CLAIMED:"এই TrxID ইতিমধ্যে ব্যবহার করা হয়েছে।",TRANSACTION_IN_PROCESS:"এই TrxID অন্য একটি অনুরোধে যাচাই হচ্ছে।",AMOUNT_MISMATCH:"পেমেন্টের পরিমাণ নির্বাচিত প্যাকেজের দামের সঙ্গে মিলছে না।",INVALID_ACCOUNT_PHONE:"সঠিক ১১ ডিজিটের বাংলাদেশি মোবাইল নম্বর দিন।",PROFILE_NOT_FOUND_OR_AMBIGUOUS:"প্যাকেজটি সঠিকভাবে শনাক্ত করা যায়নি। অন্য প্যাকেজ নির্বাচন করুন।",MULTIPLE_LIVE_PACKAGES:"এই নম্বরে একাধিক সক্রিয় প্যাকেজ আছে। Support-এর সঙ্গে যোগাযোগ করুন."};throw Error(messages[data.code]||data.message||data.error||"পেমেন্ট যাচাই করা যায়নি।");}
    const activation=await fetch("/api/hotspot-auth/activate",{method:"POST",headers:{"Content-Type":"application/json",Accept:"application/json"},body:JSON.stringify({phone:optionalPhone,mac:deviceMac,customer_name:customerName,trxId:data.claim_trx_id||trxId})});const activated=await activation.json();if(!activation.ok||!activated.success){if(activated.code==="CLAIM_SECRET_REQUIRED"||activated.code==="OTP_NOT_FOUND_OR_EXPIRED"){showClaimCodeBox(optionalPhone,deviceMac,customerName);return;}throw Error(activated.message||activated.error||"Hotspot activation failed.");}
    box.className="mt-4 rounded-2xl p-4 bg-emerald-50 text-emerald-800";box.textContent="পেমেন্ট যাচাই ও ডিভাইস অ্যাক্টিভেশন সফল। ইন্টারনেট চালু হচ্ছে…";document.getElementById("portal-mt-user").value=activated.username||deviceMac;document.getElementById("portal-mt-pass").value=activated.password||deviceMac;setTimeout(()=>document.getElementById("portal-mikrotik-login").submit(),350);
  }catch(error){box.className="mt-4 rounded-2xl p-4 bg-red-50 text-red-700";box.textContent=error.message;}
};
</script><script>(async()=>{try{const r=await fetch('/api/hotspot/public-branding',{cache:'no-store'});if(!r.ok)return;const b=await r.json();const logo=document.querySelector('header img');if(logo&&b.logoUrl)logo.src=b.logoUrl;const desktop=b.bannerUrl||b.banner_url;if(desktop&&b.display_mode==='banner'){const picture=document.getElementById('hotspot-promo'),img=document.getElementById('hotspot-promo-desktop'),mobile=document.getElementById('hotspot-promo-mobile');img.src=desktop;if(b.mobileBannerUrl||b.mobile_banner_url)mobile.srcset=b.mobileBannerUrl||b.mobile_banner_url;picture.hidden=false;}}catch(e){console.warn('[Hotspot portal branding]',e.message||e);}})();</script></body></html>
