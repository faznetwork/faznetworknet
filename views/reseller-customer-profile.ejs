<!doctype html>
<%
  const brand = typeof brandSettings !== 'undefined' && brandSettings ? brandSettings : {};
  const brandName = String(brand.company_name || 'FAZ NETWORK');
  const profileCustomerId = String(typeof customerId !== 'undefined' ? customerId : '');
%>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <meta name="robots" content="noindex,nofollow">
  <title><%= brandName %> · Customer Profile</title>
  <% if (brand.favicon_url) { %><link rel="icon" href="<%= brand.favicon_url %>"><% } %>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap" rel="stylesheet">
  <style>
    :root{--green:#0a3d2e;--hover:#0d4d3a;--accent:#10b981;--ink:#0f172a;--muted:#64748b;--bg:#f3f7f5}
    *{box-sizing:border-box}body{margin:0;background:var(--bg);color:var(--ink);font-family:"Plus Jakarta Sans",Inter,"Segoe UI",Arial,sans-serif}
    .topbar{background:linear-gradient(115deg,var(--green),var(--hover));color:#fff;padding:19px 0}.profile-brand-title{font-weight:600}
    .page-wrap{max-width:1240px;margin:0 auto;padding:25px 20px 48px}
    .panel{background:#fff;border:1px solid #e2ebe6;border-radius:16px;padding:20px;box-shadow:0 4px 16px #0f172a08}
    .section-title{font-size:1rem;font-weight:600;margin:0}.section-subtitle{font-size:.82rem;color:var(--muted);margin-top:4px}
    .label{font-size:.7rem;text-transform:uppercase;letter-spacing:.07em;color:var(--muted);font-weight:500}
    .value{font-weight:400;margin-top:5px;overflow-wrap:anywhere}.info-cell{padding:13px;border:1px solid #edf2ef;border-radius:11px;height:100%;background:#fcfefd}
    .hero{background:linear-gradient(120deg,#0a3d2e,#0d4d3a);color:#fff;border-radius:17px;padding:23px}
    .hero .muted{color:#cde8dc}.badge-soft{background:#e7f7ef;color:#075b43}.badge-muted{background:#eef2f7;color:#475569}
    .table thead th{font-size:.71rem;font-weight:600;text-transform:uppercase;letter-spacing:.06em;color:#64748b;background:#f8fafc;white-space:nowrap}
    .table tbody td{font-size:.86rem;font-weight:400;vertical-align:middle}.empty-state{padding:28px;text-align:center;color:var(--muted)}
    .btn-fzn{background:var(--green);color:#fff;border:0}.btn-fzn:hover{background:var(--hover);color:#fff}
    #pageError{display:none}
    @media(max-width:767px){.page-wrap{padding:17px 11px 32px}.panel{padding:15px}.hero{padding:18px}.profile-heading{align-items:flex-start!important;flex-direction:column}}
  </style>
</head>
<body>
  <header class="topbar"><div class="container-fluid px-3 px-lg-4 d-flex justify-content-between align-items-center gap-3 flex-wrap">
    <div><div class="small text-white-50"><%= brandName %></div><div class="fs-5 profile-brand-title">Reseller Customer Profile</div></div>
    <a href="/reseller/dashboard" class="btn btn-sm btn-outline-light"><i class="bi bi-arrow-left me-1"></i>Back to dashboard</a>
  </div></header>
  <main class="page-wrap">
    <div id="pageError" class="alert alert-danger" role="alert"></div>
    <section class="hero mb-4">
      <div class="d-flex justify-content-between gap-3 profile-heading">
        <div><div class="small muted mb-1">CUSTOMER 360 · READ ONLY</div><h1 id="customerName" class="h3 fw-bold mb-1">Loading customer…</h1><div id="customerIdentity" class="muted small">Retrieving assigned customer profile</div></div>
        <div class="text-md-end"><span id="accountStatus" class="badge text-bg-light">Loading</span><div id="liveStatus" class="small muted mt-2">Live status checking…</div></div>
      </div>
    </section>

    <section class="panel mb-4">
      <div class="mb-3"><h2 class="section-title">Customer information</h2><div class="section-subtitle">Read-only account and service details</div></div>
      <div class="row g-3" id="customerDetails">
        <div class="col-12 text-secondary small">Loading customer information…</div>
      </div>
    </section>

    <section class="panel mb-4">
      <div class="mb-3"><h2 class="section-title">PPPoE Credentials</h2><div class="section-subtitle">Account login details · visible only to the assigned reseller</div></div>
      <div class="row g-3">
        <div class="col-12 col-md-6"><div class="info-cell"><div class="label">PPPoE username</div><div class="value" id="pppoeCredentialUsername">—</div></div></div>
        <div class="col-12 col-md-6"><div class="info-cell">
          <label class="label" for="pppoePasswordValue">PPPoE password</label>
          <div class="input-group mt-1">
            <input id="pppoePasswordValue" class="form-control" type="password" value="" placeholder="••••••••" readonly autocomplete="off" aria-label="PPPoE password">
            <button id="togglePppoePassword" class="btn btn-outline-secondary" type="button" aria-controls="pppoePasswordValue" aria-pressed="false" aria-label="Show PPPoE password"><i class="bi bi-eye" aria-hidden="true"></i><span class="ms-1">Show</span></button>
          </div>
        </div></div>
      </div>
    </section>

    <section class="panel mb-4">
      <div class="mb-3"><h2 class="section-title">Assigned network</h2><div class="section-subtitle">POP and service assignment details</div></div>
      <div class="row g-3" id="networkDetails"><div class="col-12 text-secondary small">Loading network details…</div></div>
    </section>

    <section class="panel">
      <div class="d-flex justify-content-between align-items-center gap-2 flex-wrap mb-3"><div><h2 class="section-title">Payment history</h2><div class="section-subtitle">Transactions matched to this customer's exact PPPoE username</div></div><span class="badge badge-muted" id="paymentCount">Loading</span></div>
      <div class="table-responsive"><table class="table table-hover mb-0"><thead><tr><th>Date</th><th>Transaction ID</th><th>Channel</th><th>Amount</th><th>Status</th></tr></thead><tbody id="paymentRows"><tr><td colspan="5" class="text-center text-secondary py-4">Loading payment history…</td></tr></tbody></table></div>
    </section>
    <footer class="text-center small text-secondary mt-4">© <%= new Date().getFullYear() %> <%= brandName %> · Read-only reseller view</footer>
  </main>
  <script>
    const api='/api/reseller-portal';
    const customerKey=<%- JSON.stringify(profileCustomerId) %>;
    const escapeHtml=value=>String(value??'').replace(/[&<>"']/g,char=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[char]));
    const money=value=>'৳'+Number(value||0).toLocaleString('en-BD',{minimumFractionDigits:2,maximumFractionDigits:2});
    const date=value=>{if(!value)return '—';const raw=String(value).slice(0,10);const match=raw.match(/^(\d{4})-(\d{2})-(\d{2})$/);return match?match[3]+'/'+match[2]+'/'+match[1]:escapeHtml(raw)};
    async function getJson(url){const response=await fetch(url,{headers:{Accept:'application/json'},cache:'no-store'});let data;try{data=await response.json()}catch(error){throw new Error('The server returned an invalid response.')}if(!response.ok||!data.success)throw new Error(data.message||'Unable to load customer data.');return data}
    function showError(message){const box=document.getElementById('pageError');box.textContent=message;box.style.display='block'}
    function info(label,value){return '<div class="col-6 col-lg-3"><div class="info-cell"><div class="label">'+label+'</div><div class="value">'+escapeHtml(value||'—')+'</div></div></div>'}
    async function loadProfile(){
      try{
        const [profile,payments,live]=await Promise.all([
          getJson(api+'/customers/'+encodeURIComponent(customerKey)),
          getJson(api+'/customers/'+encodeURIComponent(customerKey)+'/payments'),
          getJson(api+'/customers/'+encodeURIComponent(customerKey)+'/live-session').catch(error=>({success:false,liveStatusAvailable:false,diagnostic:error.message}))
        ]);
        const c=profile.customer||{};
        document.getElementById('customerName').textContent=c.full_name||c.username||'Customer';
        document.getElementById('customerIdentity').textContent='PPPoE username: '+(c.username||'—');
        document.getElementById('pppoeCredentialUsername').textContent=c.username||'—';
        document.getElementById('pppoePasswordValue').value=c.pppoe_password||'';
        document.getElementById('accountStatus').textContent=c.status||'Unknown';
        document.getElementById('accountStatus').className='badge '+(String(c.status).toLowerCase()==='active'?'badge-soft':'badge-muted');
        document.getElementById('customerDetails').innerHTML=
          info('Phone',c.phone)+info('Email',c.email)+info('Package',c.package_name)+info('Profile',c.profile)+
          info('Monthly bill',money(c.monthly_bill))+info('Expiration date',date(c.expiration_date))+info('Connection date',date(c.connection_date))+info('Installation address',c.installation_address);
        document.getElementById('networkDetails').innerHTML=
          info('Assigned POP',c.pop_name)+info('POP area / zone',c.pop_area_zone)+info('POP ID',c.pop_id)+info('Username',c.username);
        const liveLabel=!live.liveStatusAvailable?'Status Unavailable':(live.live?.online?'Online':'Offline');
        document.getElementById('liveStatus').textContent='● '+liveLabel;
        renderPayments(payments.payments||[]);
      }catch(error){showError(error.message);document.getElementById('customerName').textContent='Customer profile unavailable';document.getElementById('customerDetails').innerHTML='<div class="col-12 text-danger small">The requested customer profile could not be loaded.</div>';document.getElementById('paymentRows').innerHTML='<tr><td colspan="5" class="text-center text-danger py-4">Payment history unavailable.</td></tr>'}
    }
    function renderPayments(rows){
      document.getElementById('paymentCount').textContent=rows.length+' records';
      const body=document.getElementById('paymentRows');
      if(!rows.length){body.innerHTML='<tr><td colspan="5"><div class="empty-state">No username-matched payment records were found.</div></td></tr>';return}
      body.innerHTML=rows.map(row=>'<tr><td>'+date(row.created_at)+'</td><td class="font-monospace">'+escapeHtml(row.trx_id||'—')+'</td><td>'+escapeHtml(row.channel||'—')+'</td><td>'+money(row.amount)+'</td><td><span class="badge '+(String(row.status).toUpperCase()==='PAID'?'badge-soft':'badge-muted')+'">'+escapeHtml(row.status||'Unknown')+'</span></td></tr>').join('');
    }
    document.getElementById('togglePppoePassword').addEventListener('click',function(){
      const input=document.getElementById('pppoePasswordValue');
      const showing=input.type==='password';
      input.type=showing?'text':'password';
      this.setAttribute('aria-pressed',String(showing));
      this.setAttribute('aria-label',showing?'Hide PPPoE password':'Show PPPoE password');
      this.innerHTML=(showing?'<i class="bi bi-eye-slash" aria-hidden="true"></i><span class="ms-1">Hide</span>':'<i class="bi bi-eye" aria-hidden="true"></i><span class="ms-1">Show</span>');
    });
    loadProfile();
  </script>
</body>
</html>
