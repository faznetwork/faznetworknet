<!doctype html>
<% const brand=typeof brandSettings!=="undefined"&&brandSettings?brandSettings:{}; const brandName=String(brand.company_name||"FAZ NETWORK"); %><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>FAZ NETWORK · Reports</title><link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet"><link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css" rel="stylesheet"><style>:root{--green:#0a3d2e;--mint:#10b981}body{background:#f4f7f6;color:#172b25;font-family:system-ui,-apple-system,Segoe UI,sans-serif}.top{background:var(--green);color:white;padding:18px 0}.wrap{max-width:1400px}.nav-pills .nav-link{color:#33564b;background:white;border:1px solid #dce8e2;margin:0 6px 6px 0}.nav-pills .nav-link.active{background:var(--green)}.metric{border:0;border-radius:14px;box-shadow:0 4px 18px #0a3d2e0c}.metric small{color:#64748b}.metric strong{display:block;font-size:1.55rem;margin-top:5px}.table thead th{font-size:.76rem;color:#64748b;text-transform:uppercase;white-space:nowrap;background:#f8fafc}.table td{vertical-align:middle;font-size:.9rem}.btn-green{background:var(--green);color:white}.btn-green:hover{background:#0d4d3a;color:white}.filter{background:white;border:1px solid #e2ebe6;border-radius:12px;padding:16px}.badge-method{background:#e7f8ef;color:#08784c}.empty{text-align:center;padding:36px;color:#64748b}@media print{.top,.nav-pills,.filter,.btn{display:none!important}body{background:#fff}.metric{box-shadow:none}}</style><script src="/js/date-format.js"></script>
</head><body><header class="top"><div class="container wrap d-flex justify-content-between align-items-center"><div><div class="fw-bold fs-4"><i class="bi bi-bar-chart-line me-2"></i>FAZ NETWORK</div><div class="small opacity-75">Reporting & financial overview</div></div><a href="/admin" class="btn btn-outline-light btn-sm"><i class="bi bi-arrow-left me-1"></i>Admin Panel</a></div></header><main class="container wrap py-4"><div class="d-flex flex-wrap justify-content-between align-items-end gap-2 mb-3"><div><h1 class="h3 mb-1" id="pageTitle">Collection Report</h1><p class="text-secondary mb-0">Filterable operational and financial reports.</p></div><div class="text-secondary small">Currency: BDT (৳)</div></div><ul class="nav nav-pills mb-4"><li class="nav-item"><a class="nav-link" data-report="collection" href="/admin/reports/collection"><i class="bi bi-wallet2 me-1"></i>Collection Report</a></li><li class="nav-item"><a class="nav-link" data-report="due" href="/admin/reports/due"><i class="bi bi-file-text me-1"></i>Due Summary</a></li><li class="nav-item"><a class="nav-link" data-report="hotspot-revenue" href="/admin/reports/hotspot-revenue"><i class="bi bi-wifi me-1"></i>Hotspot Revenue</a></li><li class="nav-item"><a class="nav-link" data-report="expenses" href="/admin/reports/expenses"><i class="bi bi-credit-card me-1"></i>Expense Sheet</a></li></ul><div id="filters" class="filter mb-3"></div><div id="metrics" class="row g-3 mb-3"></div><div id="content" class="card metric"><div class="empty">Loading report…</div></div></main>
<div class="modal fade" id="expenseModal" tabindex="-1"><div class="modal-dialog"><form class="modal-content" id="expenseForm"><div class="modal-header"><h5 class="modal-title">Add Expense</h5><button type="button" class="btn-close" data-bs-dismiss="modal"></button></div><div class="modal-body"><input type="hidden" id="expenseId"><label class="form-label">Title</label><input class="form-control mb-3" id="expenseTitle" required maxlength="160"><label class="form-label">Category</label><select class="form-select mb-3" id="expenseCategory" required><option>Upstream bandwidth</option><option>Staff salary</option><option>Office rent</option><option>Fiber / Hardware maintenance</option><option>Electricity</option><option>Transport</option><option>Other</option></select><label class="form-label">Amount (৳)</label><input type="number" min=".01" step=".01" class="form-control mb-3" id="expenseAmount" required><label class="form-label">Date</label><input type="date" class="form-control mb-3" id="expenseDate" required><label class="form-label">Note / Receipt No.</label><textarea class="form-control" id="expenseNotes" rows="2" maxlength="2000"></textarea></div><div class="modal-footer"><button type="button" class="btn btn-light" data-bs-dismiss="modal">Cancel</button><button class="btn btn-green" type="submit">Save Expense</button></div></form></div></div><script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script><script>
const routeKind=location.pathname.split('/').pop();const kind=['add','all','report'].includes(routeKind)?'expenses':routeKind;const titles={collection:'Collection Report',due:'Due Summary','hotspot-revenue':'Hotspot Revenue',expenses:'Expense Sheet'};document.getElementById('pageTitle').textContent=titles[kind]||titles.collection;document.title=document.getElementById('pageTitle').textContent+' · FAZ NETWORK';document.querySelectorAll('[data-report]').forEach(a=>a.classList.toggle('active',a.dataset.report===kind));const fmt=n=>'৳'+Number(n||0).toLocaleString('en-BD',{minimumFractionDigits:2,maximumFractionDigits:2});const esc=s=>String(s??'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));const api=async(url,opts={})=>{const r=await fetch(url,{...opts,headers:{'Content-Type':'application/json',...(opts.headers||{})}});const j=await r.json();if(!r.ok||!j.success)throw Error(j.message||'Request failed');return j};const metrics=items=>document.getElementById('metrics').innerHTML=items.map(([l,v,i])=>'<div class="col-12 col-md-4"><div class="card metric h-100"><div class="card-body"><small><i class="bi '+i+' me-1"></i>'+esc(l)+'</small><strong>'+esc(v)+'</strong></div></div></div>').join('');const table=(h,rows)=>'<div class="table-responsive"><table class="table table-hover mb-0"><thead><tr>'+h.map(x=>'<th>'+x+'</th>').join('')+'</tr></thead><tbody>'+(rows.length?rows.map(r=>'<tr>'+r.map(x=>'<td>'+x+'</td>').join('')+'</tr>').join(''):'<tr><td class="empty" colspan="'+h.length+'">No records found.</td></tr>')+'</tbody></table></div>';const filters=document.getElementById('filters'),content=document.getElementById('content');
function exportTable(name){const t=content.querySelector('table');if(!t)return;const csv=[...t.rows].map(r=>[...r.cells].map(c=>'"'+c.innerText.replace(/"/g,'""')+'"').join(',')).join('\r\n');const a=document.createElement('a');a.href=URL.createObjectURL(new Blob(['\ufeff'+csv],{type:'text/csv;charset=utf-8'}));a.download=name.toLowerCase().replace(/\s+/g,'-')+'.csv';a.click();URL.revokeObjectURL(a.href)}
function collectionFilters(){filters.innerHTML='<div class="row g-3 align-items-end"><div class="col-sm-6 col-lg-3"><label class="form-label">From</label><input type="date" class="form-control" id="from"></div><div class="col-sm-6 col-lg-3"><label class="form-label">To</label><input type="date" class="form-control" id="to"></div><div class="col-sm-6 col-lg-3"><label class="form-label">Payment method</label><select class="form-select" id="method"><option value="all">All methods</option><option value="cash">Cash</option><option value="bkash">bKash</option><option value="nagad">Nagad</option><option value="rocket">Rocket</option><option value="upay">Upay</option></select></div><div class="col-sm-6 col-lg-3 d-flex gap-2"><button class="btn btn-green flex-fill" id="apply">Apply</button><button class="btn btn-outline-secondary" id="print"><i class="bi bi-printer"></i></button><button class="btn btn-outline-secondary" id="csv">CSV</button></div></div>';document.getElementById('apply').onclick=load;document.getElementById('print').onclick=()=>print();document.getElementById('csv').onclick=()=>exportTable('Collection Report')}
async function load(){try{content.innerHTML='<div class="empty">Loading…</div>';
if(kind==='collection'){const q=new URLSearchParams();['from','to','method'].forEach(k=>{const v=document.getElementById(k)?.value;if(v)q.set(k,v)});const d=await api('/api/reports/collection?'+q),s=d.summary;metrics([['Total Collected',fmt(s.total),'bi-cash-stack'],['Cash vs MFS',fmt(s.cash)+' / '+fmt(s.mfs),'bi-wallet2'],['Transactions',Number(s.count||0).toLocaleString(),'bi-receipt']]);content.innerHTML=table(['Date & Time','Customer / Username','Package / Purpose','Amount','Method','TrxID'],d.rows.map(r=>[esc(FazDate.formatDateTime(r.created_at)),'<b>'+esc(r.customer_name)+'</b><br><small>'+esc(r.matched_username||r.sender_phone||'')+'</small>',esc(r.purpose),'<b>'+fmt(r.amount)+'</b>','<span class="badge badge-method">'+esc(r.channel)+'</span>',esc(r.trx_id||'—')]))}
else if(kind==='due'){if(!filters.dataset.ready){filters.innerHTML='<div class="row g-3 align-items-end"><div class="col-md-5"><label class="form-label">Package</label><select id="package" class="form-select"><option value="">All packages</option></select></div><div class="col-md-4"><label class="form-label">Billing status</label><select id="status" class="form-select"><option value="all">All overdue / expired</option><option value="overdue">Overdue</option><option value="expired">Expired</option></select></div><div class="col-md-3"><button class="btn btn-green w-100" id="apply">Apply filters</button></div></div>';filters.dataset.ready='1'}const d=await api('/api/reports/due?'+new URLSearchParams({status:document.getElementById('status').value,package:document.getElementById('package').value})),sel=document.getElementById('package');if(!sel.dataset.ready){sel.innerHTML+=[...new Set(d.packages)].map(p=>'<option value="'+esc(p)+'">'+esc(p)+'</option>').join('');sel.dataset.ready='1'}document.getElementById('apply').onclick=load;metrics([['Total Outstanding Due',fmt(d.summary.outstanding),'bi-exclamation-circle'],['Defaulter Subscribers',Number(d.summary.subscribers||0).toLocaleString(),'bi-people']]);content.innerHTML=table(['Customer','PPPoE Username','Phone','Package','Monthly Bill','Expiry Date','Days Overdue','Action'],d.rows.map(r=>[esc(r.full_name),esc(r.username),esc(r.phone),esc(r.package_name),fmt(r.monthly_bill),esc(r.expiration_date||'Not set'),'<span class="badge text-bg-danger">'+Number(r.days_overdue||0)+'</span>','<a class="btn btn-sm btn-outline-success" href="/admin/customers/'+Number(r.id)+'">View / Renew</a>']))}
else if(kind==='hotspot-revenue'){filters.innerHTML='<div class="text-end"><button class="btn btn-outline-secondary" id="csv">Export CSV</button></div>';document.getElementById('csv').onclick=()=>exportTable('Hotspot Revenue');const d=await api('/api/reports/hotspot-revenue');metrics([['Total Hotspot Earnings',fmt(d.summary.earnings),'bi-cash-stack'],['Voucher Users',Number(d.summary.users||0).toLocaleString(),'bi-people'],['Most Popular Profile',d.summary.popular||'—','bi-wifi']]);content.innerHTML='<h2 class="h6 p-3 mb-0">Profile sales breakdown</h2>'+table(['Profile Name','Price / Unit','Quantity Sold','Revenue'],d.profiles.map(r=>[esc(r.profile_name),fmt(r.price),Number(r.quantity),fmt(r.revenue)]))+'<h2 class="h6 p-3 mb-0 border-top">Recent verified payments</h2>'+table(['Phone','Profile','TrxID','Timestamp','Amount'],d.transactions.map(r=>[esc(r.sender_phone||'—'),esc(r.profile||'Hotspot'),esc(r.trx_id||'—'),esc(FazDate.formatDateTime(r.created_at)),fmt(r.amount)]))}
else{filters.innerHTML='<div class="d-flex flex-wrap justify-content-between align-items-center gap-2"><span class="text-secondary small">Track operating costs and monthly net profit.</span><div><button class="btn btn-green me-2" id="add"><i class="bi bi-plus-lg me-1"></i>Add Expense</button><button class="btn btn-outline-secondary" id="csv">Export CSV</button></div></div>';document.getElementById('add').onclick=()=>openExpense();document.getElementById('csv').onclick=()=>exportTable('Expense Sheet');const d=await api('/api/reports/expenses');metrics([['Expense This Month',fmt(d.summary.month_expense),'bi-credit-card'],['Collection This Month',fmt(d.summary.month_collection),'bi-cash-stack'],['Net Profit This Month',fmt(d.summary.net_profit),'bi-graph-down-arrow']]);content.innerHTML=table(['Date','Category','Description','Amount','Added By','Actions'],d.rows.map(r=>[esc(String(r.date).slice(0,10)),esc(r.category),'<b>'+esc(r.title)+'</b><br><small>'+esc(r.notes||'')+'</small>',fmt(r.amount),esc(r.created_by||'admin'),'<div class="btn-group btn-group-sm"><button class="btn btn-outline-secondary" data-edit="'+r.id+'"><i class="bi bi-pencil"></i></button><button class="btn btn-outline-danger" data-delete="'+r.id+'"><i class="bi bi-trash"></i></button></div>']));content.querySelectorAll('[data-edit]').forEach(b=>b.onclick=()=>openExpense(d.rows.find(r=>r.id===Number(b.dataset.edit))));content.querySelectorAll('[data-delete]').forEach(b=>b.onclick=async()=>{if(confirm('Delete this expense record?'))try{await api('/api/reports/expenses/'+b.dataset.delete,{method:'DELETE'});load()}catch(e){alert(e.message)}})}
}catch(e){content.innerHTML='<div class="alert alert-danger m-3">'+esc(e.message)+'</div>'}}
function openExpense(r){const f=document.getElementById('expenseForm');f.reset();document.getElementById('expenseId').value=r?.id||'';document.getElementById('expenseTitle').value=r?.title||'';document.getElementById('expenseCategory').value=r?.category||'Other';document.getElementById('expenseAmount').value=r?.amount||'';document.getElementById('expenseDate').value=r?.date?String(r.date).slice(0,10):new Date().toLocaleDateString('en-CA');document.getElementById('expenseNotes').value=r?.notes||'';document.querySelector('#expenseModal .modal-title').textContent=r?'Edit Expense':'Add Expense';bootstrap.Modal.getOrCreateInstance(document.getElementById('expenseModal')).show()}
document.getElementById('expenseForm').addEventListener('submit',async e=>{e.preventDefault();const id=document.getElementById('expenseId').value,body={title:document.getElementById('expenseTitle').value,category:document.getElementById('expenseCategory').value,amount:document.getElementById('expenseAmount').value,date:document.getElementById('expenseDate').value,notes:document.getElementById('expenseNotes').value};try{await api('/api/reports/expenses'+(id?'/'+id:''),{method:id?'PUT':'POST',body:JSON.stringify(body)});bootstrap.Modal.getInstance(document.getElementById('expenseModal')).hide();load()}catch(e){alert(e.message)}});if(kind==='collection')collectionFilters();load().then(()=>{if(routeKind==='add')openExpense()});
</script></body></html>