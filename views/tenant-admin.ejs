<!doctype html>
<html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Tenant Workspace · FAZ NETWORK</title><link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet"><style>body{background:#f4f7f6;color:#15332b;font-family:system-ui,sans-serif}.shell{max-width:1180px;margin:auto;padding:24px}.card{border:1px solid #dbe7e2;border-radius:16px}.muted{color:#64748b}.secret{font-family:ui-monospace,monospace}</style></head>
<body><div class="shell"><header class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4"><div><div class="text-success fw-bold">FAZ NETWORK · TENANT WORKSPACE</div><h1 class="h3 fw-bold mb-1"><%= tenant.name %></h1><div class="muted">Tenant Number: <strong><%= tenant.id %></strong> · Hardware belongs to this tenant only.</div></div><form method="post" action="/tenant/logout"><button class="btn btn-outline-secondary">Sign out</button></form></header>
<div id="status" class="alert d-none" role="status"></div>
<div class="row g-4"><div class="col-lg-6"><section class="card p-4 h-100"><h2 class="h5 fw-bold">Add MikroTik Router</h2><p class="muted small">Credentials are encrypted before storage. RouterOS operations are not run by this form.</p><form id="routerForm"><label class="form-label">Router name</label><input class="form-control mb-2" name="router_name" required maxlength="120"><label class="form-label">Host / IP</label><input class="form-control mb-2" name="host" required maxlength="253"><label class="form-label">API port</label><input class="form-control mb-2" name="api_port" type="number" min="1" max="65535" value="8728" required><label class="form-label">API username</label><input class="form-control mb-2" name="username" required maxlength="160"><label class="form-label">API password</label><input class="form-control mb-3" name="password" type="password" required autocomplete="new-password"><button class="btn btn-success">Save Router</button></form></section></div>
<div class="col-lg-6"><section class="card p-4 h-100"><h2 class="h5 fw-bold">Add OLT</h2><p class="muted small">SNMP community and password are encrypted at rest.</p><form id="oltForm"><label class="form-label">OLT name</label><input class="form-control mb-2" name="olt_name" required maxlength="120"><label class="form-label">OLT type / vendor</label><input class="form-control mb-2" name="olt_type" required maxlength="80" placeholder="e.g. V-SOL"><label class="form-label">IP / hostname</label><input class="form-control mb-2" name="ip_address" required maxlength="253"><label class="form-label">SNMP community (optional)</label><input class="form-control mb-2" name="snmp_community" autocomplete="off"><label class="form-label">Username (optional)</label><input class="form-control mb-2" name="username"><label class="form-label">Password (optional)</label><input class="form-control mb-3" name="password" type="password" autocomplete="new-password"><button class="btn btn-success">Save OLT</button></form></section></div></div>
<section class="card p-4 mt-4"><div class="d-flex justify-content-between align-items-center"><h2 class="h5 fw-bold mb-0">My Routers</h2><button id="refresh" class="btn btn-sm btn-outline-secondary">Refresh</button></div><div id="routers" class="mt-3 muted">Loading…</div></section>
<section class="card p-4 mt-4"><h2 class="h5 fw-bold">My OLTs</h2><div id="olts" class="mt-3 muted">Loading…</div></section>
<p class="muted small mt-4">This tenant workspace only lists hardware owned by tenant <%= tenant.id %>. Hotspot/voucher/queue operations remain disabled here until their operational APIs are fully tenant-scoped.</p></div>
<script>
const statusEl=document.getElementById('status');
function showStatus(text,bad=false){statusEl.textContent=text;statusEl.className='alert '+(bad?'alert-danger':'alert-success');}
async function api(url,opts={}){const r=await fetch(url,{credentials:'same-origin',headers:{'Content-Type':'application/json','Accept':'application/json'},cache:'no-store',...opts});const d=await r.json().catch(()=>({message:'Invalid server response'}));if(!r.ok||d.success===false)throw new Error(d.message||'Request failed');return d;}
function esc(v){return String(v??'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));}
async function refresh(){const d=await api('/api/tenant/hardware');document.getElementById('routers').innerHTML=d.routers.length?'<div class="table-responsive"><table class="table"><thead><tr><th>Name</th><th>Host</th><th>Port</th><th>Username</th><th>Status</th><th></th></tr></thead><tbody>'+d.routers.map(x=>'<tr><td>'+esc(x.router_name)+'</td><td>'+esc(x.host)+'</td><td>'+esc(x.api_port)+'</td><td>'+esc(x.username)+'</td><td>'+(x.is_active?'Active':'Inactive')+'</td><td><button class="btn btn-sm btn-outline-danger" data-del-router="'+x.id+'">Delete</button></td></tr>').join('')+'</tbody></table></div>':'No routers configured yet.';document.getElementById('olts').innerHTML=d.olts.length?'<div class="table-responsive"><table class="table"><thead><tr><th>Name</th><th>Type</th><th>IP</th><th>Credentials</th><th></th></tr></thead><tbody>'+d.olts.map(x=>'<tr><td>'+esc(x.olt_name)+'</td><td>'+esc(x.olt_type)+'</td><td>'+esc(x.ip_address)+'</td><td>SNMP: '+(x.snmp_configured?'configured':'—')+' · Password: '+(x.password_configured?'configured':'—')+'</td><td><button class="btn btn-sm btn-outline-danger" data-del-olt="'+x.id+'">Delete</button></td></tr>').join('')+'</tbody></table></div>':'No OLTs configured yet.';}
function formBody(form){return Object.fromEntries(new FormData(form).entries());}
document.getElementById('routerForm').addEventListener('submit',async e=>{e.preventDefault();try{await api('/api/tenant/hardware/routers',{method:'POST',body:JSON.stringify(formBody(e.target))});e.target.reset();e.target.elements.api_port.value='8728';showStatus('Router saved to this tenant.');await refresh();}catch(err){showStatus(err.message,true);}});
document.getElementById('oltForm').addEventListener('submit',async e=>{e.preventDefault();try{await api('/api/tenant/hardware/olts',{method:'POST',body:JSON.stringify(formBody(e.target))});e.target.reset();showStatus('OLT saved to this tenant.');await refresh();}catch(err){showStatus(err.message,true);}});
document.addEventListener('click',async e=>{const r=e.target.closest('[data-del-router]'),o=e.target.closest('[data-del-olt]');if(!r&&!o)return;if(!confirm('Delete this hardware record from your tenant?'))return;try{await api('/api/tenant/hardware/'+(r?'routers/':'olts/')+(r?r.dataset.delRouter:o.dataset.delOlt),{method:'DELETE'});showStatus('Hardware record deleted.');await refresh();}catch(err){showStatus(err.message,true);}});
document.getElementById('refresh').addEventListener('click',()=>refresh().catch(e=>showStatus(e.message,true)));
refresh().catch(e=>showStatus(e.message,true));
</script></body></html>