<!doctype html>
<% const brand=typeof brandSettings!=="undefined"&&brandSettings?brandSettings:{}; const brandName=String(brand.company_name||"FAZ NETWORK"); const brandCopyright=String(brand.footer_copyright||"© {year} {company_name}. All Rights Reserved.").replace(/\{year\}/g,String(new Date().getFullYear())).replace(/\{company_name\}/g,brandName); %>
<html lang="en">
<head>
<meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1">
<meta name="theme-color" content="#062f2a">
<title>Customer Self-Care | <%= brandName %></title><% if(brand.favicon_url){ %><link rel="icon" href="<%= brand.favicon_url %>"><% } %>
<link rel="preconnect" href="https://fonts.googleapis.com"><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
<script src="https://cdn.tailwindcss.com"></script>
<style>
:root{font-family:"Plus Jakarta Sans",Inter,system-ui,sans-serif;color:#122a2b;background:#f6f9f8;font-synthesis:none;text-rendering:optimizeLegibility}
*{box-sizing:border-box}body{margin:0;min-height:100vh;font-family:"Plus Jakarta Sans",Inter,system-ui,sans-serif;background:radial-gradient(ellipse at 7% 2%,rgba(16,185,129,.11),transparent 31%),radial-gradient(ellipse at 95% 15%,rgba(13,148,136,.09),transparent 27%),linear-gradient(145deg,#f8fafc 0%,#f2f7f5 55%,#f8fafc 100%)}
button,input{font:inherit}button{transition:transform .2s ease,box-shadow .2s ease,background-color .2s ease,border-color .2s ease}button:focus-visible,input:focus-visible{outline:3px solid rgba(16,185,129,.24);outline-offset:2px}
.glass{background:rgba(255,255,255,.82);border:1px solid rgba(226,232,240,.85);box-shadow:0 12px 38px rgba(15,45,42,.045);backdrop-filter:blur(16px)}
.hero{position:relative;overflow:hidden;background:linear-gradient(118deg,#062f2a 0%,#0b4940 54%,#087f68 100%);box-shadow:0 24px 60px rgba(6,47,42,.2)}
.hero:before{content:"";position:absolute;width:390px;height:390px;border:1px solid rgba(167,243,208,.16);border-radius:50%;right:-125px;top:-225px;box-shadow:0 0 0 34px rgba(167,243,208,.035),0 0 0 75px rgba(167,243,208,.025)}
.hero:after{content:"";position:absolute;width:230px;height:230px;border-radius:50%;right:8%;bottom:-190px;background:rgba(52,211,153,.18);filter:blur(2px)}
.metric{transition:transform .22s ease,box-shadow .22s ease,border-color .22s ease}.metric:hover{transform:translateY(-2px);box-shadow:0 14px 35px rgba(15,45,42,.075);border-color:#cbded7}
.pulse{position:relative}.pulse:after{content:"";position:absolute;inset:-5px;border:1px solid currentColor;opacity:.35;border-radius:999px;animation:pulse 2.2s ease-out infinite}@keyframes pulse{0%{transform:scale(.82);opacity:.4}100%{transform:scale(1.32);opacity:0}}
.meter-track{height:6px;background:#e7efec;border-radius:99px;overflow:hidden}.meter-fill{height:100%;border-radius:99px;background:linear-gradient(90deg,#10b981,#0f766e);transition:width .5s ease}
.field{transition:border-color .2s ease,box-shadow .2s ease;background:#fbfdfc}.field:focus{border-color:#10b981;box-shadow:0 0 0 4px rgba(16,185,129,.12);outline:none}
.pay-cta{background:linear-gradient(110deg,#047857,#059669 55%,#0f766e);box-shadow:0 9px 20px rgba(5,150,105,.2)}.pay-cta:hover:not(:disabled){transform:translateY(-1px);box-shadow:0 13px 25px rgba(5,150,105,.28)}.pay-cta:disabled{opacity:.68;cursor:wait}
.spinner{width:16px;height:16px;border:2px solid rgba(255,255,255,.42);border-top-color:white;border-radius:50%;animation:spin .7s linear infinite}@keyframes spin{to{transform:rotate(360deg)}}
.copy-btn{border:1px solid #dce9e4;background:#fff;color:#0f766e}.copy-btn:hover{background:#ecfdf5;border-color:#a7f3d0}
@media(prefers-reduced-motion:reduce){*,*:before,*:after{animation-duration:.01ms!important;animation-iteration-count:1!important;scroll-behavior:auto!important;transition-duration:.01ms!important}}
</style>
<script src="/js/date-format.js"></script>
</head>
<body class="min-h-screen text-slate-800">
<header class="sticky top-0 z-30 border-b border-white/70 bg-white/75 backdrop-blur-xl">
 <div class="mx-auto flex max-w-7xl items-center justify-between px-4 py-3.5 sm:px-6 lg:px-8">
  <a href="/" class="group flex items-center gap-3" aria-label="<%= brandName %> home"><span class="flex h-10 w-10 items-center justify-center rounded-2xl bg-gradient-to-br from-emerald-600 to-teal-800 text-white shadow-lg shadow-emerald-900/15"><% if(brand.logo_url){ %><img src="<%= brand.logo_url %>" alt="" class="h-8 max-w-9 object-contain"><% } else { %><svg viewBox="0 0 24 24" fill="none" class="h-6 w-6" aria-hidden="true"><path d="M4 9.5a12 12 0 0 1 16 0M7 13a7.5 7.5 0 0 1 10 0m-7 3.5a3 3 0 0 1 4 0M12 20h.01" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg><% } %></span><span><span class="block text-[15px] font-extrabold tracking-tight text-slate-900"><%= brandName %></span><span class="block text-[10px] font-bold uppercase tracking-[.2em] text-slate-400">Subscriber services</span></span></a>
  <div class="flex items-center gap-2 sm:gap-3"><span class="hidden items-center gap-2 rounded-full border border-emerald-100 bg-emerald-50 px-3 py-2 text-xs font-bold text-emerald-800 sm:inline-flex"><span class="h-1.5 w-1.5 rounded-full bg-emerald-500"></span>Secure customer portal</span><span id="customerLabel" class="hidden max-w-36 truncate text-sm font-bold text-slate-600 md:inline"></span><button id="logoutBtn" class="rounded-xl border border-slate-200 bg-white px-3.5 py-2.5 text-xs font-bold text-slate-600 hover:border-slate-300 hover:bg-slate-50 sm:px-4 sm:text-sm">Sign out <span aria-hidden="true">↗</span></button></div>
 </div>
</header>
<main class="mx-auto max-w-7xl px-4 pb-12 pt-7 sm:px-6 sm:pt-10 lg:px-8">
 <div class="mb-6 flex flex-col justify-between gap-3 sm:mb-8 sm:flex-row sm:items-end"><div><p class="text-[11px] font-extrabold uppercase tracking-[.24em] text-emerald-700">Your private dashboard</p><h1 class="mt-2 text-3xl font-extrabold tracking-[-.045em] text-slate-900 sm:text-[2.55rem]">Your Internet Account<span class="text-emerald-600">.</span></h1><p class="mt-2 max-w-xl text-sm leading-6 text-slate-500 sm:text-[15px]">Everything about your connection, usage and billing — in one place.</p></div><div class="flex items-center gap-2 text-xs font-semibold text-slate-400"><svg class="h-4 w-4 text-emerald-600" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M12 3 5 6v5c0 4.5 3 7.5 7 10 4-2.5 7-5.5 7-10V6l-7-3Z" stroke="currentColor" stroke-width="1.7"/><path d="m9 12 2 2 4-4" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/></svg>Private &amp; secure account access</div></div>
 <div id="loading" class="glass rounded-3xl p-8 sm:p-12"><div class="mx-auto flex max-w-sm flex-col items-center text-center"><span class="mb-4 flex h-14 w-14 items-center justify-center rounded-2xl bg-emerald-50 text-emerald-700"><span class="spinner" style="border-color:#a7f3d0;border-top-color:#047857;width:25px;height:25px"></span></span><p class="font-bold text-slate-800">Preparing your dashboard</p><p class="mt-1 text-sm text-slate-500">Securely retrieving your subscriber details…</p></div></div>
 <div id="errorBox" role="alert" class="hidden rounded-2xl border border-rose-200 bg-rose-50 p-5 font-semibold text-rose-700"></div>
<script>
/* Independent safety net: still releases the loading screen if the dashboard's main script fails before its own timeout handler starts. */
(function(){
  window.setTimeout(function(){
    var loading=document.getElementById("loading");
    var dashboard=document.getElementById("dashboard");
    var errorBox=document.getElementById("errorBox");
    if(!loading||!dashboard||!errorBox||loading.classList.contains("hidden")||!dashboard.classList.contains("hidden"))return;
    loading.classList.add("hidden");
    errorBox.classList.remove("hidden");
    errorBox.textContent="Dashboard scripts or account request did not finish. Please reload the page. If this repeats, contact FAZ NETWORK support.";
    var retry=document.getElementById("dashboardEmergencyRetry");
    if(!retry){
      retry=document.createElement("button");
      retry.id="dashboardEmergencyRetry";
      retry.type="button";
      retry.className="mt-4 rounded-xl bg-emerald-700 px-4 py-2 text-sm font-bold text-white";
      retry.textContent="Reload dashboard";
      retry.addEventListener("click",function(){window.location.reload();});
      errorBox.appendChild(document.createElement("br"));
      errorBox.appendChild(retry);
    }
  },15000);
})();
</script>
 <div id="dashboard" class="hidden space-y-5 sm:space-y-6"></div>
 <footer class="mt-8 flex flex-col gap-3 border-t border-slate-200/80 pt-5 text-xs text-slate-400 sm:flex-row sm:items-center sm:justify-between"><span><span><%= brandCopyright %></span></span><span class="flex items-center gap-2"><span class="h-1.5 w-1.5 rounded-full bg-emerald-500"></span>Need help? <a class="font-extrabold text-emerald-800 hover:text-emerald-600" href="tel:<%= brand.support_phone||"01339932887" %>"><%= brand.support_phone||"01339932887" %></a><% if(brand.whatsapp_number){ %><span class="text-slate-300">·</span><a class="font-extrabold text-emerald-800 hover:text-emerald-600" href="https://wa.me/<%= brand.whatsapp_number %>" target="_blank" rel="noopener">WhatsApp</a><% } %><span class="text-slate-300">·</span>Never share your password or payment OTP.</span></footer>
</main>
<script>
(()=>{
 const $=id=>document.getElementById(id);
 const esc=v=>String(v??"—").replace(/[&<>"']/g,c=>({"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;","'":"&#39;"}[c]));
 const money=v=>"৳"+Number(v||0).toLocaleString("en-BD",{maximumFractionDigits:2});
 const paymentAccountList=c=>{
   const a=c?.paymentAccounts||{},items=[["bKash","bkash"],["Nagad","nagad"],["Rocket","rocket"],["Upay","upay"]].filter(([label,key])=>String(a[key]||"").trim());
   if(!items.length)return '<p class="mt-3 text-xs text-slate-500">Please contact FAZ NETWORK support for current payment account details.</p>';
   return '<div class="mt-3 grid grid-cols-2 gap-2">'+items.map(([label,key])=>'<div class="rounded-xl border border-slate-200 bg-slate-50 px-3 py-2"><p class="text-[10px] font-extrabold text-slate-500">'+label+' · Send Money</p><p class="mt-1 break-all text-sm font-extrabold text-slate-800">'+esc(a[key])+'</p><button type="button" class="mt-1 text-[10px] font-extrabold text-emerald-700" data-copy-account="'+esc(a[key])+'">Copy number</button></div>').join('')+'</div>';
 };

 const date=v=>v?FazDate.formatDate(v):"—";
 const bytes=v=>{const n=Math.max(0,Number(v)||0);if(n<1024)return n+" B";const units=["KB","MB","GB","TB"];let x=n/1024,i=-1;do{x/=i<0?1:1024;i++;}while(x>=1024&&i<3);return x.toFixed(2)+" "+units[i];};
 const icon=(name,cls="h-5 w-5")=>{const paths={user:'<circle cx="12" cy="8" r="3.5"/><path d="M5 20a7 7 0 0 1 14 0"/>',wifi:'<path d="M3 8a14 14 0 0 1 18 0M6.5 12a8.5 8.5 0 0 1 11 0M10 15.5a3 3 0 0 1 4 0"/><path d="M12 20h.01"/>',calendar:'<rect x="3" y="5" width="18" height="16" rx="2"/><path d="M16 3v4M8 3v4M3 10h18"/>',shield:'<path d="M12 3 5 6v5c0 4.5 3 7.5 7 10 4-2.5 7-5.5 7-10V6l-7-3Z"/><path d="m9 12 2 2 4-4"/>',down:'<path d="M12 4v15m-6-6 6 6 6-6"/>',up:'<path d="M12 20V5m-6 6 6-6 6 6"/>',copy:'<rect x="8" y="8" width="12" height="12" rx="2"/><path d="M16 8V5a2 2 0 0 0-2-2H5a2 2 0 0 0-2 2v9a2 2 0 0 0 2 2h3"/>',check:'<path d="m5 12 4 4L19 6"/>',clock:'<circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/>',bolt:'<path d="m13 2-9 12h7l-1 8 10-13h-7l0-7Z"/>',receipt:'<path d="M5 3h14v18l-3-2-4 2-4-2-3 2V3Z"/><path d="M8 8h8M8 12h8M8 16h4"/>',arrow:'<path d="M5 12h14m-6-6 6 6-6 6"/>',phone:'<rect x="6" y="2" width="12" height="20" rx="2"/><path d="M11 18h2"/>',database:'<ellipse cx="12" cy="5" rx="8" ry="3"/><path d="M4 5v14c0 1.7 3.6 3 8 3s8-1.3 8-3V5M4 12c0 1.7 3.6 3 8 3s8-1.3 8-3"/>',spark:'<path d="m12 3 1.9 5.8L20 11l-6.1 2.2L12 19l-1.9-5.8L4 11l6.1-2.2L12 3Z"/>',refresh:'<path d="M20 7v5h-5M4 17v-5h5"/><path d="M5.5 9A7 7 0 0 1 17 5l3 2M4 17l3 2a7 7 0 0 0 11.5-4"/>',wallet:'<rect x="3" y="5" width="18" height="15" rx="2"/><path d="M3 9h18m-5 5h2"/>',clock2:'<circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/>'};return '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" class="'+cls+'" aria-hidden="true">'+(paths[name]||paths.spark)+'</svg>';};
 const card=(label,value,sub="",symbol="spark")=>'<div class="metric rounded-2xl border border-slate-200/80 bg-white/85 p-4 sm:p-5"><div class="flex items-center justify-between gap-2"><span class="text-[10px] font-extrabold uppercase tracking-[.16em] text-slate-400 sm:text-[11px]">'+esc(label)+'</span><span class="flex h-9 w-9 items-center justify-center rounded-xl bg-emerald-50 text-emerald-700">'+icon(symbol,'h-4 w-4')+'</span></div><p class="mt-3 break-words text-lg font-extrabold tracking-tight text-slate-900 sm:text-xl">'+esc(value)+'</p>'+(sub?'<p class="mt-1.5 text-xs leading-5 text-slate-500">'+esc(sub)+'</p>':'')+'</div>';
 const pill=(text,kind)=>'<span class="inline-flex items-center gap-1.5 rounded-full px-3 py-1.5 text-[11px] font-extrabold '+(kind==="good"?"bg-emerald-100 text-emerald-800":kind==="bad"?"bg-rose-100 text-rose-700":"bg-amber-100 text-amber-800")+'"><span class="h-1.5 w-1.5 rounded-full '+(kind==="good"?"bg-emerald-500":kind==="bad"?"bg-rose-500":"bg-amber-500")+'"></span>'+esc(text)+'</span>';
 const initials=name=>String(name||"F").trim().split(/\s+/).slice(0,2).map(x=>x[0]||"").join("").toUpperCase()||"F";
 async function load(){
  const controller=new AbortController();
  const timeout=setTimeout(()=>controller.abort(),12000);
  $("loading").classList.remove("hidden");
  $("errorBox").classList.add("hidden");
  $("dashboard").classList.add("hidden");
  try{
   const r=await fetch("/api/customer/profile",{headers:{Accept:"application/json"},credentials:"same-origin",signal:controller.signal});
   let d={};try{d=await r.json();}catch(_){throw new Error("The server returned an invalid response. Please retry.");}
   if(r.status===401){location.href="/?customerLogin=1";return;}
   if(!r.ok||!d.success)throw new Error(d.message||"Unable to load your account.");
   const c=d.customer||{},hotspot=c.type==="hotspot",name=c.name||c.username||"Subscriber";
   $("customerLabel").textContent=name;if($("year"))$("year").textContent=new Date().getFullYear();
   const isExpired=(c.expiryDate?Number(c.remainingDays)<0:String(c.status||"").toLowerCase()==="expired"),isActive=!isExpired&&(["active","online"].includes(String(c.status||"").toLowerCase())||(c.remainingDays!==null&&c.remainingDays!==undefined&&Number(c.remainingDays)>=0)),statusKind=isExpired?"bad":isActive?"good":"warn";
   let html='<section class="hero rounded-[1.75rem] p-5 text-white sm:rounded-[2rem] sm:p-8 lg:p-9"><div class="relative z-10 flex flex-col justify-between gap-7 lg:flex-row lg:items-center"><div class="flex min-w-0 items-start gap-4 sm:gap-5"><div class="relative shrink-0"><div class="flex h-[58px] w-[58px] items-center justify-center rounded-[1.3rem] border border-white/20 bg-white/10 text-lg font-extrabold tracking-wide text-white shadow-inner sm:h-[72px] sm:w-[72px] sm:rounded-[1.6rem] sm:text-xl">'+esc(initials(name))+'</div><span class="pulse absolute bottom-0 right-0 h-3.5 w-3.5 rounded-full border-2 border-[#0b4940] '+(statusKind==="good"?"bg-emerald-300 text-emerald-300":statusKind==="bad"?"bg-rose-300 text-rose-300":"bg-amber-300 text-amber-300")+'"></span></div><div class="min-w-0 flex-1"><p class="text-[10px] font-extrabold uppercase tracking-[.22em] text-emerald-200 sm:text-xs">Welcome back</p><h2 class="mt-1.5 break-words text-2xl font-extrabold tracking-[-.04em] sm:text-3xl">'+esc(name)+'</h2><p class="mt-1.5 flex flex-wrap items-center gap-x-2 gap-y-1 text-xs text-emerald-50/75 sm:text-sm"><span>'+icon("phone","inline-block h-3.5 w-3.5 align-[-2px]")+'</span>'+esc(c.phone||c.username||"Registered subscriber")+'<span class="text-white/30">·</span><span class="font-semibold text-white/85">'+esc(c.username||"")+'</span></p><div class="mt-4 flex flex-wrap items-center gap-2">'+pill(c.status||"Status unavailable",statusKind)+'<span class="inline-flex items-center gap-1.5 rounded-full border border-white/15 bg-white/10 px-3 py-1.5 text-[11px] font-bold text-white/90">'+icon(hotspot?"wifi":"bolt","h-3.5 w-3.5")+(hotspot?"Hotspot subscriber":"PPPoE subscriber")+'</span></div></div></div><div class="relative z-10 rounded-2xl border border-white/15 bg-black/10 p-4 backdrop-blur-sm sm:min-w-[260px] sm:p-5"><p class="text-[10px] font-extrabold uppercase tracking-[.18em] text-emerald-100/75">'+(hotspot?"ACTIVE HOTSPOT PROFILE":"YOUR CURRENT PLAN")+'</p><p class="mt-2 flex items-center gap-2 text-lg font-extrabold tracking-tight sm:text-xl">'+icon(hotspot?"wifi":"bolt","h-5 w-5 text-emerald-200")+'<span class="break-words">'+esc(hotspot?(c.profile||"Hotspot"): (c.planName||c.profile||"Internet plan"))+'</span></p><p class="mt-1 text-xs font-semibold text-emerald-100/80">'+(hotspot?esc(c.limitUptime||"Validity from profile"):esc([c.rateLimit,c.packageDurationMonths>0?(c.packageDurationMonths+" month"+(c.packageDurationMonths===1?"":"s")):""].filter(Boolean).join(" · ")||"Package details unavailable"))+'</p><div class="mt-4 flex items-end justify-between gap-4 border-t border-white/15 pt-3"><div><p class="text-[10px] font-bold text-white/60">'+(hotspot?"PACKAGE PRICE":"MONTHLY FEE")+'</p><p class="mt-1 text-2xl font-extrabold tracking-tight">'+money(hotspot?c.price:c.monthlyFee)+'<span class="ml-1 text-xs font-semibold text-white/60">'+(hotspot?"":" / mo")+'</span></p></div><span class="mb-1 rounded-lg bg-emerald-300/15 px-2.5 py-1.5 text-[10px] font-extrabold uppercase tracking-wider text-emerald-100">'+(isExpired?"Renewal due":"FAZ connected")+'</span></div></div></div><div class="relative z-10 mt-7 flex flex-wrap items-center justify-between gap-2 border-t border-white/15 pt-4 text-[11px] font-semibold text-emerald-50/70"><span class="flex items-center gap-2">'+icon("shield","h-4 w-4 text-emerald-200")+'Your subscriber details are private</span>' + (!hotspot && /^[A-Za-z0-9_-]{1,64}$/.test(String(c.username||"")) ? '<a href="https://t.me/faznetwork_Alerts_bot?start='+encodeURIComponent(String(c.username))+'" target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-2 rounded-xl border border-white/20 bg-white/10 px-3 py-2 text-xs font-extrabold text-white hover:bg-white/20">'+icon("send","h-4 w-4")+'Connect Telegram alerts</a>' : '') + '<span><%= brandName %> · Self-care</span></div></section>';
   if(!hotspot){
