<!doctype html>
<html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Sign In · FAZ NETWORK</title><link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet"><style>body{min-height:100vh;background:linear-gradient(135deg,#062e25,#0b7051);display:grid;place-items:center;padding:18px;font-family:system-ui,sans-serif}.panel{width:min(100%,460px);background:#fff;border-radius:22px;padding:30px;box-shadow:0 25px 70px #001c153d}.brand{color:#087f5b;font-weight:900;letter-spacing:-.04em}.form-control{min-height:46px}.hint{color:#64748b;font-size:.85rem}</style></head><body><main class="panel"><div class="brand fs-3">FAZ NETWORK</div><h1 class="h4 fw-bold mt-3">Sign in to your ISP workspace</h1><p class="hint mb-4">Use your username or email and password. No tenant number required.</p><% if(error){ %><div class="alert alert-danger"><%= error %></div><% } %><form method="post" action="/login" autocomplete="on"><div class="mb-3"><label class="form-label fw-semibold" for="username">Username or Email</label><input class="form-control" id="username" name="username" autocomplete="username" required maxlength="254"></div><div class="mb-4"><label class="form-label fw-semibold" for="password">Password</label><input class="form-control" id="password" name="password" type="password" autocomplete="current-password" required></div><button class="btn btn-success w-100 py-3 fw-bold" type="submit">Sign in</button></form><p class="hint mt-4 mb-0">Platform Owner access remains available through the admin account.</p></main></body></html>
