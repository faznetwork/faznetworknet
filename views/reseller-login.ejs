<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <meta name="robots" content="noindex,nofollow">
  <title><%= title %></title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=Outfit:wght@500;600;700;800&display=swap" rel="stylesheet">
  <style>
    *{box-sizing:border-box}body{margin:0;min-height:100vh;display:grid;place-items:center;padding:24px;background:#f1f5f9;font-family:Inter,Arial,sans-serif;color:#0f172a}
    main{width:min(100%,420px);padding:32px;background:#fff;border:1px solid #e2e8f0;border-radius:18px;box-shadow:0 18px 50px #0f172a12}
    h1{margin:0;color:#0a3d2e;font-family:Outfit,Inter,sans-serif;font-weight:700;font-size:25px}p{color:#64748b;line-height:1.6}
    label{display:block;margin:18px 0 7px;font-weight:600;font-size:14px}input{width:100%;padding:12px 14px;border:1px solid #cbd5e1;border-radius:9px;font:inherit}
    button{width:100%;margin-top:22px;padding:13px;border:0;border-radius:9px;background:#0a3d2e;color:#fff;font-weight:700;cursor:pointer}
    button:disabled{opacity:.6;cursor:wait}.message{margin-top:16px;padding:12px;border-radius:8px;background:#f1f5f9;color:#334155}.message.error{background:#fff1f2;color:#9f1239}
  </style>
</head>
<body>
  <main>
    <h1>FAZ NETWORK</h1>
    <p>Reseller portal sign in</p>
    <form id="loginForm">
      <label for="email">Email or legacy username</label>
      <input id="email" name="email" type="text" autocomplete="username" required>
      <label for="password">Password</label>
      <input id="password" name="password" type="password" autocomplete="current-password" required>
      <button id="submitButton" type="submit">Sign in</button>
    </form>
    <div id="message" class="message" role="status" aria-live="polite" hidden></div>
  </main>
  <script>
    const form=document.getElementById('loginForm');
    form.addEventListener('submit',async event=>{
      event.preventDefault();
      const button=document.getElementById('submitButton');
      const message=document.getElementById('message');
      button.disabled=true;message.hidden=false;message.className='message';message.textContent='Signing in…';
      try{
        const response=await fetch('/api/resellers/login',{
          method:'POST',headers:{'Content-Type':'application/json'},
          body:JSON.stringify(Object.fromEntries(new FormData(form).entries()))
        });
        const result=await response.json();
        if(!response.ok||!result.success)throw new Error(result.message||'Sign in failed.');
        window.location.assign(result.redirect||'/reseller/dashboard');
      }catch(error){
        message.className='message error';message.textContent=error.message;button.disabled=false;
      }
    });
  </script>
</body>
</html>
