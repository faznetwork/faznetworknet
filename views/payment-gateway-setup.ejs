<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1">
<meta name="theme-color" content="#f4f6f9"><title>Payment Gateways &amp; MFS Setup · FAZ NETWORK</title>
<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
<link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet">
<style>
:root{--page:#f4f6f9;--ink:#172033;--muted:#64748b;--line:#e2e8f0;--blue:#1769aa}
body{background:var(--page);color:var(--ink);font:14px Inter,system-ui,-apple-system,"Segoe UI",sans-serif}.page{max-width:1100px;margin:auto;padding:28px 18px 48px}.card{border:1px solid var(--line);border-radius:16px;box-shadow:0 6px 22px rgba(15,23,42,.04)}.card-header{border-bottom:1px solid var(--line);border-radius:16px 16px 0 0!important}.form-control,.form-select{min-height:43px;border-color:#cfd8e3}.form-control:focus,.form-select:focus{border-color:#70a8d6;box-shadow:0 0 0 3px #1769aa18}.provider{height:100%;border:1px solid var(--line);border-radius:13px;padding:17px;background:#fff}.provider h3{font-size:15px;font-weight:800}.brand-bkash{color:#e2136e}.brand-nagad{color:#e43b2f}.brand-rocket{color:#832b73}.brand-upay{color:#0054a6}.status{min-height:20px}.small-label{font-size:11px;font-weight:800;letter-spacing:.08em;color:var(--muted)}@media(max-width:576px){.page{padding:18px 12px 32px}.header-actions{width:100%}.header-actions button{width:100%}}
</style></head>
<body>
<main class="page">
  <div class="d-flex flex-wrap justify-content-between align-items-start gap-3 mb-4">
    <div><a href="/admin" class="text-decoration-none text-secondary small"><i class="bi bi-arrow-left me-1"></i>Admin dashboard</a>
      <div class="small-label mt-3">BILLING &amp; PAYMENTS / CONFIGURATION</div>
      <h1 class="h3 fw-bold mt-1 mb-2">Payment Gateways &amp; MFS Setup</h1>
      <p class="text-secondary mb-0">Manage receiving accounts and hosted online checkout credentials.</p>
    </div>
    <div class="header-actions"><button class="btn btn-primary px-4" id="save-top" type="button"><i class="bi bi-check2-circle me-1"></i>Save Configuration</button></div>
  </div>
  <div id="feedback" class="alert d-none" role="status" aria-live="polite"></div>
  <div class="alert alert-info border-0 d-flex gap-2 align-items-start"><i class="bi bi-shield-lock fs-5"></i><div><strong>Secure configuration</strong><div class="small mt-1">Secrets are encrypted before storage and never returned to the browser. Leave the secret field blank to keep the saved credential.</div></div></div>
  <section class="card mb-4">
    <div class="card-header bg-white p-4"><h2 class="h5 fw-bold mb-1">Direct MFS Accounts</h2><p class="text-secondary small mb-0">Receiving numbers for direct transfers. Enable only accounts that are ready to receive payments.</p></div>
    <div class="card-body p-4"><div class="row g-3">
      <div class="col-12 col-md-6"><div class="provider"><div class="d-flex justify-content-between align-items-center mb-3"><h3 class="brand-bkash mb-0">bKash</h3><div class="form-check form-switch"><input class="form-check-input" type="checkbox" id="bkash-enabled"><label class="form-check-label small" for="bkash-enabled">Enabled</label></div></div><label class="form-label" for="bkash-number">Receiving number</label><input class="form-control" id="bkash-number" inputmode="tel" autocomplete="off" placeholder="01XXXXXXXXX"></div></div>
      <div class="col-12 col-md-6"><div class="provider"><div class="d-flex justify-content-between align-items-center mb-3"><h3 class="brand-nagad mb-0">Nagad</h3><div class="form-check form-switch"><input class="form-check-input" type="checkbox" id="nagad-enabled"><label class="form-check-label small" for="nagad-enabled">Enabled</label></div></div><label class="form-label" for="nagad-number">Receiving number</label><input class="form-control" id="nagad-number" inputmode="tel" autocomplete="off" placeholder="01XXXXXXXXX"></div></div>
      <div class="col-12 col-md-6"><div class="provider"><div class="d-flex justify-content-between align-items-center mb-3"><h3 class="brand-rocket mb-0">Rocket</h3><div class="form-check form-switch"><input class="form-check-input" type="checkbox" id="rocket-enabled"><label class="form-check-label small" for="rocket-enabled">Enabled</label></div></div><label class="form-label" for="rocket-number">Receiving number</label><input class="form-control" id="rocket-number" inputmode="tel" autocomplete="off" placeholder="01XXXXXXXXX"></div></div>
      <div class="col-12 col-md-6"><div class="provider"><div class="d-flex justify-content-between align-items-center mb-3"><h3 class="brand-upay mb-0">Upay</h3><div class="form-check form-switch"><input class="form-check-input" type="checkbox" id="upay-enabled"><label class="form-check-label small" for="upay-enabled">Enabled</label></div></div><label class="form-label" for="upay-number">Receiving number</label><input class="form-control" id="upay-number" inputmode="tel" autocomplete="off" placeholder="01XXXXXXXXX"></div></div>
    </div></div>
  </section>
  <section class="card mb-4">
    <div class="card-header bg-white p-4"><h2 class="h5 fw-bold mb-1">Online Payment Gateway</h2><p class="text-secondary small mb-0">Hosted checkout configuration for SSLCommerz.</p></div>
    <div class="card-body p-4">
      <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4"><div><h3 class="h6 fw-bold mb-1">SSLCommerz</h3><span class="text-secondary small">Store credentials for server-side checkout integration.</span></div><div class="form-check form-switch"><input class="form-check-input" type="checkbox" id="ssl-enabled"><label class="form-check-label" for="ssl-enabled">Enabled</label></div></div>
      <div class="row g-3">
        <div class="col-12 col-lg-6"><label class="form-label" for="ssl-store-id">Store ID</label><input id="ssl-store-id" class="form-control" autocomplete="off" placeholder="Enter Store ID"></div>
        <div class="col-12 col-lg-6"><label class="form-label" for="ssl-secret">Store Password / API Secret</label><input id="ssl-secret" type="password" class="form-control" autocomplete="new-password" placeholder="Leave blank to keep existing secret"><div id="secret-hint" class="form-text">Loading credential status…</div></div>
        <div class="col-12 col-lg-6"><label class="form-label" for="ssl-environment">Environment</label><select id="ssl-environment" class="form-select"><option value="sandbox">Sandbox / Test</option><option value="production">Production</option></select></div>
        <div class="col-12 col-lg-6"><label class="form-label">Currency</label><input class="form-control" value="BDT" readonly></div>
      </div>
      <hr class="my-4"><div class="d-flex flex-wrap align-items-center gap-3"><button class="btn btn-outline-primary" id="test-connection" type="button"><i class="bi bi-plug me-1"></i>Validate Configuration</button><span id="connection-status" class="small text-secondary" role="status">Credentials have not been validated.</span></div>
      <p class="text-secondary small mt-3 mb-0">Validation checks saved configuration only. A live provider handshake is not implemented by this settings endpoint.</p>
    </div>
  </section>
  <div class="d-flex justify-content-end"><button class="btn btn-primary px-4" id="save-bottom" type="button"><i class="bi bi-check2-circle me-1"></i>Save Configuration</button></div>
</main>
<script>
"use strict";
const $=id=>document.getElementById(id);
const providerIds=["bkash","nagad","rocket","upay"];
async function requestJson(url,options={}){const response=await fetch(url,{...options,cache:"no-store",credentials:"same-origin",headers:{"Accept":"application/json",...(options.body?{"Content-Type":"application/json"}:{}),...(options.headers||{})}});let data={};try{data=await response.json()}catch(_){}if(!response.ok||data.success===false)throw new Error(data.message||"Request failed ("+response.status+").");return data;}
function feedback(message,kind="success"){const el=$("feedback");el.className="alert alert-"+kind;el.textContent=message;}
async function loadPaymentGatewaySettings(){try{const data=await requestJson("/api/admin/payment-gateways");const s=data.settings||{};providerIds.forEach(id=>{const item=s.mfs?.[id]||{};$ (id+"-number").value=item.number||"";$(id+"-enabled").checked=Boolean(item.enabled)});const ssl=s.sslcommerz||{};$("ssl-enabled").checked=Boolean(ssl.enabled);$("ssl-store-id").value=ssl.storeId||"";$("ssl-environment").value=ssl.environment||"sandbox";$("ssl-secret").value="";$("secret-hint").textContent=ssl.secretConfigured?"A secret is already saved. Leave blank to keep it unchanged.":"No API secret is saved yet.";if(ssl.secretConfigured&&!ssl.secretEncrypted)feedback("A legacy SSLCommerz secret is stored without encryption. Save a new secret to migrate it to encrypted storage.","warning");}catch(error){feedback(error.message||"Unable to load payment gateway settings.","danger")}}
async function savePaymentGatewaySettings(){const buttons=[$("save-top"),$("save-bottom")];buttons.forEach(b=>b.disabled=true);try{const payload={mfs:Object.fromEntries(providerIds.map(id=>[id,{number:$(id+"-number").value.trim(),enabled:$(id+"-enabled").checked}])),sslcommerz:{enabled:$("ssl-enabled").checked,storeId:$("ssl-store-id").value.trim(),storePassword:$("ssl-secret").value,environment:$("ssl-environment").value}};const data=await requestJson("/api/admin/payment-gateways/save",{method:"POST",body:JSON.stringify(payload)});$("ssl-secret").value="";feedback(data.message||"Payment gateway settings saved.");await loadPaymentGatewaySettings();}catch(error){feedback(error.message||"Unable to save payment gateway settings.","danger")}finally{buttons.forEach(b=>b.disabled=false)}}
function validatePaymentGatewayConfiguration(){const enabledMfs=providerIds.filter(id=>$(id+"-enabled").checked);const invalid=enabledMfs.filter(id=>!$(id+"-number").value.trim());if(invalid.length){$("connection-status").textContent="Add receiving numbers for enabled MFS providers: "+invalid.join(", ");$("connection-status").className="small text-danger";return;}if($("ssl-enabled").checked&&!$("ssl-store-id").value.trim()){ $("connection-status").textContent="SSLCommerz is enabled but Store ID is missing.";$("connection-status").className="small text-danger";return;}if($("ssl-enabled").checked&&!$("secret-hint").textContent.includes("already saved")&&!$("ssl-secret").value.trim()){ $("connection-status").textContent="SSLCommerz is enabled but API secret is missing.";$("connection-status").className="small text-danger";return;}$("connection-status").textContent="Configuration fields look valid. This does not verify connectivity with the payment provider.";$("connection-status").className="small text-success";}
$("save-top").addEventListener("click",savePaymentGatewaySettings);$("save-bottom").addEventListener("click",savePaymentGatewaySettings);$("test-connection").addEventListener("click",validatePaymentGatewayConfiguration);loadPaymentGatewaySettings();
</script></body></html>