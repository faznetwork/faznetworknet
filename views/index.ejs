      <button type="button" id="hotspotTab" class="package-tab" role="tab" aria-selected="false" aria-controls="hotspotPanel" data-package-tab="hotspot"><span class="tab-icon">⌁</span><span><strong>Hotspot WiFi Zones</strong><small>Voucher, time &amp; data passes</small></span></button>
    </div>
    <div class="mt-9 flex flex-wrap items-center justify-between gap-3">
      <div><p class="text-sm font-bold uppercase tracking-[.18em] text-emerald-300" id="packageCategoryLabel">HOME FIBER</p><p class="mt-1 text-sm text-slate-400" id="packageCountLabel"><%= safePackages.length %> verified monthly plans</p></div>
      <span class="inline-flex items-center gap-2 rounded-full border border-emerald-400/20 bg-emerald-400/10 px-3 py-2 text-xs font-bold text-emerald-200"><span class="live-dot"></span> Clear pricing · No hidden plan cards</span>
    </div>
    <% const publicPppoePackages=safePackages.filter(pkg=>{const n=String(pkg.plan_name||pkg.profile_name||"").trim();return n&&!/(expired|ex-|disabled|block|default|vpn)/i.test(n)&&Number(pkg.price)>0;}); %>
    <% const publicHotspotPackages=safeHotspotPackages.filter(pkg=>{const n=String(pkg.name||pkg.profile||"").trim();return n&&!/(expired|ex-|disabled|block|default|vpn)/i.test(n)&&Number(pkg.price)>0;}); %>
    <div id="pppoePanel" class="package-panel mt-5 grid gap-5 sm:grid-cols-2 xl:grid-cols-3" role="tabpanel" aria-labelledby="pppoeTab">
      <% if(!publicPppoePackages.length){ %><div class="package-empty sm:col-span-2 xl:col-span-3"><span class="empty-orbit">⌁</span><h3>No home fiber plans are published yet</h3><p>Contact FAZ NETWORK to confirm current availability and pricing.</p><button type="button" class="cta-secondary mt-5" data-open-support>Talk to support <span>↗</span></button></div><% } %>
      <% publicPppoePackages.forEach((pkg,index)=>{ const name=String(pkg.plan_name||pkg.profile_name||"Home Fiber").trim(); const speed=String(pkg.rate_limit||"Speed confirmed on connection").trim(); const price=Number(pkg.price); const duration=Math.max(1,Number(pkg.duration_months||1)); const match=speed.match(/([0-9]+(?:\.[0-9]+)?)\s*(mbps|mb\/s|m)?/i); const speedCallout=match?match[1]+" Mbps":speed; %>
        <article class="package-card <%= index===1?'package-card-featured':'' %>" style="--card-hue:<%= [165,190,265][index%3] %>deg">
          <div class="card-topline"><span class="plan-index">PLAN / <%= String(index+1).padStart(2,"0") %></span><span class="plan-chip"><span class="live-dot"></span> HOME FIBER</span></div>
          <h3 class="mt-5 text-xl font-extrabold text-white"><%= esc(name) %></h3><p class="mt-2 text-sm leading-6 text-slate-400">Dedicated home broadband for everyday streaming, work and play.</p>
          <div class="speed-display"><span class="speed-value"><%= esc(speedCallout) %></span><span class="speed-label"><%= match?"HIGH-SPEED BROADBAND":"PLAN SPEED" %></span></div>
          <div class="price-row"><div><span class="price-value">৳<%= price.toLocaleString("en-BD",{maximumFractionDigits:0}) %></span><span class="price-period"> / <%= duration %> month<%= duration===1?"":"s" %></span></div><span class="price-badge">MONTHLY</span></div>
          <ul class="feature-list"><li><span>✓</span> Fiber connectivity where available</li><li><span>✓</span> Streaming, study &amp; work ready</li><li><span>✓</span> Local customer support</li></ul>
          <button type="button" class="cta-primary" data-open-support>Get Connected <span>↗</span></button>
        </article>
      <% }) %>
    </div>
    <div id="hotspotPanel" class="package-panel mt-5 hidden grid gap-5 sm:grid-cols-2 xl:grid-cols-3" role="tabpanel" aria-labelledby="hotspotTab" hidden>
      <% publicHotspotPackages.forEach((pkg,index)=>{const name=String(pkg.name||pkg.profile||"WiFi Pass").trim();const validity=String(pkg.validityLabel||pkg.validity||"Flexible access").trim();const price=Number(pkg.price);const quota=Number(pkg.limitBytesTotal||pkg.limit_bytes_total||0);const quotaLabel=quota>0?(quota>=1073741824?(quota/1073741824).toFixed(quota%1073741824===0?0:1)+" GB Quota":(quota/1048576).toFixed(0)+" MB Quota"):validity; %>
        <article class="package-card hotspot-card" style="--card-hue:<%= [190,145,265][index%3] %>deg">
          <div class="card-topline"><span class="plan-index">PASS / <%= String(index+1).padStart(2,"0") %></span><span class="plan-chip hotspot-chip"><span class="live-dot"></span> WIFI ZONE</span></div>
          <h3 class="mt-5 text-xl font-extrabold text-white"><%= esc(name) %></h3><p class="mt-2 text-sm leading-6 text-slate-400">Flexible WiFi access for your phone, laptop and everyday browsing.</p>
          <div class="speed-display"><span class="speed-value"><%= esc(quotaLabel) %></span><span class="speed-label"><%= quota>0?"DATA ALLOWANCE":"ACCESS VALIDITY" %></span></div>
          <div class="price-row"><div><span class="price-value">৳<%= price.toLocaleString("en-BD",{maximumFractionDigits:0}) %></span><span class="price-period"> / pass</span></div><span class="price-badge hotspot-price-badge"><%= esc(validity) %></span></div>
          <ul class="feature-list"><li><span>✓</span> Simple voucher-based access</li><li><span>✓</span> Time or data-based pass</li><li><span>✓</span> Local customer support</li></ul>
          <button type="button" class="cta-primary" data-buy-hotspot data-profile="<%= esc(name) %>" data-price="<%= price %>" data-validity="<%= esc(validity) %>">Buy Package <span>↗</span></button>
        </article>
      <% }) %>
      <% if(!publicHotspotPackages.length){ %><div class="package-empty sm:col-span-2 xl:col-span-3"><span class="empty-orbit">⌁</span><h3>Hotspot passes are being refreshed</h3><p>Ask support for currently available WiFi voucher and data passes.</p><button type="button" class="cta-secondary mt-5" data-open-support>View available passes <span>↗</span></button></div><% } %>
    </div>
    <p class="mt-7 text-center text-xs leading-5 text-slate-500">Displayed prices and specifications are based on configured consumer plans. Coverage, speed and availability may vary by location and package terms.</p>
  </div>
</section>

<section id="coverage" class="mx-auto max-w-7xl px-4 py-16 lg:px-8">
  <div class="rounded-3xl bg-slate-900 p-8 text-white sm:p-12">
    <p class="text-xs font-black uppercase tracking-widest text-cyan-300">Coverage &amp; Service</p>
    <div class="mt-3 grid gap-8 lg:grid-cols-2">
      <div><h2 class="text-3xl font-black">Connected where FAZ NETWORK serves.</h2><p class="mt-4 leading-7 text-slate-300">Coverage depends on local fiber infrastructure and availability. Contact support to confirm serviceability at your address.</p></div>
      <div class="grid gap-3 sm:grid-cols-2"><div class="rounded-2xl bg-white/10 p-5"><p class="font-black">Fiber Internet</p><p class="mt-1 text-sm text-slate-300">Reliable broadband connectivity.</p></div><div class="rounded-2xl bg-white/10 p-5"><p class="font-black">Smart Hotspot</p><p class="mt-1 text-sm text-slate-300">Flexible hotspot services.</p></div></div>
    </div>
  </div>
</section>
</main>

<footer id="support" class="border-t border-slate-200 bg-white">
  <div class="mx-auto grid max-w-7xl gap-8 px-4 py-12 sm:grid-cols-2 lg:grid-cols-4 lg:px-8">
    <div><div class="text-xl font-black">FAZ <span class="text-cyan-600">NETWORK</span></div><p class="mt-3 text-sm text-slate-500">Fiber Internet &amp; Smart Hotspot services.</p></div>
    <div><h3 class="font-black">Support</h3><p class="mt-3 text-sm text-slate-500">24/7 Helpline: <%= esc(safeHelpline) %></p><button id="supportBtnFooter" class="mt-3 text-sm font-bold text-cyan-600">WhatsApp Support</button></div>
    <div><h3 class="font-black">Office</h3><p class="mt-3 text-sm text-slate-500"><%= esc(safeOfficeAddress) %></p></div>
    <div><h3 class="font-black">Terms</h3><p class="mt-3 text-sm text-slate-500">Service terms, fair-use policies and applicable BTRC regulatory requirements apply.</p></div>
  </div>
  <div class="border-t border-slate-100 py-5 text-center text-xs text-slate-400"><%= esc(copyrightText) %></div>
</footer>


<div id="hotspotPurchaseModal" class="fixed inset-0 z-[60] hidden items-center justify-center overflow-y-auto bg-slate-950/80 p-4" role="dialog" aria-modal="true" aria-labelledby="hotspotPurchaseTitle">
  <div class="my-auto w-full max-w-xl rounded-3xl border border-white/10 bg-[#0e1828] p-5 shadow-2xl sm:p-7">
    <div class="flex items-start justify-between gap-4"><div><p class="text-xs font-black uppercase tracking-widest text-emerald-300">Secure Hotspot Checkout</p><h2 id="hotspotPurchaseTitle" class="mt-2 text-2xl font-black text-white">Buy Hotspot Package</h2><p class="mt-2 text-sm text-slate-300">Send the exact amount, then submit your TrxID to activate the package.</p></div><button id="closeHotspotPurchase" type="button" aria-label="Close payment window" class="rounded-lg px-2 text-2xl text-slate-400 hover:bg-white/10">×</button></div>
    <div class="mt-5 rounded-2xl border border-white/10 bg-white/[.04] p-4"><div class="flex items-start justify-between gap-3"><div><p id="purchasePackageName" class="font-bold text-white">Selected package</p><p id="purchasePackageValidity" class="mt-1 text-sm text-slate-400">Hotspot access</p></div><p id="purchasePackagePrice" class="text-2xl font-black text-emerald-300">৳0</p></div></div>
    <div class="mt-4 rounded-2xl border border-pink-400/20 bg-pink-400/[.06] p-4"><label for="paymentMethod" class="block text-sm font-bold text-white">Payment method</label><select id="paymentMethod" class="mt-2 w-full rounded-xl border border-white/10 bg-[#08111e] px-3 py-3 text-white"><option value="bkash">bKash — Send Money</option><option value="nagad">Nagad — Send Money</option><option value="rocket">Rocket — Send Money</option><option value="upay">Upay — Send Money</option></select><p class="mt-4 text-xs font-bold uppercase tracking-widest text-slate-400">Send Money to this number</p><div class="mt-2 flex items-center gap-2"><strong id="paymentReceiverNumber" class="min-w-0 flex-1 break-all text-xl font-black text-white">Not configured</strong><button id="copyPaymentReceiver" type="button" class="shrink-0 rounded-lg border border-white/15 px-3 py-2 text-xs font-bold text-emerald-200">Copy</button></div><ol class="mt-4 list-decimal space-y-2 pl-5 text-sm leading-6 text-slate-300"><li>Open your MFS app and choose <b>Send Money</b> (not Cash Out or Payment).</li><li>Enter the receiving number shown above.</li><li>Send exactly <b id="paymentInstructionAmount">৳0</b>.</li><li>Enter your MFS transaction ID (TrxID) below after the payment SMS is received.</li></ol><p id="paymentSetupWarning" class="mt-3 hidden rounded-xl bg-amber-400/10 p-3 text-sm text-amber-200">This payment method has no receiving number configured. Please contact support.</p></div>
    <form id="hotspotPurchaseForm" class="mt-5 space-y-4"><div><label for="hotspotBuyerPhone" class="mb-1 block text-sm font-bold text-white">Mobile number (Hotspot password)</label><input id="hotspotBuyerPhone" type="tel" inputmode="numeric" autocomplete="tel" required pattern="01[0-9]{9}" maxlength="11" class="w-full rounded-xl border border-white/10 bg-[#08111e] px-4 py-3 text-white outline-none focus:border-emerald-400" placeholder="01XXXXXXXXX"><p class="mt-1 text-xs text-slate-400">Your phone is the Hotspot password. The device MAC will be bound on first captive login.</p></div><div><label for="hotspotBuyerTrxId" class="mb-1 block text-sm font-bold text-white">TrxID / TxnID</label><input id="hotspotBuyerTrxId" required maxlength="120" autocomplete="off" class="w-full rounded-xl border border-white/10 bg-[#08111e] px-4 py-3 text-white outline-none focus:border-emerald-400" placeholder="Enter the transaction ID"></div><div id="hotspotPurchaseResult" class="hidden rounded-xl p-4 text-sm" role="status" aria-live="polite"></div><button id="hotspotPurchaseSubmit" type="submit" class="w-full rounded-xl bg-gradient-to-r from-emerald-300 to-cyan-300 px-5 py-3 font-black text-slate-950 disabled:cursor-not-allowed disabled:opacity-60">Verify Payment &amp; Activate Package</button><p class="text-center text-xs leading-5 text-slate-400">Payment verification requires the transaction SMS to have reached FAZ NETWORK. Do not share your MFS PIN or OTP.</p></form>
  </div>
</div>

<div id="customerLoginModal" class="fixed inset-0 z-50 hidden items-center justify-center overflow-y-auto bg-slate-950/70 p-4">
  <div class="my-auto w-full max-w-lg rounded-3xl bg-white p-6 shadow-2xl sm:p-8">
    <div class="flex items-start justify-between"><div><p class="text-xs font-black uppercase tracking-widest text-cyan-600">Secure Self-Care</p><h2 class="mt-1 text-2xl font-black">Customer Login</h2><p class="mt-1 text-sm text-slate-500">Sign in to view your own account only.</p></div><button id="closeCustomerLogin" type="button" aria-label="Close login" class="rounded-lg px-2 text-2xl text-slate-400 hover:bg-slate-100">×</button></div>
    <div class="mt-6 grid grid-cols-2 gap-2 rounded-2xl bg-slate-100 p-1"><button type="button" data-login-type="pppoe" class="customer-type rounded-xl bg-white px-3 py-3 text-sm font-black text-cyan-700 shadow-sm">PPPoE Subscriber</button><button type="button" data-login-type="hotspot" class="customer-type rounded-xl px-3 py-3 text-sm font-black text-slate-500">Hotspot Subscriber</button></div>
    <form id="customerLoginForm" class="mt-5 space-y-4">
      <input id="loginType" type="hidden" value="pppoe">
      <div><label id="loginIdentifierLabel" for="loginIdentifier" class="mb-1 block text-sm font-bold">Username or registered phone</label><input id="loginIdentifier" required autocomplete="username" maxlength="120" class="w-full rounded-xl border border-slate-300 px-4 py-3 outline-none focus:border-cyan-500 focus:ring-2 focus:ring-cyan-100" placeholder="PPPoE username or phone number"></div>
      <div id="loginPasswordWrap"><label for="loginPassword" class="mb-1 block text-sm font-bold">Password</label><input id="loginPassword" required type="password" autocomplete="current-password" class="w-full rounded-xl border border-slate-300 px-4 py-3 outline-none focus:border-cyan-500 focus:ring-2 focus:ring-cyan-100" placeholder="Your PPPoE password"></div>
      <p id="hotspotLoginHint" class="hidden rounded-xl bg-emerald-50 p-3 text-sm text-emerald-800">Use your registered phone to view self-care. For Wi-Fi access, enter it on the device captive login page, where the MAC is bound.</p>
      <div id="loginError" role="alert" class="hidden rounded-xl bg-red-50 px-4 py-3 text-sm font-semibold text-red-700"></div>
      <button id="loginSubmit" class="w-full rounded-xl bg-cyan-600 px-5 py-3 font-black text-white hover:bg-cyan-700 disabled:opacity-60">Login to Account</button>
    </form>
    <p class="mt-5 text-center text-xs leading-5 text-slate-400">Customer access is separate from the administrator login. Never share your password or payment OTP.</p>
  </div>
</div>

<div id="supportModal" class="fixed inset-0 z-50 hidden items-center justify-center bg-slate-950/70 p-4">
  <div class="w-full max-w-md rounded-3xl bg-white p-7 shadow-2xl"><div class="flex justify-between"><h2 class="text-2xl font-black">FAZ NETWORK Support</h2><button id="closeSupport" class="text-2xl text-slate-400">×</button></div><p class="mt-4 text-slate-500">24/7 customer assistance</p><div class="mt-5 space-y-3"><a class="block rounded-xl bg-cyan-50 p-4 font-bold text-cyan-700" href="tel:<%= esc(safeHelpline) %>">☎ Call <%= esc(safeHelpline) %></a><% if (safeWhatsapp) { %><a class="block rounded-xl bg-emerald-50 p-4 font-bold text-emerald-700" href="https://wa.me/<%= esc(safeWhatsapp) %>" target="_blank" rel="noopener">💬 WhatsApp Support</a><% } %><div class="rounded-xl bg-slate-50 p-4 text-sm font-semibold text-slate-700">⌂ <%= esc(safeOfficeAddress) %></div><% if(safeBtrc){ %><div class="rounded-xl bg-slate-50 p-4 text-sm font-semibold text-slate-700">BTRC License: <%= esc(safeBtrc) %></div><% } %></div></div>
</div>

<script>
(()=> {
  const $=id=>document.getElementById(id);
  const esc=v=>String(v??"").replace(/[&<>"']/g,c=>({"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;","'":"&#39;"}[c]));
  const modal=(id,open)=>{const el=$(id);if(!el)return;el.classList.toggle("hidden",!open);el.classList.toggle("flex",open);document.body.classList.toggle("overflow-hidden",open);};
  const paymentAccounts=<%- JSON.stringify(paymentAccounts||{bkash:"",nagad:"",rocket:"",upay:""}).replace(/</g,"\\u003c") %>;
  let selectedHotspotPackage={name:"",price:0,validity:""};
  const updatePaymentMethod=()=>{
    const method=$("paymentMethod").value,number=String(paymentAccounts[method]||"").trim();
    $("paymentReceiverNumber").textContent=number||"Not configured";
    $("paymentSetupWarning").classList.toggle("hidden",Boolean(number));
    $("copyPaymentReceiver").disabled=!number;
    $("copyPaymentReceiver").classList.toggle("opacity-50",!number);
  };
  document.querySelectorAll("[data-buy-hotspot]").forEach(button=>button.addEventListener("click",()=>{
    selectedHotspotPackage={name:button.dataset.profile||"",price:Number(button.dataset.price||0),validity:button.dataset.validity||""};
    $("purchasePackageName").textContent=selectedHotspotPackage.name;
    $("purchasePackageValidity").textContent=selectedHotspotPackage.validity;
    $("purchasePackagePrice").textContent="৳"+selectedHotspotPackage.price.toLocaleString("en-BD");
    $("paymentInstructionAmount").textContent="৳"+selectedHotspotPackage.price.toLocaleString("en-BD");
    $("hotspotPurchaseResult").className="hidden rounded-xl p-4 text-sm";
    $("hotspotPurchaseResult").textContent="";
    $("hotspotPurchaseForm").reset();
    updatePaymentMethod();
    modal("hotspotPurchaseModal",true);
  }));
  $("paymentMethod")?.addEventListener("change",updatePaymentMethod);
  $("closeHotspotPurchase")?.addEventListener("click",()=>modal("hotspotPurchaseModal",false));
  $("hotspotPurchaseModal")?.addEventListener("click",e=>{if(e.target.id==="hotspotPurchaseModal")modal("hotspotPurchaseModal",false)});
  $("copyPaymentReceiver")?.addEventListener("click",async()=>{
    const number=String(paymentAccounts[$("paymentMethod").value]||"").trim();if(!number)return;
    try{await navigator.clipboard.writeText(number);$("copyPaymentReceiver").textContent="Copied";setTimeout(()=>{$("copyPaymentReceiver").textContent="Copy"},1200);}
    catch(_){$("paymentReceiverNumber").textContent=number;}
  });
  $("hotspotPurchaseForm")?.addEventListener("submit",async e=>{
    e.preventDefault();const btn=$("hotspotPurchaseSubmit"),box=$("hotspotPurchaseResult");
    if(!selectedHotspotPackage.name||!selectedHotspotPackage.price){box.className="rounded-xl p-4 text-sm bg-red-400/10 text-red-200";box.textContent="Please select a valid package.";return;}
    btn.disabled=true;btn.textContent="Verifying payment…";box.className="rounded-xl p-4 text-sm bg-white/5 text-slate-200";box.textContent="Checking payment and saving your pending Hotspot package…";
    try{
      const response=await fetch("/api/verify-trx",{method:"POST",headers:{"Content-Type":"application/json","Accept":"application/json"},body:JSON.stringify({service_type:"hotspot",phone:$("hotspotBuyerPhone").value.trim(),account_phone:$("hotspotBuyerPhone").value.trim(),trxId:$("hotspotBuyerTrxId").value.trim(),amount:selectedHotspotPackage.price,profile_id:selectedHotspotPackage.name,paymentMethod:$("paymentMethod").value})});
      const data=await response.json();if(!response.ok||!data.success)throw new Error(data.error||data.message||"Payment verification failed.");
      box.className="rounded-xl p-4 text-sm bg-emerald-400/10 text-emerald-200";
      box.textContent="Payment verified. Connect to FAZ NETWORK Wi-Fi and enter this same 11-digit phone on the captive login page. Your device MAC will bind on first login, when package validity starts.";
      btn.textContent="Package Activated";
    }catch(error){box.className="rounded-xl p-4 text-sm bg-red-400/10 text-red-200";box.textContent=error.message||"Unable to verify payment. Check the TrxID and try again.";btn.textContent="Verify Payment & Activate Package";}
    finally{btn.disabled=false;}
  });
  [$("supportBtn"),$("supportBtnFooter")].forEach(b=>b&&b.addEventListener("click",()=>modal("supportModal",true)));
  document.querySelectorAll("[data-open-support]").forEach(b=>b.addEventListener("click",()=>modal("supportModal",true)));
  const packageTabs=[...document.querySelectorAll("[data-package-tab]")];
  const packageLabels={pppoe:{title:"HOME FIBER",count:Number(<%= publicPppoePackages.length %>)},hotspot:{title:"HOTSPOT PASSES",count:Number(<%= publicHotspotPackages.length %>)}};
  packageTabs.forEach(tab=>tab.addEventListener("click",()=>{const type=tab.dataset.packageTab;packageTabs.forEach(t=>{const active=t===tab;t.classList.toggle("is-active",active);t.setAttribute("aria-selected",String(active));});document.querySelectorAll(".package-panel").forEach(panel=>{const active=panel.id===(type==="pppoe"?"pppoePanel":"hotspotPanel");panel.hidden=!active;panel.classList.toggle("hidden",!active);});const label=$("packageCategoryLabel"),count=$("packageCountLabel");if(label)label.textContent=packageLabels[type].title;if(count)count.textContent=packageLabels[type].count+(type==="pppoe"?" verified monthly plans":" configured passes");}));
  $("closeSupport")?.addEventListener("click",()=>modal("supportModal",false));
  $("supportModal")?.addEventListener("click",e=>{if(e.target.id==="supportModal")modal("supportModal",false)});
  $("customerLoginBtn")?.addEventListener("click",()=>modal("customerLoginModal",true));
  if(new URLSearchParams(location.search).get("customerLogin")==="1")modal("customerLoginModal",true);
  $("closeCustomerLogin")?.addEventListener("click",()=>modal("customerLoginModal",false));
  $("customerLoginModal")?.addEventListener("click",e=>{if(e.target.id==="customerLoginModal")modal("customerLoginModal",false)});
  document.addEventListener("keydown",e=>{if(e.key==="Escape"){modal("supportModal",false);modal("customerLoginModal",false)}});



  let customerLoginType="pppoe";
  const setCustomerLoginType=type=>{
    customerLoginType=type;
    $("loginType").value=type;
    document.querySelectorAll(".customer-type").forEach(button=>{
      const active=button.dataset.loginType===type;
      button.classList.toggle("bg-white",active);button.classList.toggle("shadow-sm",active);
      button.classList.toggle("text-cyan-700",active);button.classList.toggle("text-slate-500",!active);
    });
    $("loginIdentifierLabel").textContent=type==="hotspot"?"11-digit mobile number":"Username or registered phone";
    $("loginIdentifier").placeholder=type==="hotspot"?"01XXXXXXXXX":"PPPoE username or phone number";
    $("loginIdentifier").inputMode=type==="hotspot"?"numeric":"text";
    $("loginIdentifier").maxLength=type==="hotspot"?11:120;
    $("loginPasswordWrap").classList.toggle("hidden",type==="hotspot");
    $("loginPassword").required=type==="pppoe";
    $("hotspotLoginHint").classList.toggle("hidden",type!=="hotspot");
    if(type==="hotspot")$("loginPassword").value="";
  };
  document.querySelectorAll(".customer-type").forEach(button=>button.addEventListener("click",()=>setCustomerLoginType(button.dataset.loginType)));
  $("loginIdentifier")?.addEventListener("input",()=>{if(customerLoginType==="hotspot")$("loginPassword").value=$("loginIdentifier").value.trim();});
  $("customerLoginForm")?.addEventListener("submit",async e=>{
    e.preventDefault();const btn=$("loginSubmit"),err=$("loginError");err.classList.add("hidden");btn.disabled=true;btn.textContent="Verifying…";
    try{
      const identifier=$("loginIdentifier").value.trim();
      const payload={type:customerLoginType,identifier,password:customerLoginType==="hotspot"?identifier:$("loginPassword").value};
      const r=await fetch("/api/customer/login",{method:"POST",headers:{"Content-Type":"application/json",Accept:"application/json"},body:JSON.stringify(payload)});
      const d=await r.json();if(!r.ok||!d.success)throw new Error(d.message||"Login failed.");
      location.href=d.redirect||"/customer/dashboard";
    }catch(ex){err.textContent=ex.message;err.classList.remove("hidden");}
    finally{btn.disabled=false;btn.textContent="Login to Account";}
  });
})();
</script>
</body>
</html>