#hotspotPurchaseModal .hotspot-checkout-card{--hotspot-brand:#1769aa;--hotspot-tint:#f2f8ff;width:min(100%,560px);max-height:calc(100dvh - 24px);overflow:auto;border:1px solid #e0e6ed;border-top:4px solid var(--hotspot-brand);border-radius:18px;background:#fff;color:#111827;box-shadow:0 22px 60px rgba(15,23,42,.2)}
#hotspotPurchaseModal .hotspot-checkout-card[data-provider="bkash"]{--hotspot-brand:#e2136e;--hotspot-tint:#fff0f6}
#hotspotPurchaseModal .hotspot-checkout-card[data-provider="nagad"]{--hotspot-brand:#f7941d;--hotspot-tint:#fff7eb}
