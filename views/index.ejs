#hotspotPurchaseModal #hotspotPurchaseResult.hotspot-result-error{border-color:#f3c5ce;background:#fff4f5;color:#9f2338}
@media(max-width:480px){#hotspotPurchaseModal{padding:10px}#hotspotPurchaseModal .hotspot-checkout-card{max-height:calc(100dvh - 20px);padding:16px;border-radius:15px}#hotspotPurchaseModal .hotspot-mfs-card{gap:7px;padding:9px 7px;font-size:12px}#hotspotPurchaseModal .hotspot-mfs-logo{width:64px;height:34px}}
@media(prefers-reduced-motion:reduce){#hotspotPurchaseModal *{transition:none!important}}
</style>
