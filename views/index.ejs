#hotspotPurchaseModal .hotspot-receive{border:1px solid color-mix(in srgb,var(--hotspot-brand) 24%,white);background:var(--hotspot-tint)}
#hotspotPurchaseModal .hotspot-receive-label{color:var(--hotspot-brand)}
#hotspotPurchaseModal #paymentReceiverNumber{color:var(--hotspot-brand)}
#hotspotPurchaseModal .hotspot-copy-button{border:1px solid #d5dde7;background:#fff;color:#334155}
#hotspotPurchaseModal .hotspot-copy-button:disabled{opacity:.5;cursor:not-allowed}
#hotspotPurchaseModal #paymentSetupWarning{border:1px solid #f5d99a;background:#fff8e8;color:#8a5a08}
#hotspotPurchaseModal #hotspotPaymentTimer{color:var(--hotspot-brand);font-variant-numeric:tabular-nums}
#hotspotPurchaseModal #hotspotPaymentTimer.expired{color:#b4233c}
#hotspotPurchaseModal .hotspot-timer-track{height:5px;border-radius:999px;background:#e9edf2;overflow:hidden}
#hotspotPurchaseModal .hotspot-timer-fill{height:100%;width:100%;background:var(--hotspot-brand);transition:width .25s linear}
#hotspotPurchaseModal .hotspot-instructions{color:#475569}
#hotspotPurchaseModal .hotspot-checkout-input{min-height:48px;border:1px solid #cfd8e3;border-radius:10px;background:#fff;color:#111827;outline:none;font:400 14px Inter,system-ui,sans-serif}
#hotspotPurchaseModal .hotspot-checkout-input:focus{border-color:var(--hotspot-brand);box-shadow:0 0 0 3px color-mix(in srgb,var(--hotspot-brand) 13%,transparent)}
#hotspotPurchaseModal .hotspot-checkout-input::placeholder{color:#94a3b8}
#hotspotPurchaseModal .hotspot-submit-button{min-height:45px;border:1px solid var(--hotspot-brand);border-radius:10px;background:var(--hotspot-brand);color:#fff;box-shadow:0 2px 4px rgba(23,105,170,.12)}
#hotspotPurchaseModal .hotspot-submit-button:hover:not(:disabled){filter:brightness(.93)}
#hotspotPurchaseModal #hotspotPurchaseResult:not(.hidden){border:1px solid #c9def3;background:#f2f8ff;color:#245d8f}
