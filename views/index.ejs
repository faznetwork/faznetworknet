<section id="packages" class="packages-shell relative overflow-hidden py-20 sm:py-24">
  <div class="packages-grid-glow pointer-events-none absolute inset-0" aria-hidden="true"></div>
  <div class="relative mx-auto max-w-7xl px-4 lg:px-8">
    <div class="mx-auto max-w-3xl text-center">
      <span class="eyebrow"><span class="live-dot"></span> PLANS BUILT FOR YOUR WORLD</span>
      <h2 class="mt-5 text-3xl font-extrabold tracking-tight text-white sm:text-5xl">Choose your <span class="gradient-text">connection.</span></h2>
      <p class="mx-auto mt-4 max-w-2xl text-base leading-7 text-slate-300 sm:text-lg">Transparent pricing, reliable connectivity, and a plan that fits the way you live, work and play.</p>
    </div>
    <div class="mx-auto mt-9 flex max-w-xl flex-col gap-2 rounded-2xl border border-white/10 bg-white/[0.04] p-2 sm:flex-row" role="tablist" aria-label="Internet package category">
