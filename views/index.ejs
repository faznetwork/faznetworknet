#hotspotPurchaseModal #hotspotPurchaseTitle{color:#111827;letter-spacing:-.035em}
#hotspotPurchaseModal .hotspot-close{border:1px solid #dce3eb;background:#fff;color:#475569}
#hotspotPurchaseModal .hotspot-package-summary{border:1px solid #e1e7ef;background:#fafbfd}
#hotspotPurchaseModal #purchasePackagePrice{color:var(--hotspot-brand)}
#hotspotPurchaseModal .hotspot-payment-section{border:1px solid #e1e7ef;background:#fff}
#hotspotPurchaseModal .hotspot-mfs-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:10px}
