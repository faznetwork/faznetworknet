er-radius:13px;overflow:hidden;background:#f8fafc}.customer-renew-detail{display:flex;align-items:flex-start;justify-content:space-between;gap:12px;padding:10px 12px;border-bottom:1px solid #e2e8f0}.customer-renew-detail:last-child{border-bottom:0}.customer-renew-detail>span{font-size:12px;color:#64748b;flex:0 0 42%}.customer-renew-detail>strong,.customer-renew-detail>code{font-size:12px;text-align:right;min-width:0;overflow-wrap:anywhere;word-break:break-word;color:#0f172a}#renewConfirmSubmit{min-height:40px;font-weight:700}@media(max-width:767.98px){#customerRenewConfirmModal .modal-dialog{margin:12px auto;max-width:calc(100% - 24px)}#customerRenewConfirmModal .modal-footer .btn{flex:1;min-height:42px}}</style>
