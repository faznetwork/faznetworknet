  }catch(error){
    // Navigation failures must not block the panel with a placeholder alert.
    console.error('[Dashboard KPI navigation]',error);
  }
  finally{if(button){button.classList.remove('is-navigating');button.setAttribute('aria-busy','false');}}
}
