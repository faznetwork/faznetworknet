                const customer=data.customer||{};
                const username=String(customer.username||id).trim();
                if(!username)throw new Error('Customer username is missing.');
                await openCustomerProfile(username,data);
            }catch(error){alert(error.message||'Unable to open Customer 360 / Master Management Hub.');}
        }

        let customerEditFormOrigin=null;
        function ensureCustomerEditFormModal(){
            const form=document.getElementById('addCustomerForm'),modalEl=document.getElementById('customerEditFormModal'),body=document.getElementById('customerEditFormModalBody');
            if(!form||!modalEl||!body)throw new Error('Customer edit form modal is unavailable.');
            if(!customerEditFormOrigin)customerEditFormOrigin={parent:form.parentNode,next:form.nextSibling};
            if(form.parentNode!==body)body.appendChild(form);
            if(!modalEl.dataset.restoreBound){
                modalEl.addEventListener('hidden.bs.modal',()=>{
                    const f=document.getElementById('addCustomerForm'),origin=customerEditFormOrigin;
                    if(f&&origin?.parent)origin.parent.insertBefore(f,origin.next&&origin.next.parentNode===origin.parent?origin.next:null);
                    const editId=document.getElementById('customerEditId');if(editId)editId.value='';
                    const title=document.getElementById('customerEditFormModalTitle');if(title)title.textContent='Edit Customer';
                    const save=document.getElementById('saveCustomerBtn');if(save)save.innerHTML='<i class="bi bi-person-plus-fill me-1"></i><span>Save &amp; Provision Customer</span>';
                    customerEditFormOrigin=null;
                });
                modalEl.dataset.restoreBound='1';
            }
            return window.bootstrap?.Modal?.getOrCreateInstance(modalEl);
        }
        async function openCustomerEditForm(customerId,usernameFallback){
            // RouterOS IDs are not customer-table IDs and can collide with a
            // panel-created customer's numeric database ID. Resolve edits by
            // the selected PPPoE username, never by the row's router ID.
            const username=String(usernameFallback||customerId||'').trim();
            if(!username){alert('Customer ID or PPPoE username is missing.');return;}
            try{
                const data=await jsonFetch('/api/customers/profile?username='+encodeURIComponent(username)),customer=data.customer||{};
                if(!customer.username)throw new Error('Customer details could not be loaded for '+username+'.');
                await populateCustomerEditForm(customer,customer.username);
                const modal=ensureCustomerEditFormModal();
                if(!modal)throw new Error('Bootstrap modal is unavailable. Refresh the admin panel and try again.');
                modal.show();
            }catch(error){console.error('[Customer Edit Form]',error);alert(error.message||'Unable to open customer edit form.');}
        }

        async function deleteCustomer(customerId, username) {
            const id=String(customerId||'').trim(), name=String(username||'').trim();
            if(!id && !name)return;
            if(!name){alert('Cannot safely delete this customer: PPPoE username is missing. No records were changed.');return;}
            if(!confirm('Are you sure you want to permanently delete "'+name+'" from MikroTik and Database?'))return;
            const typedUsername=prompt('Type the exact PPPoE username "'+name+'" to confirm permanent deletion:');
            if(typedUsername===null)return;
            if(String(typedUsername).trim().toLowerCase()!==name.toLowerCase()){
                alert('Username did not match. No customer records were deleted.');
                return;
            }
            const row=Array.from(document.querySelectorAll('#customerFilterBody tr[data-customer-row]')).find(function(el){
                return String(el.dataset.customerId||el.dataset.id||'')===id;
            });
            const button=row?.querySelector('.action-delete-btn');
            if(button?.disabled)return;
            if(button)button.disabled=true;
            try{
                // Await the server transaction completely before mutating local state.
                const data=await jsonFetch('/api/customers/'+encodeURIComponent(id||name),{
                    method:'DELETE',
                    headers:{'Content-Type':'application/json'},
                    body:JSON.stringify({username:name})
                });

                if(!(data&&data.success!==false))throw new Error(data?.message||'Customer deletion failed.');

                window.__deletedCustomerIds = window.__deletedCustomerIds instanceof Set ? window.__deletedCustomerIds : new Set();
                window.__deletedCustomerUsernames = window.__deletedCustomerUsernames instanceof Set ? window.__deletedCustomerUsernames : new Set();
                if(id)window.__deletedCustomerIds.add(id);
                if(name)window.__deletedCustomerUsernames.add(name.toLowerCase());

                currentCustomerUsers = (currentCustomerUsers||[]).filter(function(user){
                    return String(user?.customer_id||user?.id||'')!==id && String(user?.username||'').toLowerCase()!==name.toLowerCase();
                });
                if(Array.isArray(window.cachedCustomers)){
                    window.cachedCustomers = window.cachedCustomers.filter(function(user){
                        return String(user?.customer_id||user?.id||'')!==id && String(user?.username||'').toLowerCase()!==name.toLowerCase();
                    });
                }

                // Remove the exact row immediately; the deleted-id guard also blocks
                // a stale in-flight polling response from rendering it again.
                document.querySelectorAll('#customerFilterBody tr[data-customer-row]').forEach(function(el){
                    const rowId=String(el.dataset.customerId||el.dataset.id||'');
                    const rowUsername=String(el.dataset.username||'').toLowerCase();
                    if((id&&rowId===id)||(name&&rowUsername===name.toLowerCase()))el.remove();
                });

                if(typeof showCustomerActionToast==='function')showCustomerActionToast(data.message||'Customer deleted successfully.');
                else alert(data.message||'Customer deleted successfully.');
            }catch(error){
                if(button)button.disabled=false;
                alert(error.message||'Unable to delete customer.');
            }
        }

        async function quickRenewCustomer(customerId, packagePrice) {
            const id=String(customerId||'').trim();
            if(!id)return;
            let price=Number(packagePrice||0), name='Customer';
            const localUser=currentCustomerUsers.find(function(u){return String(u.customer_id||u.id||'')===id;});
            name=String(localUser?.full_name||localUser?.fullName||localUser?.name||localUser?.username||name);
            if(!Number.isFinite(price)||price<=0){
                try{
                    const details=await jsonFetch('/api/customers/'+encodeURIComponent(id)+'/profile');
                    price=Number(details.package?.price||details.customer?.monthly_bill||0);
                    name=String(details.customer?.fullName||details.customer?.name||details.customer?.username||name);
                }catch(error){ alert(error.message||'Unable to load customer package price.'); return; }
            }
            if(!Number.isFinite(price)||price<0){alert('Package price is unavailable.');return;}
            if(!confirm('Renew '+name+' for 1 Month (৳'+price.toFixed(2)+')?'))return;
            const row=Array.from(document.querySelectorAll('#customerFilterBody tr[data-customer-row]')).find(function(el){return String(el.dataset.id||'')===id;});
            const button=row?.querySelector('.action-renew-btn');
            if(button?.disabled)return;
            if(button)button.disabled=true;
            try{
                const data=await jsonFetch('/api/customers/'+encodeURIComponent(id)+'/renew',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({amount:price,paymentMethod:'CASH',trxId:'CASH-RENEW-'+Date.now()})});
                await refreshCustomerSection();
                if(typeof showCustomerActionToast==='function')showCustomerActionToast(data.message||'Customer renewed successfully.');
                else alert(data.message||'Customer renewed successfully.');
            }catch(error){
                if(button)button.disabled=false;
                alert(error.message||'Unable to renew customer.');
            }
        }

        try {
            window.openCustomerEditModal=openCustomerEditModal;
        window.openCustomerEditForm=openCustomerEditForm;
            window.deleteCustomer=deleteCustomer;
            window.quickRenewCustomer=quickRenewCustomer;
        } catch (actionInitError) {
            console.error('[Customer Actions] Initialization failed:', actionInitError);
        }

        try {
        window.deleteCustomer=deleteCustomer;
        window.quickRenewCustomer=quickRenewCustomer;

        if(!window.__customerActionDelegationBound){
            document.addEventListener('click',async function(event){
                const profileLink=event.target.closest('.customer-profile-link');
                const editBtn=event.target.closest('.action-edit-btn');
                const paidBtn=event.target.closest('.action-paid-btn');
                const viewBtn=event.target.closest('.action-view-btn');
                if(editBtn){
                    event.preventDefault();
                    event.stopPropagation();
                    const customerId=String(editBtn.dataset.id||'').trim();
                    const username=String(editBtn.dataset.username||'').trim();
                    if(editBtn.disabled)return;
                    if(customerId&&typeof window.openCustomerEditModal==='function'){
                        window.openCustomerEditModal(customerId);
                    }else if(username){
                        window.openCustomerProfile(username);
                    }else{
                        alert('Customer ID or PPPoE username is missing.');
                    }
                    return;
                }
                const username=String((profileLink||paidBtn||viewBtn)?.dataset?.username||'').trim();
                if(!username)return;
                if(profileLink){
                    // Customer 360 is a dedicated page, not the missing editCustomerModal.
                    // Follow the standard server route so the browser requests /admin/customers/:username.
                    event.preventDefault();
                    window.location.assign(profileLink.href);
                    return;
                }
                if(paidBtn){
                    event.preventDefault();
                    if(String(paidBtn.dataset.status||'').toLowerCase()==='paid')return;
                    if(!confirm('Mark "'+username+'" as paid for the current billing cycle?'))return;
                    if(paidBtn.disabled)return;
                    paidBtn.disabled=true;
                    try{
                        const data=await jsonFetch('/api/customers/mark-paid',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({username})});
                        paidBtn.innerHTML='Paid';paidBtn.dataset.status='Paid';paidBtn.title='Already paid for current cycle';
                        paidBtn.classList.remove('btn-danger','btn-outline-success');paidBtn.classList.add('btn-success','text-white');
                        const billingBadge=paidBtn.closest('tr')?.querySelector('.customer-billing-badge');
                        if(billingBadge){billingBadge.className='badge bg-success-subtle text-success border customer-billing-badge ms-1';billingBadge.textContent='Paid';}
                        if(data.message)console.info(data.message);
                    }catch(error){alert(error.message||'Unable to mark bill as paid.');}
                    finally{paidBtn.disabled=false;}
                    return;
                }
                if(viewBtn){event.preventDefault();viewCustomerDetails(encodeURIComponent(username));}
            });
            window.__customerActionDelegationBound=true;
        }
        } catch (actionBindingError) {
            console.error('[Customer Actions] Event binding failed:', actionBindingError);
        }

        function customerBillingCounts(users) {
            return (users || []).reduce(function(counts, user) {
                const status = String(user?.billing_status || 'unpaid').toLowerCase();
                if (status === 'paid') counts.paid++; else if (status === 'due') counts.due++; else counts.unpaid++;
                counts.all++; return counts;
            }, {all:0,paid:0,due:0,unpaid:0});
        }

