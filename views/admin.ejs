                <article class="noc-kpi noc-blue"><div class="noc-kpi-top">TODAY'S BILLING</div><div class="noc-kpi-value noc-billing-value" id="nocBillingToday">৳ 0.00</div><div class="noc-kpi-sub noc-billing-sub" id="nocBillingSub">0 Transactions Today • MTD ৳3,330.00</div><button class="noc-kpi-action-link" onclick="loadPaymentsSection('all','all_payments')">Open collections</button></article>
                <article class="noc-kpi noc-amber"><div class="noc-kpi-top">OPTICAL / FIBER HEALTH</div><div class="noc-kpi-value noc-fiber-value" id="nocFiberValue">— Online • — Alert</div><div class="noc-kpi-sub noc-fiber-sub"><i class="bi bi-exclamation-triangle-fill" aria-hidden="true"></i><span id="nocFiberSub">Waiting for OLT telemetry</span></div><div class="noc-fiber-meta"><span id="nocPonSummary">PON —/—</span><button class="noc-kpi-action-link" onclick="window.loadOltManagement('overview')">Open OLT</button></div></article>
