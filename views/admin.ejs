        function openHotspotProfileModal(profileName) {
            const existing=profileName?currentHotspotProfiles.find(function(p){return String(p.name)===String(profileName);}):null;
            let modal=document.getElementById('hotspotProfileModal');
            if(!modal){
                modal=document.createElement('div');modal.id='hotspotProfileModal';modal.className='modal fade';modal.tabIndex=-1;modal.setAttribute('role','dialog');modal.setAttribute('aria-modal','true');modal.setAttribute('aria-labelledby','hotspotProfileModalTitle');
                modal.innerHTML='<div class="modal-dialog modal-lg modal-dialog-centered"><div class="modal-content border-0 shadow-lg"><div class="modal-header bg-light"><div><h5 id="hotspotProfileModalTitle" class="modal-title fw-bold"><i class="bi bi-wifi text-success me-2"></i>Create Hotspot Profile</h5><div class="small text-muted">Set speed, price, and custom time or data validity.</div></div><button type="button" class="btn-close" data-bs-dismiss="modal"></button></div><form id="hotspotProfileForm"><div class="modal-body p-4"><input type="hidden" id="hotspotProfileOriginalName"><div class="row g-3"><div class="col-md-6"><label class="form-label fw-semibold">Profile Name</label><input id="hotspotProfileName" class="form-control" required maxlength="100" placeholder="Profile-1Day"></div><div class="col-md-6"><label class="form-label fw-semibold">Speed Limit / Rate Limit (RX/TX) (Optional)</label><input id="hotspotProfileRate" class="form-control" type="text" placeholder="e.g., 50M/50M (leave blank for Unlimited speed)" autocomplete="off"></div><div class="col-md-4"><label class="form-label fw-semibold">Price (৳ BDT)</label><input id="hotspotProfilePrice" type="number" min="0" step="0.01" class="form-control" value="20" required></div><div class="col-md-4"><label class="form-label fw-semibold">Shared Users</label><input id="hotspotProfileShared" type="number" min="1" step="1" class="form-control" value="1" required></div><div class="col-md-4"><label class="form-label fw-semibold">Validity Value</label><input id="hotspotProfileValidityValue" type="number" min="1" step="1" class="form-control" value="1" required></div><div class="col-md-6"><label class="form-label fw-semibold">Validity Unit</label><select id="hotspotProfileValidityUnit" class="form-select" required><option value="minutes">Minutes</option><option value="hours">Hours</option><option value="days" selected>Days</option><option value="gb">GB (data quota, no time limit)</option></select></div><div class="col-md-6"><label class="form-label fw-semibold">Resolved Validity</label><div id="hotspotProfileValidityPreview" class="form-control bg-light fw-semibold">1 Day</div></div><div class="col-12"><label class="form-label fw-semibold">RouterOS On-Login Policy Preview</label><textarea id="hotspotProfileOnLogin" class="form-control font-monospace small" rows="6" readonly></textarea><div class="form-text">This exact script is generated by the backend used by Save Profile and Sync All Profiles. Previewing is read-only; Save Profile or Sync All Profiles applies it to MikroTik.</div></div></div><div id="hotspotProfileFormResult" class="small mt-3" role="status" aria-live="polite"></div></div><div class="modal-footer"><button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button><button type="submit" class="btn btn-theme" id="hotspotProfileSave"><i class="bi bi-cloud-check me-1"></i>Save Profile to MikroTik</button></div></form></div></div>';
                document.body.appendChild(modal);
                let previewSequence=0,previewTimer=null;
                function refreshPreview(){
                    const value=Math.max(1,Math.floor(Number(document.getElementById('hotspotProfileValidityValue').value||1)));
                    const unit=document.getElementById('hotspotProfileValidityUnit').value||'days';
                    const suffix={minutes:'m',hours:'h',days:'d',gb:'GB'}[unit]||'d';
                    const label={minutes:'Minute',hours:'Hour',days:'Day',gb:'GB'}[unit]||'Day';
                    const resolved=unit==='gb'?value+' GB':value+' '+label+(value===1?'':'s');
                    const preview=document.getElementById('hotspotProfileValidityPreview');
                    if(preview)preview.textContent=resolved+(unit==='gb'?' · '+(value*1073741824).toLocaleString('en-GB')+' bytes':' · '+value+suffix);
                    const script=document.getElementById('hotspotProfileOnLogin');
                    if(!script)return;
                    const requestId=++previewSequence;
                    if(previewTimer)window.clearTimeout(previewTimer);
                    script.value='Generating the exact backend RouterOS script…';
                    previewTimer=window.setTimeout(async function(){
                        try{
                            const data=await jsonFetch('/api/hotspot/profiles/script-preview',{method:'POST',headers:{'Content-Type':'application/json','Accept':'application/json'},body:JSON.stringify({
                                name:String(document.getElementById('hotspotProfileName').value||'profile').trim(),
                                sharedUsers:Number(document.getElementById('hotspotProfileShared').value||1),
                                validityValue:value,
                                validityUnit:unit
                            })});
                            if(requestId!==previewSequence)return;
                            if(!data||data.success===false||typeof data.onLogin!=='string')throw new Error(data&&data.message||'Preview response was invalid.');
                            script.value=data.onLogin;
                            script.dataset.scriptVersion=data.scriptVersion||'';
                        }catch(error){
                            if(requestId!==previewSequence)return;
                            script.value='Unable to load the executable script preview: '+(error.message||'Unknown error');
                        }
                    },180);
                }
                ['hotspotProfileValidityValue','hotspotProfileValidityUnit','hotspotProfileName'].forEach(function(id){const el=document.getElementById(id);el.addEventListener('input',refreshPreview);el.addEventListener('change',refreshPreview);});
                document.getElementById('hotspotProfileForm').onsubmit=async function(event){
                    event.preventDefault();
                    const button=document.getElementById('hotspotProfileSave'),result=document.getElementById('hotspotProfileFormResult');
                    const original=document.getElementById('hotspotProfileOriginalName').value.trim(),name=document.getElementById('hotspotProfileName').value.trim(),rateLimit=document.getElementById('hotspotProfileRate').value.trim(),validityValue=Number(document.getElementById('hotspotProfileValidityValue').value),validityUnit=document.getElementById('hotspotProfileValidityUnit').value,price=Number(document.getElementById('hotspotProfilePrice').value),sharedUsers=Number(document.getElementById('hotspotProfileShared').value);
                    if(!name||!Number.isSafeInteger(validityValue)||validityValue<1||!Number.isFinite(price)||price<0||!Number.isSafeInteger(sharedUsers)||sharedUsers<1){if(result)result.textContent='Enter a profile name, non-negative price, and positive whole-number validity/shared users.';return;}
                    button.disabled=true;if(result){result.className='small mt-3 text-muted';result.textContent='Saving profile and package metadata…';}
                    try{
                        const response=await fetch(original?'/api/hotspot/profiles/'+encodeURIComponent(original):'/api/hotspot/profiles/create',{method:original?'PUT':'POST',headers:{'Content-Type':'application/json','Accept':'application/json'},body:JSON.stringify({name,rateLimit,sharedUsers,validityValue,validityUnit,price})});
                        const data=await response.json();if(!response.ok||data.success===false)throw new Error(data.message||data.error||'Unable to save profile.');
                        bootstrap.Modal.getInstance(modal)?.hide();await loadHotspotProfiles('hotspot_profile');
                    }catch(error){if(result){result.className='small mt-3 text-danger fw-semibold';result.textContent=error.message||'Profile save failed.';}else alert(error.message);}finally{button.disabled=false;}
                };
            }
            const set=function(id,value){const el=document.getElementById(id);if(el)el.value=value;};
            set('hotspotProfileOriginalName',existing?.name||'');set('hotspotProfileName',existing?.name||'');set('hotspotProfileRate',existing?.rateLimit||existing?.['rate-limit']||'');set('hotspotProfilePrice',Number(existing?.price||0).toFixed(2));set('hotspotProfileShared',Number(existing?.sharedUsers||existing?.['shared-users']||1));
            const match=String(existing?.sessionTimeout||existing?.['session-timeout']||'1d').match(/^(\d+)(m|h|d)$/i);
            set('hotspotProfileValidityValue',existing?.validityValue||(match?Number(match[1]):1));
            set('hotspotProfileValidityUnit',existing?.validityUnit||(match?({m:'minutes',h:'hours',d:'days'}[match[2].toLowerCase()]):'days'));
            const nameField=document.getElementById('hotspotProfileName');if(nameField){nameField.readOnly=Boolean(existing);nameField.disabled=false;}const modalTitle=document.getElementById('hotspotProfileModalTitle');if(modalTitle)modalTitle.innerHTML='<i class="bi bi-wifi text-success me-2"></i>'+(existing?'Edit Hotspot Profile':'Create Hotspot Profile');const saveButton=document.getElementById('hotspotProfileSave');if(saveButton)saveButton.innerHTML='<i class="bi bi-cloud-check me-1"></i>'+(existing?'Update Profile':'Save Profile to MikroTik');
            const result=document.getElementById('hotspotProfileFormResult');if(result){result.className='small mt-3';result.textContent='';}
            ['hotspotProfileValidityValue','hotspotProfileValidityUnit','hotspotProfileName'].forEach(function(id){document.getElementById(id)?.dispatchEvent(new Event('input'));});
            if(modal.parentElement!==document.body)document.body.appendChild(modal);
            document.querySelectorAll('.modal-backdrop').forEach(function(el){el.remove();});document.body.classList.remove('modal-open');
            bootstrap.Modal.getOrCreateInstance(modal,{backdrop:'static',keyboard:true}).show();
        }
        async function syncHotspotProfiles(button){
            if(!button||button.disabled)return;
            const previous=button.innerHTML;
            button.disabled=true;
            button.innerHTML='<span class="spinner-border spinner-border-sm me-1" aria-hidden="true"></span>Syncing…';
            try{
                const data=await jsonFetch('/api/hotspot/profiles/sync',{method:'POST',headers:{'Content-Type':'application/json','Accept':'application/json'},body:JSON.stringify({})});
                const sync=data.sync||{},auth=sync.serverAuth||{};
                const summary='Hotspot User Profiles: '+Number(sync.updated||0)+' updated, '+Number(sync.unchanged||0)+' already up-to-date, '+Number(sync.ineligible||0)+' not eligible for time-profile sync, '+Number(sync.failed||0)+' failed. MAC authentication: '+Number(auth.updated||0)+' server profile(s) updated, '+Number(auth.skipped||0)+' already correct, '+Number(auth.failed||0)+' failed.';
                await loadHotspotProfiles('hotspot_profile');
                alert(summary);
            }catch(error){alert(error.message||'Hotspot profile sync failed.');}
            finally{
                const current=document.querySelector('.hotspot-dynamic-view button[onclick="syncHotspotProfiles(this)"]');
                if(current){current.disabled=false;current.innerHTML=previous;}
            }
        }
        window.syncHotspotProfiles = syncHotspotProfiles;
        window.loadHotspotProfiles = loadHotspotProfiles;
        function editHotspotProfile(name){ if(!name)return; openHotspotProfileModal(name); }
        async function deleteHotspotProfile(name){
            if(!name)return; if(!confirm('Delete Hotspot profile "'+name+'" from MikroTik?'))return;
            try{await jsonFetch('/api/hotspot/profiles/delete',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({name:name})});await loadHotspotProfiles('hotspot_profile');}
            catch(error){alert(error.message);}
        }

        function voucherCardHtml(v) {
            const qrPayload=escapeHtml(JSON.stringify({pin:v.username,password:v.password}));
            return '<div class="voucher-card"><div class="voucher-brand">FAZ NETWORK Wi-Fi Hotspot</div><div class="voucher-cut"></div><div class="voucher-qr" data-payload="'+qrPayload+'"></div><div class="small text-muted" data-key="username_label">Username / PIN</div><div class="voucher-credential">'+escapeHtml(v.username)+'</div><div class="small text-muted mt-1" data-key="password_pin">Password / PIN</div><div class="voucher-credential">'+escapeHtml(v.password)+'</div><div class="d-flex justify-content-between mt-2 small"><span>Profile: <strong>'+escapeHtml(v.profile||'-')+'</strong></span><span>Validity: <strong>'+escapeHtml(v.validity||'-')+'</strong></span></div><div class="fw-bold mt-1">Price: ৳ '+Number(v.price||0).toFixed(2)+'</div><div class="voucher-cut"></div><div class="voucher-instruction"><span data-key="instructions">Scan QR or connect to Wi-Fi and enter PIN/password</span></div></div>';
        }

        function renderVoucherCards(vouchers) {
            currentVoucherBatch=vouchers||[];
            const area=document.getElementById('voucherPrintArea') || document.getElementById('hotspotVoucherPrint');
            if(area) { area.innerHTML='<div class="voucher-grid">'+currentVoucherBatch.map(voucherCardHtml).join('')+'</div>'; if(typeof QRCode!=='undefined') area.querySelectorAll('.voucher-qr').forEach(function(node){new QRCode(node,{text:node.dataset.payload,width:86,height:86,correctLevel:QRCode.CorrectLevel.M});}); else console.warn('[HOTSPOT VOUCHERS] QR library unavailable; QR codes were not rendered.'); }
        }

        window.loadVoucherGeneratorSection = async function loadVoucherGeneratorSection() {
            currentHotspotMode='generator'; currentHotspotTitleKey='gen_print_vouchers'; setHotspotTitle('gen_print_vouchers');
            appendHotspotView('<section class="hotspot-dynamic-view admin-view"><div class="row g-4"><div class="col-12"><div class="card card-custom"><div class="card-custom-header"><i class="bi bi-ticket-perforated text-success fs-5"></i><span data-key="gen_print_vouchers">'+escapeHtml(hotspotTitle('gen_print_vouchers'))+'</span></div><div class="card-body"><form id="voucherGeneratorForm"><div class="row g-3"><div class="col-md-2"><label class="form-label" data-key="quantity">Quantity</label><input id="voucherQuantity" type="number" class="form-control" min="1" max="500" value="10" required></div><div class="col-md-2"><label class="form-label" data-key="user_prefix">User Prefix</label><input id="voucherPrefix" class="form-control" value="FAZ-" maxlength="20"></div><div class="col-md-2"><label class="form-label" data-key="character_length">PIN Length</label><input id="voucherCharLength" type="number" class="form-control" min="4" max="16" value="6" required></div><div class="col-md-4"><label class="form-label" data-key="profile">Existing Hotspot Profile</label><select id="voucherProfile" class="form-select" required><option value="">Loading profiles...</option></select><small id="voucherProfileValidity" class="text-muted">Validity is inherited from the selected profile.</small></div><div class="col-md-2"><label class="form-label" data-key="price">Price</label><input id="voucherPrice" type="number" class="form-control" min="0" step="0.01" value="20" required></div><div class="col-12 d-flex justify-content-end gap-2 mt-3"><button type="submit" class="btn btn-theme"><i class="bi bi-magic me-1"></i> <span data-key="generate_batch_vouchers">Generate Batch Vouchers</span></button><button type="button" class="btn btn-outline-success" onclick="printVoucherCards()">🖨️ <span data-key="print_voucher_cards">Print Voucher Cards</span></button></div></div></form><div id="voucherGeneratorStatus" class="mt-3" role="status" aria-live="polite"></div></div></div></div><div class="col-12"><div class="card card-custom"><div class="card-custom-header"><i class="bi bi-collection text-success fs-5"></i> Unused Voucher Batches</div><div class="card-body"><div class="small text-muted mb-3">Generated scratch cards remain available here until claimed. Open any batch to preview or print the remaining unused cards.</div><div id="unusedVoucherBatches"><div class="text-center py-3 text-muted">Loading saved batches...</div></div></div></div></div><div class="col-12"><div class="card card-custom"><div class="card-custom-header"><i class="bi bi-printer text-success fs-5"></i> <span data-key="printable_voucher_cards">Printable Voucher Cards</span> <span id="voucherBatchCount" class="badge bg-success ms-2">0</span></div><div class="card-body" id="voucherPrintArea"><div class="text-center py-5 text-muted">Generate a voucher batch to preview printable cards.</div></div></div></div></div></section>');
            const form=document.getElementById('voucherGeneratorForm');
            const select=document.getElementById('voucherProfile');
            const status=document.getElementById('voucherGeneratorStatus');
            try {
                const data=await jsonFetch('/api/hotspot/profiles');
                const profiles=(data.profiles||[]).filter(function(p){return p.name&&String(p.name).toLowerCase()!=='default';});
                select.innerHTML='<option value="">Select a Hotspot profile</option>'+profiles.map(function(p){const validity=p.validityLabel||((p.validityValue&&p.validityUnit)?p.validityValue+' '+p.validityUnit:'Profile configured validity');return '<option value="'+escapeHtml(p.name)+'" data-validity="'+escapeHtml(validity)+'">'+escapeHtml(p.name)+(p.rateLimit?' — '+escapeHtml(p.rateLimit):'')+'</option>';}).join('');
                if(!profiles.length) select.innerHTML='<option value="">No MikroTik profiles found</option>';
                const updateValidityLabel=function(){const selected=select.options[select.selectedIndex];const label=document.getElementById('voucherProfileValidity');if(label)label.textContent=selected&&selected.value?'Profile validity: '+(selected.dataset.validity||'Configured on the selected profile'):'Validity will come from the selected profile.';};
                select.addEventListener('change',updateValidityLabel);updateValidityLabel();
            } catch(error) {
                if(select) select.innerHTML='<option value="">Could not load profiles</option>';
                if(status)status.innerHTML='<div class="alert alert-danger mb-0">'+escapeHtml(error.message||'Failed to load Hotspot profiles.')+'</div>';
            }
            if(form)form.addEventListener('submit',generateVoucherBatch);
            await loadUnusedVoucherBatches();
        }

        async function loadUnusedVoucherBatches(){
            const target=document.getElementById('unusedVoucherBatches');if(!target)return;
            try{
                const data=await jsonFetch('/api/hotspot/vouchers/batches');
                const batches=Array.isArray(data.batches)?data.batches:[];
                if(!batches.length){target.innerHTML='<div class="text-center py-4 text-muted">No unused batches. Newly generated batches will be saved here automatically.</div>';return;}
                target.innerHTML='<div class="table-responsive"><table class="table table-sm table-hover align-middle mb-0"><thead><tr><th>Generated</th><th>Batch ID</th><th>Profile</th><th>Unused</th><th>Price</th><th>Action</th></tr></thead><tbody>'+batches.map(function(b){
                    const date=b.created_at?new Date(b.created_at).toLocaleString('en-GB',{timeZone:'Asia/Dhaka',day:'2-digit',month:'2-digit',year:'numeric',hour:'2-digit',minute:'2-digit'}):'—';
                    return '<tr><td>'+escapeHtml(date)+'</td><td><code>'+escapeHtml(String(b.batch_id||'').slice(0,8))+'</code></td><td>'+escapeHtml(b.profile||'—')+'</td><td><span class="badge bg-success">'+escapeHtml(b.unused_count||0)+'</span></td><td>৳'+escapeHtml(Number(b.price||0).toFixed(2))+'</td><td><button type="button" class="btn btn-outline-success btn-sm" data-batch-id="'+escapeHtml(b.batch_id||'')+'" onclick="window.openSavedVoucherBatch(this.dataset.batchId)"><i class="bi bi-printer me-1"></i>Re-open / Print</button></td></tr>';
                }).join('')+'</tbody></table></div>';
            }catch(error){target.innerHTML='<div class="alert alert-warning mb-0">Could not load saved voucher batches: '+escapeHtml(error.message||'Request failed')+'</div>';}
        }

        window.openSavedVoucherBatch=async function(batchId){
            const status=document.getElementById('voucherGeneratorStatus');
            try{
                const data=await jsonFetch('/api/hotspot/vouchers/batches/'+encodeURIComponent(batchId));
                const vouchers=Array.isArray(data.vouchers)?data.vouchers:[];
                if(!vouchers.length)throw new Error('This batch has no unused vouchers left to print.');
                renderVoucherCards(vouchers);
                safeSetText('voucherBatchCount',vouchers.length);
                if(status)status.innerHTML='<div class="alert alert-success mb-0">Loaded '+vouchers.length+' unused voucher(s) from saved batch '+escapeHtml(String(batchId).slice(0,8))+'.</div>';
                document.getElementById('voucherPrintArea')?.scrollIntoView({behavior:'smooth',block:'start'});
            }catch(error){if(status)status.innerHTML='<div class="alert alert-warning mb-0">'+escapeHtml(error.message||'Could not open saved batch.')+'</div>';}
        };

        async function generateVoucherBatch(event) {
            event.preventDefault();
            const btn=event.submitter||document.querySelector('#voucherGeneratorForm button[type="submit"]');
            const status=document.getElementById('voucherGeneratorStatus');
            if(btn){btn.disabled=true;btn.innerHTML='<span class="spinner-border spinner-border-sm me-1"></span> Generating...';}
            if(status)status.replaceChildren();
            try {
                const payload={quantity:Number(document.getElementById('voucherQuantity').value),profile:document.getElementById('voucherProfile').value,price:Number(document.getElementById('voucherPrice').value),userPrefix:document.getElementById('voucherPrefix').value.trim(),charLength:Number(document.getElementById('voucherCharLength').value)};
                const data=await jsonFetch('/api/hotspot/vouchers/generate',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify(payload)});
                if(!data||data.success===false)throw new Error(data&&(data.error||data.message)||'Voucher generation failed.');
                renderVoucherCards(data.vouchers||[]);
                safeSetText('voucherBatchCount',data.count||0);
                if(status)status.innerHTML='<div class="alert alert-success mb-0">'+escapeHtml(data.message||('Generated '+(data.count||0)+' vouchers.'))+' Batch ID: <code>'+escapeHtml(data.batchId||'')+'</code></div>';
                await loadUnusedVoucherBatches();
            } catch(error) {
                if(status)status.innerHTML='<div class="alert alert-danger mb-0">'+escapeHtml(error.message||'Voucher generation failed.')+'</div>';
                else alert(error.message||'Voucher generation failed.');
            } finally {
                if(btn){btn.disabled=false;btn.innerHTML='<i class="bi bi-magic me-1"></i> <span data-key="generate_batch_vouchers">Generate Batch Vouchers</span>';}
            }
        }

        function printVoucherCards() {
            if(!currentVoucherBatch.length){alert(hotspotTitle('generate_first'));return;}
            document.body.classList.add('hotspot-printing');
            setTimeout(function(){window.print();},50);
            setTimeout(function(){document.body.classList.remove('hotspot-printing');},1000);
        }


        const _existingUpdateLanguage = updateLanguage;
        updateLanguage = function(lang) {
            _existingUpdateLanguage(lang);
            if(currentHotspotTitleKey && translations[lang]?.[currentHotspotTitleKey]) {
                setPageTitleSafe(translations[lang][currentHotspotTitleKey]);
            }
        };
    </script>
