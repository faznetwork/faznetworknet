                    : '<div class="row g-3 mb-4"><div class="col-12 col-sm-6"><div class="border rounded-4 p-3 h-100"><div class="small text-muted">Online PPPoE sessions</div><div class="h3 fw-bold mb-0">' + sessions.length + '</div></div></div><div class="col-12 col-sm-6"><div class="border rounded-4 p-3 h-100"><div class="small text-muted">Data source</div><div class="mt-1"><span class="badge ' + sourceClass + '">' + escapeHtml(source) + '</span></div></div></div></div>';
                const rows = sessions.map(session => {
                    const user = escapeHtml(session.username || '—');
                    const ip = escapeHtml(session.address || '—');
                    const uptime = escapeHtml(session.uptime || '—');
                    const service = escapeHtml(session.service || 'PPPoE');
                    const caller = escapeHtml(session.callerId || '—');
                    return '<tr><td class="fw-semibold text-break">' + user + '</td><td class="text-nowrap">' + ip + '</td><td class="text-nowrap">' + uptime + '</td><td>' + service + '</td><td class="text-break">' + caller + '</td>' + (isUsage ? '<td class="text-nowrap">' + formatBytes(session.bytesIn) + '</td><td class="text-nowrap">' + formatBytes(session.bytesOut) + '</td>' : '') + '</tr>';
                }).join('');
                content.innerHTML = summary + (data.source === 'recent-router-snapshot' ? '<div class="alert alert-warning small">MikroTik live query was unavailable. These rows came from a recent stored snapshot and may not reflect the exact current state.</div>' : '') +
                    '<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-2"><h3 class="h6 fw-bold mb-0">' + (isUsage ? 'Session traffic counters' : 'Online sessions') + '</h3><span class="small text-muted">Source: ' + escapeHtml(source) + '</span></div>' +
                    '<div class="table-responsive border rounded-3"><table class="table table-hover align-middle mb-0"><thead class="table-light"><tr><th>Username</th><th>IP address</th><th>Uptime</th><th>Service</th><th>Caller ID</th>' + (isUsage ? '<th>RX · Download</th><th>TX · Upload</th>' : '') + '</tr></thead><tbody>' +
                    (sessions.length ? rows : '<tr><td colspan="' + (isUsage ? 7 : 5) + '" class="text-center text-muted py-4">No active PPPoE sessions were returned.</td></tr>') +
                    '</tbody></table></div>';
                return true;
            } catch (error) {
                content.innerHTML = '<div class="alert alert-danger mb-0" role="alert">' + escapeHtml(error.message || 'Unable to load active PPPoE sessions.') + '</div>';
                return false;
            }
        };


