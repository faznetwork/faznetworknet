        async function handleCustomerSubmit(e) {
            if (e) e.preventDefault();

            const form = e?.currentTarget || document.getElementById('addCustomerForm');
            const submitBtn = document.getElementById('saveCustomerBtn') || document.querySelector('#addCustomerForm button[type="submit"]');
            const originalText = submitBtn ? submitBtn.innerHTML : 'Save';

            if (submitBtn) {
                submitBtn.disabled = true;
                submitBtn.innerHTML = '<span class="spinner-border spinner-border-sm me-2"></span>Saving to MikroTik...';
            }

            try {
                if (!form) throw new Error('Customer form was not found.');

                if (!form.checkValidity()) {
                    form.classList.add('was-validated');
                    throw new Error('Please complete all required customer fields.');
                }

                const valueOf = (id, fallback = '') => document.getElementById(id)?.value ?? fallback;
                const select = document.getElementById('packageSelect');
                const profile = String(valueOf('packageSelect')).trim();
                const option = select?.options?.[select.selectedIndex] || null;
                const editId = String(valueOf('customerEditId')).trim();

                const payload = {
                    name: String(valueOf('fullName')).trim(),
                    fullName: String(valueOf('fullName')).trim(),
                    phone: String(valueOf('phoneNumber')).trim(),
                    connectionDate: dateInputToIso(valueOf('connectionDate')) || '',
                    activationDate: dateInputToIso(valueOf('activationDate')) || '',
                    expirationDate: dateInputToIso(valueOf('expirationDate')) || '',
                    username: String(valueOf('username')).trim(),
                    password: String(valueOf('password')).trim(),
                    package: option?.textContent?.split(' — ৳')[0]?.trim() || profile,
                    profile,
                    packageProfile: profile,
                    email: String(valueOf('customerEmail')).trim(),
                    whatsappPhone: String(valueOf('customerWhatsappPhone')).trim(),
                    telegramLink: String(valueOf('customerTelegramLink')).trim(),
                    facebookLink: String(valueOf('customerFacebookLink')).trim(),
                    package_id: option?.dataset?.packageId || option?.value || '',
                    nid: String(valueOf('nidNumber')).trim(),
                    installationAddress: String(valueOf('installationAddress')).trim(),
                    areaZone: String(valueOf('areaZone')).trim(),
                    fiberBox: String(valueOf('fiberBox')).trim(),
                    alternativePhone: String(valueOf('alternativePhone')).trim(),
                    oltPonPort: String(valueOf('oltPonPort')).trim(),
                    distributionBox: String(valueOf('fiberBox')).trim(),
                    onuMac: String(valueOf('onuMac')).trim(),
                    onuSerial: String(valueOf('onuSerial')).trim(),
                    fiberDropCore: String(valueOf('fiberDropCore')).trim(),
                    billingCycle: String(valueOf('customerBillingCycle')||'monthly'),
                    billingDurationDays: String(valueOf('customerBillingDays')).trim(),
                    billingStatus: String(valueOf('customerBillingStatus')||'unpaid'),
                    billingExpiryOverride: !Boolean(document.getElementById('customerAutoExpire')?.checked),
                    billing_expiry_override: !Boolean(document.getElementById('customerAutoExpire')?.checked),
                    disabled: !Boolean(document.getElementById('customerAccountEnabled')?.checked),
                    remarks: String(valueOf('customerRemarks')).trim()
                };

                const requiredFields = [
                    ['fullName', payload.fullName],
                    ['phoneNumber', payload.phone],
                    ['connectionDate', payload.connectionDate],
                    ['username', payload.username],
                    ['password', payload.password],
                    ['packageSelect', payload.profile],
                    ['activationDate', payload.activationDate],
                    ['expirationDate', payload.expirationDate]
                ];
                const missingField = requiredFields.find(([id, value]) =>
                    !document.getElementById(id) || !String(value || '').trim()
                );

                if (missingField) {
                    throw new Error('Customer form field is missing or empty: ' + missingField[0]);
                }

                const endpoint = editId
                    ? '/api/customers/' + encodeURIComponent(editId)
                    : '/api/customers';

                const response = await fetch(endpoint, {
                    method: editId ? 'PUT' : 'POST',
                    headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
                    credentials: 'include',
                    body: JSON.stringify(payload)
                });

                const data = await response.json().catch(() => ({}));

                if (!response.ok || data.success === false) {
                    throw new Error(data.message || data.error || ('Server returned HTTP ' + response.status));
                }

                // A successful API response means the customer record is saved. If RouterOS is
                // temporarily unavailable, keep the saved record and show its pending status instead
                // of treating the save as a failure (which could cause duplicate retries).
                alert(data.message || (editId
                    ? 'Customer updated successfully in MikroTik.'
                    : 'Customer saved and provisioned successfully in MikroTik.'));

                form.reset();
                form.querySelectorAll('#connectionDate, #activationDate, #expirationDate').forEach(input => { if (input._flatpickr) input._flatpickr.clear(); });
                form.classList.remove('was-validated');
                const editField = document.getElementById('customerEditId');
                if (editField) editField.value = '';
                if(editId){const editModalEl=document.getElementById('customerEditFormModal');if(editModalEl&&window.bootstrap?.Modal)window.bootstrap.Modal.getOrCreateInstance(editModalEl).hide();}

                if (typeof loadCustomerSection === 'function') {
                    await loadCustomerSection('all', 'all_customer');
                } else if (typeof window.loadCustomers === 'function') {
                    await window.loadCustomers();
                }
            } catch (error) {
                console.error('[CUSTOMER UI] Submission error:', error);
                alert('Failed to Provision: ' + (error?.message || 'Unknown server or MikroTik error'));
            } finally {
                if (submitBtn) {
                    submitBtn.disabled = false;
                    submitBtn.innerHTML = originalText;
                }
            }
        }

        document.getElementById('addCustomerForm')?.addEventListener('submit', handleCustomerSubmit);



