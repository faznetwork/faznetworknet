        function openAddIpPoolModal(){openIpPoolModal();}

        async function saveIpPool(event){
            event.preventDefault();
            const button=document.getElementById('ipPoolSaveBtn'); if(!button)return;
            const oldHtml=button.innerHTML; button.disabled=true; button.innerHTML='<span class="spinner-border spinner-border-sm me-1"></span>Saving...';
            try{
                const payload={
                    originalName:(currentIpPoolEdit?.name||document.getElementById('ipPoolName').value).trim(),
                    name:document.getElementById('ipPoolName').value.trim(),
                    subnet:document.getElementById('ipPoolSubnet').value.trim(),
                    localAddress:document.getElementById('ipPoolLocalAddress').value.trim(),
                    ranges:document.getElementById('ipPoolRanges').value.trim(),
                    nextPool:document.getElementById('ipPoolNext').value||'none'
                };
                if(!payload.name||!payload.localAddress||!payload.ranges)throw new Error('Pool Name, Local Address and Pool Range are required.');
                const endpoint=currentIpPoolEdit?'/api/ip-pools/update':'/api/ip-pools/save';
                const res=await fetch(endpoint,{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify(payload)});
                const data=await res.json().catch(()=>({}));
                if(!res.ok||!data.success){alert('Operation Failed: '+(data.message||res.statusText||'Server error'));return;}
                alert(data.message||'IP Pool saved and synchronized with MikroTik.');
                const modal=bootstrap.Modal.getInstance(document.getElementById('ipPoolModal')); if(modal)modal.hide();
                purgeStuckBackdrops(); currentIpPoolEdit=null; await loadIpPools();
            }catch(error){alert('Operation Failed: '+(error?.message||'Network error while saving IP Pool'));}finally{button.disabled=false;button.innerHTML=oldHtml;}
        }

        async function syncIpPoolsFromMikrotik(){
            const button=document.getElementById('syncIpPoolBtn'); if(button){button.disabled=true;button.innerHTML='<span class="spinner-border spinner-border-sm me-1"></span>Syncing...';}
            try{await jsonFetch('/api/ip-pools/sync',{method:'POST'});await loadIpPools();}
            catch(error){alert(error.message);}
            finally{if(button){button.disabled=false;button.innerHTML='<i class="bi bi-arrow-repeat me-1"></i> Sync from MikroTik';}}
        }

        async function deleteIpPool(id,name){
            const poolName=String(name||id||'').trim();
            if(!poolName||!confirm('Permanently delete IP Pool "'+poolName+'" from MikroTik?'))return;
            const button=Array.from(document.querySelectorAll('.delete-pool-btn')).find(el=>String(el.dataset.name||'')===poolName);
            if(button){button.disabled=true;button.innerHTML='<span class="spinner-border spinner-border-sm"></span>';}
            try{
                const result=await jsonFetch('/api/ip-pools/'+encodeURIComponent(poolName),{method:'DELETE'});
                if(result?.success===false)throw new Error(result.message||'MikroTik did not delete the IP pool.');
                await loadIpPools();
                if(typeof showCustomerActionToast==='function')showCustomerActionToast(result.message||'IP pool deleted from MikroTik.');
            }catch(error){if(button){button.disabled=false;button.innerHTML='<i class="bi bi-trash3"></i> Delete';}alert(error.message||'IP pool deletion failed.');}
        }

        function initIpPoolActionHandlers(){
            if(window.__ipPoolActionHandlersReady)return;
            window.__ipPoolActionHandlersReady=true;
            document.addEventListener('click',function(event){
                const editButton=event.target.closest('.edit-pool-btn');
                if(editButton){event.preventDefault();openIpPoolModal(ipPoolCache[String(editButton.dataset.name).toLowerCase()]||{name:editButton.dataset.name||'',ranges:editButton.dataset.ranges||'',subnet:editButton.dataset.subnet||'',localAddress:editButton.dataset.localAddress||'',nextPool:editButton.dataset.next||'none'});return;}
                const deleteButton=event.target.closest('.delete-pool-btn');
                if(deleteButton){event.preventDefault();deleteIpPool('',deleteButton.dataset.name||'');}
            });
        }
        initIpPoolActionHandlers();


