                }).join('');
                const body=rows||'<tr><td colspan="6" class="text-center py-5 text-muted"><i class="bi bi-wifi fs-2 d-block mb-2"></i>No Hotspot profiles found.</td></tr>';
                appendHotspotView('<section class="hotspot-dynamic-view admin-view"><div class="card card-custom shadow-sm border-0 overflow-hidden"><div class="card-header bg-white border-bottom p-3 p-md-4"><div class="d-flex flex-column flex-md-row align-items-md-center gap-3"><div><div class="d-flex align-items-center gap-2"><h5 class="mb-0 fw-bold">Hotspot Profiles</h5><span class="badge rounded-pill bg-success">'+currentHotspotProfiles.length+'</span></div><div class="small text-muted mt-1">Live RouterOS profiles, package prices and validity</div></div><button type="button" class="btn btn-theme ms-md-auto" onclick="openHotspotProfileModal()"><i class="bi bi-plus-lg me-1"></i>Create Profile</button></div></div><div class="table-responsive"><table class="table table-hover align-middle mb-0 hotspot-profile-table"><thead class="table-light"><tr><th>Profile Name</th><th>Rate Limit (Rx/Tx)</th><th>Price (BDT)</th><th>Validity / Quota</th><th>Shared Users</th><th class="text-end">Actions</th></tr></thead><tbody>'+body+'</tbody></table></div></div></section>');
                updateLanguage(localStorage.getItem('faz_preferred_lang')||'en');
