<script>
        window.updateLanguage = window.updateLanguage || function(){};
        // Defensive UI reset: a stale Bootstrap backdrop must never own the click layer.
        try {
            document.querySelectorAll('.modal-backdrop, .offcanvas-backdrop, .sidebar-backdrop').forEach(el => el.remove());
            document.body.classList.remove('modal-open');
            document.body.style.removeProperty('overflow');
            document.body.style.removeProperty('padding-right');
        } catch (error) {
            console.warn('[Admin Boot] backdrop cleanup failed:', error);
        }

        // Guaranteed Global Fetch Helper
        window.jsonFetch = async function(url, options = {}) {
            const timeoutMs = options.timeout || 8000;
            const controller = new AbortController();
            const timeoutId = setTimeout(() => controller.abort(), timeoutMs);

            try {
                const { timeout: _ignoredTimeout, ...fetchOptions } = options;
                const res = await fetch(url, {
                    credentials: 'include',
                    headers: {
                        'Content-Type': 'application/json',
                        'Accept': 'application/json',
                        ...(fetchOptions.headers || {})
                    },
                    ...fetchOptions,
                    signal: fetchOptions.signal || controller.signal
                });

                clearTimeout(timeoutId);

                if (res.status === 401) {
                    window.location.href = '/login';
                    return { success: false, message: 'Unauthorized. Redirecting...' };
                }

                const contentType = res.headers.get('content-type') || '';
                if (contentType.includes('application/json')) {
                    return await res.json();
                }

                const text = await res.text();
                return { success: res.ok, data: text };
            } catch (err) {
                clearTimeout(timeoutId);
                console.error('[jsonFetch Failed]:', url, err.name === 'AbortError' ? 'Request Timed Out' : err.message);
                return {
                    success: false,
                    message: err.name === 'AbortError' ? 'Request Timed Out' : err.message
                };
            }
        };
        // Alias for backward compatibility
        window.fetchJson = window.jsonFetch;

        function safeSetText(idOrSelector, text) {
            let el = document.getElementById(idOrSelector);
            if (!el && typeof idOrSelector === 'string') {
                el = document.querySelector(idOrSelector);
            }
            if (el) {
                el.innerText = text;
            }
        }

        function setPageTitleSafe(title) {
            const el = document.getElementById('pageTitle') || document.querySelector('.page-title') || document.querySelector('h1, h2, h3');
            if (el) el.innerText = title;
        }
        // Hotspot global entry points: define these before any dependent admin code executes.
        window.loadHotspotDashboard = function() {
            console.log('[HOTSPOT UI] loadHotspotDashboard triggered');
            const dashboard=document.getElementById('view-dashboard');
            if(dashboard) dashboard.style.display='none';
            const container=document.getElementById('dynamicPageContent');
            if(!container) return false;
            container.style.display='block';
            safeSetText('pageTitle', 'Hotspot Dashboard');
            container.innerHTML =
                '<div class="row g-3 mb-4">'+
                    '<div class="col-12 col-sm-6 col-xl-3"><div class="card card-custom p-3 shadow-sm border-0 h-100"><div class="text-muted small">Total Hotspot Users</div><div class="fs-4 fw-bold text-success" id="hsTotal">0</div></div></div>'+
                    '<div class="col-12 col-sm-6 col-xl-3"><div class="card card-custom p-3 shadow-sm border-0 h-100"><div class="text-muted small">Online Clients</div><div class="fs-4 fw-bold text-primary" id="hsOnline">0</div></div></div>'+
                    '<div class="col-12 col-sm-6 col-xl-3"><div class="card card-custom p-3 shadow-sm border-0 h-100"><div class="text-muted small">Offline Users</div><div class="fs-4 fw-bold text-secondary" id="hsOffline">0</div></div></div>'+
                    '<div class="col-12 col-sm-6 col-xl-3"><div class="card card-custom p-3 shadow-sm border-0 h-100"><div class="text-muted small">Vouchers Generated</div><div class="fs-4 fw-bold text-info" id="hsVouchers">0</div></div></div>'+
                '</div>'+
                '<div class="row g-3 mb-4">'+
                    '<div class="col-12 col-sm-6 col-xl-3"><div class="card card-custom p-3 shadow-sm border-0"><div class="text-muted small">Today\'s Revenue</div><div class="fs-4 fw-bold text-warning">৳ <span id="hsRevenue">0.00</span></div></div></div>'+
                '</div>'+
                '<div class="card card-custom p-4 shadow-sm border-0"><p class="text-muted mb-0">Use the submenus on the left to view users or generate new vouchers.</p></div>';
            fetch('/api/hotspot/dashboard-metrics')
                .then(function(response){ return response.json().then(function(data){ return {ok:response.ok,data:data}; }); })
                .then(function(result){
                    const d=result.data||{};
                    if(!result.ok || d.success===false) throw new Error(d.message||d.error||'Unable to load Hotspot dashboard metrics.');
                    safeSetText('hsTotal', Number(d.totalUsers||0));
                    safeSetText('hsOnline', Number(d.onlineClients ?? d.activeUsers ?? 0));
                    safeSetText('hsOffline', Number(d.offlineUsers||0));
                    safeSetText('hsVouchers', Number(d.totalVouchers||0));
                    safeSetText('hsRevenue', Number(d.todayRevenue||0).toFixed(2));
                })
                .catch(function(error){
                    console.warn('[HOTSPOT UI]',error);
                    safeSetText('hsTotal',0);
                    safeSetText('hsOnline',0);
                    safeSetText('hsOffline',0);
                    safeSetText('hsVouchers',0);
                    safeSetText('hsRevenue','0.00');
                });
            return false;
        };

        window.loadHotspotSection = async function(filterType, titleKey) {
            purgeStuckBackdrops();
            currentHotspotMode=filterType || 'all';
            currentHotspotTitleKey=titleKey || (filterType==='active'?'active_user':'all_user');
            setHotspotTitle(currentHotspotTitleKey);
            if(typeof closeSidebarMobile==='function') closeSidebarMobile();

            const container=document.getElementById('dynamicPageContent');
            if(!container) return false;
            const isActive=currentHotspotMode==='active';
            container.style.display='block';
            if(document.getElementById('view-dashboard')) document.getElementById('view-dashboard').style.display='none';

            const loadingTitle=isActive?'Live Active Sessions':'Hotspot Users Database';
            const icon=isActive?'bi-broadcast-pin':'bi-database';
            container.innerHTML='<section class="hotspot-dynamic-view admin-view"><div class="card card-custom shadow-sm border-0 overflow-hidden"><div class="card-header bg-white border-bottom p-3 p-md-4"><div class="d-flex flex-column flex-lg-row align-items-lg-center gap-3"><div><div class="d-flex align-items-center gap-2"><span class="'+(isActive?'hotspot-live-dot':'text-success')+'"><i class="bi '+icon+'"></i></span><h5 class="mb-0 fw-bold">'+loadingTitle+'</h5><span id="hotspotSectionCount" class="badge rounded-pill bg-success">0</span></div><div class="small text-muted mt-1">'+(isActive?'Real-time clients connected to MikroTik Hotspot':'All configured customer accounts from MikroTik Hotspot')+'</div></div><div class="d-flex flex-wrap gap-2 ms-lg-auto">'+
                (isActive?'<button type="button" class="btn btn-outline-success btn-sm" onclick="window.loadHotspotSection(\'active\',\'active_user\')"><i class="bi bi-arrow-clockwise me-1"></i>Refresh</button>':'<div class="input-group input-group-sm hotspot-enterprise-search"><span class="input-group-text bg-white"><i class="bi bi-search"></i></span><input id="hotspotAllSearch" class="form-control" placeholder="Search phone / name..." oninput="filterHotspotRows(this.value)"></div><button type="button" class="btn btn-theme btn-sm" onclick="window.loadAddHotspotUserView()"><i class="bi bi-person-plus-fill me-1"></i>+ Add User</button><button type="button" class="btn btn-outline-success btn-sm" onclick="window.loadHotspotSection(\'all\',\'all_user\')"><i class="bi bi-arrow-repeat me-1"></i>Sync</button>')+
                '</div></div></div><div class="table-responsive"><table class="table table-hover align-middle mb-0 hotspot-enterprise-table"><thead class="table-light">'+
                (isActive?'<tr><th>#</th><th>Username / Phone</th><th>IP Address</th><th>MAC Address</th><th>Current Uptime</th><th>Data Usage</th><th class="text-end">Action</th></tr>':'<tr><th>#</th><th>User / Phone</th><th>Profile / Plan</th><th>Uptime Used</th><th>Status</th><th>Comment</th><th class="text-end">Actions</th></tr>')+
                '</thead><tbody id="hotspotUserBody"><tr><td colspan="'+(isActive?7:7)+'" class="text-center py-5 text-muted"><div class="spinner-border spinner-border-sm text-success me-2"></div>Loading from MikroTik...</td></tr></tbody></table></div></div></section>';

            try {
                if(isActive) {
                    const data=await jsonFetch('/api/hotspot/active');
                    renderActiveHotspotUsers(data.users||[]);
                } else {
                    const results=await Promise.all([jsonFetch('/api/hotspot/users?filter=all'),jsonFetch('/api/hotspot/active')]);
                    renderAllHotspotUsers(results[0].users||[],results[1].users||[]);
                }
            } catch(error) {
