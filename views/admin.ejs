        function formatBdPhoneNumber(phone) {
            if (!phone) return '—';
            try {
                let clean = String(phone).replace(/[^0-9]/g, '');
                if (clean.startsWith('00880')) clean = clean.substring(4);
                else if (clean.startsWith('880')) clean = clean.substring(2);
                else if (clean.startsWith('00')) clean = clean.substring(1);
                if (!clean.startsWith('0') && clean.length === 10) clean = '0' + clean;
                return clean || '—';
            } catch (e) {
                return String(phone || '—');
            }
        }

        function parseCustomerMetadata(user) {
            const rawComment = String(user?.comment || user?.full_name || user?.fullName || user?.name || '').trim();
            let displayName = String(user?.full_name || user?.fullName || user?.name || '-').trim() || '-';
            let displayPhone = formatBdPhoneNumber(user?.phone || user?.phoneNumber || '');
            if (rawComment.includes('|') || /Customer:/i.test(rawComment)) {
                const nameMatch = rawComment.match(/Customer:\s*([^|]+)/i);
                const phoneMatch = rawComment.match(/Phone:\s*([^|]+)/i);
                if (nameMatch?.[1]) displayName = nameMatch[1].trim();
                if (phoneMatch?.[1] && displayPhone === '—') displayPhone = formatBdPhoneNumber(phoneMatch[1].trim());
            }
            return { rawComment, displayName, displayPhone };
        }

        function formatDhakaExpiration(value, rawComment = '') {
            let raw = String(value ?? '').trim();
            if (!raw) {
                const expMatch = rawComment.match(/EXP:\s*([^|]+)/i);
                raw = expMatch?.[1]?.trim() || '';
            }
            if (!raw) return '-';
            if (/^(?:EXPIRED_|UNLIMITED)/i.test(raw)) return 'EXP: ' + raw;
            if (/^\d{2}\/\d{2}\/\d{4}$/.test(raw)) return 'EXP: ' + FazDate.formatDate(raw);
            try {
                const source = /^\d{4}-\d{2}-\d{2}$/.test(raw) ? raw + 'T00:00:00+06:00' : raw;
                const date = new Date(source);
                if (Number.isNaN(date.getTime())) return 'EXP: ' + raw;
                const dateFormatted = new Intl.DateTimeFormat('en-GB', {
                    timeZone: 'Asia/Dhaka', day: '2-digit', month: '2-digit', year: 'numeric'
                }).format(date);
                return 'EXP: ' + dateFormatted;
            } catch (_) {
                return 'EXP: ' + raw;
            }
        }

        function customerStatus(user) {
            const expiry = String(user?.expiration_date || user?.expiry_date || '').trim();
            let expired = false;
            if (/^\d{4}-\d{2}-\d{2}$/.test(expiry)) {
                const expDateObj = new Date(expiry + 'T23:59:59.999+06:00');
                expired = !Number.isNaN(expDateObj.getTime()) && Date.now() > expDateObj.getTime();
            } else if (/^\d{2}\/\d{2}\/\d{4}$/.test(expiry)) {
                const parsed = FazDate.parse(expiry);
                if (parsed) {
                    const endOfDay = new Date(parsed.getTime() + 86400000 - 1);
                    expired = Date.now() > endOfDay.getTime();
                }
            }
            // Ignore stale router/computed flags when the canonical customer expiry is still valid.
            if (expired || (!expiry && String(user?.computed_status || '').toLowerCase() === 'expired')) return { key: 'expired_status', cls: 'bg-danger', online: false };
            if (user?.online) return { key: 'online_status', cls: 'bg-success', online: true };
            return { key: 'offline_status', cls: 'bg-secondary', online: false };
        }

        function isCustomerPaidCurrentCycle(user) {
            const billingStatus = String(user?.billing_status || '').trim().toLowerCase();
            const paidUntil = String(user?.paid_until || '').slice(0, 10);
            const today = new Intl.DateTimeFormat('en-CA', { timeZone: 'Asia/Dhaka', year: 'numeric', month: '2-digit', day: '2-digit' }).format(new Date());
            const expiryRaw = String(user?.expiry_date || '').slice(0, 10);
            const expired = /^\d{4}-\d{2}-\d{2}$/.test(expiryRaw) && Date.now() > new Date(expiryRaw + 'T23:59:59.999+06:00').getTime();
            const accountState = String(user?.status || '').trim().toLowerCase();
            const suspended = Boolean(user?.disabled) || ['expired','suspended','disabled','left','terminated','due'].includes(accountState);
            return billingStatus === 'paid' && /^\d{4}-\d{2}-\d{2}$/.test(paidUntil) && paidUntil >= today && !suspended && !expired;
        }

        function filterCustomerRows(query) {
            const q = String(query || '').trim().toLowerCase();
            // Keep the selected billing filter applied when the search box changes.
            const activeTab = document.querySelector('#customerBillingTabs button[data-billing-filter].active');
            const wanted = String(activeTab?.getAttribute('data-billing-filter') || 'all').toLowerCase();
            document.querySelectorAll('#customerFilterBody tr[data-customer-row]').forEach(row => {
                const rowStatus = String(row.getAttribute('data-billing-status') || 'unpaid').toLowerCase();
                const matchesStatus = wanted === 'all' || rowStatus === wanted;
                const matchesSearch = !q || row.innerText.toLowerCase().includes(q);
                row.style.display = matchesStatus && matchesSearch ? '' : 'none';
            });
        }

