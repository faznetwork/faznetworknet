            try {
                const data = await window.jsonFetch('/api/admin/users');
                let users = Array.isArray(data.users) ? data.users : [];
                if (currentStaffMode === 'sub-staff') users = users.filter(user => user.role === 'staff');
                usersBody.innerHTML = users.length ? users.map(user => {
                    const created = user.created_at ? (typeof FazDate !== 'undefined' ? FazDate.formatDateTime(user.created_at) : user.created_at) : '—';
                    const firstLogin = user.is_first_login ? '<span class="badge text-bg-warning">Pending verification</span>' : '<span class="badge text-bg-success">Complete</span>';
                    const status = user.status === 'disabled' ? '<span class="badge text-bg-secondary">Disabled</span>' : '<span class="badge text-bg-success">Active</span>';
                    const nextStatus = user.status === 'disabled' ? 'active' : 'disabled';
                    const statusLabel = user.status === 'disabled' ? 'Activate' : 'Disable';
                    const resend = user.is_first_login ? '<button type="button" class="btn btn-sm btn-outline-primary" data-user-resend="' + Number(user.id) + '">Resend invite</button>' : '';
                    return '<tr><td class="fw-semibold">' + escapeHtml(user.username) + '</td><td class="text-break">' + escapeHtml(user.email) + '</td><td><span class="badge text-bg-light border">' + escapeHtml(user.role) + '</span></td><td>' + firstLogin + '</td><td>' + status + '</td><td class="text-nowrap">' + escapeHtml(created) + '</td><td><div class="d-flex flex-wrap gap-1">' + resend + '<button type="button" class="btn btn-sm btn-outline-success" data-user-status="' + Number(user.id) + '" data-next-status="' + nextStatus + '">' + statusLabel + '</button><button type="button" class="btn btn-sm btn-outline-danger" data-user-delete="' + Number(user.id) + '">Delete</button></div></td></tr>';
                }).join('') : '<tr><td colspan="7" class="text-center text-muted py-4">No accounts found for this view.</td></tr>';
                usersBody.querySelectorAll('[data-user-status]').forEach(button => button.addEventListener('click', async () => {
                    button.disabled = true;
                    try { await window.jsonFetch('/api/admin/users/' + button.dataset.userStatus + '/status', {method:'PATCH',body:JSON.stringify({status:button.dataset.nextStatus})}); await window.loadStaffManagement(currentStaffMode); }
                    catch(error) { window.alert(error.message || 'Unable to update account status.'); button.disabled = false; }
                }));
                usersBody.querySelectorAll('[data-user-delete]').forEach(button => button.addEventListener('click', async () => {
                    if (!window.confirm('Delete this account? This action cannot be undone.')) return;
                    button.disabled = true;
                    try { await window.jsonFetch('/api/admin/users/' + button.dataset.userDelete, {method:'DELETE'}); await window.loadStaffManagement(currentStaffMode); }
                    catch(error) { window.alert(error.message || 'Unable to delete account.'); button.disabled = false; }
                }));
                usersBody.querySelectorAll('[data-user-resend]').forEach(button => button.addEventListener('click', async () => {
                    button.disabled = true;
                    try { await window.jsonFetch('/api/admin/users/' + button.dataset.userResend + '/resend-invitation', {method:'POST',body:JSON.stringify({})}); window.alert('Invitation resent.'); await window.loadStaffInvitations(currentStaffMode); }
                    catch(error) { window.alert(error.message || 'Unable to resend invitation.'); button.disabled = false; }
                }));
                await window.loadStaffInvitations(currentStaffMode);
                const form = document.getElementById('rbacCreateUserForm');
                if (form && !form.dataset.rbacSubmitBound) {
                    form.dataset.rbacSubmitBound = '1';
                    form.addEventListener('submit', async event => {
                        event.preventDefault();
                        const result = document.getElementById('rbacCreateUserResult');
                        const button = document.getElementById('rbacCreateUserBtn');
                        const payload = {
                            username:document.getElementById('rbacUsername')?.value || '',
                            email:document.getElementById('rbacEmail')?.value || '',
                            role:currentStaffMode === 'sub-staff' || !currentAdminCanInvitePrivileged ? 'staff' : (document.getElementById('rbacRole')?.value || 'staff')
                        };
                        if (button) { button.disabled = true; button.innerHTML = '<span class="spinner-border spinner-border-sm me-2"></span>Sending…'; }
                        if (result) { result.className = 'small'; result.textContent = ''; }
                        try {
                            await window.jsonFetch('/api/admin/users', {method:'POST',body:JSON.stringify(payload)});
                            if (result) { result.className = 'small text-success'; result.textContent = 'Invitation sent successfully. The account activates after email verification.'; }
                            form.reset();
                            if (roleSelect) roleSelect.value = 'staff';
                            await window.loadStaffManagement(currentStaffMode);
                        } catch(error) {
                            if (result) { result.className = 'small text-danger'; result.textContent = error.message || 'Unable to send invitation.'; }
                        } finally {
                            if (button) { button.disabled = false; button.innerHTML = '<i class="bi bi-envelope-paper me-1"></i>Send invitation'; }
                        }
                    });
                }
                return true;
            } catch(error) {
                usersBody.innerHTML = '<tr><td colspan="7" class="text-center text-danger py-4">' + escapeHtml(error.message || 'Unable to load accounts.') + '</td></tr>';
                await window.loadStaffInvitations(currentStaffMode);
                return false;
            }
        };


