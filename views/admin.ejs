<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= (typeof brandSettings!=="undefined" && brandSettings.company_name) || "FAZ NETWORK" %> - Admin Panel</title>
    <% if (typeof brandSettings!=="undefined" && brandSettings.favicon_url) { %><link rel="icon" href="<%= brandSettings.favicon_url %>"><% } %>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=JetBrains+Mono:wght@500;600;700&family=Plus+Jakarta+Sans:wght@500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/flatpickr/dist/flatpickr.min.css">
    <style>
        :root {
            --primary-color: #0a3d2e;
            --primary-hover: #0d4d3a;
            --accent-color: #10b981;
            --sidebar-width: 260px;
        }
        body { 
            background-color: #f8fafc; 
            font-family: 'Segoe UI', Arial, sans-serif; 
            margin: 0;
            padding: 0;
        }
        
        .sidebar {
            width: var(--sidebar-width);
            background-color: var(--primary-color);
            color: #fff;
            position: fixed;
            top: 0;
            bottom: 0;
            left: 0;
            transition: all 0.3s ease;
            z-index: 1000;
            overflow-y: auto;
        }
        .sidebar-header {
            padding: 20px;
            font-size: 20px;
            font-weight: bold;
            border-bottom: 1px solid rgba(255, 255, 255, 0.1);
            display: flex;
            justify-content: space-between;
            align-items: center;
        }
        
        .lang-switcher {
            padding: 10px 20px;
            font-size: 13px;
            border-bottom: 1px solid rgba(255, 255, 255, 0.1);
            display: flex;
            gap: 10px;
            align-items: center;
        }
        .lang-switcher select {
            background: rgba(255, 255, 255, 0.1);
            color: #fff;
            border: 1px solid rgba(255, 255, 255, 0.2);
            padding: 4px 8px;
            border-radius: 5px;
            font-size: 13px;
            cursor: pointer;
            outline: none;
        }
        .lang-switcher select option {
            background-color: var(--primary-color);
            color: #fff;
        }

        .sidebar-menu { 
            list-style: none; 
            padding: 0; 
            margin: 10px 0 30px 0; 
        }
        .menu-item a, .menu-item .dropdown-toggle {
            color: #a7f3d0;
            padding: 12px 20px;
            display: flex;
            align-items: center;
            text-decoration: none;
            transition: all 0.2s;
            cursor: pointer;
            border: none;
            background: transparent;
            width: 100%;
            text-align: left;
            font-size: 14px;
        }
        .menu-item a:hover, 
        .menu-item a.active, 
        .menu-item .dropdown-toggle:hover {
            background-color: rgba(16, 185, 129, 0.2);
            color: #fff;
        }
        .menu-item i { margin-right: 12px; font-size: 17px; }
        
        .dropdown-toggle::after {
            display: none;
        }
        
        .submenu {
            background-color: rgba(0, 0, 0, 0.25);
            list-style: none;
            padding: 0;
            display: none;
        }
        .submenu.show { display: block; }
        .submenu a, .submenu button { 
            padding-left: 48px; 
            font-size: 13.5px; 
        }
        .submenu .submenu a { 
            padding-left: 65px; 
            font-size: 13px; 
            background-color: rgba(0, 0, 0, 0.15);
        }
        
        .main-content {
            margin-left: var(--sidebar-width);
            transition: all 0.3s ease;
            padding: 24px;
        }

        .dashboard-shortcuts{display:flex;flex-wrap:wrap;justify-content:center;align-items:flex-start;gap:18px;padding:8px 0}
        .dashboard-section-divider{border:0;border-top:2px solid #dbe5e1;opacity:1;margin:8px 0 24px}
        .dashboard-resource-card{border:1px solid #d1fae5;border-radius:14px;box-shadow:0 8px 24px rgba(15,23,42,.06);overflow:hidden}
        .dashboard-resource-card .card-custom-header{background:linear-gradient(100deg,#fff 0%,#ecfdf5 100%);border-bottom:1px solid #d1fae5}
        .dashboard-monitor-row .card-body{min-width:0}
        @media(max-width:1199.98px){.dashboard-monitor-row .traffic-monitor-tiles{gap:16px}}
        .dashboard-round-button{--round-color:#047857;--round-tint:#ecfdf5;width:158px;height:158px;flex:0 0 158px;border:1px solid color-mix(in srgb,var(--round-color) 24%,white);border-radius:50%;background:linear-gradient(145deg,#fff,var(--round-tint));box-shadow:0 5px 18px rgba(15,23,42,.07);display:flex;flex-direction:column;align-items:center;justify-content:center;gap:3px;padding:13px;text-align:center;color:#0f172a;transition:transform .18s ease,box-shadow .18s ease,border-color .18s ease;cursor:pointer}
        .dashboard-round-button:hover,.dashboard-round-button:focus-visible{transform:translateY(-3px);box-shadow:0 10px 24px rgba(15,23,42,.13);border-color:var(--round-color);outline:3px solid color-mix(in srgb,var(--round-color) 18%,transparent);outline-offset:2px}
        .dashboard-round-icon{width:35px;height:35px;border-radius:50%;display:flex;align-items:center;justify-content:center;background:var(--round-color);color:#fff;font-size:17px;margin-bottom:2px}
        .dashboard-round-button>strong{font-size:23px;line-height:1.1;font-weight:800;color:var(--round-color);max-width:130px;overflow-wrap:anywhere}
        .dashboard-round-button>strong.dashboard-round-amount{font-size:16px}
        .dashboard-round-label{font-size:12px;font-weight:800;line-height:1.15;max-width:125px}
        .dashboard-round-hint{font-size:10px;color:#64748b}
        .dashboard-round-customers{--round-color:#047857;--round-tint:#ecfdf5}
        .dashboard-round-online{--round-color:#0284c7;--round-tint:#f0f9ff}
        .dashboard-round-offline{--round-color:#64748b;--round-tint:#f8fafc}
        .dashboard-round-collection{--round-color:#b45309;--round-tint:#fffbeb}
        .dashboard-round-router{--round-color:#6d28d9;--round-tint:#f5f3ff}
        .dashboard-module-card{display:flex;align-items:flex-start;gap:8px;padding:18px;border:1px solid #e2e8f0;background:#fff;color:#0f172a;min-height:150px;transition:transform .18s ease,box-shadow .18s ease,border-color .18s ease}
        .dashboard-module-card:hover{transform:translateY(-2px);box-shadow:0 8px 22px rgba(15,23,42,.08);border-color:#a7f3d0;color:#0f172a}
        .dashboard-module-icon{font-size:1.45rem;line-height:1.3}
        .dashboard-module-card .small{line-height:1.5}
        .dashboard-module-card:focus-visible{outline:3px solid #10b981;outline-offset:2px}
        /* Live traffic uses the same bright, clean accent-card language as the dashboard shortcuts. */
        .traffic-monitor-card{scroll-margin-top:18px;overflow:hidden;border:1px solid #dbeafe;border-radius:14px;box-shadow:0 8px 24px rgba(15,23,42,.06)}
        .traffic-monitor-card .card-custom-header{background:linear-gradient(100deg,#fff 0%,#f0fdf4 55%,#eff6ff 100%);border-bottom:1px solid #dbeafe}
        .traffic-monitor-card .card-custom-header>i{color:#059669!important}
        /* Circular live-traffic tiles intentionally mirror the round metric shortcuts above. */
        .traffic-monitor-card{scroll-margin-top:18px;overflow:hidden;border:1px solid #dbeafe;border-radius:14px;box-shadow:0 8px 24px rgba(15,23,42,.06)}
        .traffic-monitor-card .card-custom-header{background:linear-gradient(100deg,#fff 0%,#f0fdf4 55%,#eff6ff 100%);border-bottom:1px solid #dbeafe}
        .traffic-monitor-card .card-custom-header>i{color:#059669!important}
        .traffic-monitor-tiles{display:flex;justify-content:center;align-items:center;flex-wrap:wrap;gap:22px;padding:8px 0}
        .traffic-digital-card{--traffic-color:#047857;--traffic-tint:#ecfdf5;position:relative;width:158px;height:158px;flex:0 0 158px;border:1px solid color-mix(in srgb,var(--traffic-color) 24%,white);border-radius:50%;padding:13px;background:linear-gradient(145deg,#fff,var(--traffic-tint));box-shadow:0 5px 18px rgba(15,23,42,.07);color:#0f172a;display:flex;flex-direction:column;align-items:center;justify-content:center;text-align:center;gap:4px;overflow:hidden;transition:transform .18s ease,box-shadow .18s ease}
        .traffic-digital-card:hover{transform:translateY(-3px);box-shadow:0 10px 24px rgba(15,23,42,.13)}
        .traffic-digital-card.traffic-rx{--traffic-color:#047857;--traffic-tint:#ecfdf5}
        .traffic-digital-card.traffic-tx{--traffic-color:#6d28d9;--traffic-tint:#f5f3ff;border-color:#ddd6fe}
        .traffic-digital-icon{width:35px;height:35px;flex:0 0 35px;border-radius:50%;display:flex;align-items:center;justify-content:center;background:var(--traffic-color);color:#fff;font-size:17px;margin-bottom:2px}
        .traffic-digital-label{font-size:11px;font-weight:800;letter-spacing:.035em;color:#334155;line-height:1.15}
        .traffic-digital-value{display:flex;align-items:baseline;justify-content:center;flex-wrap:wrap;gap:4px;margin-top:2px;font-family:'JetBrains Mono',ui-monospace,monospace;font-variant-numeric:tabular-nums;max-width:100%}
        .traffic-digital-value span{font-size:clamp(1.15rem,2.3vw,1.55rem);font-weight:800;line-height:1.05;letter-spacing:-.045em;color:var(--traffic-color);overflow-wrap:anywhere}
        .traffic-digital-value small{font-size:.68rem;font-weight:800;letter-spacing:0;color:#64748b}
        .traffic-digital-caption{font-size:.62rem;color:#64748b;line-height:1.2;margin-top:1px;max-width:120px}
        .traffic-digital-card:after{content:"";position:absolute;inset:5px;border:1px solid color-mix(in srgb,var(--traffic-color) 15%,transparent);border-radius:50%;pointer-events:none}
        .traffic-sidebar-link{margin:5px 10px 9px;border:1px solid rgba(167,243,208,.35)!important;border-radius:10px;background:linear-gradient(100deg,rgba(16,185,129,.22),rgba(59,130,246,.15))!important;color:#fff!important;font-weight:800!important}
        .traffic-sidebar-link i{color:#6ee7b7!important}
        .traffic-sidebar-link:hover,.traffic-sidebar-link:focus-visible{background:linear-gradient(100deg,rgba(16,185,129,.38),rgba(139,92,246,.28))!important;outline:2px solid #6ee7b7;outline-offset:1px}
        @media(max-width:575.98px){.traffic-monitor-tiles{gap:12px}.traffic-digital-card{width:calc(50vw - 36px);height:calc(50vw - 36px);flex-basis:calc(50vw - 36px);max-width:158px;max-height:158px;min-width:132px;min-height:132px}.traffic-digital-value span{font-size:clamp(1rem,5vw,1.35rem)}}
        .traffic-sidebar-link{margin:5px 10px 9px;border:1px solid rgba(167,243,208,.35)!important;border-radius:10px;background:linear-gradient(100deg,rgba(16,185,129,.22),rgba(59,130,246,.15))!important;color:#fff!important;font-weight:800!important}
        .traffic-sidebar-link i{color:#6ee7b7!important}
        .traffic-sidebar-link:hover,.traffic-sidebar-link:focus-visible{background:linear-gradient(100deg,rgba(16,185,129,.38),rgba(139,92,246,.28))!important;outline:2px solid #6ee7b7;outline-offset:1px}
        .hotspot-dashboard-shortcuts{justify-content:flex-start}
        @media(max-width:575.98px){.hotspot-dashboard-shortcuts{gap:12px}}
        @media(max-width:575.98px){.dashboard-shortcuts{gap:12px}.dashboard-round-button{width:calc(50vw - 28px);height:calc(50vw - 28px);flex-basis:calc(50vw - 28px);max-width:158px;max-height:158px;min-width:132px;min-height:132px}.dashboard-round-button>strong{font-size:21px}.dashboard-round-label{font-size:11px}}
        .card-custom {
            border: none;
            border-radius: 10px;
            box-shadow: 0 0.125rem 0.25rem rgba(0, 0, 0, 0.075);
            background: #ffffff;
        }
        .card-custom-header {
            background-color: #ffffff;
            border-bottom: 1px solid #edf2f7;
            padding: 16px 24px;
            font-weight: 600;
            color: var(--primary-color);
            display: flex;
            align-items: center;
            gap: 10px;
        }
        .btn-theme {
            background-color: var(--primary-color);
            color: #ffffff;
            border: none;
            padding: 9px 22px;
            font-weight: 500;
        }
        .btn-theme:hover {
            background-color: var(--primary-hover);
            color: #ffffff;
        }
        .form-label {
            font-weight: 500;
            font-size: 13.5px;
            color: #334155;
            margin-bottom: 6px;
        }
        .form-control, .form-select {
            border-radius: 6px;
            border: 1px solid #cbd5e1;
            padding: 9px 13px;
            font-size: 14px;
        }
        .form-control:focus, .form-select:focus {
            border-color: var(--accent-color);
            box-shadow: 0 0 0 0.2rem rgba(16, 185, 129, 0.15);
        }
        .customer-live-table {
            --customer-border: #e7edf4;
            border-collapse: separate;
            border-spacing: 0;
            background: #fff;
        }
        .customer-live-table th { white-space: nowrap; font-size: 11px; font-weight: 800; color: #64748b; text-transform: uppercase; letter-spacing: .065em; background: #f8fafc; border-bottom: 1px solid #dfe7ef; padding: 13px 12px; }
        .customer-live-table td { vertical-align: middle; font-size: 13px; padding: 14px 12px; border-bottom: 1px solid #edf2f7; background: #fff; }
        .customer-live-table tbody tr { transition: background .15s ease-in-out, box-shadow .15s ease-in-out; }
        .customer-live-table tbody tr:hover td { background: #f8fafc; }
        .customer-live-table .customer-identity-cell { border-left: 3px solid #bae6fd; border-right: 1px solid #edf2f7; }
        .customer-live-table .customer-pppoe-cell { border-left: 1px solid #e2e8f0; border-right: 1px solid #e2e8f0; }
        .customer-live-table .customer-status-cell { border-left: 1px solid #ede9fe; border-right: 1px solid #ede9fe; }
        .customer-live-table .customer-validity-cell { border-right: 1px solid #edf2f7; }
        .customer-avatar { width: 38px; height: 38px; flex: 0 0 38px; display: inline-flex; align-items: center; justify-content: center; border-radius: 50%; background: #e0f2fe; color: #0369a1; font-size: 12px; font-weight: 800; letter-spacing: .02em; }
        .customer-profile-link { color: #0f172a !important; } .customer-profile-link:hover { color: #0369a1 !important; }
        .customer-phone { color: #64748b; font-size: 12px; line-height: 1.35; } .customer-phone i { color: #94a3b8; }
        .customer-username { display: inline-flex; align-items: center; max-width: 180px; padding: 5px 8px; border: 1px solid #e2e8f0; border-radius: 7px; background: #f8fafc; color: #334155; font: 600 12px/1.2 ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace; }
        .customer-package { display: inline-flex; align-items: center; padding: 5px 9px; border: 1px solid #ddd6fe; border-radius: 999px; background: #f5f3ff; color: #6d28d9; font-size: 12px; font-weight: 700; white-space: nowrap; }
        .customer-connection-value { font: 600 12px/1.35 ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace; color: #334155; } .customer-connection-meta { color: #94a3b8; font-size: 11px; margin-top: 3px; }
        .customer-status-badge { display: inline-flex; align-items: center; gap: 5px; border: 1px solid currentColor; border-radius: 999px; padding: 5px 9px; font-size: 11px; font-weight: 800; }
        .customer-status-badge.status-paid { color: #047857; background: #ecfdf5; border-color: #a7f3d0; box-shadow: 0 0 0 3px rgba(16,185,129,.06); }
        .customer-status-badge.status-unpaid, .customer-status-badge.status-expired { color: #b91c1c; background: #fef2f2; border-color: #fecaca; box-shadow: 0 0 0 3px rgba(239,68,68,.05); }
        .customer-validity-date { display: block; color: #334155; font-size: 12px; font-weight: 700; }
        .customer-days-pill { display: inline-flex; margin-top: 4px; padding: 3px 7px; border-radius: 999px; font-size: 10px; font-weight: 800; }
        .customer-days-pill.days-positive { background:#ecfdf5; color:#047857; } .customer-days-pill.days-today { background:#fff7ed; color:#c2410c; } .customer-days-pill.days-expired { background:#fef2f2; color:#b91c1c; }
        .customer-action-group { display: inline-flex; align-items: center; gap: 4px; padding: 4px; border: 1px solid #e2e8f0; border-radius: 10px; background: #f8fafc; box-shadow: 0 1px 2px rgba(15,23,42,.04); }
        .customer-action-group .btn { min-width: 34px; min-height: 32px; border-radius: 7px !important; display: inline-flex; align-items: center; justify-content: center; } .customer-action-group .btn:hover { transform: translateY(-1px); }
        .customer-serial { color: #64748b; font: 800 11px ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace; }
        .customer-live-table .customer-session { font-size: 11px; line-height: 1.35; margin-top: 4px; }
        .customer-search-wrap { min-width: 260px; } .customer-ip { font-family: ui-monospace, SFMono-Regular, Menlo, monospace; font-size: 12px; }
        .ip-pool-page{--pool-ink:#0f172a;--pool-muted:#64748b;color:var(--pool-ink)}
        .ip-pool-hero{display:flex;justify-content:space-between;align-items:center;gap:24px;flex-wrap:wrap;padding:24px;margin-bottom:22px;border:1px solid #dbeafe;border-radius:18px;background:linear-gradient(120deg,#fff 0%,#f0fdf4 100%);box-shadow:0 8px 26px rgba(15,23,42,.045)}
        .ip-pool-eyebrow{font-size:10px;font-weight:800;letter-spacing:.14em;color:#059669;margin-bottom:8px}.ip-pool-hero h3{font-size:25px;font-weight:800;letter-spacing:-.03em;margin:0}.ip-pool-hero p{font-size:13px;color:#64748b;margin:7px 0 12px}.ip-pool-summary{display:flex;gap:16px;flex-wrap:wrap;font-size:12px;color:#475569}.ip-pool-toolbar{display:flex;gap:9px;flex-wrap:wrap}.ip-pool-card{position:relative;overflow:hidden;padding:19px;border:1px solid var(--pool-accent);border-top:4px solid var(--pool-accent);border-radius:16px;background:#fff;box-shadow:0 5px 18px rgba(15,23,42,.045);transition:transform .18s ease,box-shadow .18s ease}.ip-pool-card:hover{transform:translateY(-3px);box-shadow:0 12px 28px rgba(15,23,42,.09)}.ip-pool-card-top{display:flex;justify-content:space-between;align-items:center;margin-bottom:14px}.ip-pool-icon{display:flex;align-items:center;justify-content:center;width:42px;height:42px;border-radius:12px;color:var(--pool-accent);background:color-mix(in srgb,var(--pool-accent) 12%,white);font-size:19px}.ip-pool-live{display:inline-flex;align-items:center;gap:6px;border:1px solid #a7f3d0;background:#ecfdf5;color:#047857;border-radius:999px;padding:5px 9px;font-size:10px;font-weight:800}.ip-pool-live span{width:6px;height:6px;border-radius:50%;background:#10b981}.ip-pool-name{font-size:17px;font-weight:800;overflow-wrap:anywhere;margin-bottom:17px}.ip-pool-field{display:flex;flex-direction:column;gap:5px;min-width:0}.ip-pool-field>span{font-size:10px;font-weight:800;text-transform:uppercase;letter-spacing:.07em;color:#94a3b8}.ip-pool-field code,.ip-pool-field strong{font-size:12px;overflow-wrap:anywhere;color:#334155}.ip-pool-field code{white-space:normal;background:#f8fafc;border:1px solid #e2e8f0;border-radius:7px;padding:9px}.ip-pool-meta{display:grid;grid-template-columns:1fr 1fr;gap:14px;margin-top:14px}.ip-pool-device{border-top:1px solid #edf2f7;margin-top:16px;padding-top:13px;color:#64748b;font-size:12px}.ip-pool-actions{display:flex;gap:8px;margin-top:16px;padding-top:14px;border-top:1px solid #edf2f7}.ip-pool-actions .btn{flex:1;font-size:12px;font-weight:700;border-radius:8px}.ip-pool-empty-card{padding:45px 20px;border:1px dashed #cbd5e1;border-radius:16px;background:#fff;text-align:center;color:#64748b}.ip-pool-empty-card h5{font-weight:800;color:#334155}.ip-pool-empty-card p{font-size:13px}@media(max-width:768px){.ip-pool-hero{padding:18px}.ip-pool-toolbar{width:100%}.ip-pool-toolbar .btn{flex:1}.ip-pool-meta{gap:9px}}
        .ip-pool-table th { white-space: nowrap; font-size: 12px; color: #475569; text-transform: uppercase; letter-spacing: .02em; }
        .ip-pool-table td { vertical-align: middle; font-size: 13px; }
        .ip-pool-range { font-family: ui-monospace, SFMono-Regular, Menlo, monospace; word-break: break-word; }
        .ip-pool-network-badge { display:inline-flex; align-items:center; gap:5px; }
        .ip-pool-empty { min-height:220px; display:flex; align-items:center; justify-content:center; flex-direction:column; color:#64748b; }
        @media(max-width:768px){.ip-pool-table{min-width:760px;}}
        .customer-live-table td { vertical-align: middle; font-size: 13px; }
        .customer-status { min-width: 78px; }
        .customer-session { font-size: 11px; line-height: 1.35; }
        .customer-search-wrap { min-width: 260px; }
        .customer-action-group .btn { min-width: 34px; }
        .customer-ip { font-family: ui-monospace, SFMono-Regular, Menlo, monospace; font-size: 12px; }
        .payment-ledger-table th { white-space: nowrap; font-size: 12px; color: #475569; text-transform: uppercase; letter-spacing: .02em; }
        .payment-ledger-table td { vertical-align: middle; font-size: 13px; }
        .payment-search-wrap { min-width: 280px; }
        .payment-gateway-badge { color: #fff; min-width: 70px; }
        .gateway-bkash { background: #e2136e; }
        .gateway-nagad { background: #f6921e; }
        .gateway-rocket { background: #8c3494; }
        .payment-kpi { border-left: 4px solid var(--accent-color); }
        .payment-action-group .btn { min-width: 34px; }
        
        @media (max-width: 768px) {
            .sidebar { left: calc(-1 * var(--sidebar-width)); }
            .sidebar.show { left: 0; }
            .main-content { margin-left: 0; }
        }
    
        .sidebar-backdrop{display:none;position:fixed;inset:0;background:rgba(0,0,0,.42);z-index:999}
        .sidebar-backdrop.show{display:block}
        /* Mobile drawer/backdrop hardening: navigation must never leave an overlay behind. */
