            document.querySelectorAll('.billing-preset').forEach(btn=>btn.classList.toggle('active',Number(btn.dataset.months)===Number(months))); updateCustomerValidityStatus();
        }
        function syncActivationDate(){const activation=document.getElementById('activationDate'),expiration=document.getElementById('expirationDate');if(!activation||!expiration)return;const activationIso=dateInputToIso(activation.value)||localDateValue();if(!dateInputToIso(activation.value))setCustomerDateValue(activation,activationIso);setCustomerDateValue(expiration,addCalendarMonths(activationIso,1));document.querySelectorAll('.billing-preset').forEach(btn=>btn.classList.remove('active'));updateCustomerValidityStatus();}


