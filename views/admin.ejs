ay:flex;gap:8px;margin-top:16px;padding-top:14px;border-top:1px solid #edf2f7}.ip-pool-actions .btn{flex:1;font-size:12px;font-weight:700;border-radius:8px}.ip-pool-empty-card{padding:45px 20px;border:1px dashed #cbd5e1;border-radius:16px;background:#fff;text-align:center;color:#64748b}.ip-pool-empty-card h5{font-weight:800;color:#334155}.ip-pool-empty-card p{font-size:13px}@media(max-width:768px){.ip-pool-hero{padding:18px}.ip-pool-toolbar{width:100%}.ip-pool-toolbar .btn{flex:1}.ip-pool-meta{gap:9px}}
