                modal.innerHTML='<div class="modal-dialog modal-lg modal-dialog-centered"><div class="modal-content border-0 shadow-lg"><div class="modal-header bg-light"><div><h5 class="modal-title fw-bold"><i class="bi bi-wifi text-success me-2"></i>Create / Edit Hotspot Profile</h5><div class="small text-muted">Set speed, price, and custom time or data validity.</div></div><button type="button" class="btn-close" data-bs-dismiss="modal"></button></div><form id="hotspotProfileForm"><div class="modal-body p-4"><input type="hidden" id="hotspotProfileOriginalName"><div class="row g-3"><div class="col-md-6"><label class="form-label fw-semibold">Profile Name</label><input id="hotspotProfileName" class="form-control" required maxlength="100" placeholder="Profile-1Day"></div><div class="col-md-6"><label class="form-label fw-semibold">Rate Limit (Rx/Tx)</label><input id="hotspotProfileRate" class="form-control" required placeholder="10M/10M"></div><div class="col-md-4"><label class="form-label fw-semibold">Price (৳ BDT)</label><input id="hotspotProfilePrice" type="number" min="0" step="0.01" class="form-control" value="20" required></div><div class="col-md-4"><label class="form-label fw-semibold">Shared Users</label><input id="hotspotProfileShared" type="number" min="1" step="1" class="form-control" value="1" required></div><div class="col-md-4"><label class="form-label fw-semibold">Validity Value</label><input id="hotspotProfileValidityValue" type="number" min="1" step="1" class="form-control" value="1" required></div><div class="col-md-6"><label class="form-label fw-semibold">Validity Unit</label><select id="hotspotProfileValidityUnit" class="form-select" required><option value="minutes">Minutes</option><option value="hours">Hours</option><option value="days" selected>Days</option><option value="gb">GB (data quota, no time limit)</option></select></div><div class="col-md-6"><label class="form-label fw-semibold">Resolved Validity</label><div id="hotspotProfileValidityPreview" class="form-control bg-light fw-semibold">1 Day</div></div><div class="col-12"><label class="form-label fw-semibold">RouterOS On-Login Policy Preview</label><textarea id="hotspotProfileOnLogin" class="form-control font-monospace small" rows="6" readonly></textarea><div class="form-text">Preview only. On save, the backend compiles and pushes the complete executable script to MikroTik.</div></div></div><div id="hotspotProfileFormResult" class="small mt-3" role="status" aria-live="polite"></div></div><div class="modal-footer"><button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button><button type="submit" class="btn btn-theme" id="hotspotProfileSave"><i class="bi bi-cloud-check me-1"></i>Save Profile to MikroTik</button></div></form></div></div>';
