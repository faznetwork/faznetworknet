        .ipam-shell .ipam-table thead th{background:#f8fafc!important;color:#475569!important;border-bottom:1px solid #e2e8f0;border-top:0;padding:11px 12px;font-size:11px;font-weight:800;letter-spacing:.07em;white-space:nowrap}
        .ipam-shell .ipam-table tbody td{padding:10px 12px;border-color:#f1f5f9!important;color:#334155!important;background:#fff;vertical-align:middle}
