                if (editField) editField.value = '';
                if(editId){const editModalEl=document.getElementById('customerEditFormModal');if(editModalEl&&window.bootstrap?.Modal)window.bootstrap.Modal.getOrCreateInstance(editModalEl).hide();}

                if (typeof loadCustomerSection === 'function') {
                    await loadCustomerSection('all', 'all_customer');
                } else if (typeof window.loadCustomers === 'function') {
                    await window.loadCustomers();
                }
            } catch (error) {
                console.error('[CUSTOMER UI] Submission error:', error);
                alert('Failed to Provision: ' + (error?.message || 'Unknown server or MikroTik error'));
            } finally {
                if (submitBtn) {
                    submitBtn.disabled = false;
                    submitBtn.innerHTML = originalText;
                }
            }
        }

        document.getElementById('addCustomerForm')?.addEventListener('submit', handleCustomerSubmit);



        async function fetchPayments(channel = '') {
            const body = document.getElementById('paymentsBody');
            if (!body) return;
            try {
                const gateway = channel || 'all';
                const data = await jsonFetch('/api/payments/transactions?gateway=' + encodeURIComponent(gateway));
                const rows = (data.transactions || []).slice(0, 500);
                safeSetText('paymentFilterLabel', gateway.toUpperCase());
                body.innerHTML = rows.length ? rows.map(t =>
                    '<tr><td><strong>' + escapeHtml(t.trx_id) + '</strong></td>' +
                    '<td>' + escapeHtml(t.channel || '-') + '</td>' +
                    '<td>৳' + Number(t.amount || 0).toFixed(2) + '</td>' +
                    '<td>' + escapeHtml(t.sender_phone || '-') + '</td>' +
                    '<td><span class="badge ' + (t.status === 'processed' ? 'bg-success' : 'bg-warning text-dark') + '">' + escapeHtml(t.status || 'unknown') + '</span></td>' +
                    '<td>' + escapeHtml(t.created_at ? FazDate.formatDateTime(t.created_at) : '-') + '</td></tr>'
                ).join('') : '<tr><td colspan="6" class="text-center py-3 text-muted">No payment records found.</td></tr>';
            } catch (error) {
                body.innerHTML = '<tr><td colspan="6" class="text-center py-3 text-danger">' + escapeHtml(error.message) + '</td></tr>';
            }
        }

        async function refreshDashboard() {
            try {
                const [users, active, summary] = await Promise.all([
                    jsonFetch('/api/pppoe/users'),
                    jsonFetch('/api/pppoe/active'),
                    jsonFetch('/api/payments/summary')
                ]);
                safeSetText('metricCustomers', (users.users || []).length);
                safeSetText('metricSessions', (active.sessions || active.active || []).length);
                safeSetText('metricCollection', '৳' + Number(summary.summary?.today_collection || 0).toFixed(2));
                const recent = summary.recent || [];
                document.getElementById('recentPaymentsBody').innerHTML = recent.slice(0,5).map(t =>
                    '<tr><td>' + escapeHtml(t.trx_id) + '</td><td>' + escapeHtml(t.channel) + '</td><td>৳' + Number(t.amount || 0).toFixed(2) + '</td><td><span class="badge ' + (t.status === 'processed' ? 'bg-success' : 'bg-warning text-dark') + '">' + escapeHtml(t.status) + '</span></td><td>' + escapeHtml(FazDate.formatDateTime(t.created_at)) + '</td></tr>'
                ).join('') || '<tr><td colspan="5" class="text-center py-3 text-muted">No recent payments.</td></tr>';
            } catch (error) {
                console.error('[Dashboard]', error);
            }
            await loadRouterMetrics();
        }

        async function loadRouterMetrics() {
            const dashboard = document.getElementById('view-dashboard');
            if (!dashboard || dashboard.style.display === 'none') return;
            try {
                const data = await jsonFetch('/api/router/resources');
                const r = data.resources || {};
                const cpu = Number(r.cpuLoad || 0);
                const ram = Number(r.memoryUsagePercent || 0);
                safeSetText('metricCpu', cpu + '%');
                safeSetText('metricRam', ram + '%');
                document.getElementById('cpuBar').style.width = Math.min(cpu,100) + '%';
                document.getElementById('ramBar').style.width = Math.min(ram,100) + '%';
                const status = document.getElementById('dashboardRouterStatus');
                status.className = 'badge bg-success ms-auto';
                safeSetText('dashboardRouterStatus', 'Online');
            } catch (error) {
                safeSetText('metricCpu', '—');
                safeSetText('metricRam', '—');
                const status = document.getElementById('dashboardRouterStatus');
                status.className = 'badge bg-danger ms-auto';
                safeSetText('dashboardRouterStatus', 'Offline');
            }
        }

        async function loadInterfaces() {
            try {
                const data = await jsonFetch('/api/router/interfaces');
                const interfaces = data.interfaces || [];
                const select = document.getElementById('dashboardInterface');
                const current = select.value;
                if (!select.options.length) select.innerHTML = interfaces.map(i => '<option value="' + escapeHtml(i.name) + '">' + escapeHtml(i.name) + '</option>').join('');
                if (current) select.value = current;
                if (select.value) pollTraffic();
            } catch (error) {
                console.error('[Traffic]', error);
            }
        }

        async function pollTraffic() {
            if (trafficPollInFlight) return;
            const dashboard = document.getElementById('view-dashboard');
            if (!dashboard || dashboard.style.display === 'none') return;
            const select = document.getElementById('dashboardInterface');
            if (!select || !select.value) return;
            trafficPollInFlight = true;
            try {
                const data = await jsonFetch('/api/router/traffic?interface=' + encodeURIComponent(select.value));
                const t = data.traffic || data;
                if (!trafficChart) {
                    trafficChart = new Chart(document.getElementById('dashboardTrafficChart'), {
                        type:'line',
                        data:{labels:[],datasets:[
                            {label:'RX Mbps',data:[],tension:.3},
                            {label:'TX Mbps',data:[],tension:.3}
                        ]},
                        options:{responsive:true,maintainAspectRatio:false,animation:false}
                    });
                }
                trafficChart.data.labels.push(new Date().toLocaleTimeString());
                trafficChart.data.datasets[0].data.push(Number(t.rxMbps || 0));
                trafficChart.data.datasets[1].data.push(Number(t.txMbps || 0));
                if (trafficChart.data.labels.length > 30) {
                    trafficChart.data.labels.shift();
                    trafficChart.data.datasets.forEach(d => d.data.shift());
                }
                trafficChart.update('none');
            } catch (error) {
                console.error('[Traffic]', error);
            } finally {
                trafficPollInFlight = false;
            }
        }

        function startTrafficPolling() {
            if (trafficTimer) clearInterval(trafficTimer);
            void loadInterfaces();
            trafficTimer = setInterval(() => { void pollTraffic(); }, 10000);
        }

        async function safeAdminBootStep(label, task) {
            try { return await Promise.resolve().then(task); }
            catch (error) { console.error('[Admin Boot] ' + label + ' failed:', error); return null; }
        }

        // Defensive guard: customer date fields use text + Flatpickr, never native date controls.
        function enforceCustomerDateDisplay(root) {
            const scope = root && root.querySelectorAll ? root : document;
            const selector = '#connectionDate, #activationDate, #expirationDate, #cpExpiration, #editCustomerModal input[type="date"], #customerEditFormModal input[type="date"], #customerProfileModal input[type="date"]';
            const candidates = [];
            if (scope.matches && scope.matches(selector)) candidates.push(scope);
            if (scope.querySelectorAll) scope.querySelectorAll(selector).forEach(input => candidates.push(input));
            candidates.forEach(input => {
                if (!(input instanceof HTMLInputElement)) return;
                const previousValue = String(input.value || '').trim();
                if (input.type === 'date') input.type = 'text';
                if (!['connectionDate', 'activationDate', 'expirationDate', 'cpExpiration'].includes(input.id) && !previousValue) return;
                input.placeholder = 'DD/MM/YYYY';
                input.inputMode = 'numeric';
                input.autocomplete = 'off';
                input.maxLength = 10;
                input.setAttribute('pattern', '\\d{2}/\\d{2}/\\d{4}');
                input.dataset.dateFormat = 'DD/MM/YYYY';
                const iso = dateInputToIso(previousValue);
                if (iso) input.value = formatDateForInput(iso);
            });
            initializeCustomerDatePickers(scope);
        }

        function initializeCustomerDateFormatGuard() {
            enforceCustomerDateDisplay(document);
            if (document.documentElement.dataset.customerDateGuardBound === '1') return;
            document.documentElement.dataset.customerDateGuardBound = '1';
            document.addEventListener('show.bs.modal', event => enforceCustomerDateDisplay(event.target), true);
            document.addEventListener('shown.bs.modal', event => enforceCustomerDateDisplay(event.target), true);
            const observer = new MutationObserver(records => {
                records.forEach(record => {
                    // Catch scripts that change an existing date field back to type="date".
                    if (record.type === 'attributes' && record.target instanceof HTMLInputElement) {
                        enforceCustomerDateDisplay(record.target);
                        return;
                    }
                    record.addedNodes?.forEach(node => {
                        if (node.nodeType === Node.ELEMENT_NODE) enforceCustomerDateDisplay(node);
                    });
                });
            });
            observer.observe(document.documentElement, {
                childList: true, subtree: true, attributes: true, attributeFilter: ['type']
            });
        }

        function initializeAdminRuntime() {
            try { initializeCustomerDateFormatGuard(); }
            catch (error) { console.error('[Customer Date Format] guard initialization failed:', error); }
            try {
                const dashboardInterface = document.getElementById('dashboardInterface');
                if (dashboardInterface && !dashboardInterface.dataset.runtimeBound) {
                    dashboardInterface.dataset.runtimeBound = '1';
                    dashboardInterface.addEventListener('change', function() {
                        try {
                            if (trafficChart) {
                                trafficChart.data.labels = [];
                                trafficChart.data.datasets.forEach(d => d.data = []);
                                trafficChart.update('none');
                            }
                            void safeAdminBootStep('traffic refresh', () => pollTraffic());
                        } catch (error) {
                            console.error('[Admin Boot] traffic change handler failed:', error);
                        }
                    });
                }
            } catch (error) {
                console.error('[Admin Boot] event binding failed:', error);
            }

            // switchView('dashboard') owns the initial dashboard and traffic startup.
            // Avoid issuing duplicate MikroTik requests during page initialization.
            try { void safeAdminBootStep('switch dashboard view', () => switchView('dashboard')); }
            catch (error) { console.error('[Admin Boot] switch dashboard failed:', error); }

            try {
                if (metricsTimer) clearInterval(metricsTimer);
                metricsTimer = setInterval(() => {
                    if (metricsPollInFlight) return;
                    metricsPollInFlight = true;
                    (async () => {
                        try {
                            if (document.getElementById('view-dashboard')?.style.display !== 'none') {
                                // refreshDashboard also updates router metrics; call it once per cycle.
                                await safeAdminBootStep('dashboard refresh', () => refreshDashboard());
                            }
                            if (currentHotspotMode === 'dashboard' && document.getElementById('hotspotDashboardSessions')) {
                                await safeAdminBootStep('hotspot metrics', () => refreshHotspotDashboardMetrics());
                            }
                            if (currentPaymentTitleKey && document.getElementById('view-payment-ledger')) {
                                await safeAdminBootStep('payment refresh', () => fetchPaymentsSection());
                            }
                        } catch (error) {
                            console.error('[Admin Poll] metrics cycle failed:', error);
                        } finally {
                            metricsPollInFlight = false;
                        }
                    })();
                }, 15000);
            } catch (error) {
                console.error('[Admin Boot] metrics timer failed:', error);
            }
        }

        if (document.readyState === 'loading') {
            document.addEventListener('DOMContentLoaded', initializeAdminRuntime, { once: true });
        } else {
            initializeAdminRuntime();
        }
    </script>
