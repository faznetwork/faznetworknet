        function emergencyUiUnfreeze() {
            document.querySelectorAll('.modal-backdrop, .offcanvas-backdrop').forEach(function(el) { el.remove(); });
            document.body.classList.remove('modal-open');
            document.body.style.overflow = '';
            document.body.style.paddingRight = '';
            document.body.style.pointerEvents = 'auto';
        }

        function purgeStuckBackdrops() {
            document.querySelectorAll('.modal-backdrop').forEach(function(el) { el.remove(); });
            document.querySelectorAll('.offcanvas-backdrop').forEach(function(el) { el.remove(); });
            document.querySelectorAll('.sidebar-backdrop').forEach(function(el) { el.classList.remove('show'); el.remove(); });
            document.querySelectorAll('.offcanvas.show, .offcanvas.showing, .offcanvas.hiding').forEach(function(el) {
                el.classList.remove('show', 'showing', 'hiding');
                el.setAttribute('aria-hidden', 'true');
            });
            if (document.body) {
                document.body.classList.remove('modal-open', 'offcanvas-open', 'sidebar-open');
                document.body.style.overflow = '';
                document.body.style.paddingRight = '';
                document.body.removeAttribute('data-bs-overflow');
                document.body.removeAttribute('data-bs-padding-right');
            }
            var sidebar = document.getElementById('sidebar');
            if (sidebar && window.innerWidth < 768) sidebar.classList.remove('show');
            var sidebarButton = document.getElementById('mobileSidebarToggle');
            if (sidebarButton) sidebarButton.setAttribute('aria-expanded', 'false');
            document.body.style.pointerEvents = 'auto';
        }

        window.navigateToCustomerProfile = function(customerId){
            const id=String(customerId||'').trim();
            if(!id)return;
            purgeStuckBackdrops();
            const target='/admin/customers/'+encodeURIComponent(id);
            if(window.location.pathname===target)return;
            window.history.pushState({customer360:true,customerId:id},'',target);
            window.location.replace(target);
        };

        function syncMobileSidebarState(){const sidebar=document.getElementById('sidebar'),backdrop=document.getElementById('sidebarBackdrop'),button=document.getElementById('mobileSidebarToggle');const open=Boolean(sidebar&&sidebar.classList.contains('show')&&window.innerWidth<768);if(backdrop)backdrop.classList.toggle('show',open);document.body.classList.toggle('sidebar-open',open);if(button)button.setAttribute('aria-expanded',open?'true':'false');}
        function closeSidebarMobile(){purgeStuckBackdrops();const sidebar=document.getElementById('sidebar');if(sidebar)sidebar.classList.remove('show');const backdrop=document.getElementById('sidebarBackdrop');if(backdrop)backdrop.classList.remove('show');if(document.body)document.body.classList.remove('sidebar-open');syncMobileSidebarState();}
        function toggleSidebar(){const sidebar=document.getElementById('sidebar');if(!sidebar||window.innerWidth>=768)return;sidebar.classList.toggle('show');syncMobileSidebarState();}

        function toggleSubmenu(event, button) {
            event.stopPropagation();
            const submenu = button.nextElementSibling;
            if (submenu) submenu.classList.toggle('show');
            const arrow = button.querySelector('.arrow-icon');
            if (arrow) arrow.classList.toggle('bi-chevron-up');
        }
        document.addEventListener('click',function(event){if(window.innerWidth>=768)return;const sidebar=document.getElementById('sidebar');if(!sidebar||!sidebar.classList.contains('show'))return;if(event.target.closest('#sidebar .submenu a')||event.target.closest('#sidebar .sidebar-menu > .menu-item > a'))closeSidebarMobile();});
        window.addEventListener('resize',function(){if(window.innerWidth>=768){closeSidebarMobile();purgeStuckBackdrops();}else{syncMobileSidebarState();}});

        const viewTitles = {
            dashboard: 'Dashboard',
            'add-customer': 'Add New Customer',
            'all-customer': 'All Customer (PPPoE)',
            payments: 'All Payments',
            'general-settings': 'General Settings',
            'hotspot-webhook': 'Hotspot Webhook Settings'
        };

