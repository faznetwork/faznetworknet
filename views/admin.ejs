    <script>
    (function(){
      const form=document.getElementById('mikrotikAddRouterForm');
      if(!form || form.dataset.initialized==='1') return;
      form.dataset.initialized='1';
      const $=id=>document.getElementById(id);
      let testedFingerprint='';
      const fields=['routerDeviceName','routerDeviceHost','routerDevicePort','routerDeviceUsername','routerDevicePassword','routerDeviceTimeout'];
      function fingerprint(){return fields.map(id=>$(id).type==='checkbox'?String($(id).checked):String($(id).value||'')).join('|');}
      function invalidateTest(){testedFingerprint='';$('routerDeviceSaveBtn').disabled=true;$('routerDeviceTestDetails').classList.add('d-none');}
      function result(message,kind,icon){const el=$('routerDeviceTestResult');el.className='alert alert-'+kind+' mb-0 py-2';el.textContent='';const i=document.createElement('i');i.className='bi '+icon+' me-1';el.appendChild(i);el.appendChild(document.createTextNode(message));}
      fields.forEach(id=>$(id).addEventListener('input',invalidateTest));
      $('routerDeviceTogglePassword').addEventListener('click',()=>{const p=$('routerDevicePassword'),show=p.type==='password';p.type=show?'text':'password';$('routerDeviceTogglePassword').innerHTML='<i class="bi '+(show?'bi-eye-slash':'bi-eye')+'"></i>';$('routerDeviceTogglePassword').setAttribute('aria-label',show?'Hide password':'Show password');});
      function validHost(value){const h=String(value||'').trim();if(!h||/[\s/@?#]/.test(h)||h.includes('://'))return false;const ipv4=/^(?:\d{1,3}\.){3}\d{1,3}$/.test(h);if(ipv4)return h.split('.').every(x=>Number(x)<=255);return /^(?=.{1,253}$)(?:[a-zA-Z0-9](?:[a-zA-Z0-9-]{0,61}[a-zA-Z0-9])?)(?:\.(?:[a-zA-Z0-9](?:[a-zA-Z0-9-]{0,61}[a-zA-Z0-9])?))*\.?$/.test(h);}
      function payload(){return {router_name:$('routerDeviceName').value.trim(),host:$('routerDeviceHost').value.trim(),api_port:Number($('routerDevicePort').value),username:$('routerDeviceUsername').value.trim(),password:$('routerDevicePassword').value,timeout:Math.min(Number($('routerDeviceTimeout').value)||5000,5000)};}
      $('routerDeviceTestBtn').addEventListener('click',async()=>{
        invalidateTest();
        const data=payload();
        if(!data.router_name||!validHost(data.host)||!data.username||!data.password){result('Enter a router name, valid IPv4/hostname, username and password.','warning','bi-exclamation-triangle');return;}
        if(!Number.isInteger(data.api_port)||data.api_port<1||data.api_port>65535){result('API port must be between 1 and 65535.','warning','bi-exclamation-triangle');return;}
        const button=$('routerDeviceTestBtn');button.disabled=true;button.innerHTML='<span class="spinner-border spinner-border-sm me-1"></span>Testing…';result('Connecting to RouterOS and reading identity/resources…','info','bi-arrow-repeat');
        try{
          const response=await fetch('/api/mikrotik/test-connection',{method:'POST',headers:{'Content-Type':'application/json'},credentials:'same-origin',body:JSON.stringify(data)});
          const body=await response.json().catch(()=>({message:'Invalid server response'}));
          if(!response.ok||!body.success){const message=body.message||'Connection failed.';result(((body.code==='CONNECTION_REFUSED'||body.errorCode==='PORT_UNREACHABLE')?'Port unreachable: ':(body.code==='AUTH_FAILED'||body.errorCode==='INVALID_CREDENTIALS')?'Invalid credentials: ':'')+message,body.status==='auth_failed'?'danger':'warning',body.status==='auth_failed'?'bi-shield-x':'bi-exclamation-triangle');return;}
          testedFingerprint=fingerprint();$('routerDeviceLatency').textContent=body.latency_ms+' ms';$('routerDeviceBoard').textContent=body.board_model||'Unknown';$('routerDeviceVersion').textContent=body.ros_version||'Unknown';$('routerDeviceCpu').textContent=body.cpu_load===null?'N/A':body.cpu_load+'%';$('routerDeviceArchitecture').textContent=body.architecture||'Unknown';$('routerDeviceUptime').textContent=body.uptime||'Unknown';$('routerDeviceTestDetails').classList.remove('d-none');$('routerDeviceSaveBtn').disabled=false;result('Connected to '+(body.identity||'MikroTik')+' successfully. Save is enabled.','success','bi-check-circle-fill');
        }catch(error){result(error.message||'Could not reach the server.','danger','bi-x-circle');}
        finally{button.disabled=false;button.innerHTML='<i class="bi bi-plug me-1"></i>Test Connection';}
      });
      form.addEventListener('submit',async event=>{
        event.preventDefault();
        if(!testedFingerprint||testedFingerprint!==fingerprint()) {invalidateTest();result('Test the current settings successfully before saving.','warning','bi-exclamation-triangle');return;}
        const button=$('routerDeviceSaveBtn');button.disabled=true;button.innerHTML='<span class="spinner-border spinner-border-sm me-1"></span>Saving…';
        try{
          const response=await fetch('/api/mikrotik/add-device',{method:'POST',headers:{'Content-Type':'application/json'},credentials:'same-origin',body:JSON.stringify(payload())});
          const body=await response.json().catch(()=>({message:'Invalid server response'}));
          if(!response.ok||!body.success)throw new Error(body.message||'Router could not be saved.');
          result('Router saved successfully.','success','bi-check-circle-fill');
          const modal=bootstrap.Modal.getInstance($('mikrotikAddRouterModal'));if(modal)modal.hide();
          form.reset();invalidateTest();
          if(typeof window.loadDevices==='function')await window.loadDevices();
          else window.location.reload();
        }catch(error){result(error.message||'Router could not be saved.','danger','bi-x-circle');}
        finally{button.innerHTML='<i class="bi bi-check2-circle me-1"></i>Save Router';button.disabled=true;}
      });
      $('mikrotikAddRouterModal').addEventListener('hidden.bs.modal',()=>{form.reset();invalidateTest();result('Enter the connection details, then test the connection before saving.','secondary','bi-info-circle');});
    })();
    </script>

