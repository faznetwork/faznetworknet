                            name: String(profile.name),
                            price: Number(profile.price),
                            validity: String(profile.validityLabel || profile.validity || '')
                        })));
                }
                const packages = await manualMatchPackagesPromise;
                if (!document.getElementById('manualMatchPackage')) return;
                const sorted = packages.slice().sort((a, b) => {
                    const aMatch = Math.round(a.price * 100) === Math.round(Number(transactionAmount) * 100) ? 0 : 1;
                    const bMatch = Math.round(b.price * 100) === Math.round(Number(transactionAmount) * 100) ? 0 : 1;
                    return aMatch - bMatch || a.price - b.price || a.name.localeCompare(b.name);
                });
                select.innerHTML = '<option value="">Select Hotspot package</option>' + sorted.map(profile => {
                    const matches = Math.round(profile.price * 100) === Math.round(Number(transactionAmount) * 100);
