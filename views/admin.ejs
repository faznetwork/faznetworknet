        /* FAZ NETWORK mobile-first navigation and dashboard refinement. */
        @media (max-width: 767.98px) {
            :root { --sidebar-width: min(300px, 86vw); }

            .main-content {
                box-sizing: border-box;
                padding: 10px 12px max(16px, env(safe-area-inset-bottom));
                min-width: 0;
