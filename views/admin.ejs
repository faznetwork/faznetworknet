        async function syncCustomerExpiryDates(btn) {
            if (!confirm('Push EXP: YYYY-MM-DD comments for all customers with valid expiry dates to MikroTik? Profiles, passwords, and disabled states will not be changed.')) return;
            const old = btn.innerHTML; btn.disabled = true; btn.innerHTML = 'Pushing EXP dates…';
            try {
                const data = await jsonFetch('/api/customers/sync-expiry-dates', {method:'POST', timeout:90000});
                if (!data || data.success === false) throw new Error(data?.message || 'EXP sync request failed.');
                alert('EXP sync finished. Updated: ' + Number(data.updated || 0) + ', skipped: ' + Number(data.skipped || 0) + ', failed: ' + Number(data.failed || 0));
                await fetchCustomers(); await refreshDashboard();
            } catch (error) { alert(error.message || 'Failed to push EXP dates to MikroTik.'); }
            finally { btn.disabled = false; btn.innerHTML = old; }
        }
        async function restoreMissingRouterCustomer(button) {
            const username = (window.prompt('Enter the exact MikroTik PPPoE username to restore into All Customers:') || '').trim();
            if (!username) return;
            if (!window.confirm('Restore "' + username + '" from its existing MikroTik PPPoE secret into FAZ NETWORK Billing Panel? This does not change or delete anything on MikroTik.')) return;
            const original = button ? button.innerHTML : '';
            if (button) { button.disabled = true; button.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span>Restoring...'; }
            try {
                const result = await jsonFetch('/api/pppoe/restore-user', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ username }),
                    timeout: 90000
                });
                if (!result || !result.success) throw new Error(result?.message || 'Restore failed.');
                await fetchCustomers();
                await refreshDashboard();
                alert(result.message || ('Restored ' + username + ' into All Customers.'));
            } catch (error) {
                alert('Could not restore customer: ' + (error?.message || 'Unknown error'));
            } finally {
                if (button) { button.disabled = false; button.innerHTML = original; }
            }
        }
        window.restoreMissingRouterCustomer = restoreMissingRouterCustomer;

