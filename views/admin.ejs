                    <div class="hs-create-card-body">
                      <form id="addHotspotUserForm" novalidate>
                        <div class="hs-create-step">
                          <span class="hs-create-step-number" aria-hidden="true">1</span>
                          <div class="hs-create-step-content">
                            <label class="hs-create-label d-block">Activation Type</label><div class="d-flex flex-wrap gap-3 mb-3"><label class="form-check-label"><input class="form-check-input me-1" type="radio" name="activation_type" value="first_login" checked> On First Login</label><label class="form-check-label"><input class="form-check-input me-1" type="radio" name="activation_type" value="preassigned"> Pre-Assigned (Instant MAC Bind)</label></div>
                            <label class="hs-create-label" for="hsCustomerName">Customer Name</label><input id="hsCustomerName" name="customer_name" type="text" class="hs-create-input mb-3" maxlength="160" autocomplete="name" placeholder="Md. Rahim" required>
                            <label class="hs-create-label" for="hsUsername">Customer Phone Number <span class="text-danger">*</span></label>
                            <p class="hs-create-help">Use the 11-digit Bangladesh phone number (01XXXXXXXXX).</p>
                            <div class="hs-create-input-shell">
                              <i class="bi bi-telephone hs-create-input-icon" aria-hidden="true"></i>
                              <input id="hsUsername" name="phone" type="tel" class="hs-create-input" required minlength="11" maxlength="11" pattern="01[0-9]{9}" autocomplete="tel" inputmode="numeric" placeholder="01712345678" aria-describedby="hsPhoneFeedback">
                              <span id="hsPhoneValid" class="hs-create-valid-mark" aria-hidden="true">✓</span>
                            </div>
                            <div id="hsPhoneFeedback" class="hs-create-feedback" aria-live="polite">Enter a valid 11-digit Bangladeshi mobile number.</div><label class="hs-create-label mt-3" for="hsDeviceMac">Device MAC Address <span class="text-muted fw-normal">(Required for Pre-Assigned)</span></label><input id="hsDeviceMac" name="mac" type="text" class="hs-create-input mb-3 font-monospace" maxlength="17" placeholder="AA:BB:CC:DD:EE:FF" autocomplete="off"><label class="hs-create-label" for="hsPassword">Password <span class="text-muted fw-normal">(Defaults to phone)</span></label><input id="hsPassword" name="password" type="text" class="hs-create-input mb-2" maxlength="128" autocomplete="new-password" placeholder="Assigned automatically from device MAC">
                          </div>
                        </div>

                        <div class="hs-create-step">
                          <span class="hs-create-step-number" aria-hidden="true">2</span>
                          <div class="hs-create-step-content">
                            <label class="hs-create-label" for="hsProfile">Package / Profile <span class="text-danger">*</span></label>
                            <p class="hs-create-help">Choose the configured Hotspot profile, validity, and price.</p>
                            <div class="hs-create-profile-row">
                              <select id="hsProfile" name="profile" class="hs-create-select" required>
                                <option value="">Loading packages…</option>
                              </select>
                              <button type="button" id="hsRefreshProfiles" class="hs-create-refresh" aria-label="Reload packages and profiles" title="Reload packages">
                                <i class="bi bi-arrow-clockwise" aria-hidden="true"></i>
                              </button>
                            </div>
                          </div>
                        </div>

                        <div class="hs-create-step"><span class="hs-create-step-number" aria-hidden="true">+</span><div class="hs-create-step-content"><label class="hs-create-label" for="hsCustomExpiry">Custom Expiry Date &amp; Time <span class="text-muted fw-normal">(Optional override)</span></label><input id="hsCustomExpiry" name="expires_at" type="datetime-local" class="hs-create-input"><p class="hs-create-help">Used for Pre-Assigned accounts; first-login vouchers start their validity at activation.</p></div></div>
                        <div class="hs-create-step">
                          <span class="hs-create-step-number" aria-hidden="true">3</span>
                          <div class="hs-create-step-content">
                            <div class="hs-create-label">Account Validity Preview</div>
                            <div class="hs-create-validity-card">
                              <span class="hs-create-validity-icon" aria-hidden="true"><i class="bi bi-clock-history"></i></span>
                              <div>
                                <div class="small text-muted mb-1">Selected profile validity</div>
                                <div id="hsValidityLabel" class="fw-bold text-success">Select a profile</div>
                                <div class="small text-muted mt-1">Starts at first captive login; continuous clock thereafter.</div>
                              </div>
                            </div>
                          </div>
                        </div>

                        <div class="hs-create-step">
                          <span class="hs-create-step-number" aria-hidden="true">4</span>
                          <div class="hs-create-step-content">
                            <label class="hs-create-label" for="hsServer">Hotspot Server <span class="text-muted fw-normal">(Optional)</span></label>
                            <select id="hsServer" name="server" class="hs-create-select">
                              <option value="all">All Hotspot servers (default)</option>
                            </select>
                            <p class="hs-create-help mt-2 mb-0">Choose a specific server only when required; otherwise keep the default.</p>
                          </div>
                        </div>

                        <div class="mb-3"><label class="hs-create-label" for="hsCustomerNote">Optional Note / Address</label><textarea id="hsCustomerNote" name="note" class="form-control" rows="2" maxlength="1000" placeholder="Internal reference only"></textarea></div>
                        <div class="hs-create-actions">
                          <button type="button" id="hsClearForm" class="btn btn-outline-secondary hs-create-reset">
                            <i class="bi bi-arrow-counterclockwise me-2" aria-hidden="true"></i>Reset
                          </button>
                          <button type="submit" id="hsSaveButton" class="btn btn-success hs-create-save" disabled>
                            <i class="bi bi-person-check me-2" aria-hidden="true"></i>Save Pending Account
                          </button>
                        </div>
                        <div id="hotspotCreateResult" class="mt-3" role="status" aria-live="polite"></div>
                      </form>
                    </div>
                  </div>

                  <aside class="hs-create-preview" aria-label="Live Hotspot account preview">
                    <div class="hs-create-preview-card">
                      <div class="hs-create-card-head">
                        <div class="d-flex align-items-center justify-content-between gap-2 flex-wrap">
                          <h5 class="hs-create-preview-title"><i class="bi bi-eye text-success" aria-hidden="true"></i>Preview &amp; Details</h5>
                          <span class="hs-create-pending-badge"><i class="bi bi-hourglass-split" aria-hidden="true"></i>PENDING</span>
                        </div>
                        <p class="hs-create-preview-subtitle">Credentials and package details update as you complete the form.</p>
                      </div>
                      <div class="hs-create-card-body">
                        <div class="hs-create-credential-list">
                          <div class="hs-create-credential-row">
                            <span class="hs-create-credential-label">RouterOS Username</span>
                            <strong id="hsPreviewUsername" class="hs-create-credential-value">Assigned at first login (Device MAC)</strong>
                          </div>
                          <div class="hs-create-credential-row">
                            <span class="hs-create-credential-label">RouterOS Password</span>
                            <strong id="hsPreviewPassword" class="hs-create-credential-value">Customer phone number</strong>
                          </div>
                          <div class="hs-create-credential-row">
                            <span class="hs-create-credential-label">Profile</span>
                            <strong id="hsPreviewProfile" class="hs-create-credential-value">—</strong>
                          </div>
                          <div class="hs-create-credential-row">
                            <span class="hs-create-credential-label">Package Price</span>
                            <strong id="hsPreviewPrice" class="hs-create-credential-value">—</strong>
                          </div>
                          <div class="hs-create-credential-row">
                            <span class="hs-create-credential-label">Validity</span>
                            <strong id="hsPreviewValidity" class="hs-create-credential-value">—</strong>
                          </div>
                          <div class="hs-create-credential-row">
                            <span class="hs-create-credential-label">Hotspot Server</span>
                            <strong id="hsPreviewServer" class="hs-create-credential-value">All Hotspot servers (default)</strong>
                          </div>
                          <div class="hs-create-credential-row">
                            <span class="hs-create-credential-label">Expiry Date</span>
                            <strong id="hsPreviewExpiry" class="hs-create-credential-value">Starts at first login (Continuous clock)</strong>
                          </div>
                        </div>

                        <div class="mt-3">
                          <div class="d-flex align-items-center justify-content-between gap-2 mb-2">
                            <span class="small fw-bold text-success">MikroTik Comment</span>
                            <span class="small text-muted">Auto</span>
                          </div>
                          <code id="hsPreviewComment" class="hs-create-comment">FAZ | PENDING | —</code>
                        </div>

                        <div class="hs-create-info">
                          <i class="bi bi-shield-check fs-5" aria-hidden="true"></i>
                          <span>No manual MAC entry needed. The customer's device MAC will be locked to this phone number upon first captive portal connection.</span>
                        </div>
                      </div>
                    </div>
                  </aside>
                </div>
              </div>
            </section>`);

            const form = document.getElementById('addHotspotUserForm');
            const phone = document.getElementById('hsUsername');
            const phoneValidMark = document.getElementById('hsPhoneValid');
            const phoneFeedback = document.getElementById('hsPhoneFeedback');
            const profile = document.getElementById('hsProfile');
            const server = document.getElementById('hsServer');
            const macInput = document.getElementById('hsDeviceMac');
            const passwordInput = document.getElementById('hsPassword');
            const expiryInput = document.getElementById('hsCustomExpiry');
            const activationInputs = [...form.querySelectorAll('input[name="activation_type"]')];
            const activationMode = () => activationInputs.find(input => input.checked)?.value || 'first_login';
            if (expiryInput) expiryInput.disabled = true;
            const button = document.getElementById('hsSaveButton');
            const result = document.getElementById('hotspotCreateResult');
            const validityLabel = document.getElementById('hsValidityLabel');
            if (!form || !phone || !profile || !server || !button) return;

            let profileRecords = [];
            let profileReady = false;

            const asciiDigits = value => String(value || '')
                .replace(/[০-৯]/g, ch => String('০১২৩৪৫৬৭৮৯'.indexOf(ch)))
                .replace(/[^0-9]/g, '')
                .slice(0, 11);

            const validityText = p => {
                if (!p) return 'Select a profile';
                if (p.validityLabel) return String(p.validityLabel);
                const value = Number(p.validityValue);
                const unit = String(p.validityUnit || '').trim().toLowerCase();
                if (Number.isFinite(value) && value > 0) {
                    if (unit === 'gb' || unit === 'gib') return value + ' GB';
                    const labels = { second:'Second', seconds:'Seconds', minute:'Minute', minutes:'Minutes', hour:'Hour', hours:'Hours', day:'Day', days:'Days', week:'Week', weeks:'Weeks', month:'Month', months:'Months', year:'Year', years:'Years' };
                    const label = labels[unit] || unit;
                    return value + ' ' + label;
                }
                if (p.sessionTimeout && String(p.sessionTimeout).toLowerCase() !== 'none') return String(p.sessionTimeout);
                if (p.validity) return String(p.validity);
                if (Number(p.limitBytesTotal) > 0) return (Number(p.limitBytesTotal) / 1073741824).toFixed(0) + ' GB data limit';
                return 'Validity not configured';
            };

            const priceText = p => {
                if (!p || p.price === undefined || p.price === null || p.price === '') return 'Price not set';
                const amount = Number(p.price);
                return Number.isFinite(amount) ? '৳' + amount.toLocaleString('en-BD', { maximumFractionDigits: 2 }) : 'Price not set';
            };

            const selectedProfile = () => profileRecords.find(p => String(p.profile_id || p.name) === String(profile.value));
            const putText = (id, value) => {
                const element = document.getElementById(id);
                if (element) element.textContent = value;
            };

            const updatePhoneFeedback = () => {
                const normalized = asciiDigits(phone.value);
                if (phone.value !== normalized) phone.value = normalized;
                const valid = /^01[0-9]{9}$/.test(normalized);
                phone.classList.toggle('hs-phone-valid', valid);
                phone.classList.toggle('hs-phone-invalid', normalized.length > 0 && !valid);
                if (phoneValidMark) phoneValidMark.classList.toggle('is-visible', valid);
                if (phoneFeedback) {
                    phoneFeedback.textContent = valid
                        ? '✓ Valid Bangladesh mobile number.'
                        : (normalized.length ? 'Enter a valid 11-digit number beginning with 01.' : 'Enter a valid 11-digit Bangladeshi mobile number.');
                    phoneFeedback.classList.toggle('is-valid', valid);
                    phoneFeedback.classList.toggle('is-invalid', normalized.length > 0 && !valid);
                }
                return valid;
            };

            const updatePreview = () => {
                const p = selectedProfile();
                const validity = validityText(p);
                const selectedServer = server.value || 'all';
                if (validityLabel) validityLabel.textContent = p ? validity + ' — starts at first captive login' : 'Select a profile';
                const preassigned = activationMode() === 'preassigned';
                putText('hsPreviewUsername', preassigned ? (macInput.value.trim().toUpperCase() || 'Enter device MAC') : 'Assigned at first login (Device MAC)');
                putText('hsPreviewPassword', preassigned ? (macInput.value.trim().toUpperCase() || 'Same as device MAC') : 'Same as device MAC after first login');
                putText('hsPreviewProfile', p ? String(p.name || '—') : '—');
                putText('hsPreviewPrice', p ? priceText(p) : '—');
                putText('hsPreviewValidity', p ? validity : '—');
                putText('hsPreviewServer', selectedServer === 'all' ? 'All Hotspot servers (default)' : selectedServer);
                putText('hsPreviewExpiry', preassigned && expiryInput.value ? expiryInput.value.replace('T',' ') : preassigned ? 'Package validity starts now' : 'Starts at first login (Continuous clock)');
                putText('hsPreviewComment', preassigned ? 'Exp: ' + (expiryInput.value ? expiryInput.value.replace('T',' ') + ':00' : 'calculated from package') : 'FAZ | PENDING | ' + (p ? String(p.name || 'PROFILE') : '—'));
            };

            const updateButton = () => {
                const validPhone = updatePhoneFeedback();
                const preassigned = activationMode() === 'preassigned';
                const validMac = !preassigned || /^([0-9a-fA-F]{2}:){5}[0-9a-fA-F]{2}$/.test((macInput.value || '').trim().replace(/-/g, ':'));
                button.disabled = !(validPhone && profile.value && profileReady && validMac);
            };

            const toast = message => {
                let host = document.getElementById('hotspotProvisionToastHost');
                if (!host) {
                    host = document.createElement('div');
                    host.id = 'hotspotProvisionToastHost';
                    host.className = 'position-fixed top-0 end-0 p-3';
                    host.style.zIndex = '20000';
                    document.body.appendChild(host);
                }
                const item = document.createElement('div');
                item.className = 'alert alert-success shadow border-0 mb-0';
                item.setAttribute('role', 'status');
                item.textContent = message;
                host.appendChild(item);
                window.setTimeout(() => {
                    item.remove();
                    if (!host.children.length) host.remove();
                }, 4500);
            };

            phone.addEventListener('input', () => { updatePreview(); updateButton(); });
            [macInput,passwordInput,expiryInput].forEach(el => el?.addEventListener('input',()=>{updatePreview();updateButton();}));
            activationInputs.forEach(el=>el.addEventListener('change',()=>{macInput.required=activationMode()==='preassigned';expiryInput.disabled=activationMode()!=='preassigned';updatePreview();updateButton();}));
            profile.addEventListener('change', () => { updatePreview(); updateButton(); });
            server.addEventListener('change', updatePreview);

            const loadOptions = async () => {
                const previousProfile = profile.value;
                profileReady = false;
                button.disabled = true;
                profile.innerHTML = '<option value="">Loading packages…</option>';
                try {
                    const data = await jsonFetch('/api/hotspot/profiles');
                    profileRecords = (Array.isArray(data.profiles) ? data.profiles : [])
                        .filter(p => p && p.name && String(p.name).toLowerCase() !== 'default');
                    if (profileRecords.length) {
                        profile.innerHTML = '<option value="">Select a package / profile…</option>' +
                            profileRecords.map(p => '<option value="' + escapeHtml(p.profile_id || p.name) + '">' +
                                escapeHtml(p.name) + ' — ' + escapeHtml(validityText(p)) + ' — ' + escapeHtml(priceText(p)) +
                                '</option>').join('');
                        profileReady = true;
                        if (profileRecords.some(p => String(p.profile_id || p.name) === previousProfile)) profile.value = previousProfile;
                    } else {
                        profile.innerHTML = '<option value="">No saved packages found</option>';
                    }
                } catch (error) {
                    profileRecords = [];
                    profile.innerHTML = '<option value="">Package list unavailable — try reload</option>';
                }

                server.innerHTML = '<option value="all">All Hotspot servers (default)</option>';
                try {
                    const data = await jsonFetch('/api/hotspot/servers');
                    const servers = Array.isArray(data.servers) ? data.servers.filter(s => s && s.name) : [];
                    if (servers.length) {
                        server.innerHTML += servers.map(item => '<option value="' + escapeHtml(item.name) + '">' +
                            escapeHtml(item.name) + '</option>').join('');
                        const previousServer = server.dataset.selected || 'all';
                        if ([...server.options].some(option => option.value === previousServer)) server.value = previousServer;
                    }
                } catch (_) {
                    /* The "all servers" default remains usable if server discovery is unavailable. */
                }
                server.dataset.selected = server.value || 'all';
                updatePreview();
                updateButton();
            };

            const refreshButton = document.getElementById('hsRefreshProfiles');
            if (refreshButton) {
                refreshButton.addEventListener('click', async () => {
                    const oldHtml = refreshButton.innerHTML;
                    refreshButton.disabled = true;
                    refreshButton.innerHTML = '<span class="spinner-border spinner-border-sm" role="status" aria-label="Loading"></span>';
                    try { await loadOptions(); }
                    finally { refreshButton.disabled = false; refreshButton.innerHTML = oldHtml; }
                });
            }

            const resetButton = document.getElementById('hsClearForm');
            if (resetButton) {
                resetButton.addEventListener('click', () => {
                    form.reset();
                    profile.value = '';
                    macInput.value='';passwordInput.value='';expiryInput.value='';activationInputs.forEach(el=>el.checked=el.value==='first_login');macInput.required=false;expiryInput.disabled=true;
                    server.value = 'all';
                    server.dataset.selected = 'all';
                    if (result) result.innerHTML = '';
                    updatePreview();
                    updateButton();
                    phone.focus();
                });
            }

            form.addEventListener('submit', async event => {
                event.preventDefault();
                if (!updatePhoneFeedback() || !document.getElementById('hsCustomerName')?.value.trim()) {
                    if (!document.getElementById('hsCustomerName')?.value.trim()) document.getElementById('hsCustomerName')?.focus(); else phone.focus();
                    updateButton();
                    return;
                }
                if (!form.reportValidity()) return;
                const value = phone.value.trim();
                const chosen = selectedProfile();
                if (!chosen) {
                    if (result) result.innerHTML = '<div class="alert alert-danger mb-0">Choose a valid package / profile.</div>';
                    return;
                }

                button.disabled = true;
                button.innerHTML = '<span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>Saving Hotspot account…';
                if (result) result.innerHTML = '';
                try {
                    const response = await jsonFetch('/api/hotspot/users', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({
                            phone: value,
                            activation_type: activationMode(),
                            mac: macInput.value.trim(),
                            password: passwordInput.value.trim(),
                            expires_at: expiryInput.value || '',
                            customer_name: document.getElementById('hsCustomerName')?.value.trim() || '',
                            note: document.getElementById('hsCustomerNote')?.value.trim() || '',
                            profile_id: chosen.profile_id || chosen.name,
                            server: server.value || 'all'
                        })
                    });
                    if (!response || response.success !== true) throw new Error(response?.message || 'The pending account was not saved.');
                    const successMessage = response.instant_provisioned ? 'Pre-assigned Hotspot user provisioned immediately for ' + value + '.' : 'First-login Hotspot package saved for ' + value + '. MAC binding and countdown start on captive-portal activation.';
                    toast(successMessage);
                    if (result) result.innerHTML = '<div class="alert alert-success mb-0">' + escapeHtml(successMessage) + '</div>';
                    if (typeof window.refreshHotspotVoucherStats === 'function') {
                        Promise.resolve(window.refreshHotspotVoucherStats()).catch(() => {});
                    }
                } catch (error) {
                    if (result) result.innerHTML = '<div class="alert alert-danger mb-0">' + escapeHtml(error?.message || 'Unable to save pending account.') + '</div>';
                } finally {
                    button.innerHTML = '<i class="bi bi-person-check me-2" aria-hidden="true"></i>Save Direct Subscriber';
                    updateButton();
                }
            });

            await loadOptions();
        }
        async function loadHotspotDashboard(){
            // Compatibility alias for any existing internal callers. Always use the
            // canonical dashboard so the retired circular layout cannot be restored.
            if (typeof window.switchView === 'function') window.switchView('hotspot-dashboard');
            if (typeof window.startNocPolling === 'function') window.startNocPolling();
            return false;
        }
        window.loadHotspotDashboard = loadHotspotDashboard;
        window.refreshHotspotVoucherStats = async function refreshHotspotVoucherStats(){
            const ids=['hsVoucherTotal','hsVoucherUnused','hsVoucherUsed','hsVoucherActive','hsVoucherExpired','hsVoucherCleanupPending'];
            try{
                const response=await fetch('/api/hotspot/voucher-stats',{headers:{'Accept':'application/json'}});
                if(!response.ok) throw new Error('Unable to load voucher statistics ('+response.status+').');
                const data=await response.json();
                if(data.success===false) throw new Error(data.message||'Unable to load voucher statistics.');
                safeSetText('hsVoucherTotal',Number(data.totalVouchers||0).toLocaleString());
                safeSetText('hsVoucherUnused',Number(data.unusedVouchers||0).toLocaleString());
                safeSetText('hsVoucherUsed',Number(data.usedVouchers||0).toLocaleString());
                safeSetText('hsVoucherActive',Number(data.activeVouchers||0).toLocaleString());
                safeSetText('hsVoucherExpired',Number(data.expiredVouchers||0).toLocaleString());
                safeSetText('hsVoucherCleanupPending',Number(data.cleanupPending||0).toLocaleString());
            }catch(error){
                ids.forEach(function(id){safeSetText(id,'—');});
                console.error('[HOTSPOT VOUCHER STATS]',error);
                const total=document.getElementById('hsVoucherTotal');
                if(total) total.title=error.message||'Voucher statistics unavailable';
            }
        };
        async function refreshHotspotDashboardMetrics(){
            const body=document.getElementById('hotspotDashboardSessions'); if(!body)return;
            try{
                const [metricsResponse,activeResponse]=await Promise.all([
                    fetch('/api/hotspot/dashboard-metrics'),
                    fetch('/api/hotspot/active')
                ]);
                if(!metricsResponse.ok) throw new Error('Unable to load Hotspot dashboard metrics.');
                if(!activeResponse.ok) throw new Error('Unable to load active Hotspot users.');
                const d=await metricsResponse.json();
                const activeData=await activeResponse.json();
                safeSetText('hsTotalUsers',Number(d.totalUsers||0));
                safeSetText('hsActiveUsers',Number(d.activeUsers||0));
                safeSetText('hsOfflineUsers',Number(d.offlineUsers||0));
                safeSetText('hsTodayRevenue',Number(d.activeRevenue??d.todayRevenue??0).toFixed(2));
                safeSetText('hsVouchersSoldToday',Number(d.vouchersSoldToday||0).toLocaleString());
                safeSetText('hsExpiredToday',Number(d.expiredToday||0).toLocaleString());
                safeSetText('hsExpiringWithinHour',Number(d.expiringWithinHour||0).toLocaleString());
                safeSetText('hsCleanupPending',Number(d.cleanupPending||0).toLocaleString());
                safeSetText('hsEvictedToday',Number(d.evictedToday||0).toLocaleString()+' evicted today');
                safeSetText('hsRoundTotalUsers',Number(d.totalUsers||0).toLocaleString());
                safeSetText('hsRoundActiveUsers',Number(d.activeUsers||0).toLocaleString());
                safeSetText('hsRoundOfflineUsers',Number(d.offlineUsers||0).toLocaleString());
                safeSetText('hsRoundTodayRevenue','৳'+Number(d.todayRevenue||0).toFixed(2));
                const rows=Array.isArray(activeData.users)?activeData.users:[];
                body.innerHTML=rows.length?rows.map(function(s){
                    return '<tr><td><strong>'+escapeHtml(s.username||'-')+'</strong></td><td class="font-monospace">'+escapeHtml(s.address||'-')+'</td><td class="font-monospace">'+escapeHtml(s.mac_address||'-')+'</td><td>'+escapeHtml(s.uptime||'-')+'</td></tr>';
                }).join(''):'<tr><td colspan="4" class="text-center py-5 text-muted">No active Hotspot users.</td></tr>';
                const status=document.getElementById('hotspotDashboardStatus');
                if(status){status.className='badge bg-success ms-auto';status.textContent='Live · '+Number(d.activeUsers||0)+' active';}
            }catch(error){
                safeSetText('hsTotalUsers','—'); safeSetText('hsActiveUsers','—'); safeSetText('hsOfflineUsers','—'); safeSetText('hsTodayRevenue','—');
