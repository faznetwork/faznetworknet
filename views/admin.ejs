                if(status){status.textContent='Syncing…';status.className='badge bg-info ms-auto';}
                const response=await jsonFetch('/api/settings/hotspot-profiles');
                liveHotspotProfiles=Array.isArray(response.profiles)?response.profiles:[];
                const rows=document.getElementById('hotspotPriceProfileRows');
                if(!liveHotspotProfiles.length)throw new Error('No Hotspot profiles were returned by MikroTik.');
                if(rows)rows.innerHTML=liveHotspotProfiles.map(p=>{
                    const quota=Number(p.limitBytesTotal||0);
                    const quotaLabel=quota>0?(quota/1073741824).toLocaleString(undefined,{maximumFractionDigits:2})+' GB':'—';
                    const validity=p.validityLabel||p.sessionTimeout||'Not configured';
                    return '<tr><td class="fw-semibold">'+escapeHtml(p.name)+'</td><td><span class="badge text-bg-light border">৳'+Number(p.price||0).toFixed(2)+'</span></td><td>'+escapeHtml(validity)+'</td><td>'+escapeHtml(p.rateLimit||'Not set')+'</td><td>'+escapeHtml(quotaLabel)+'</td></tr>';
                }).join('');
                const source=document.getElementById('hotspotProfileSource');if(source)source.textContent='Live MikroTik profiles + database metadata · '+liveHotspotProfiles.length+' profiles · Last synced '+new Date().toLocaleTimeString();
                if(status){status.textContent='Synced';status.className='badge bg-success ms-auto';}
                if(result){result.className='small mt-3 text-muted';result.textContent='Automatically refreshed. Profile price or validity edits are used by the next payment verification.';}
            }catch(error){if(status){status.textContent='Unavailable';status.className='badge bg-danger ms-auto';}if(result){result.className='small mt-3 text-danger fw-semibold';result.textContent=error.message||'Unable to load live Hotspot profiles.';}}
        }
