            appendHotspotView('<section class="hotspot-dynamic-view admin-view"><div class="card card-custom"><div class="card-body text-center py-5"><div class="spinner-border text-success"></div><div class="small text-muted mt-2">Loading Hotspot profiles…</div></div></div></section>');
