                if(!profiles.length) select.innerHTML='<option value="">No MikroTik profiles found</option>';
            } catch(error) {
                const select=document.getElementById('voucherProfile'); if(select) select.innerHTML='<option value="">'+escapeHtml(error.message)+'</option>';
            }
            document.getElementById('voucherGeneratorForm').addEventListener('submit',generateVoucherBatch);
        }

        async function generateVoucherBatch(event) {
            event.preventDefault();
            const btn=event.submitter;
            if(btn){btn.disabled=true;btn.innerHTML='<span class="spinner-border spinner-border-sm me-1"></span> '+hotspotTitle('generating')+'...';}
            try {
                const payload={quantity:Number(document.getElementById('voucherQuantity').value),profile:document.getElementById('voucherProfile').value,validity:document.getElementById('voucherValidity').value.trim(),price:Number(document.getElementById('voucherPrice').value),userPrefix:document.getElementById('voucherPrefix').value.trim(),charLength:Number(document.getElementById('voucherCharLength').value)};
                const data=await jsonFetch('/api/hotspot/vouchers/generate',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify(payload)});
                renderVoucherCards(data.vouchers||[]);
                const count=document.getElementById('voucherBatchCount'); safeSetText('voucherBatchCount', data.count||0);
            } catch(error) { alert(error.message); }
            finally { if(btn){btn.disabled=false;btn.innerHTML='<i class="bi bi-magic me-1"></i> <span data-key="generate_batch_vouchers">Generate Batch Vouchers</span>';} }
        }

        function printVoucherCards() {
            if(!currentVoucherBatch.length){alert(hotspotTitle('generate_first'));return;}
            document.body.classList.add('hotspot-printing');
            setTimeout(function(){window.print();},50);
            setTimeout(function(){document.body.classList.remove('hotspot-printing');},1000);
        }


