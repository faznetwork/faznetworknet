                await jsonFetch('/api/hotspot/users/kick',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({id:id,username:username})});
                await refreshHotspotCurrent();
            } catch(error){ alert(error.message); }
        }

                function filterHotspotRows(query) {
            const q=String(query||'').trim().toLowerCase();
            document.querySelectorAll('#hotspotUserBody tr').forEach(function(row){row.style.display=row.innerText.toLowerCase().includes(q)?'':'none';});
        }

        async function loadHotspotSection(filter,titleKey) {
