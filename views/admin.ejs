            }

            .main-content > .navbar {
                position: sticky;
                top: 0;
                z-index: 1020;
                min-height: 56px;
                margin: -10px -12px 14px !important;
                padding: 8px 10px !important;
                border-radius: 0 !important;
                border-bottom: 1px solid #e2e8f0;
                box-shadow: 0 3px 12px rgba(15,23,42,.06) !important;
            }

            .main-content > .navbar > .container-fluid {
                flex-wrap: nowrap;
                gap: 8px !important;
                min-width: 0;
            }

            #mobileSidebarToggle {
                display: inline-grid;
                place-items: center;
                flex: 0 0 40px;
                width: 40px;
                height: 40px;
                padding: 0;
                border-radius: 10px;
                font-size: 20px;
                touch-action: manipulation;
            }

            #pageTitle {
                min-width: 0;
                margin: 0;
                overflow: hidden;
                text-overflow: ellipsis;
                white-space: nowrap;
                font-size: 15px !important;
            }

            .main-content > .navbar .text-end { display: none !important; }
            .main-content > .navbar form[action="/logout"] { display: none !important; }

            /* Stable drawer: animate transform rather than competing left/width transitions. */
            .sidebar {
                display: flex;
                flex-direction: column;
                left: 0 !important;
                top: 0;
                bottom: 0;
                width: var(--sidebar-width);
                max-width: 86vw;
                padding-bottom: max(8px, env(safe-area-inset-bottom));
                overflow: hidden;
                overscroll-behavior: contain;
                transform: translateX(-102%);
                visibility: hidden;
                transition: transform 220ms ease, visibility 0s linear 220ms;
                will-change: transform;
                z-index: 1041;
                box-shadow: 8px 0 30px rgba(0,0,0,.22);
            }

            .sidebar.show {
                left: 0 !important;
                transform: translateX(0);
                visibility: visible;
                transition-delay: 0s;
            }

            .sidebar-backdrop {
                display: block;
                position: fixed;
                inset: 0;
                z-index: 1040;
                background: rgba(15,23,42,.48);
                opacity: 0;
                visibility: hidden;
                pointer-events: none;
                transition: opacity 180ms ease, visibility 0s linear 180ms;
                touch-action: manipulation;
            }

            .sidebar-backdrop.show {
                opacity: 1;
                visibility: visible;
                pointer-events: auto;
                transition-delay: 0s;
            }

            body.sidebar-open {
                overflow: hidden;
                overscroll-behavior: none;
            }

            .sidebar-header {
                flex: 0 0 auto;
                min-height: 58px;
                padding: 12px 14px;
