        function paymentCustomerTypeBadge(value, t) {
            const type = String(value || 'unassigned').toLowerCase();
            const labels = { pppoe: t.type_pppoe || 'PPPoE', hotspot: t.type_hotspot || 'Hotspot', unassigned: t.type_unassigned || 'Unassigned', unknown: t.type_unknown || 'Unknown' };
            const classes = { pppoe: 'bg-primary', hotspot: 'bg-success', unassigned: 'bg-secondary', unknown: 'bg-warning text-dark' };
            return '<span class="badge ' + (classes[type] || classes.unknown) + '">' + escapeHtml(labels[type] || labels.unknown) + '</span>';
        }

        function paymentRowHtml(tx, index, t) {
            const unmatched = String(tx.status || '').toLowerCase() === 'unmatched';
            const status = String(tx.status || '').toLowerCase();
            const gateway = String(tx.channel || '').toLowerCase();
            const gatewayLabel = gateway === 'bkash' ? 'bKash' : gateway === 'nagad' ? 'Nagad' : gateway === 'rocket' ? 'Rocket' : gateway || '-';
            const manualAction = unmatched ? '<button type="button" class="btn btn-sm btn-outline-success" title="' + escapeHtml(t.manual_match) + '" aria-label="' + escapeHtml(t.manual_match) + '" data-manual-match-trx="' + escapeHtml(tx.trx_id || '') + '"><i class="bi bi-person-check"></i></button>' : '';
            const canForceProvision = ['unmatched','processing','processed','paid'].includes(status) && String(tx.customer_type || '').toLowerCase() !== 'pppoe';
            const forceAction = canForceProvision ? '<button type="button" class="btn btn-sm btn-warning text-dark text-nowrap" title="Immediately provision Hotspot access" data-force-provision-trx="' + escapeHtml(tx.trx_id || '') + '"><i class="bi bi-lightning-charge-fill me-1"></i>Force Provision</button>' : '';
            const action = manualAction || forceAction ? manualAction + forceAction : '<span class="text-muted">—</span>';
            return '<tr data-payment-row>' +
                '<td>' + index + '</td>' +
                '<td><strong>' + escapeHtml(tx.trx_id || '-') + '</strong></td>' +
                '<td><span class="badge payment-gateway-badge ' + paymentGatewayClass(gateway) + '">' + escapeHtml(gatewayLabel) + '</span></td>' +
                '<td class="fw-semibold">৳' + Number(tx.amount || 0).toFixed(2) + '</td>' +
                '<td>' + escapeHtml(tx.sender_phone || '-') + '</td>' +
                '<td>' + escapeHtml(tx.matched_username || '-') + '</td>' +
                '<td>' + paymentCustomerTypeBadge(tx.customer_type, t) + '</td>' +
