        }

        // Explicit globals keep inline sidebar/table handlers stable even if bundling/scope changes.
        window.loadCustomerSection = loadCustomerSection;
        window.refreshCustomerSection = refreshCustomerSection;
        window.filterCustomerRows = filterCustomerRows;
        window.setCustomerBillingFilter = setCustomerBillingFilter;
        window.showAddCustomerForm = showAddCustomerForm;

