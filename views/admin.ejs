        if(!window.__planPackageDelegationBound){
            document.addEventListener('click', function(e) {
                const createBtn = e.target.closest('#createPlanBtn, .create-plan-btn');
                if (createBtn) {
                    e.preventDefault();
                    window.openCreatePlanModal();
                    return;
                }

                const editBtn = e.target.closest('.edit-plan-btn');
                if (editBtn) {
                    e.preventDefault();
                    let plan = null;
                    try {
                        plan = JSON.parse(editBtn.getAttribute('data-plan-json') || '{}');
                    } catch (_) {
                        plan = {
                            id: editBtn.getAttribute('data-id') || '',
                            name: editBtn.getAttribute('data-name') || '',
                            price: editBtn.getAttribute('data-price') || '',
                            duration_months: editBtn.getAttribute('data-duration') || '1',
                            rate_limit: editBtn.getAttribute('data-ratelimit') || '',
                            local_address: editBtn.getAttribute('data-localaddress') || '',
                            remote_address: editBtn.getAttribute('data-remoteaddress') || '',
                            dns_server: editBtn.getAttribute('data-dnsserver') || '',
                            change_tcp_mss: editBtn.getAttribute('data-tcpmss') || 'default'
                        };
                    }

                    const idEl = document.getElementById('planId');
                    const nameEl = document.getElementById('planName');
                    const priceEl = document.getElementById('planPrice');
                    const durationEl = document.getElementById('planDuration');
                    const rateEl = document.getElementById('planRateLimit');
                    const localEl = document.getElementById('planLocalAddress');
                    const remoteEl = document.getElementById('planRemoteAddress');
                    const dnsEl = document.getElementById('planDnsServer');
                    const mssEl = document.getElementById('planChangeTcpMss');

                    if (idEl) idEl.value = editBtn.getAttribute('data-id') || plan.id || '';
                    if (nameEl) nameEl.value = editBtn.getAttribute('data-name') || plan.plan_name || plan.name || '';
                    if (priceEl) priceEl.value = editBtn.getAttribute('data-price') || plan.price || '';
                    if (durationEl) durationEl.value = editBtn.getAttribute('data-duration') || plan.duration_months || plan.duration || '1';
                    if (rateEl) rateEl.value = editBtn.getAttribute('data-ratelimit') || plan.rate_limit || plan.rateLimit || '';
                    if (localEl) localEl.value = editBtn.getAttribute('data-localaddress') || plan.local_address || plan.localAddress || '';
                    if (remoteEl) remoteEl.value = editBtn.getAttribute('data-remoteaddress') || plan.remote_address || plan.remoteAddress || plan.pool_name || '';
                    if (dnsEl) dnsEl.value = editBtn.getAttribute('data-dnsserver') || plan.dns_server || plan.dnsServer || '';
                    if (mssEl) mssEl.value = editBtn.getAttribute('data-tcpmss') || plan.change_tcp_mss || plan.changeTcpMss || 'default';

                    purgeStuckBackdrops();
                    openPlanModal(plan);
                    return;
                }

                const deleteBtn = e.target.closest('.delete-plan-btn');
                if (deleteBtn) {
                    e.preventDefault();
                    const planId = deleteBtn.getAttribute('data-id') || '';
                    const planName = deleteBtn.getAttribute('data-name') || '';
                    if (!planName) return;
                    if (!confirm('Are you sure you want to delete Plan "' + planName + '" from MikroTik and Database?')) return;

                    deletePlan(planId, planName).catch(function(error) {
                        console.error('[PLAN UI] Delete error:', error);
                        alert(error?.message || 'Network error while deleting plan.');
                    });
                }
            });

            document.addEventListener('submit', function(e) {
                const form = e.target.closest('#planForm, #createPlanForm');
                if (!form) return;
                e.preventDefault();
                savePlan(e);
            });

            window.__planPackageDelegationBound = true;
        }

