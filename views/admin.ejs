        // Customer-facing dates are DD/MM/YYYY; API and date arithmetic use YYYY-MM-DD.
        // Slash dates default to DMY; unambiguous dates are resolved automatically.
        function parseCustomerDate(value, slashOrder = 'DMY') {
            if (value == null || value === '') return null;
            if (value instanceof Date) {
                if (Number.isNaN(value.getTime())) return null;
                return validateCustomerDate(value.getFullYear(), value.getMonth() + 1, value.getDate());
            }
            const raw = String(value).trim();
            if (!raw) return null;
            let match = raw.match(/^(\d{4})-(\d{2})-(\d{2})(?:$|T|\s)/);
            if (match) return validateCustomerDate(Number(match[1]), Number(match[2]), Number(match[3]));
            match = raw.match(/^(\d{1,2})[\/-](\d{1,2})[\/-](\d{4})$/);
            if (!match) return null;
            const first = Number(match[1]), second = Number(match[2]), year = Number(match[3]);
            let day, month;
            if (first > 12) { day = first; month = second; }
            else if (second > 12) { month = first; day = second; }
            else if (String(slashOrder).toUpperCase() === 'MDY') { month = first; day = second; }
            else { day = first; month = second; }
            return validateCustomerDate(year, month, day);
        }
        function validateCustomerDate(year, month, day) {
            if (year < 1000 || year > 9999) return null;
            const date = new Date(Date.UTC(year, month - 1, day));
            if (date.getUTCFullYear() !== year || date.getUTCMonth() !== month - 1 || date.getUTCDate() !== day) return null;
            return { year, month, day };
        }
        function dateInputToIso(value) {
            const parts = parseCustomerDate(value, 'DMY');
            if (!parts) return '';
            return String(parts.year).padStart(4, '0') + '-' + String(parts.month).padStart(2, '0') + '-' + String(parts.day).padStart(2, '0');
        }
        // Display-only formatter. Never use this result as the RouterOS/API payload.
        function formatMikrotikDate(dateStr) {
            if (!dateStr || dateStr === '-') return '-';
            const parts = parseCustomerDate(dateStr, 'DMY');
            if (!parts) return '';
            const iso = String(parts.year).padStart(4, '0') + '-' +
                String(parts.month).padStart(2, '0') + '-' +
                String(parts.day).padStart(2, '0');
            // Format only a validated calendar date; preserve the canonical date separately.
            const match = iso.match(/^(\\d{4})-(\\d{2})-(\\d{2})$/);
            return match ? `${match[3]}/${match[2]}/${match[1]}` : '';
        }
        function formatDateForInput(value) {
            const formatted = formatMikrotikDate(value);
            return formatted === '-' ? '' : formatted;
        }
        function initializeCustomerDatePickers(root = document) {
            if (typeof window.flatpickr !== 'function') {
                console.error('[Customer Date Picker] Flatpickr did not load.');
                return;
            }
            const selectors = '#connectionDate, #activationDate, #expirationDate, #cpExpiration';
            const candidates = [];
            if (root instanceof Element && root.matches?.(selectors)) candidates.push(root);
            if (root.querySelectorAll) root.querySelectorAll(selectors).forEach(input => candidates.push(input));
            candidates.forEach(input => {
                if (!(input instanceof HTMLInputElement)) return;
                if (input.type !== 'text') input.type = 'text';
                input.placeholder = 'DD/MM/YYYY';
                input.inputMode = 'numeric';
                input.autocomplete = 'off';
                input.maxLength = 10;
                input.setAttribute('pattern', '\\d{2}/\\d{2}/\\d{4}');
                input.dataset.dateFormat = 'DD/MM/YYYY';
                if (input._flatpickr) return;
                const prior = input.value;
                window.flatpickr(input, {
                    dateFormat: 'd/m/Y',
                    allowInput: true,
                    disableMobile: true,
                    clickOpens: true,
                    onClose(selectedDates, dateStr, instance) {
                        if (!dateStr) {
                            instance.input.setCustomValidity('');
                            return;
                        }
                        const iso = dateInputToIso(dateStr);
                        instance.input.setCustomValidity(iso ? '' : 'Enter a valid date in DD/MM/YYYY format.');
                        if (iso) instance.setDate(iso, false, 'Y-m-d');
                    }
                });
                const iso = dateInputToIso(prior);
                if (iso) input._flatpickr.setDate(iso, false, 'Y-m-d');
            });
        }
        function setCustomerDateValue(input, value) {
            if (!input) return;
            const iso = dateInputToIso(value);
            if (input._flatpickr) input._flatpickr.setDate(iso || '', false, 'Y-m-d');
            else input.value = iso ? formatDateForInput(iso) : '';
            input.setCustomValidity('');
        }
        function localDateValue() {
            const now = new Date();
            const offset = now.getTimezoneOffset();
            return new Date(now.getTime() - offset * 60000).toISOString().slice(0, 10);
        }
        function addCalendarMonths(dateString, months) {
            const base=new Date(String(dateString||"")+"T00:00:00Z"); if(Number.isNaN(base.getTime())) return "";
            const day=base.getUTCDate(), target=new Date(Date.UTC(base.getUTCFullYear(),base.getUTCMonth()+Number(months),1));
            const last=new Date(Date.UTC(target.getUTCFullYear(),target.getUTCMonth()+1,0)).getUTCDate(); target.setUTCDate(Math.min(day,last));
            return target.toISOString().slice(0,10);
        }
