        function hotspotStatusBadge(user) {
            if(user.online) return '<span class="badge bg-success">Online</span>';
            if(user.active) return '<span class="badge bg-primary">Active</span>';
            if(user.status==='expired') return '<span class="badge bg-danger">Expired</span>';
            return '<span class="badge bg-secondary">Unused</span>';
        }

        function formatBytes(value) {
            const n=Number(value||0); if(!n) return '0 B';
            const units=['B','KB','MB','GB','TB']; const i=Math.min(Math.floor(Math.log(n)/Math.log(1024)),units.length-1);
            return (n/Math.pow(1024,i)).toFixed(i?1:0)+' '+units[i];
        }

        function renderHotspotTable(data, mode, titleKey) {
            const lang=localStorage.getItem('faz_preferred_lang')||'en';
            const users=data.users||[];
            let rows='';
            if(mode==='active') {
                rows=users.map(function(u,i){
                    const sid=u.id||'';
                    return '<tr><td>'+(i+1)+'</td><td><strong>'+escapeHtml(u.username||'-')+'</strong></td><td class="font-monospace">'+escapeHtml(u.address||'-')+'</td><td class="font-monospace">'+escapeHtml(u.mac_address||u.macAddress||'-')+'</td><td>'+escapeHtml(u.uptime||'-')+'</td><td>'+formatBytes(u.bytes_in||u.bytesIn)+' / '+formatBytes(u.bytes_out||u.bytesOut)+'</td><td><button class="btn btn-sm btn-outline-warning" onclick="kickHotspotSession('+JSON.stringify(sid)+','+JSON.stringify(u.username||'')+')"><i class="bi bi-box-arrow-right"></i> Kick</button></td></tr>';
                }).join('');
                if(!rows) rows='<tr><td colspan="7" class="text-center py-5 text-muted">No active Hotspot devices are connected right now.</td></tr>';
                appendHotspotView('<section class="hotspot-dynamic-view admin-view"><div class="card card-custom"><div class="card-custom-header flex-wrap"><div><i class="bi bi-broadcast-pin text-success fs-5 me-2"></i>'+escapeHtml(hotspotTitle(titleKey))+' <span class="badge bg-success">'+users.length+'</span></div><div class="ms-auto"><span class="badge bg-success">Live MikroTik</span><button class="btn btn-outline-success btn-sm ms-2" onclick="refreshHotspotCurrent()"><i class="bi bi-arrow-clockwise"></i></button></div></div><div class="card-body p-0 table-responsive"><table class="table table-hover mb-0 hotspot-live-table"><thead class="table-light"><tr><th>#</th><th>User / Code</th><th>Assigned IP</th><th>MAC Address</th><th>Current Uptime</th><th>Download / Upload</th><th>Action</th></tr></thead><tbody id="hotspotUserBody">'+rows+'</tbody></table></div></div></section>');
            } else {
                rows=users.map(function(u,i){ return '<tr><td>'+(i+1)+'</td><td><strong>'+escapeHtml(u.username)+'</strong></td><td class="font-monospace">'+escapeHtml(u.password||u.mikrotik?.password||'-')+'</td><td>'+escapeHtml(u.profile||u.mikrotik?.profile||'-')+'</td><td>'+escapeHtml(u.online?.address||'-')+'</td><td>'+escapeHtml(u.online?.macAddress||'-')+'</td><td>'+escapeHtml(u.online?.uptime||'-')+'</td><td>'+hotspotStatusBadge(u)+'</td><td><button class="btn btn-sm btn-outline-warning" '+(u.online?'':'disabled')+' onclick="kickHotspotUser('+JSON.stringify(u.username)+')"><i class="bi bi-box-arrow-right"></i></button> <button class="btn btn-sm btn-outline-danger" onclick="removeHotspotUser('+JSON.stringify(u.username)+')"><i class="bi bi-trash"></i></button></td></tr>'; }).join('');
                if(!rows) rows='<tr><td colspan="10" class="text-center py-5 text-muted">No Hotspot users found.</td></tr>';
                appendHotspotView('<section class="hotspot-dynamic-view admin-view"><div class="card card-custom"><div class="card-custom-header flex-wrap"><div><i class="bi bi-wifi text-success fs-5 me-2"></i>'+escapeHtml(hotspotTitle(titleKey))+' <span class="badge bg-success">'+users.length+'</span></div><div class="hotspot-search ms-auto mt-2 mt-md-0"><div class="input-group input-group-sm"><span class="input-group-text bg-white"><i class="bi bi-search"></i></span><input id="hotspotSearch" class="form-control" placeholder="Search username, profile, IP or MAC..." data-placeholder-key="search_hotspot" oninput="filterHotspotRows(this.value)"></div></div><button class="btn btn-outline-success btn-sm ms-2 mt-2 mt-md-0" onclick="refreshHotspotCurrent()"><i class="bi bi-arrow-clockwise"></i></button></div><div class="card-body p-0 table-responsive"><table class="table table-hover mb-0 hotspot-live-table"><thead class="table-light"><tr><th>#</th><th>Username</th><th>Password</th><th>Profile</th><th>IP</th><th>MAC Address</th><th>Uptime</th><th data-key="bytes_in_out">Bytes In/Out</th><th>Status</th><th>Actions</th></tr></thead><tbody id="hotspotUserBody">'+rows+'</tbody></table></div></div></section>');
            }
            updateLanguage(lang);
