        .ipam-shell .ipam-table code{font:600 12px 'JetBrains Mono',ui-monospace,SFMono-Regular,Menlo,monospace;color:#0f766e!important}
        .ipam-shell .ipam-muted{font-size:12px;color:#475569!important}
        .ipam-shell .ipam-pool-tag{display:inline-block;max-width:180px;overflow-wrap:anywhere;border:1px solid #e2e8f0;background:#f8fafc!important;color:#334155!important;border-radius:6px;padding:4px 7px;font-size:11px;font-weight:650}
        .ipam-shell .ipam-table-foot{padding:11px 12px;border-top:1px solid #e2e8f0;font-size:11px;color:#475569!important;line-height:1.55;background:#f8fafc}
