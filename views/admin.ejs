        // Defensive guard: customer date fields use text + Flatpickr, never native date controls.
        function enforceCustomerDateDisplay(root) {
            const scope = root && root.querySelectorAll ? root : document;
            const selector = '#connectionDate, #activationDate, #expirationDate, #cpExpiration, #editCustomerModal input[type="date"], #customerEditFormModal input[type="date"], #customerProfileModal input[type="date"]';
            const candidates = [];
            if (scope.matches && scope.matches(selector)) candidates.push(scope);
            if (scope.querySelectorAll) scope.querySelectorAll(selector).forEach(input => candidates.push(input));
            candidates.forEach(input => {
                if (!(input instanceof HTMLInputElement)) return;
                const previousValue = String(input.value || '').trim();
                if (input.type === 'date') input.type = 'text';
                if (!['connectionDate', 'activationDate', 'expirationDate', 'cpExpiration'].includes(input.id) && !previousValue) return;
                input.placeholder = 'DD/MM/YYYY';
                input.inputMode = 'numeric';
                input.autocomplete = 'off';
                input.maxLength = 10;
                input.setAttribute('pattern', '\\d{2}/\\d{2}/\\d{4}');
                input.dataset.dateFormat = 'DD/MM/YYYY';
                const iso = dateInputToIso(previousValue);
                if (iso) input.value = formatDateForInput(iso);
            });
            initializeCustomerDatePickers(scope);
        }

        function initializeCustomerDateFormatGuard() {
            enforceCustomerDateDisplay(document);
