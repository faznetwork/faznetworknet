            .mobile-header-status{padding:6px 7px;font-size:9px}
            .hotspot-dashboard-shortcuts{display:grid!important;grid-template-columns:repeat(2,minmax(0,1fr));align-items:stretch;justify-content:stretch;gap:10px;width:100%;padding:2px 0 4px;margin-bottom:14px!important}
            .hotspot-dashboard-shortcuts>.dashboard-round-button{box-sizing:border-box;width:100%;min-width:0;max-width:none;height:auto;min-height:112px;max-height:none;flex:initial;padding:12px 8px;border-radius:14px;gap:5px;overflow-wrap:anywhere}
            .hotspot-dashboard-shortcuts .dashboard-round-icon{width:30px;height:30px;flex:0 0 30px;font-size:14px;margin:0 0 2px}
            .hotspot-dashboard-shortcuts .dashboard-round-button>strong{max-width:100%;font-size:20px}
            .hotspot-dashboard-shortcuts .dashboard-round-button>strong.dashboard-round-amount{font-size:14px}
            .hotspot-dashboard-shortcuts .dashboard-round-label{max-width:100%;font-size:11px;line-height:1.25}
            .hotspot-dashboard-shortcuts .dashboard-round-hint{font-size:10px;line-height:1.25}
            .hotspot-dashboard-shortcuts>.hotspot-router-action{grid-column:1/-1;display:flex;flex-direction:row;justify-content:flex-start;align-items:center;gap:12px;min-height:72px;padding:14px 16px;border-radius:14px;text-align:left;background:linear-gradient(110deg,#fff 0%,#f5f3ff 100%);box-shadow:0 5px 16px rgba(109,40,217,.08)}
            .hotspot-dashboard-shortcuts>.hotspot-router-action .dashboard-round-icon{width:42px;height:42px;flex:0 0 42px;font-size:18px;margin:0}
            .hotspot-dashboard-shortcuts>.hotspot-router-action .hotspot-router-action-copy strong{max-width:100%;color:#6d28d9;font-size:14px;line-height:1.2}
            .hotspot-dashboard-shortcuts>.hotspot-router-action .dashboard-round-hint{color:#64748b;font-size:11px}
            .hotspot-dashboard-shortcuts>.hotspot-router-action .hotspot-router-action-arrow{flex:0 0 auto;color:#6d28d9;font-size:20px}
            .sidebar{height:100vh;height:100dvh;display:flex;flex-direction:column;overflow:hidden}
            .lang-switcher{flex:0 0 auto;align-self:flex-start;display:inline-flex;width:auto;max-width:100%;gap:7px;align-items:center;padding:6px 12px;margin:4px 0 0;border-bottom:0;font-size:12px}
            .lang-switcher>i{margin:0;font-size:15px}
            .lang-switcher select{width:auto;min-width:0;max-width:132px;height:30px;padding:3px 24px 3px 8px;font-size:12px;border-radius:8px}
            .sidebar-menu{flex:1 1 auto;min-height:0;overflow-y:auto;overflow-x:hidden;overscroll-behavior:contain;-webkit-overflow-scrolling:touch;margin:4px 0 0;padding-bottom:12px}
            .drawer-account{position:sticky;bottom:0;z-index:2;flex:0 0 auto;margin-top:auto;padding-bottom:max(8px,env(safe-area-inset-bottom));box-shadow:0 -5px 18px rgba(0,0,0,.12)}
            .hotspot-dashboard-tip{margin-top:2px;padding:12px}
        }
