        async function loadVoucherGeneratorSection() {
            currentHotspotMode='generator'; currentHotspotTitleKey='gen_print_vouchers'; setHotspotTitle('gen_print_vouchers');
            appendHotspotView('<section class="hotspot-dynamic-view admin-view"><div class="row g-4"><div class="col-12"><div class="card card-custom"><div class="card-custom-header"><i class="bi bi-ticket-perforated text-success fs-5"></i><span data-key="gen_print_vouchers">'+escapeHtml(hotspotTitle('gen_print_vouchers'))+'</span></div><div class="card-body"><form id="voucherGeneratorForm"><div class="row g-3"><div class="col-md-2"><label class="form-label" data-key="quantity">Quantity</label><input id="voucherQuantity" type="number" class="form-control" min="1" max="500" value="10" required></div><div class="col-md-2"><label class="form-label" data-key="user_prefix">User Prefix</label><input id="voucherPrefix" class="form-control" value="FAZ-" maxlength="20"></div><div class="col-md-2"><label class="form-label" data-key="character_length">Character Length</label><input id="voucherCharLength" type="number" class="form-control" min="4" max="16" value="6"></div><div class="col-md-3"><label class="form-label" data-key="profile">Profile</label><select id="voucherProfile" class="form-select" required><option value="">Loading profiles...</option></select></div><div class="col-md-1"><label class="form-label" data-key="price">Price</label><input id="voucherPrice" type="number" class="form-control" min="0" step="0.01" value="20"></div><div class="col-md-2"><label class="form-label" data-key="validity">Validity</label><input id="voucherValidity" class="form-control" value="1d" required></div><div class="col-12 d-flex justify-content-end gap-2 mt-3"><button type="submit" class="btn btn-theme"><i class="bi bi-magic me-1"></i> <span data-key="generate_batch_vouchers">Generate Batch Vouchers</span></button><button type="button" class="btn btn-outline-success" onclick="printVoucherCards()">🖨️ <span data-key="print_voucher_cards">Print Voucher Cards</span></button></div></div></form></div></div></div><div class="col-12"><div class="card card-custom"><div class="card-custom-header"><i class="bi bi-printer text-success fs-5"></i> <span data-key="printable_voucher_cards">Printable Voucher Cards</span> <span id="voucherBatchCount" class="badge bg-success ms-2">0</span></div><div class="card-body" id="voucherPrintArea"><div class="text-center py-5 text-muted">Generate a voucher batch to preview printable cards.</div></div></div></div></div></section>');
            try {
