        .ipam-shell .ipam-meter{height:8px;flex:0 0 8px;border-radius:999px;background:#e2e8f0!important;overflow:hidden}.ipam-shell .ipam-meter i{display:block;height:100%;border-radius:inherit;transition:width .2s ease}
        .ipam-shell .ipam-pool-actions{display:flex;flex-wrap:wrap;align-items:center;gap:6px;margin-top:12px;padding-top:10px;border-top:1px solid #f1f5f9}
        .ipam-shell .ipam-pool-actions .btn{font-size:11px;line-height:1.35;font-weight:650;padding:5px 9px;border-radius:7px;white-space:nowrap}
        .ipam-shell .ipam-pool-actions .btn:disabled{opacity:.5;cursor:not-allowed}
        .ipam-shell .ipam-filters{display:grid;grid-template-columns:minmax(220px,1fr) minmax(150px,220px) minmax(150px,200px);gap:8px;margin-bottom:12px}
        .ipam-shell .ipam-filters .form-control,.ipam-shell .ipam-filters .form-select{background:#fff!important;color:#0f172a!important;border-color:#cbd5e1!important;font-family:'Inter',sans-serif;font-size:12px;min-height:38px;border-radius:8px}
        .ipam-shell .ipam-filters .form-control::placeholder{color:#64748b!important;opacity:1}
