<script>
        // Keep core admin helpers available before any dependent UI code executes.
        window.setPageTitleSafe = window.setPageTitleSafe || function(title) {
            try { document.title = title || 'FAZ NETWORK'; } catch (e) {}
        };
        window.currentHotspotMode = window.currentHotspotMode || 'seamless';
        window.jsonFetch = window.jsonFetch || async function(url, opts) {
            const res = await fetch(url, opts);
            return res.json();
        };
        window.updateLanguage = window.updateLanguage || function(){};
        // Defensive UI reset: a stale Bootstrap backdrop must never own the click layer.
        try {
            document.querySelectorAll('.modal-backdrop, .offcanvas-backdrop, .sidebar-backdrop').forEach(el => el.remove());
            document.body.classList.remove('modal-open');
            document.body.style.removeProperty('overflow');
            document.body.style.removeProperty('padding-right');
        } catch (error) {
            console.warn('[Admin Boot] backdrop cleanup failed:', error);
        }

        // Guaranteed Global Fetch Helper
        window.jsonFetch = async function(url, options = {}) {
            const timeoutMs = options.timeout || 8000;
            const controller = new AbortController();
            const timeoutId = setTimeout(() => controller.abort(), timeoutMs);

            try {
                const { timeout: _ignoredTimeout, ...fetchOptions } = options;
                const res = await fetch(url, {
                    credentials: 'include',
                    headers: {
                        'Content-Type': 'application/json',
                        'Accept': 'application/json',
                        ...(fetchOptions.headers || {})
                    },
                    ...fetchOptions,
                    signal: fetchOptions.signal || controller.signal
                });

                clearTimeout(timeoutId);

                if (res.status === 401) {
                    window.location.href = '/login';
                    return { success: false, message: 'Unauthorized. Redirecting...' };
                }

                const contentType = res.headers.get('content-type') || '';
                if (contentType.includes('application/json')) {
                    return await res.json();
                }

                const text = await res.text();
                return { success: res.ok, data: text };
            } catch (err) {
                clearTimeout(timeoutId);
                console.error('[jsonFetch Failed]:', url, err.name === 'AbortError' ? 'Request Timed Out' : err.message);
                return {
                    success: false,
                    message: err.name === 'AbortError' ? 'Request Timed Out' : err.message
                };
            }
        };
        // Alias for backward compatibility
        window.fetchJson = window.jsonFetch;

        function safeSetText(idOrSelector, text) {
            let el = document.getElementById(idOrSelector);
            if (!el && typeof idOrSelector === 'string') {
                el = document.querySelector(idOrSelector);
            }
            if (el) {
                el.innerText = text;
            }
        }

        function setPageTitleSafe(title) {
            const el = document.getElementById('pageTitle') || document.querySelector('.page-title') || document.querySelector('h1, h2, h3');
            if (el) el.innerText = title;
        }

        function setMobilePageLoading(isLoading, label) {
            const nav = document.getElementById('adminTopBar');
            const bar = document.getElementById('mobilePageLoadingBar');
            const status = document.getElementById('mobileHeaderStatusText');
            if (nav) nav.classList.toggle('is-loading', Boolean(isLoading));
            if (bar) bar.setAttribute('aria-hidden', isLoading ? 'false' : 'true');
            if (status) status.textContent = label || (isLoading ? 'LOADING' : 'READY');
        }
        // Hotspot global entry points: define these before any dependent admin code executes.
        window.loadHotspotDashboard = function() {
            // The Hotspot Dashboard menu now opens the canonical nine-card overview.
            // Do not rebuild the legacy circular dashboard in dynamicPageContent.
            if (typeof window.switchView === 'function') window.switchView('hotspot-dashboard');
            if (typeof window.startNocPolling === 'function') window.startNocPolling();
            return false;
        };

        // Bind navigation to the current All Hotspot Users renderer; do not override it with the legacy table loader.
        window.loadHotspotSection = loadHotspotSection;

        function formatHotspotDuration(value) {
            const raw=String(value||'').trim();
            if(!raw) return '-';
            const m=raw.match(/(?:(\d+)w)?(?:(\d+)d)?(?:(\d+)h)?(?:(\d+)m)?(?:(\d+)s)?/i);
            if(!m || !m[0]) return raw;
            const parts=[];
            if(m[1]) parts.push(m[1]+'w');
            if(m[2]) parts.push(m[2]+'d');
            if(m[3]) parts.push(m[3]+'h');
            if(m[4]) parts.push(m[4]+'m');
            if(m[5]) parts.push(m[5]+'s');
            return parts.length?parts.slice(0,3).join(' '):raw;
        }

        function formatHotspotBytes(value) {
            const n=Number(value||0);
            if(!Number.isFinite(n)||n<=0) return '0 B';
            const units=['B','KB','MB','GB','TB'];
            const i=Math.min(Math.floor(Math.log(n)/Math.log(1024)),units.length-1);
            return (n/Math.pow(1024,i)).toFixed(i?1:0)+' '+units[i];
        }

        function renderAllHotspotUsers(users, activeUsers) {
            const tbody=document.getElementById('hotspotUserBody');
            if(!tbody) return;
            const activeMap=new Map((Array.isArray(activeUsers)?activeUsers:[]).map(s=>[String(s.user||'').toLowerCase(),s]));
            const rows=(Array.isArray(users)?users:[]).map(function(u,index){
                const name=String(u.name||u.username||'-');
                const live=activeMap.get(name.toLowerCase());
                const status=live?'<span class="badge rounded-pill bg-success-subtle text-success-emphasis border border-success-subtle"><i class="bi bi-circle-fill me-1" style="font-size:7px"></i>Active</span>':'<span class="badge rounded-pill bg-light text-secondary border"><i class="bi bi-circle me-1"></i>Offline</span>';
                return '<tr data-hotspot-row><td class="text-muted fw-semibold">'+(index+1)+'</td><td><div class="d-flex align-items-center gap-2"><span class="hotspot-user-icon"><i class="bi bi-telephone-fill"></i></span><strong>'+escapeHtml(name)+'</strong></div></td><td><span class="badge rounded-pill bg-success-subtle text-success-emphasis border border-success-subtle">'+escapeHtml(u.profile||'No Plan')+'</span></td><td><span class="font-monospace">'+escapeHtml(formatHotspotDuration(u.uptime||u.limitUptime))+'</span></td><td>'+status+'</td><td><span class="small text-muted">'+escapeHtml(u.comment||'—')+'</span></td><td class="text-end"><div class="btn-group btn-group-sm"><button type="button" class="btn btn-outline-success" title="Edit" onclick="openHotspotUserEditModal('+JSON.stringify(u)+')"><i class="bi bi-pencil-square"></i></button><button type="button" class="btn btn-outline-danger" title="Delete" onclick="removeHotspotUser('+JSON.stringify(name)+')"><i class="bi bi-trash3"></i></button></div></td></tr>';
            }).join('');
            tbody.innerHTML=rows||'<tr><td colspan="7" class="text-center py-5"><div class="hotspot-empty-icon"><i class="bi bi-database"></i></div><div class="fw-semibold text-secondary mt-2">No Hotspot users found</div><div class="small text-muted">Create a customer account to get started.</div></td></tr>';
            safeSetText('hotspotSectionCount',Array.isArray(users)?users.length:0);
            updateLanguage(localStorage.getItem('faz_preferred_lang')||'en');
        }

        function renderActiveHotspotUsers(users) {
            const tbody=document.getElementById('hotspotUserBody');
            if(!tbody) return;
            const rows=(Array.isArray(users)?users:[]).map(function(s,index){
                return '<tr><td class="text-muted fw-semibold">'+(index+1)+'</td><td><strong>'+escapeHtml(s.user||'-')+'</strong></td><td><span class="badge rounded-pill bg-light text-dark border font-monospace">'+escapeHtml(s.address||'-')+'</span></td><td class="font-monospace text-secondary">'+escapeHtml(s.macAddress||'-')+'</td><td class="font-monospace">'+escapeHtml(formatHotspotDuration(s.uptime))+'</td><td><span class="text-primary">'+formatHotspotBytes(s.bytesIn)+'</span> <span class="text-muted">/</span> <span class="text-success">'+formatHotspotBytes(s.bytesOut)+'</span></td><td class="text-end"><button type="button" class="btn btn-sm btn-outline-danger" onclick="disconnectHotspotActive('+JSON.stringify(s.id)+','+JSON.stringify(s.user||'')+')"><i class="bi bi-power me-1"></i>Disconnect</button></td></tr>';
            }).join('');
            tbody.innerHTML=rows||'<tr><td colspan="7" class="text-center py-5"><div class="hotspot-empty-icon"><i class="bi bi-wifi-off"></i></div><div class="fw-semibold text-secondary mt-2">No live active sessions at the moment</div><div class="small text-muted">Connected Hotspot clients will appear here automatically.</div></td></tr>';
            safeSetText('hotspotSectionCount',Array.isArray(users)?users.length:0);
            const lang=localStorage.getItem('faz_preferred_lang')||'en'; updateLanguage(lang);
        }

        function filterHotspotRows(query) {
            const q=String(query||'').trim().toLowerCase();
            document.querySelectorAll('#hotspotUserBody tr[data-hotspot-row]').forEach(function(row){row.style.display=row.innerText.toLowerCase().includes(q)?'':'none';});
        }

        async function disconnectHotspotActive(id, username) {
            if(!id) return;
            if(!confirm('Disconnect '+(username||'this active session')+'?')) return;
            try {
                await jsonFetch('/api/hotspot/active/disconnect',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({id:id})});
                await window.loadHotspotSection('active','active_user');
            } catch(error){ alert(error.message); }
        }

        function openHotspotUserEditModal(user) {
            purgeStuckBackdrops();
            const existing=document.getElementById('hotspotUserEditModal');
            if(existing) existing.remove();
            const modal=document.createElement('div');
            modal.id='hotspotUserEditModal'; modal.className='modal fade'; modal.tabIndex=-1;
            modal.innerHTML='<div class="modal-dialog modal-dialog-centered"><div class="modal-content"><div class="modal-header"><h5 class="modal-title"><i class="bi bi-pencil-square text-success me-2"></i>Edit Hotspot User</h5><button type="button" class="btn-close" data-bs-dismiss="modal"></button></div><div class="modal-body"><div class="alert alert-light border mb-3">User editing is currently limited to MikroTik-backed account details.</div><div class="row g-3"><div class="col-12"><label class="form-label">User / Phone</label><input class="form-control" value="'+escapeHtml(user.name||user.username||'')+'" readonly></div><div class="col-md-6"><label class="form-label">Profile / Plan</label><input class="form-control" value="'+escapeHtml(user.profile||'')+'" readonly></div><div class="col-md-6"><label class="form-label">Uptime Limit</label><input class="form-control" value="'+escapeHtml(user.limitUptime||'')+'" readonly></div><div class="col-12"><label class="form-label">Comment</label><textarea class="form-control" rows="3" readonly>'+escapeHtml(user.comment||'')+'</textarea></div></div></div><div class="modal-footer"><button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button></div></div></div>';
            document.body.appendChild(modal);
            const instance=bootstrap.Modal.getOrCreateInstance(modal,{backdrop:'static',keyboard:true});
            modal.addEventListener('hidden.bs.modal',function(){modal.remove();purgeStuckBackdrops();},{once:true});
            instance.show();
        }

        window.loadHotspotVoucherRecords = async function(filter,title){
            const container=document.getElementById('dynamicPageContent');
            if(document.getElementById('view-main-dashboard'))document.getElementById('view-main-dashboard').style.display='none';
            if(document.getElementById('view-hotspot-dashboard'))document.getElementById('view-hotspot-dashboard').style.display='none';
            if(!container)return false;
            container.style.display='block';if(typeof closeSidebarMobile==='function')closeSidebarMobile();
            safeSetText('pageTitle',title||'Voucher Management');
            container.innerHTML='<section class="hotspot-dynamic-view admin-view"><div class="card card-custom"><div class="card-custom-header flex-wrap"><div><i class="bi bi-ticket-perforated-fill text-success me-2"></i><strong>Voucher Management</strong><div class="small text-muted mt-1">Calendar validity · First login starts the timer · Expired credentials are evicted</div></div><div class="d-flex flex-wrap gap-2 ms-auto"><button class="btn btn-outline-secondary btn-sm" onclick="window.loadHotspotVoucherRecords(\'all\',\'All Hotspot Users\')">All Users</button><button class="btn btn-outline-success btn-sm" onclick="window.loadHotspotVoucherRecords(\'online\',\'Online Hotspot Users\')">Online</button><button class="btn btn-outline-primary btn-sm" onclick="window.loadHotspotVoucherRecords(\'active\',\'Active Offline Users\')">Active</button><button class="btn btn-outline-secondary btn-sm" onclick="window.loadHotspotVoucherRecords(\'offline\',\'Offline Hotspot Users\')">Offline</button><button class="btn btn-outline-danger btn-sm" onclick="window.loadHotspotVoucherRecords(\'expired\',\'Expired Hotspot Users\')">Expired</button><button class="btn btn-outline-warning btn-sm" onclick="window.loadHotspotVoucherRecords(\'unused\',\'Unused Vouchers\')">Unused</button><button class="btn btn-outline-warning btn-sm" onclick="window.loadHotspotVoucherRecords(\'cleanup\',\'Cleanup Pending\')">Cleanup Pending</button></div></div><div class="card-body"><div class="hotspot-voucher-desktop-wrap d-none d-md-block table-responsive"><table class="table table-hover align-middle"><thead id="hsVoucherRecordsHead"><tr><th>Customer / Type</th><th>Phone</th><th>Voucher PIN / Username</th><th>Password</th><th>MAC Address</th><th>Profile</th><th>Validity</th><th>First Login</th><th>Expiry</th><th>Live Status</th><th>Account Type</th><th>Actions</th></tr></thead><tbody id="hsVoucherRecordsBody"><tr><td colspan="8" class="text-center py-4">Loading voucher records...</td></tr></tbody></table></div><div id="hsVoucherMobileList" class="hotspot-voucher-mobile-list d-md-none"><div class="text-center py-4 text-muted">Loading voucher records...</div></div><div id="hsVoucherRecordsNote" class="small text-muted mt-2"></div></div></div></section>';
            try{
                const data=await jsonFetch('/api/hotspot/voucher-records?status='+encodeURIComponent(filter||'all'));
                const rows=Array.isArray(data.vouchers)?data.vouchers:[];
                const body=document.getElementById('hsVoucherRecordsBody'),mobile=document.getElementById('hsVoucherMobileList'),head=document.getElementById('hsVoucherRecordsHead');
                if(head&&String(filter||'all').toLowerCase()==='unused')head.innerHTML='<tr><th>Voucher Type</th><th>Phone</th><th>Voucher PIN</th><th>Password</th><th>Profile</th><th>Validity</th><th>First Login</th><th>Expiry</th><th>Status</th><th>Account Type</th><th>Actions</th></tr>';
                const fmt=function(value){if(!value)return 'Not activated';const d=new Date(value);return Number.isNaN(d.getTime())?'—':d.toLocaleString('en-GB',{timeZone:'Asia/Dhaka',day:'2-digit',month:'2-digit',year:'numeric',hour:'2-digit',minute:'2-digit'});};
                const badge=function(status){const st=String(status||'unused').toLowerCase();const cls=st.includes('online')?'bg-success':st.includes('expired')?'bg-danger':st.includes('active')?'bg-primary':st.includes('pending')?'bg-warning text-dark':'bg-secondary';return '<span class="badge hotspot-voucher-status '+cls+'">'+escapeHtml(status||'Offline')+'</span>';};
                const enc=function(value){return encodeURIComponent(String(value||''));};
                if(body)body.innerHTML=rows.map(function(v){const scratchUnused=Boolean(v.is_scratch_unused)||(String(v.subscriber_type||'').toLowerCase()==='scratch_voucher'&&String(v.db_status||v.status||'').toLowerCase()==='unused');return '<tr><td><strong>'+escapeHtml(scratchUnused?'Printable scratch card':(v.customer_name||v.subscriber_type||'Direct subscriber'))+'</strong></td><td>'+escapeHtml(v.phone||'—')+'</td><td><strong class="font-monospace">'+escapeHtml(v.username||'—')+'</strong></td><td><span class="font-monospace">'+escapeHtml(scratchUnused?(v.password||'—'):'—')+'</span></td>'+(String(filter||'all').toLowerCase()==='unused'?'':'<td>'+escapeHtml(scratchUnused?'—':(v.mac_address||'—'))+'</td>')+'<td>'+escapeHtml(v.profile||'—')+'</td><td>'+escapeHtml(v.validity||'—')+'</td><td>'+escapeHtml(fmt(v.first_login_at))+'</td><td>'+escapeHtml(fmt(v.expires_at))+'</td><td>'+badge(v.display_status||v.status)+'<div class="small text-muted mt-1">'+escapeHtml(v.session_ip||v.cleanup_status||'—')+'</div></td><td><span class="badge bg-light text-dark">'+escapeHtml(v.subscriber_type||'legacy')+'</span><div class="small text-muted">'+escapeHtml(v.activation_type||'legacy')+'</div></td><td><div class="d-flex gap-1">'+(scratchUnused?'<button class="btn btn-outline-success btn-sm" data-batch-id="'+enc(v.batch_id)+'" onclick="window.openSavedVoucherBatch(this.dataset.batchId)">Print batch</button>':'<button class="btn btn-outline-warning btn-sm" data-username="'+enc(v.username)+'" onclick="window.kickHotspotVoucher(this.dataset.username)">Kick</button>')+'<button class="btn btn-outline-danger btn-sm" data-username="'+enc(v.username)+'" onclick="window.deleteHotspotVoucher(this.dataset.username)">Delete</button></div></td></tr>';}).join('')||'<tr><td colspan="12" class="text-center py-5 text-muted">No Hotspot users found.</td></tr>';
