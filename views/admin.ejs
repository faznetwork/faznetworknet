        function trafficInterfaceRole(item) {
            const signature = [item && item.name, item && item.type, item && item.comment].filter(Boolean).join(' ').toLowerCase();
            if (/(wan|ether|sfp|starlink|pppoe-out|eoip|wireguard|l2tp|sstp|ovpn|openvpn|gre|ipip|ipsec|lte|tunnel|(^|[\s_-])wg(?:\d|[\s_-]|$))/i.test(signature)) return 'wan';
            if (/(bridge|lan|wlan|wifi|wireless)/i.test(signature)) return 'lan';
            return 'wan';
        }

        async function loadInterfaces() {
            try {
                const data = await jsonFetch('/api/router/interfaces', { cache: 'no-store' });
                const interfaces = Array.isArray(data.interfaces) ? data.interfaces.filter(item => item && item.name) : [];
                const select = document.getElementById('dashboardInterface');
                if (!select) return;

                const current = select.value;
                const usable = interfaces.map(item => ({
                    ...item,
                    role: trafficInterfaceRole(item),
                    isRunning: item.running === true || String(item.running).toLowerCase() === 'true',
                    isDisabled: item.disabled === true || String(item.disabled).toLowerCase() === 'true'
                }));
                select.innerHTML = usable.map(item =>
                    '<option value="' + escapeHtml(item.name) + '" data-role="' + item.role + '" data-running="' + (item.isRunning ? '1' : '0') + '">' +
                    escapeHtml(item.name) + ' · ' + item.role.toUpperCase() + (item.isRunning ? ' · RUNNING' : '') +
                    (item.isDisabled ? ' · DISABLED' : '') + '</option>'
                ).join('');

                const isPreferredWan = item => /(starlink|pppoe-out|wireguard|eoip|(^|[\s_-])wg(?:\d|[\s_-]|$))/i.test([item.name, item.type, item.comment].join(' '));
                const isPhysicalWan = item => /(ether|sfp)/i.test([item.name, item.type].join(' '));
                const running = usable.filter(item => item.isRunning && !item.isDisabled);
                const candidates = [
                    usable.find(item => item.name === current && !item.isDisabled),
                    running.filter(item => item.role === 'wan').sort((a, b) =>
                        (isPreferredWan(a) ? 0 : isPhysicalWan(a) ? 1 : 2) -
                        (isPreferredWan(b) ? 0 : isPhysicalWan(b) ? 1 : 2)
                    )[0],
                    running.find(isPhysicalWan),
                    running[0],
                    usable.find(item => !item.isDisabled),
                    usable[0]
                ].filter(Boolean);
                const selected = candidates[0];
                if (!selected) {
                    select.innerHTML = '<option value="">No interfaces returned by MikroTik</option>';
                    safeSetText('nocInterfacePill', 'No interfaces detected');
                    const status = document.getElementById('dashboardTrafficStatus');
                    if (status) { status.className = 'badge bg-warning text-dark'; status.textContent = 'NO INTERFACES'; }
                    return;
                }

                select.value = selected.name;
                select.dataset.nocOptionsLoaded = '1';
                safeSetText('nocInterfacePill', 'Interface: ' + selected.name);
                void pollTraffic();
            } catch (error) {
                console.error('[Traffic] Interface inventory unavailable:', error);
                const status = document.getElementById('dashboardTrafficStatus');
                if (status) { status.className = 'badge bg-warning text-dark'; status.textContent = 'RETRYING'; }
            }
        }

        async function pollTraffic() {
            if (trafficPollInFlight) return;
            const dashboard = document.getElementById('view-main-dashboard');
            if (!dashboard || dashboard.style.display === 'none') return;
            const select = document.getElementById('dashboardInterface');
            if (!select || !select.value) return;

            trafficPollInFlight = true;
            try {
                const selectedOption = select.options[select.selectedIndex];
                const role = selectedOption && selectedOption.dataset.role || trafficInterfaceRole({ name: select.value });
                safeSetText('nocInterfacePill', 'Interface: ' + select.value);
                const data = await jsonFetch('/api/router/traffic?interface=' + encodeURIComponent(select.value) + '&role=' + encodeURIComponent(role), { cache: 'no-store' });
                const downloadBps = Number(data.downloadBps);
                const uploadBps = Number(data.uploadBps);
                if (!Number.isFinite(downloadBps) || downloadBps < 0 || !Number.isFinite(uploadBps) || uploadBps < 0) {
                    throw new Error('Traffic response did not include valid numeric downloadBps/uploadBps.');
                }

                const downloadMbps = downloadBps / 1000000;
                const uploadMbps = uploadBps / 1000000;
                safeSetText('dashboardTrafficRx', downloadMbps.toFixed(2));
                safeSetText('dashboardTrafficTx', uploadMbps.toFixed(2));
                if (typeof nocTrafficHistory !== 'undefined') {
                    nocTrafficHistory.push({ rx: downloadMbps, tx: uploadMbps });
                    if (nocTrafficHistory.length > 60) nocTrafficHistory.shift();
                    nocChart();
                }
                const trafficStatus = document.getElementById('dashboardTrafficStatus');
                if (trafficStatus) { trafficStatus.className = 'badge bg-success ms-auto'; trafficStatus.textContent = 'LIVE'; }
            } catch (error) {
                console.warn('[Traffic] sample failed; retaining last good values:', error.message || error);
                const trafficStatus = document.getElementById('dashboardTrafficStatus');
                if (trafficStatus) { trafficStatus.className = 'badge bg-warning text-dark ms-auto'; trafficStatus.textContent = 'RETRYING'; }
            } finally {
                trafficPollInFlight = false;
            }
        }


        function startTrafficPolling() {
            if (trafficTimer) clearInterval(trafficTimer);
            void loadInterfaces();
            trafficTimer = setInterval(() => { void pollTraffic(); }, 1000);
        }

