        async function pollTraffic() {
            if (trafficPollInFlight) return;
            const dashboard = document.getElementById('view-dashboard');
            if (!dashboard || dashboard.style.display === 'none') return;
            const select = document.getElementById('dashboardInterface');
            if (!select || !select.value) return;
            trafficPollInFlight = true;
            try {
                const data = await jsonFetch('/api/router/traffic?interface=' + encodeURIComponent(select.value));
                const t = data.traffic || data;
                safeSetText('dashboardTrafficRx', Number(t.rxMbps || 0).toFixed(3));
                safeSetText('dashboardTrafficTx', Number(t.txMbps || 0).toFixed(3));
                const trafficStatus = document.getElementById('dashboardTrafficStatus');
                if (trafficStatus) { trafficStatus.className = 'badge bg-success ms-auto'; trafficStatus.textContent = 'LIVE'; }
            } catch (error) {
                console.error('[Traffic]', error);
                safeSetText('dashboardTrafficRx', 'Unavailable');
                safeSetText('dashboardTrafficTx', 'Unavailable');
                const trafficStatus = document.getElementById('dashboardTrafficStatus');
                if (trafficStatus) { trafficStatus.className = 'badge bg-danger ms-auto'; trafficStatus.textContent = 'NO DATA'; }
            } finally {
                trafficPollInFlight = false;
            }
        }

        function startTrafficPolling() {
            if (trafficTimer) clearInterval(trafficTimer);
            void loadInterfaces();
            trafficTimer = setInterval(() => { void pollTraffic(); }, 1000);
        }

