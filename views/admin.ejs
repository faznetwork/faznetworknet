        function emergencyUiUnfreeze() {
            document.querySelectorAll('.modal-backdrop, .offcanvas-backdrop').forEach(function(el) { el.remove(); });
            document.body.classList.remove('modal-open');
            document.body.style.overflow = '';
            document.body.style.paddingRight = '';
            document.body.style.pointerEvents = 'auto';
        }

        // Heal stale invisible Bootstrap backdrops that can intercept sidebar clicks.
        // Only clean overlays when no modal/offcanvas is actually open.
        function recoverStaleNavigationOverlay() {
            if (document.querySelector('.modal.show, .offcanvas.show, .offcanvas.showing')) return;
            const stale = document.querySelectorAll('.modal-backdrop, .offcanvas-backdrop');
            if (!stale.length) return;
            stale.forEach(function (el) { el.remove(); });
            if (document.body) {
                document.body.classList.remove('modal-open', 'offcanvas-open');
                document.body.style.removeProperty('overflow');
                document.body.style.removeProperty('padding-right');
                document.body.style.pointerEvents = 'auto';
            }
        }

        function purgeStuckBackdrops() {
            document.querySelectorAll('.modal-backdrop').forEach(function(el) { el.remove(); });
            document.querySelectorAll('.offcanvas-backdrop').forEach(function(el) { el.remove(); });
            document.querySelectorAll('.sidebar-backdrop:not(#sidebarBackdrop)').forEach(function(el) { el.classList.remove('show'); el.remove(); });
            document.querySelectorAll('.offcanvas.show, .offcanvas.showing, .offcanvas.hiding').forEach(function(el) {
                el.classList.remove('show', 'showing', 'hiding');
                el.setAttribute('aria-hidden', 'true');
            });
            if (document.body) {
                document.body.classList.remove('modal-open', 'offcanvas-open', 'sidebar-open');
                document.body.style.overflow = '';
                document.body.style.paddingRight = '';
                document.body.removeAttribute('data-bs-overflow');
                document.body.removeAttribute('data-bs-padding-right');
            }
            var sidebar = document.getElementById('sidebar');
            if (sidebar && window.innerWidth < 768) sidebar.classList.remove('show');
            var sidebarButton = document.getElementById('mobileSidebarToggle');
            if (sidebarButton) sidebarButton.setAttribute('aria-expanded', 'false');
            document.body.style.pointerEvents = 'auto';
        }

        window.navigateToCustomerProfile = function(customerId){
            const id=String(customerId||'').trim();
            if(!id)return;
            purgeStuckBackdrops();
            const target='/admin/customers/'+encodeURIComponent(id);
            if(window.location.pathname===target)return;
            window.history.pushState({customer360:true,customerId:id},'',target);
            window.location.replace(target);
        };

        // Bootstrap should remove these itself; this observer handles orphaned backdrops
        // left behind by interrupted modal transitions, without polling RouterOS or APIs.
        if (!window.__sidebarOverlayRecoveryBound) {
            window.__sidebarOverlayRecoveryBound = true;
            const overlayObserver = new MutationObserver(function () {
                // Bootstrap inserts the backdrop before the modal's .show class is applied.
                // Defer recovery so we never remove a valid backdrop mid-transition.
                window.setTimeout(function () {
                    try { recoverStaleNavigationOverlay(); }
                    catch (error) { console.error('[Admin Overlay Recovery] Cleanup failed:', error); }
                }, 120);
            });
            overlayObserver.observe(document.body, { childList: true, subtree: true });
            document.addEventListener('hidden.bs.modal', function () {
                window.setTimeout(recoverStaleNavigationOverlay, 80);
            }, true);
            document.addEventListener('hidden.bs.offcanvas', function () {
                window.setTimeout(recoverStaleNavigationOverlay, 80);
            }, true);
        }

