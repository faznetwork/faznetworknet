        async function viewCustomerDetails(encodedUsername) {
            const username = decodeURIComponent(String(encodedUsername || ''));
            const user = (currentCustomerUsers || []).find(item => String(item.username || '') === username)
                || (Array.isArray(window.cachedCustomers) ? window.cachedCustomers.find(item => String(item.username || '') === username) : null);
            if (!user) { if (username && typeof window.openCustomerProfile === 'function') window.openCustomerProfile(username); return; }
            const meta = parseCustomerMetadata(user);
            const initials = String(meta.displayName || username).split(/\s+/).filter(Boolean).slice(0,2).map(x=>x.charAt(0).toUpperCase()).join('') || 'CU';
            const expiryRaw = String(user.expiry_date || user.expiration_date || '').trim();
            const formatQuickDate = value => {
                const iso = String(value || '').slice(0,10);
                if (!/^\d{4}-\d{2}-\d{2}$/.test(iso)) return 'Not set';
                return new Intl.DateTimeFormat('en-GB',{day:'2-digit',month:'short',year:'numeric',timeZone:'Asia/Dhaka'}).format(new Date(iso+'T00:00:00+06:00'));
            };
            let modalEl = document.getElementById('customerQuickViewModal');
            if (!modalEl) {
