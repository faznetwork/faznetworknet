                }
            });
        });

        function renewalDateIso(value){const raw=String(value||'').trim();if(/^\d{4}-\d{2}-\d{2}$/.test(raw))return raw;const m=raw.match(/^(\d{2})\/(\d{2})\/(\d{4})$/);if(m)return m[3]+'-'+m[2]+'-'+m[1];if(/^\d{4}-\d{2}-\d{2}[T\s]/.test(raw)){const d=new Date(raw);if(!Number.isNaN(d.getTime()))return new Intl.DateTimeFormat('en-CA',{timeZone:'Asia/Dhaka',year:'numeric',month:'2-digit',day:'2-digit'}).format(d);}return '';}
        function previewRenewalExpiry(expiry,cycleValue,durationValue){const today=new Intl.DateTimeFormat('en-CA',{timeZone:'Asia/Dhaka',year:'numeric',month:'2-digit',day:'2-digit'}).format(new Date());let base=renewalDateIso(expiry);if(!base||base<today)base=today;const cycle=String(cycleValue||'monthly').trim().toLowerCase(),fixed=cycle==='15_days'?15:cycle==='30_days'?30:null;if(cycle==='custom_days'||fixed!==null){const days=fixed===null?Number.parseInt(durationValue,10):fixed;if(Number.isInteger(days)&&days>0&&days<=3650){const [y,m,d]=base.split('-').map(Number),n=new Date(Date.UTC(y,m-1,d+days));return [n.getUTCFullYear(),String(n.getUTCMonth()+1).padStart(2,'0'),String(n.getUTCDate()).padStart(2,'0')].join('-');}}const [y,m,d]=base.split('-').map(Number),n=new Date(Date.UTC(y,m,1)),ty=n.getUTCFullYear(),tm=n.getUTCMonth()+1;return [ty,String(tm).padStart(2,'0'),String(Math.min(d,new Date(Date.UTC(ty,tm,0)).getUTCDate())).padStart(2,'0')].join('-');}
        function renewalDateLabel(value){const iso=renewalDateIso(value);if(!iso)return 'Not available';const [y,m,d]=iso.split('-').map(Number);return new Intl.DateTimeFormat('en-GB',{timeZone:'Asia/Dhaka',day:'2-digit',month:'short',year:'numeric'}).format(new Date(Date.UTC(y,m-1,d,6)));}
        window.handleOpenRenewConfirm=async function(customer,triggerButton){if(window.__renewConfirmLoading)return;const selected=customer||{},id=String(selected.id||'').trim();if(!id){alert('Customer ID is missing.');return;}const modal=document.getElementById('customerRenewConfirmModal'),submit=document.getElementById('renewConfirmSubmit');if(!modal||!submit||!window.bootstrap?.Modal){alert('Renewal confirmation is unavailable. Please refresh the page.');return;}const state={id,username:String(selected.username||id),name:String(selected.name||selected.username||'Customer'),price:Number(selected.price||0),expiry:String(selected.expiry||''),cycle:'monthly',duration:null,button:triggerButton||null,ready:false};window.__renewConfirmState=state;document.getElementById('renewConfirmName').textContent=state.name;document.getElementById('renewConfirmUsername').textContent=state.username;document.getElementById('renewConfirmRate').textContent=state.price>0?'৳ '+state.price.toFixed(2):'Loading…';document.getElementById('renewConfirmExpiry').textContent=renewalDateLabel(previewRenewalExpiry(state.expiry,'monthly'));document.getElementById('renewConfirmStatus').textContent='Loading current package and billing details…';submit.disabled=true;submit.innerHTML='<span class="spinner-border spinner-border-sm me-1" aria-hidden="true"></span>Loading…';window.bootstrap.Modal.getOrCreateInstance(modal).show();window.__renewConfirmLoading=true;try{const details=await jsonFetch('/api/customers/'+encodeURIComponent(id)+'/profile'),c=details.customer||{},pkg=details.package||{};state.name=String(c.fullName||c.full_name||c.name||c.username||state.name);state.username=String(c.username||c.pppoeUsername||c.pppoe_username||state.username);state.price=Number(pkg.price??c.monthly_bill??c.monthlyBill??state.price);state.expiry=String(c.expirationDate||c.expiration_date||c.expiry_date||c.billing_expiry_date||state.expiry);state.cycle=String(c.billingCycle||c.billing_cycle||'monthly');state.duration=c.billingDurationDays??c.billing_duration_days??null;if(!Number.isFinite(state.price)||state.price<=0)throw new Error('Package rate is unavailable for this customer.');document.getElementById('renewConfirmName').textContent=state.name;document.getElementById('renewConfirmUsername').textContent=state.username;document.getElementById('renewConfirmRate').textContent='৳ '+state.price.toFixed(2);document.getElementById('renewConfirmExpiry').textContent=renewalDateLabel(previewRenewalExpiry(state.expiry,state.cycle,state.duration));document.getElementById('renewConfirmStatus').textContent='This will record a cash payment and renew the current package for one billing period.';state.ready=true;submit.disabled=false;submit.innerHTML='<i class="bi bi-check2-circle me-1"></i>Confirm Renewal';}catch(error){document.getElementById('renewConfirmStatus').textContent=error.message||'Unable to load renewal details.';submit.disabled=true;submit.innerHTML='<i class="bi bi-exclamation-circle me-1"></i>Unavailable';}finally{window.__renewConfirmLoading=false;}};
        document.addEventListener('DOMContentLoaded',function bindRenewConfirmation(){const modal=document.getElementById('customerRenewConfirmModal'),submit=document.getElementById('renewConfirmSubmit');if(!modal||!submit)return;submit.addEventListener('click',async function(){const state=window.__renewConfirmState;if(!state||!state.ready||submit.disabled)return;submit.disabled=true;submit.innerHTML='<span class="spinner-border spinner-border-sm me-1" aria-hidden="true"></span>Renewing…';const ok=await quickRenewCustomer(state.id,state.price,{skipConfirm:true,button:state.button});if(ok){window.bootstrap.Modal.getInstance(modal)?.hide();state.ready=false;}else{submit.disabled=false;submit.innerHTML='<i class="bi bi-check2-circle me-1"></i>Confirm Renewal';}});modal.addEventListener('hidden.bs.modal',function(){window.__renewConfirmState=null;window.__renewConfirmLoading=false;});});

        async function quickRenewCustomer(customerId, packagePrice, options) {
            const opts=options||{},id=String(customerId||'').trim();if(!id)return false;
            let price=Number(packagePrice||0),name='Customer';
