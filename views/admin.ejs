<div class="modal fade" id="customerRenewConfirmModal" tabindex="-1" aria-labelledby="customerRenewConfirmTitle" aria-hidden="true"><div class="modal-dialog modal-dialog-centered modal-sm"><div class="modal-content customer-renew-confirm-card"><div class="modal-header border-0 pb-1"><div class="d-flex align-items-center gap-2"><span class="customer-renew-confirm-icon"><i class="bi bi-calendar-check"></i></span><div><h5 class="modal-title mb-0" id="customerRenewConfirmTitle">Renew for 1 Month?</h5><div class="small text-muted">Review the renewal details</div></div></div><button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cancel renewal"></button></div><div class="modal-body pt-2"><div class="customer-renew-confirm-summary"><div class="customer-renew-detail"><span>Customer</span><strong id="renewConfirmName">Loading…</strong></div><div class="customer-renew-detail"><span>PPPoE ID</span><code id="renewConfirmUsername">—</code></div><div class="customer-renew-detail"><span>Package rate</span><strong id="renewConfirmRate">—</strong></div><div class="customer-renew-detail"><span>New expiry date</span><strong id="renewConfirmExpiry">Calculating…</strong></div></div><div id="renewConfirmStatus" class="small text-muted mt-3" role="status" aria-live="polite">Loading current package and billing details…</div></div><div class="modal-footer border-0 pt-1"><button type="button" class="btn btn-light" data-bs-dismiss="modal">Cancel</button><button type="button" class="btn btn-success" id="renewConfirmSubmit" disabled><i class="bi bi-check2-circle me-1"></i>Confirm Renewal</button></div></div></div></div><style>.customer-renew-confirm-card{border:0;border-radius:18px;box-shadow:0 20px 55px rgba(15,23,42,.22);overflow:hidden}.customer-renew-confirm-icon{width:42px;height:42px;display:grid;place-items:center;border-radius:13px;background:#dcfce7;color:#047857;font-size:20px;flex:0 0 42px}.customer-renew-confirm-summary{display:grid;border:1px solid #e2e8f0;border-radius:13px;overflow:hidden;background:#f8fafc}.customer-renew-detail{display:flex;align-items:flex-start;justify-content:space-between;gap:12px;padding:10px 12px;border-bottom:1px solid #e2e8f0}.customer-renew-detail:last-child{border-bottom:0}.customer-renew-detail>span{font-size:12px;color:#64748b;flex:0 0 42%}.customer-renew-detail>strong,.customer-renew-detail>code{font-size:12px;text-align:right;min-width:0;overflow-wrap:anywhere;word-break:break-word;color:#0f172a}#renewConfirmSubmit{min-height:40px;font-weight:700}@media(max-width:767.98px){#customerRenewConfirmModal .modal-dialog{margin:12px auto;max-width:calc(100% - 24px)}#customerRenewConfirmModal .modal-footer .btn{flex:1;min-height:42px}}</style>
