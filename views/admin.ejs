        function ensureIpPoolModal() {
            let modal=document.getElementById('ipPoolModal');
            if(!modal){
                document.body.insertAdjacentHTML('beforeend',ipPoolDefaultModalHtml());
                modal=document.getElementById('ipPoolModal');
                document.getElementById('ipPoolForm').addEventListener('submit',saveIpPool);
                document.getElementById('ipPoolSubnet').addEventListener('input',autoFillIpPoolFromSubnet);
            }
            return modal;
        }

        function ipv4Number(value){
            const parts=String(value||'').trim().split('.');
            if(parts.length!==4||parts.some(p=>!/^\d{1,3}$/.test(p)||Number(p)>255))return null;
            return parts.reduce((n,p)=>n*256+Number(p),0);
        }
        function ipv4Text(value){
            const n=Number(value); if(!Number.isInteger(n)||n<0||n>4294967295)return '';
            return [24,16,8,0].map(s=>(n>>>s)&255).join('.');
        }
        function cidrInfo(value){
            const m=String(value||'').trim().match(/^(\d{1,3}(?:\.\d{1,3}){3})\/(\d{1,2})$/);
            if(!m)return null;
            const ip=ipv4Number(m[1]),prefix=Number(m[2]);
            if(ip===null||prefix<0||prefix>32)return null;
            const mask=prefix===0?0:(0xffffffff<<(32-prefix))>>>0;
            const network=(ip&mask)>>>0,size=2**(32-prefix),broadcast=network+size-1;
            return {local:ipv4Text(network+1),range:prefix<=30?ipv4Text(network+1)+'-'+ipv4Text(broadcast-1):''};
        }
        function autoFillIpPoolFromSubnet(){
            const subnet=document.getElementById('ipPoolSubnet')?.value||'',info=cidrInfo(subnet);
            if(!info)return;
            const local=document.getElementById('ipPoolLocalAddress'),range=document.getElementById('ipPoolRanges');
            if(local&&!local.value.trim())local.value=info.local;
            if(range&&!range.value.trim()&&info.range)range.value=info.range;
        }

        async function populateIpPoolNextOptions(selectedName){
            const select=document.getElementById('ipPoolNext'); if(!select)return;
            try{
                const response=await jsonFetch('/api/ip-pools'),pools=Array.isArray(response)?response:(response.pools||[]);
                const current=String(selectedName||'').toLowerCase();
                select.innerHTML='<option value="none">None</option>'+pools.filter(p=>String(p.name||'').toLowerCase()!==current).map(p=>'<option value="'+escapeHtml(p.name)+'">'+escapeHtml(p.name)+'</option>').join('');
            }catch(_){select.innerHTML='<option value="none">None</option>';}
        }

        async function openIpPoolModal(pool) {
            purgeStuckBackdrops(); currentIpPoolEdit=pool||null;
            const modal=ensureIpPoolModal();
            document.getElementById('ipPoolModalTitle').textContent=pool?'Edit IP Pool':'Add IP Pool';
            document.getElementById('ipPoolMikrotikId').value=pool?.id||'';
            document.getElementById('ipPoolName').value=pool?.name||'';
            document.getElementById('ipPoolSubnet').value=pool?.subnet||'';
            document.getElementById('ipPoolLocalAddress').value=pool?.localAddress||'';
            document.getElementById('ipPoolRanges').value=pool?.ranges||'';
            await populateIpPoolNextOptions(pool?.name||'');
