function animateDashboardKpiValue(element,nextValue,formatter){
  if(!element)return;
  const target=Number(nextValue||0),start=Number(element.dataset.numericValue||0),duration=420;
  element.dataset.numericValue=String(target);
  if(window.matchMedia&&window.matchMedia('(prefers-reduced-motion: reduce)').matches){element.textContent=formatter(target);return;}
  if(typeof window.requestAnimationFrame!=='function'){element.textContent=formatter(target);return;}
  const started=performance.now();
  const tick=now=>{const progress=Math.min(1,(now-started)/duration),eased=1-Math.pow(1-progress,3);element.textContent=formatter(start+(target-start)*eased);if(progress<1)window.requestAnimationFrame(tick);};
  window.requestAnimationFrame(tick);
}
