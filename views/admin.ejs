                    originalName:(currentIpPoolEdit?.name||document.getElementById('ipPoolName').value).trim(),
                    name:document.getElementById('ipPoolName').value.trim(),
                    subnet:document.getElementById('ipPoolSubnet').value.trim(),
                    localAddress:document.getElementById('ipPoolLocalAddress').value.trim(),
                    ranges:document.getElementById('ipPoolRanges').value.trim(),
                    nextPool:document.getElementById('ipPoolNext').value||'none'
                };
                if(!payload.name||!payload.localAddress||!payload.ranges)throw new Error('Pool Name, Local Address and Pool Range are required.');
                const endpoint=currentIpPoolEdit?'/api/ip-pools/update':'/api/ip-pools/save';
                const res=await fetch(endpoint,{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify(payload)});
                const data=await res.json().catch(()=>({}));
                if(!res.ok||!data.success){alert('Operation Failed: '+(data.message||res.statusText||'Server error'));return;}
