                                </tbody>
                            </table>
                        </div>
                    </div>
                </section>`;
            // Keep this dynamically rendered filter read-only until a real user focuses it.
            // Browser autofill/password managers can ignore autocomplete hints; readonly prevents
            // them from injecting a saved login such as "admin" during initial render.
            // Preserve search only when the URL explicitly contains ?search=...
            const customerSearchInput = content.querySelector('#customerLiveSearch');
            if (customerSearchInput) {
                const params = new URLSearchParams(window.location.search);
                const hasExplicitSearch = params.has('search');
                customerSearchInput.value = hasExplicitSearch ? String(params.get('search') || '') : '';
                filterCustomerRows(customerSearchInput.value);

                const enableCustomerSearch = () => {
                    if (customerSearchInput.readOnly) {
                        if (!hasExplicitSearch) {
                            customerSearchInput.value = '';
                            filterCustomerRows('');
                        }
                        customerSearchInput.readOnly = false;
                    }
                };
                customerSearchInput.addEventListener('pointerdown', enableCustomerSearch, { once: true });
                customerSearchInput.addEventListener('focus', enableCustomerSearch, { once: true });
            }
            updateLanguage(lang);
        }

