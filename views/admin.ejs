        async function loadCustomerSection(filterType, titleKey) {
            const requestId = (window.__customerSectionRequestId = (window.__customerSectionRequestId || 0) + 1);
            purgeStuckBackdrops();
            currentCustomerFilter = filterType;
            currentCustomerTitleKey = titleKey;

            const dynamic = document.getElementById('dynamicPageContent');
            const customerView = document.getElementById('view-customer-filter');
            if (!dynamic || !customerView) return;

            dynamic.style.display = 'block';
            dynamic.hidden = false;
            document.querySelectorAll('.admin-view').forEach(function(view) {
                view.style.display = 'none';
                view.hidden = false;
            });
            customerView.style.display = 'block';
            customerView.hidden = false;
            setPageTitleSafe(customerTitle(titleKey));
            customerView.innerHTML = `
                <div class="card card-custom">
                    <div class="card-custom-header">
                        <i class="bi bi-hourglass-split text-success fs-5"></i>
                        <span data-key="loading_customers">Loading current customer records...</span>
                    </div>
                    <div class="card-body text-center py-5">
                        <div class="spinner-border text-success" role="status"></div>
                    </div>
                </div>`;

            try {
                // Use the billing panel's canonical customers table for every customer
                // submenu. The PPPoE-only endpoint can include orphaned, old RouterOS
                // records and omit current panel customers without a matching secret.
                const data = await jsonFetch('/api/customers?status=all', { cache: 'no-store', timeout: 20000 });
                if (!data || data.success === false || !Array.isArray(data.users || data.customers)) {
                    throw new Error(data?.message || data?.error || 'Unable to load current customer records.');
                }
                let users = Array.isArray(data.users) ? data.users.slice() : data.customers.slice();

                if (filterType === 'online' || filterType === 'offline') {
                    // Require a successful live-session response; never guess network state.
                    const liveData = await jsonFetch('/api/pppoe/active', { cache: 'no-store', timeout: 20000 });
                    if (!liveData || liveData.success === false || !Array.isArray(liveData.sessions)) {
                        throw new Error(liveData?.message || liveData?.error || 'Live MikroTik sessions are unavailable. Online/offline status was not guessed.');
                    }
                    const sessionByUsername = new Map();
                    liveData.sessions.forEach(function(session) {
                        const name = String(session?.username || session?.name || '').trim().toLowerCase();
                        if (name && !sessionByUsername.has(name)) sessionByUsername.set(name, session);
                    });
                    users = users.map(function(user) {
                        const username = String(user?.username || '').trim().toLowerCase();
                        const session = username ? (sessionByUsername.get(username) || null) : null;
                        return {
                            ...user,
                            online: Boolean(session),
                            active: Boolean(session),
                            session: session,
                            session_ip: session?.address || null,
                            session_uptime: session?.uptime || null,
                            session_caller_id: session?.callerId || session?.caller_id || null
                        };
                    }).filter(function(user) {
                        return filterType === 'online' ? user.online : !user.online;
                    });
                } else if (filterType === 'active') {
                    users = users.filter(function(user) {
                        const status = customerStatus(user);
                        const accountState = String(user?.status || user?.customer_billing_state || '').toLowerCase();
                        return status.key !== 'expired_status' && !user.disabled && !user.pppoe_disabled &&
                            !['suspended','disabled','left','terminated','inactive'].includes(accountState);
                    });
                } else if (filterType === 'expire') {
                    users = users.filter(function(user) { return customerStatus(user).key === 'expired_status'; });
                } else if (filterType === 'expire_today_yesterday' || filterType === 'expire_7_days') {
                    const today = new Intl.DateTimeFormat('en-CA', { timeZone: 'Asia/Dhaka', year: 'numeric', month: '2-digit', day: '2-digit' }).format(new Date());
                    const todayMs = Date.parse(today + 'T00:00:00+06:00');
                    users = users.filter(function(user) {
                        const raw = String(user?.expiration_date || user?.expiry_date || '').trim();
                        let iso = /^\d{4}-\d{2}-\d{2}$/.test(raw) ? raw : '';
                        if (!iso && /^\d{2}\/\d{2}\/\d{4}$/.test(raw)) {
                            const parts = raw.split('/'); iso = parts[2] + '-' + parts[1] + '-' + parts[0];
                        }
                        if (!iso) return false;
                        const days = Math.round((Date.parse(iso + 'T00:00:00+06:00') - todayMs) / 86400000);
                        return filterType === 'expire_today_yesterday' ? days >= -1 && days <= 0 : days >= 0 && days <= 7;
                    });
                } else if (filterType === 'new') {
                    const cutoff = Date.now() - 7 * 86400000;
                    users = users.filter(function(user) {
                        const created = Date.parse(user?.created_at || user?.customer_created_at || '');
                        return Number.isFinite(created) && created >= cutoff;
                    });
                } else if (filterType === 'due') {
                    users = users.filter(function(user) {
                        const status = String(user?.billing_status || user?.computed_status || user?.status || '').toLowerCase();
                        return customerStatus(user).key === 'expired_status' ||
                            ['due','unpaid','expired','suspended','disabled','left','terminated'].includes(status) ||
                            Boolean(user.disabled || user.pppoe_disabled);
                    });
                } else if (['paid','unpaid'].includes(filterType)) {
                    users = users.filter(function(user) {
                        const status = String(user?.billing_status || user?.computed_status || '').toLowerCase();
                        return filterType === 'paid' ? status === 'paid' : ['unpaid','expired'].includes(status);
                    });
                }

                // Rapid menu changes must never let a previous response overwrite the selected submenu.
                if (requestId !== window.__customerSectionRequestId) return;
                renderCustomerTable(users);
            } catch (error) {
                if (requestId !== window.__customerSectionRequestId) return;
                customerView.style.display = 'block';
                customerView.hidden = false;
                customerView.innerHTML =
                    '<div class="alert alert-danger m-3"><i class="bi bi-exclamation-triangle me-2"></i>' +
                    escapeHtml(error?.message || 'Unable to load customer records.') +
                    '</div>';
                console.error('[Customer Section] render/fetch failed:', error);
            } finally {
                if (requestId === window.__customerSectionRequestId) {
                    dynamic.style.display = 'block';
                    dynamic.hidden = false;
                    customerView.style.display = 'block';
                    customerView.hidden = false;
                    if (window.innerWidth <= 768) document.getElementById('sidebar')?.classList.remove('show');
                }
            }
        }

