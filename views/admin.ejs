        function openHotspotProfileModal(profileName) {
            const existing=profileName?currentHotspotProfiles.find(function(p){return String(p.name)===String(profileName);}):null;
            let modal=document.getElementById('hotspotProfileModal');
            if(!modal){
                modal=document.createElement('div');modal.id='hotspotProfileModal';modal.className='modal fade';modal.tabIndex=-1;
                modal.innerHTML='<div class="modal-dialog modal-lg modal-dialog-centered"><div class="modal-content border-0 shadow-lg"><div class="modal-header bg-light"><div><h5 class="modal-title fw-bold"><i class="bi bi-wifi text-success me-2"></i>Create / Edit Hotspot Profile</h5><div class="small text-muted">Set speed, price, and custom time or data validity.</div></div><button type="button" class="btn-close" data-bs-dismiss="modal"></button></div><form id="hotspotProfileForm"><div class="modal-body p-4"><input type="hidden" id="hotspotProfileOriginalName"><div class="row g-3"><div class="col-md-6"><label class="form-label fw-semibold">Profile Name</label><input id="hotspotProfileName" class="form-control" required maxlength="100" placeholder="Profile-1Day"></div><div class="col-md-6"><label class="form-label fw-semibold">Rate Limit (Rx/Tx)</label><input id="hotspotProfileRate" class="form-control" required placeholder="10M/10M"></div><div class="col-md-4"><label class="form-label fw-semibold">Price (৳ BDT)</label><input id="hotspotProfilePrice" type="number" min="0" step="0.01" class="form-control" value="20" required></div><div class="col-md-4"><label class="form-label fw-semibold">Shared Users</label><input id="hotspotProfileShared" type="number" min="1" step="1" class="form-control" value="1" required></div><div class="col-md-4"><label class="form-label fw-semibold">Validity Value</label><input id="hotspotProfileValidityValue" type="number" min="1" step="1" class="form-control" value="1" required></div><div class="col-md-6"><label class="form-label fw-semibold">Validity Unit</label><select id="hotspotProfileValidityUnit" class="form-select" required><option value="minutes">Minutes</option><option value="hours">Hours</option><option value="days" selected>Days</option><option value="gb">GB (data quota, no time limit)</option></select></div><div class="col-md-6"><label class="form-label fw-semibold">Resolved Validity</label><div id="hotspotProfileValidityPreview" class="form-control bg-light fw-semibold">1 Day</div></div><div class="col-12"><label class="form-label fw-semibold">RouterOS On-Login Policy Preview</label><textarea id="hotspotProfileOnLogin" class="form-control font-monospace small" rows="6" readonly></textarea><div class="form-text">Preview only. On save, the backend compiles and pushes the complete executable script to MikroTik.</div></div></div><div id="hotspotProfileFormResult" class="small mt-3" role="status" aria-live="polite"></div></div><div class="modal-footer"><button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button><button type="submit" class="btn btn-theme" id="hotspotProfileSave"><i class="bi bi-cloud-check me-1"></i>Save Profile to MikroTik</button></div></form></div></div>';
                document.body.appendChild(modal);
                function refreshPreview(){
                    const value=Math.max(1,Math.floor(Number(document.getElementById('hotspotProfileValidityValue').value||1)));
                    const unit=document.getElementById('hotspotProfileValidityUnit').value||'days';
                    const suffix={minutes:'m',hours:'h',days:'d',gb:'GB'}[unit]||'d';
                    const label={minutes:'Minute',hours:'Hour',days:'Day',gb:'GB'}[unit]||'Day';
                    const resolved=unit==='gb'?value+' GB':value+' '+label+(value===1?'':'s');
                    const preview=document.getElementById('hotspotProfileValidityPreview');
                    if(preview)preview.textContent=resolved+(unit==='gb'?' · '+(value*1073741824).toLocaleString('en-GB', { timeZone: 'Asia/Dhaka', day: '2-digit', month: '2-digit', year: 'numeric', hour: '2-digit', minute: '2-digit', hour12: true })+' bytes':' · '+value+suffix);
                    const bytes=value*1073741824;
                    const name=String(document.getElementById('hotspotProfileName').value||'profile').replace(/[^a-zA-Z0-9_. -]/g,'').slice(0,80);
                    const script=document.getElementById('hotspotProfileOnLogin');
                    if(script)script.value=':local u $user; :local loginMac $"mac-address"; :local auth "unknown"; :local activeId [/ip hotspot active find where user=$u]; :if ([:len $activeId] > 0) do={ :set auth [/ip hotspot active get $activeId login-by]; }; :local uid [/ip hotspot user find where name=$u]; :if ([:len $uid] > 0) do={ /ip hotspot user set $uid mac-address=$loginMac comment=("FAZ|PROFILE='+name+'|VALIDITY='+resolved+'|MAC=".$loginMac."|AUTH=".$auth); }; '+(unit==='gb'?':if ([:len $uid] > 0) do={ /ip hotspot user set $uid limit-bytes-total='+bytes+'; };':':local sched ("faz-exp-".$u); :if ([:len [/system scheduler find where name=$sched]] = 0) do={ /system scheduler add name=$sched interval='+value+suffix+' start-time=[/system clock get time] ; # timed expiry scheduler is compiled server-side };');
                }
                ['hotspotProfileValidityValue','hotspotProfileValidityUnit','hotspotProfileName'].forEach(function(id){const el=document.getElementById(id);el.addEventListener('input',refreshPreview);el.addEventListener('change',refreshPreview);});
                document.getElementById('hotspotProfileForm').onsubmit=async function(event){
                    event.preventDefault();
                    const button=document.getElementById('hotspotProfileSave'),result=document.getElementById('hotspotProfileFormResult');
                    const original=document.getElementById('hotspotProfileOriginalName').value.trim(),name=document.getElementById('hotspotProfileName').value.trim(),rateLimit=document.getElementById('hotspotProfileRate').value.trim(),validityValue=Number(document.getElementById('hotspotProfileValidityValue').value),validityUnit=document.getElementById('hotspotProfileValidityUnit').value,price=Number(document.getElementById('hotspotProfilePrice').value),sharedUsers=Number(document.getElementById('hotspotProfileShared').value);
                    if(!name||!rateLimit||!Number.isSafeInteger(validityValue)||validityValue<1||!Number.isFinite(price)||price<0||!Number.isSafeInteger(sharedUsers)||sharedUsers<1){if(result)result.textContent='Enter a profile name, rate limit, non-negative price, and positive whole-number validity/shared users.';return;}
                    button.disabled=true;if(result){result.className='small mt-3 text-muted';result.textContent='Saving profile and package metadata…';}
                    try{
                        const response=await fetch(original?'/api/hotspot/profiles/update':'/api/hotspot/profiles/create',{method:'POST',headers:{'Content-Type':'application/json','Accept':'application/json'},body:JSON.stringify({name,rateLimit,sharedUsers,validityValue,validityUnit,price})});
                        const data=await response.json();if(!response.ok||data.success===false)throw new Error(data.message||data.error||'Unable to save profile.');
                        bootstrap.Modal.getInstance(modal)?.hide();await loadHotspotProfiles('hotspot_profile');
                    }catch(error){if(result){result.className='small mt-3 text-danger fw-semibold';result.textContent=error.message||'Profile save failed.';}else alert(error.message);}finally{button.disabled=false;}
                };
            }
            const set=function(id,value){const el=document.getElementById(id);if(el)el.value=value;};
            set('hotspotProfileOriginalName',existing?.name||'');set('hotspotProfileName',existing?.name||'');set('hotspotProfileRate',existing?.rateLimit||existing?.['rate-limit']||'');set('hotspotProfilePrice',Number(existing?.price||0).toFixed(2));set('hotspotProfileShared',Number(existing?.sharedUsers||existing?.['shared-users']||1));
            const match=String(existing?.sessionTimeout||existing?.['session-timeout']||'1d').match(/^(\d+)(m|h|d)$/i);
            set('hotspotProfileValidityValue',existing?.validityValue||(match?Number(match[1]):1));
            set('hotspotProfileValidityUnit',existing?.validityUnit||(match?({m:'minutes',h:'hours',d:'days'}[match[2].toLowerCase()]):'days'));
            const nameField=document.getElementById('hotspotProfileName');if(nameField)nameField.disabled=Boolean(existing);
            const result=document.getElementById('hotspotProfileFormResult');if(result){result.className='small mt-3';result.textContent='';}
            ['hotspotProfileValidityValue','hotspotProfileValidityUnit','hotspotProfileName'].forEach(function(id){document.getElementById(id)?.dispatchEvent(new Event('input'));});
            if(modal.parentElement!==document.body)document.body.appendChild(modal);
            document.querySelectorAll('.modal-backdrop').forEach(function(el){el.remove();});document.body.classList.remove('modal-open');
            bootstrap.Modal.getOrCreateInstance(modal,{backdrop:'static',keyboard:true}).show();
        }
        window.loadHotspotProfiles = loadHotspotProfiles;
        function editHotspotProfile(name){ if(!name)return; openHotspotProfileModal(name); }
        async function deleteHotspotProfile(name){
            if(!name)return; if(!confirm('Delete Hotspot profile "'+name+'" from MikroTik?'))return;
            try{await jsonFetch('/api/hotspot/profiles/delete',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({name:name})});await loadHotspotProfiles('hotspot_profile');}
