      <div class="modal-footer bg-white">
        <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
        <button id="cpRenewBtn" type="button" class="btn btn-success"><i class="bi bi-calendar-plus me-1"></i> Renew +1 Month</button>
        <button id="cpSaveBtn" type="button" class="btn btn-primary"><i class="bi bi-check2-circle me-1"></i> Save Changes</button>
      </div>
