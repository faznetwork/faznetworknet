v><div class="table-responsive"><table class="table table-hover align-middle mb-0"><thead class="table-light"><tr><th>Device</th><th>Type</th><th>Management / MAC</th><th>POP / Location</th><th>Integration</th><th></th></tr></thead><tbody>'+ (rows||'<tr><td colspan="6" class="text-center text-muted py-5">No devices registered yet. Add the MikroTik router and OLT to begin inventory.</td></tr>')+'</tbody></table></div></div><div class="alert alert-info mt-3 mb-0"><i class="bi bi-info-circle me-2"></i>MikroTik discovery is read-only. OLTs and ONTs are managed separately from the OLT Management submenu.</div></section>';
