        @media(max-width:768px){.ipam-shell{padding:10px;border-radius:12px}.ipam-shell .ipam-hero{padding:15px}.ipam-shell .ipam-toolbar{width:100%}.ipam-shell .ipam-toolbar .btn{flex:1}.ipam-shell .ipam-grid{grid-template-columns:1fr}.ipam-shell .ipam-filters{grid-template-columns:1fr}.ipam-shell .ipam-filters #ipamSearch{grid-column:auto}.ipam-shell .ipam-section{padding:11px}.ipam-shell .ipam-metrics{gap:8px}.ipam-shell .ipam-metric{padding:11px}.ipam-shell .ipam-metric strong{font-size:21px}.ipam-shell .ipam-pool-actions .btn{flex:0 1 auto}.ipam-shell .ipam-pool-data{gap:10px}}
        @media(max-width:420px){.ipam-shell .ipam-metrics{grid-template-columns:repeat(2,minmax(0,1fr))}.ipam-shell .ipam-metric strong{font-size:19px}.ipam-shell .ipam-pool-actions .btn{flex:1}.ipam-shell .ipam-pool-head{gap:6px}.ipam-shell .ipam-badge{font-size:10px;padding:4px 6px}}
        @media(prefers-reduced-motion:reduce){.ipam-shell .ipam-metric,.ipam-shell .ipam-pool-card{transition:none}.ipam-shell .ipam-pool-card:hover,.ipam-shell .ipam-metric:hover{transform:none}}
        
        /* IP Pools enterprise UI */
        .ip-pool-shell{position:relative}
        .ip-pool-hero{border:1px solid rgba(16,185,129,.16);background:linear-gradient(135deg,#ffffff 0%,#f0fdf8 52%,#ecfdf5 100%);border-radius:20px;padding:22px 24px;box-shadow:0 14px 40px rgba(15,23,42,.06);overflow:hidden}
        .ip-pool-hero:after{content:"";position:absolute;width:220px;height:220px;right:-90px;top:-110px;border-radius:50%;background:rgba(16,185,129,.12);filter:blur(4px)}
        .ip-pool-stat{border:1px solid #e2e8f0;background:#fff;border-radius:16px;padding:14px 16px;box-shadow:0 8px 24px rgba(15,23,42,.05)}
        .ip-pool-stat .value{font-size:22px;font-weight:800;color:#0f172a}
        .ip-pool-card{border:1px solid #e2e8f0;border-radius:18px;background:#fff;box-shadow:0 14px 34px rgba(15,23,42,.06);overflow:hidden}
        .ip-pool-table thead th{background:#f8fafc;border-bottom:1px solid #e2e8f0;color:#64748b;font-size:11px;font-weight:800;letter-spacing:.08em;text-transform:uppercase;padding:13px 16px}
        .ip-pool-table tbody td{padding:15px 16px;border-color:#f1f5f9}
        .ip-pool-row{transition:transform .18s ease,background .18s ease,box-shadow .18s ease}
        .ip-pool-row:hover{background:#f8fffb;transform:translateY(-1px);box-shadow:inset 3px 0 0 #10b981}
        .ip-pool-id{font:700 11px ui-monospace,SFMono-Regular,Menlo,monospace;color:#64748b;background:#f8fafc;border:1px solid #e2e8f0;border-radius:7px;padding:3px 7px}
        .ip-pool-action{width:36px;height:36px;border-radius:10px!important;display:inline-flex;align-items:center;justify-content:center;transition:transform .18s ease,box-shadow .18s ease}
        .ip-pool-action:hover{transform:translateY(-2px);box-shadow:0 8px 18px rgba(15,23,42,.12)}
        .ip-pool-modal .modal-content{border-radius:20px;box-shadow:0 28px 80px rgba(15,23,42,.24);animation:ipPoolModalIn .22s ease-out}
        .ip-pool-modal .modal-header{padding:18px 22px}
        .ip-pool-modal .modal-body{padding:22px}
        .ip-pool-modal .form-control{border-radius:12px;min-height:46px}
        .ip-pool-modal .form-control:focus{border-color:#10b981;box-shadow:0 0 0 4px rgba(16,185,129,.12)}
        .ip-pool-save{border-radius:11px;box-shadow:0 8px 20px rgba(5,150,105,.18);transition:transform .18s ease,box-shadow .18s ease}
        .ip-pool-save:hover{transform:translateY(-1px);box-shadow:0 12px 26px rgba(5,150,105,.25)}
        @keyframes ipPoolModalIn{from{opacity:0;transform:translateY(10px) scale(.985)}to{opacity:1;transform:translateY(0) scale(1)}}
        @media(max-width:768px){.ip-pool-hero{padding:18px}.ip-pool-table{min-width:860px}.ip-pool-modal .modal-body{padding:16px}}
    </style>
