<script>
        window.updateLanguage = window.updateLanguage || function(){};
        // Defensive UI reset: a stale Bootstrap backdrop must never own the click layer.
        try {
            document.querySelectorAll('.modal-backdrop, .offcanvas-backdrop, .sidebar-backdrop').forEach(el => el.remove());
            document.body.classList.remove('modal-open');
            document.body.style.removeProperty('overflow');
            document.body.style.removeProperty('padding-right');
        } catch (error) {
            console.warn('[Admin Boot] backdrop cleanup failed:', error);
        }

        // Guaranteed Global Fetch Helper
        window.jsonFetch = async function(url, options = {}) {
            const timeoutMs = options.timeout || 8000;
            const controller = new AbortController();
            const timeoutId = setTimeout(() => controller.abort(), timeoutMs);

            try {
                const { timeout: _ignoredTimeout, ...fetchOptions } = options;
                const res = await fetch(url, {
                    credentials: 'include',
                    headers: {
                        'Content-Type': 'application/json',
                        'Accept': 'application/json',
                        ...(fetchOptions.headers || {})
                    },
                    ...fetchOptions,
                    signal: fetchOptions.signal || controller.signal
                });

                clearTimeout(timeoutId);

                if (res.status === 401) {
                    window.location.href = '/login';
                    return { success: false, message: 'Unauthorized. Redirecting...' };
                }

                const contentType = res.headers.get('content-type') || '';
                if (contentType.includes('application/json')) {
                    return await res.json();
                }

                const text = await res.text();
                return { success: res.ok, data: text };
            } catch (err) {
                clearTimeout(timeoutId);
                console.error('[jsonFetch Failed]:', url, err.name === 'AbortError' ? 'Request Timed Out' : err.message);
                return {
                    success: false,
                    message: err.name === 'AbortError' ? 'Request Timed Out' : err.message
                };
            }
        };
        // Alias for backward compatibility
        window.fetchJson = window.jsonFetch;

        function safeSetText(idOrSelector, text) {
            let el = document.getElementById(idOrSelector);
            if (!el && typeof idOrSelector === 'string') {
                el = document.querySelector(idOrSelector);
            }
            if (el) {
                el.innerText = text;
            }
        }

        function setPageTitleSafe(title) {
            const el = document.getElementById('pageTitle') || document.querySelector('.page-title') || document.querySelector('h1, h2, h3');
            if (el) el.innerText = title;
        }

        function setMobilePageLoading(isLoading, label) {
            const nav = document.getElementById('adminTopBar');
            const bar = document.getElementById('mobilePageLoadingBar');
            const status = document.getElementById('mobileHeaderStatusText');
            if (nav) nav.classList.toggle('is-loading', Boolean(isLoading));
            if (bar) bar.setAttribute('aria-hidden', isLoading ? 'false' : 'true');
            if (status) status.textContent = label || (isLoading ? 'LOADING' : 'READY');
        }
        // Hotspot global entry points: define these before any dependent admin code executes.
        window.loadHotspotDashboard = function() {
