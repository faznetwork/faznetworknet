                if(tbody) tbody.innerHTML='<tr><td colspan="7" class="text-center py-5 text-danger"><i class="bi bi-exclamation-triangle me-2"></i>'+escapeHtml(error.message||'Failed to fetch data from MikroTik.')+'</td></tr>';
            }
