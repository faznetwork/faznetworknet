        window.showSection = function(sectionId) {
            const id = String(sectionId || '').trim();
            if (!id) return;

            const viewName = id.replace(/^view-/, '');
            const directTarget = document.getElementById(id) ||
                document.querySelector('[data-section="' + CSS.escape(id) + '"]');
            const viewTarget = document.getElementById('view-' + viewName);

            if (viewTarget && typeof window.switchView === 'function') {
                window.switchView(viewName);
                return;
            }

            document.querySelectorAll('.admin-view, .admin-section, .content-section, [data-section]').forEach(function(el) {
                el.style.display = 'none';
                el.classList.remove('active');
            });

            const target = directTarget || viewTarget;
            if (target) {
                target.style.display = 'block';
                target.classList.add('active');
            }

            document.querySelectorAll('.sidebar .nav-link, .nav-item a, .menu-item a').forEach(function(link) {
                link.classList.remove('active');
                const onclick = link.getAttribute('onclick') || '';
                if (onclick.includes(id) || onclick.includes(viewName) || link.getAttribute('data-target') === id) {
                    link.classList.add('active');
                }
            });

            if (id === 'plans' || id === 'packagesSection') {
                if (typeof window.loadPlans === 'function') window.loadPlans();
            } else if (id === 'customers' || id === 'pppoeSection') {
                if (typeof window.loadCustomers === 'function') window.loadCustomers();
            }
        };

        function updateLanguage(lang) {
            document.documentElement.lang = lang;
            document.querySelectorAll('[data-key]').forEach(el => {
                const key = el.getAttribute('data-key');
                if (translations[lang] && translations[lang][key]) el.innerText = translations[lang][key];
            });
            document.querySelectorAll('[data-placeholder-key]').forEach(el => {
                const key = el.getAttribute('data-placeholder-key');
                if (translations[lang] && translations[lang][key]) el.placeholder = translations[lang][key];
            });
            if (currentCustomerTitleKey && translations[lang]?.[currentCustomerTitleKey]) {
                setPageTitleSafe(translations[lang][currentCustomerTitleKey]);
            }
            if (currentPaymentTitleKey && translations[lang]?.[currentPaymentTitleKey]) {
                setPageTitleSafe(translations[lang][currentPaymentTitleKey]);
            }
            if (document.getElementById('paymentSearch')) {
                document.getElementById('paymentSearch').placeholder = translations[lang]?.search_payments || '';
            }
            localStorage.setItem('faz_preferred_lang', lang);
