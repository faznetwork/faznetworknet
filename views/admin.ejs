        window.loadNetworkMonitor = async function(mode = 'online') {
            mode = String(mode || 'online') === 'usage' ? 'usage' : 'online';
            const dynamic = document.getElementById('dynamicPageContent');
            if (!dynamic) return false;
            if (typeof purgeStuckBackdrops === 'function') purgeStuckBackdrops();
            if (typeof trafficTimer !== 'undefined' && trafficTimer) { clearInterval(trafficTimer); trafficTimer = null; }
            let root = document.getElementById('fazDynamicModuleRoot');
            if (!root) { root = document.createElement('div'); root.id = 'fazDynamicModuleRoot'; root.className = 'admin-view'; dynamic.appendChild(root); }
            document.querySelectorAll('.admin-view').forEach(view => view.style.display = 'none');
            root.style.display = 'block';
            if (window.innerWidth < 768 && typeof window.closeSidebarMobile === 'function') window.closeSidebarMobile();
            const isUsage = mode === 'usage';
            const title = isUsage ? 'Monitor — Usage' : 'Monitor — Online';
            setPageTitleSafe(title);
            root.innerHTML = '<section class="p-2 p-md-3"><div class="card border-0 shadow-sm rounded-4"><div class="card-body p-3 p-md-4"><div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4"><div><div class="small text-success fw-bold text-uppercase">FAZ NETWORK · PPPoE Monitor</div><h2 class="h5 fw-bold mb-1">' + escapeHtml(title) + '</h2><p class="small text-muted mb-0">' + (isUsage ? 'Current active-session byte counters only; these are not lifetime billing totals.' : 'Active PPPoE sessions reported by MikroTik or the latest available snapshot.') + '</p></div><button type="button" class="btn btn-outline-success" onclick="window.loadNetworkMonitor(\'' + mode + '\')"><i class="bi bi-arrow-clockwise me-2"></i>Refresh</button></div><div id="pppoeMonitorContent"><div class="text-center text-muted py-5"><span class="spinner-border spinner-border-sm me-2"></span>Loading active sessions…</div></div></div></div></section>';
            const content = root.querySelector('#pppoeMonitorContent');
            try {
                const data = await window.jsonFetch('/api/pppoe/active');
                const sessions = Array.isArray(data.sessions) ? data.sessions : [];
                const toBig = value => { try { const s = String(value ?? '0').trim(); return /^\d+$/.test(s) ? BigInt(s) : 0n; } catch (_) { return 0n; } };
                const formatBytes = value => {
                    const n = typeof value === 'bigint' ? value : toBig(value);
                    const units = ['B','KB','MB','GB','TB','PB'];
                    let scale = 0, size = Number(n);
                    while (size >= 1024 && scale < units.length - 1) { size /= 1024; scale++; }
                    return (scale ? size.toFixed(1) : size.toFixed(0)) + ' ' + units[scale];
                };
                const totalIn = sessions.reduce((sum, item) => sum + toBig(item.bytesIn), 0n);
                const totalOut = sessions.reduce((sum, item) => sum + toBig(item.bytesOut), 0n);
                const source = data.source === 'mikrotik-live' ? 'MikroTik live' : data.source === 'recent-router-snapshot' ? 'Recent snapshot · fallback' : 'Source not specified';
