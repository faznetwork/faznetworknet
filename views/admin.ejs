                if(!rows) rows='<tr><td colspan="10" class="text-center py-5 text-muted">No Hotspot users found.</td></tr>';
                appendHotspotView('<section class="hotspot-dynamic-view admin-view"><div class="card card-custom"><div class="card-custom-header flex-wrap"><div><i class="bi bi-wifi text-success fs-5 me-2"></i>'+escapeHtml(hotspotTitle(titleKey))+' <span class="badge bg-success">'+users.length+'</span></div><div class="hotspot-search ms-auto mt-2 mt-md-0"><div class="input-group input-group-sm"><span class="input-group-text bg-white"><i class="bi bi-search"></i></span><input id="hotspotSearch" class="form-control" placeholder="Search username, profile, IP or MAC..." data-placeholder-key="search_hotspot" oninput="filterHotspotRows(this.value)"></div></div><button class="btn btn-outline-success btn-sm ms-2 mt-2 mt-md-0" onclick="refreshHotspotCurrent()"><i class="bi bi-arrow-clockwise"></i></button></div><div class="card-body p-0 table-responsive"><table class="table table-hover mb-0 hotspot-live-table"><thead class="table-light"><tr><th>#</th><th>Username</th><th>Password</th><th>Profile</th><th>IP</th><th>MAC Address</th><th>Uptime</th><th data-key="bytes_in_out">Bytes In/Out</th><th>Status</th><th>Actions</th></tr></thead><tbody id="hotspotUserBody">'+rows+'</tbody></table></div></div></section>');
