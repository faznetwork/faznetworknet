        function filterCustomerRows(query) {
            const q = String(query || '').trim().toLowerCase();
            const activeTab = document.querySelector('#customerBillingTabs button[data-billing-filter].active');
            const wanted = String(activeTab?.getAttribute('data-billing-filter') || 'all').toLowerCase();
            document.querySelectorAll('#customerFilterBody tr[data-customer-row]').forEach(row => {
                const rowStatus = String(row.getAttribute('data-billing-status') || 'unpaid').toLowerCase();
                const isOnline = String(row.getAttribute('data-online') || 'false') === 'true';
                const matchesStatus = wanted === 'all' || (wanted === 'offline' ? !isOnline : rowStatus === wanted);
                const searchIndex = String(row.dataset.search || row.innerText || '').toLowerCase();
                const matchesSearch = !q || searchIndex.includes(q);
                row.style.display = matchesStatus && matchesSearch ? '' : 'none';
            });
        }

