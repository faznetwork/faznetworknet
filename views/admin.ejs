        function customerBillingCounts(users) {
            return (users || []).reduce(function(counts, user) {
                const status = String(user?.billing_status || 'unpaid').toLowerCase();
                if (status === 'paid') counts.paid++; else if (status === 'due') counts.due++; else counts.unpaid++;
                if (!customerStatus(user).online) counts.offline++;
                counts.all++; return counts;
            }, {all:0,paid:0,due:0,unpaid:0,offline:0});
        }

        function setCustomerBillingFilter(status, button) {
            const wanted = String(status || 'all').toLowerCase();
            document.querySelectorAll('#customerBillingTabs button[data-billing-filter]').forEach(function(btn) {
                const active = btn.getAttribute('data-billing-filter') === wanted;
                btn.classList.toggle('active', active);
                btn.setAttribute('aria-pressed', active ? 'true' : 'false');
            });
            // One combined filtering path prevents search from revealing rows excluded by the tab.
            filterCustomerRows(document.getElementById('customerLiveSearch')?.value || '');
        }
        function exportAllCustomersCsv() {
            const users = Array.isArray(window.cachedCustomers) ? window.cachedCustomers : currentCustomerUsers;
            if (!Array.isArray(users) || !users.length) {
                alert('There are no customer records to export.');
                return;
            }
            const columns = [
                ['Customer Name', user => parseCustomerMetadata(user).displayName || user.full_name || user.name || ''],
                ['Phone', user => parseCustomerMetadata(user).displayPhone || user.phone || ''],
                ['PPPoE Username', user => user.username || ''],
                ['Package / Profile', user => user.package_name || user.profile || ''],
                ['IP Address', user => user.session_ip || user.remote_address || user.remoteAddress || ''],
                ['MAC / Caller ID', user => user.session_caller_id || user.caller_id || user.mac || user.router_mac || ''],
                ['Status', user => String(user.billing_status || 'unpaid')],
                ['Validity Date', user => user.expiry_date || user.expiration_date || '']
            ];
            const csvCell = value => '"' + String(value == null ? '' : value).replace(/"/g, '""') + '"';
            const csv = [columns.map(column => csvCell(column[0])).join(',')].concat(
                users.map(user => columns.map(column => csvCell(column[1](user))).join(','))
            ).join('\r\n');
            const blob = new Blob(['\ufeff' + csv], { type: 'text/csv;charset=utf-8;' });
            const url = URL.createObjectURL(blob);
            const link = document.createElement('a');
            link.href = url;
            link.download = 'faz-network-customers-' + new Date().toISOString().slice(0, 10) + '.csv';
            document.body.appendChild(link);
            link.click();
            link.remove();
            URL.revokeObjectURL(url);
        }

