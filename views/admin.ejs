                const select=document.getElementById('voucherProfile');
                const profiles=data.profiles||[];
                select.innerHTML=profiles.map(function(p){return '<option value="'+escapeHtml(p.name)+'">'+escapeHtml(p.name)+(p.rateLimit?' — '+escapeHtml(p.rateLimit):'')+'</option>';}).join('');
                if(!profiles.length) select.innerHTML='<option value="">No MikroTik profiles found</option>';
            } catch(error) {
                const select=document.getElementById('voucherProfile'); if(select) select.innerHTML='<option value="">'+escapeHtml(error.message)+'</option>';
