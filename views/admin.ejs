            if(wrap){wrap.replaceChildren();if(s.qrDataUrl){const img=document.createElement('img');img.src=s.qrDataUrl;img.alt='Scan this QR code with WhatsApp Linked Devices';img.width=280;img.height=280;img.className='img-fluid';wrap.append(img);const p=document.createElement('p');p.className='small text-muted mt-2 mb-0';p.textContent='WhatsApp → Linked devices → Link a device';wrap.append(p);}else{const p=document.createElement('p');p.className='small text-muted mb-0';p.textContent=s.connected?'WhatsApp device is linked and ready.':(s.lastError||('WhatsApp status: '+(s.connection||'disconnected')+'. Press Connect / Reconnect if pairing is needed.'));wrap.append(p);}}
