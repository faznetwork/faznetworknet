                '<td class="customer-status-cell"><span class="customer-status-badge ' + statusClass + '"><i class="bi ' + (billingStatus === 'paid' ? 'bi-check-circle-fill' : 'bi-exclamation-circle-fill') + '"></i>' + escapeHtml(statusLabel) + '</span>' + sessionMeta + '</td>' +
