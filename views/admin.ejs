        async function loadDevices(){
            purgeStuckBackdrops(); currentCustomerTitleKey=''; currentPaymentTitleKey=''; setPageTitleSafe('MikroTik Management');
            hideAdminViews(); removeHotspotView();
            const dynamic=document.getElementById('dynamicPageContent'); if(!dynamic)return; dynamic.style.display='block';
