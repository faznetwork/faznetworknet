        /* Hotspot dashboard: balanced mobile metrics, explicit action banner, and a non-blocking loader. */
        .mobile-page-loading-bar{display:none;position:absolute;top:0;left:0;right:0;height:3px;overflow:hidden;pointer-events:none;z-index:3;background:transparent}
        .mobile-page-loading-bar::after{content:"";position:absolute;inset:0 auto 0 -42%;width:42%;background:linear-gradient(90deg,#10b981,#34d399,#60a5fa);transform:translateX(0)}
        #adminTopBar.is-loading .mobile-page-loading-bar{display:block}
        #adminTopBar.is-loading .mobile-page-loading-bar::after{animation:faz-mobile-progress 1.15s ease-in-out infinite}
        @keyframes faz-mobile-progress{0%{transform:translateX(0)}100%{transform:translateX(340%)}}
        .mobile-header-status{display:inline-flex;align-items:center;gap:6px;white-space:nowrap;padding:6px 8px;border:1px solid #d1fae5;border-radius:999px;background:#f0fdf4;color:#047857;font-size:10px;font-weight:800;letter-spacing:.04em}
