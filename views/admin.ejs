        window.loadVpnModule = async function() {
            const dynamic = document.getElementById('dynamicPageContent');
            if (!dynamic) return false;
            if (typeof purgeStuckBackdrops === 'function') purgeStuckBackdrops();
            if (typeof trafficTimer !== 'undefined' && trafficTimer) { clearInterval(trafficTimer); trafficTimer = null; }
            let root = document.getElementById('fazDynamicModuleRoot');
            if (!root) { root = document.createElement('div'); root.id = 'fazDynamicModuleRoot'; root.className = 'admin-view'; dynamic.appendChild(root); }
            document.querySelectorAll('.admin-view').forEach(view => view.style.display = 'none');
            root.style.display = 'block';
            if (window.innerWidth < 768 && typeof window.closeSidebarMobile === 'function') window.closeSidebarMobile();
            setPageTitleSafe('VPN Server');
            root.innerHTML = '<section class="p-2 p-md-3"><div class="card border-0 shadow-sm rounded-4"><div class="card-body p-3 p-md-4"><div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-3"><div><div class="small text-success fw-bold text-uppercase">FAZ NETWORK · Router Security</div><h2 class="h5 fw-bold mb-1">VPN Server Inventory</h2><p class="small text-muted mb-0">Read-only view of VPN services configured on the connected MikroTik router.</p></div><button type="button" class="btn btn-outline-success" onclick="window.loadVpnModule()"><i class="bi bi-arrow-clockwise me-2"></i>Refresh</button></div><div class="alert alert-warning small"><i class="bi bi-shield-lock me-2"></i>Read-only for production safety. VPN configuration changes are disabled here to avoid disconnecting remote users.</div><div id="vpnInventoryContent"><div class="text-center text-muted py-5"><span class="spinner-border spinner-border-sm me-2"></span>Reading router VPN settings…</div></div></div></div></section>';
            const content = root.querySelector('#vpnInventoryContent');
            try {
                const data = await window.jsonFetch('/api/router/vpn');
                const sections = data.sections || {};
                const warnings = Array.isArray(data.warnings) ? data.warnings : [];
                const configs = [
                    {key:'wireguard',title:'WireGuard Interfaces',columns:[['name','Name'],['listenPort','Listen port'],['mtu','MTU'],['disabled','Disabled']]},
                    {key:'l2tp',title:'L2TP Server',columns:[['enabled','Enabled'],['useIpsec','Use IPsec'],['defaultProfile','Default profile'],['authentication','Authentication'],['maxSessions','Max sessions']]},
                    {key:'sstp',title:'SSTP Server',columns:[['enabled','Enabled'],['port','Port'],['certificate','Certificate'],['authentication','Authentication'],['defaultProfile','Default profile']]},
                    {key:'openvpn',title:'OpenVPN Server',columns:[['enabled','Enabled'],['port','Port'],['mode','Mode'],['certificate','Certificate'],['authentication','Authentication'],['defaultProfile','Default profile']]},
                    {key:'ipsecPeers',title:'IPsec Peers',columns:[['name','Name'],['address','Peer address'],['localAddress','Local address'],['profile','Profile'],['exchangeMode','Exchange mode'],['disabled','Disabled']]}
                ];
                const count = configs.reduce((sum, config) => sum + (Array.isArray(sections[config.key]) ? sections[config.key].length : 0), 0);
                const renderSection = config => {
                    const rows = Array.isArray(sections[config.key]) ? sections[config.key] : [];
                    return '<div class="card border rounded-4 mb-3"><div class="card-header bg-white d-flex justify-content-between align-items-center gap-2"><strong>' + escapeHtml(config.title) + '</strong><span class="badge text-bg-light border">' + rows.length + '</span></div><div class="table-responsive"><table class="table table-hover align-middle mb-0"><thead class="table-light"><tr>' + config.columns.map(col => '<th>' + escapeHtml(col[1]) + '</th>').join('') + '</tr></thead><tbody>' +
                        (rows.length ? rows.map(row => '<tr>' + config.columns.map(col => {
                            let value = row[col[0]];
                            if (typeof value === 'boolean') value = value ? 'Yes' : 'No';
                            return '<td class="text-break">' + escapeHtml(value === null || value === undefined || value === '' ? '—' : String(value)) + '</td>';
                        }).join('') + '</tr>').join('') : '<tr><td colspan="' + config.columns.length + '" class="text-center text-muted py-3">No entries returned.</td></tr>') +
                        '</tbody></table></div></div>';
                };
                content.innerHTML = (data.degraded ? '<div class="alert alert-danger">Router VPN inventory is unavailable: ' + escapeHtml(data.error || 'connection failed') + '</div>' : '') +
                    '<div class="row g-3 mb-3"><div class="col-12 col-sm-6"><div class="border rounded-4 p-3"><div class="small text-muted">VPN entries returned</div><div class="h3 fw-bold mb-0">' + count + '</div></div></div><div class="col-12 col-sm-6"><div class="border rounded-4 p-3"><div class="small text-muted">Configuration scope</div><div class="fw-semibold">Connected MikroTik only</div></div></div></div>' +
                    (warnings.length ? '<div class="alert alert-info small"><strong>Some sections were unavailable:</strong><ul class="mb-0 mt-1">' + warnings.map(w => '<li>' + escapeHtml(w.section) + ': ' + escapeHtml(w.message) + '</li>').join('') + '</ul></div>' : '') +
                    configs.map(renderSection).join('');
                return true;
            } catch (error) {
                content.innerHTML = '<div class="alert alert-danger mb-0">' + escapeHtml(error.message || 'Unable to read VPN settings.') + '</div>';
                return false;
            }
        };

        window.loadPortForwarding = async function() {
            const dynamic = document.getElementById('dynamicPageContent');
            if (!dynamic) return false;
            if (typeof purgeStuckBackdrops === 'function') purgeStuckBackdrops();
            if (typeof trafficTimer !== 'undefined' && trafficTimer) { clearInterval(trafficTimer); trafficTimer = null; }
            let root = document.getElementById('fazDynamicModuleRoot');
            if (!root) { root = document.createElement('div'); root.id = 'fazDynamicModuleRoot'; root.className = 'admin-view'; dynamic.appendChild(root); }
            document.querySelectorAll('.admin-view').forEach(view => view.style.display = 'none');
            root.style.display = 'block';
            if (window.innerWidth < 768 && typeof window.closeSidebarMobile === 'function') window.closeSidebarMobile();
            setPageTitleSafe('VPN Port Forwarding');
            root.innerHTML = '<section class="p-2 p-md-3"><div class="card border-0 shadow-sm rounded-4"><div class="card-body p-3 p-md-4"><div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-3"><div><div class="small text-success fw-bold text-uppercase">FAZ NETWORK · Firewall NAT</div><h2 class="h5 fw-bold mb-1">Port Forwarding Rules</h2><p class="small text-muted mb-0">Destination-NAT rules currently configured on the connected MikroTik router.</p></div><button type="button" class="btn btn-outline-success" onclick="window.loadPortForwarding()"><i class="bi bi-arrow-clockwise me-2"></i>Refresh</button></div><div class="alert alert-warning small"><i class="bi bi-shield-lock me-2"></i>Read-only view. Creating or changing firewall rules can interrupt production traffic and is not enabled here.</div><div id="portForwardingContent"><div class="text-center text-muted py-5"><span class="spinner-border spinner-border-sm me-2"></span>Loading destination-NAT rules…</div></div></div></div></section>';
            const content = root.querySelector('#portForwardingContent');
            try {
                const data = await window.jsonFetch('/api/router/port-forwarding');
                const rules = Array.isArray(data.rules) ? data.rules : [];
                const rows = rules.map(rule => '<tr><td><div class="fw-semibold">' + escapeHtml(rule.comment || 'Unnamed rule') + '</div><div class="small text-muted">' + escapeHtml(rule.id || '') + '</div></td><td>' + escapeHtml(rule.protocol || '—') + '</td><td class="text-break">' + escapeHtml(rule.destinationAddress || 'Any') + (rule.destinationPort ? ':' + escapeHtml(rule.destinationPort) : '') + '</td><td class="text-break">' + escapeHtml(rule.incomingInterface || 'Any') + '</td><td class="text-break">' + escapeHtml(rule.targetAddress || '—') + (rule.targetPort ? ':' + escapeHtml(rule.targetPort) : '') + '</td><td>' + escapeHtml(rule.action || '—') + '</td><td><span class="badge ' + (rule.disabled ? 'text-bg-secondary' : 'text-bg-success') + '">' + (rule.disabled ? 'Disabled' : 'Enabled') + '</span></td></tr>').join('');
                content.innerHTML = (data.degraded ? '<div class="alert alert-danger">Port-forwarding rules are unavailable: ' + escapeHtml(data.error || 'connection failed') + '</div>' : '') +
                    '<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-2"><h3 class="h6 fw-bold mb-0">Destination NAT</h3><span class="badge text-bg-light border">' + rules.length + ' rules</span></div>' +
                    '<div class="table-responsive border rounded-3"><table class="table table-hover align-middle mb-0"><thead class="table-light"><tr><th>Rule / Comment</th><th>Protocol</th><th>Destination</th><th>Incoming interface</th><th>Forward target</th><th>Action</th><th>Status</th></tr></thead><tbody>' +
                    (rules.length ? rows : '<tr><td colspan="7" class="text-center text-muted py-4">No destination-NAT rules were returned.</td></tr>') +
                    '</tbody></table></div>';
                return true;
            } catch (error) {
                content.innerHTML = '<div class="alert alert-danger mb-0">' + escapeHtml(error.message || 'Unable to load port-forwarding rules.') + '</div>';
                return false;
            }
        };

        if (window.location.hash === '#hotspot-webhook') switchView('general-settings');

        window.showSection = function(sectionId) {
            const id = String(sectionId || '').trim();
            if (!id) return;

            const viewName = id.replace(/^view-/, '');
            const directTarget = document.getElementById(id) ||
                document.querySelector('[data-section="' + CSS.escape(id) + '"]');
            const viewTarget = document.getElementById('view-' + viewName);

            if (viewTarget && typeof window.switchView === 'function') {
                window.switchView(viewName);
                return;
            }

            document.querySelectorAll('.admin-view, .admin-section, .content-section, [data-section]').forEach(function(el) {
                el.style.display = 'none';
                el.classList.remove('active');
            });

            const target = directTarget || viewTarget;
            if (target) {
                target.style.display = 'block';
                target.classList.add('active');
            }

            document.querySelectorAll('.sidebar .nav-link, .nav-item a, .menu-item a').forEach(function(link) {
                link.classList.remove('active');
                const onclick = link.getAttribute('onclick') || '';
                if (onclick.includes(id) || onclick.includes(viewName) || link.getAttribute('data-target') === id) {
                    link.classList.add('active');
                }
            });

            if (id === 'plans' || id === 'packagesSection') {
                if (typeof window.loadPlans === 'function') window.loadPlans();
            } else if (id === 'customers' || id === 'pppoeSection') {
                if (typeof window.loadCustomers === 'function') window.loadCustomers();
            }
        };

        function updateLanguage(lang) {
            document.documentElement.lang = lang;
            document.querySelectorAll('[data-key]').forEach(el => {
                const key = el.getAttribute('data-key');
                if (translations[lang] && translations[lang][key]) el.innerText = translations[lang][key];
            });
            document.querySelectorAll('[data-placeholder-key]').forEach(el => {
                const key = el.getAttribute('data-placeholder-key');
                if (translations[lang] && translations[lang][key]) el.placeholder = translations[lang][key];
            });
            if (currentCustomerTitleKey && translations[lang]?.[currentCustomerTitleKey]) {
                setPageTitleSafe(translations[lang][currentCustomerTitleKey]);
            }
            if (currentPaymentTitleKey && translations[lang]?.[currentPaymentTitleKey]) {
                setPageTitleSafe(translations[lang][currentPaymentTitleKey]);
            }
            if (document.getElementById('paymentSearch')) {
                document.getElementById('paymentSearch').placeholder = translations[lang]?.search_payments || '';
            }
            localStorage.setItem('faz_preferred_lang', lang);
        }

        refreshAdminDbHealth();

        const langSelect = document.getElementById('langSelect');
        const savedLang = localStorage.getItem('faz_preferred_lang') || 'en';
        langSelect.value = savedLang;
        langSelect.addEventListener('change', function() { updateLanguage(this.value); });
        updateLanguage(savedLang);

        function escapeHtml(value) {
            return String(value ?? '').replace(/[&<>"']/g, ch => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#039;'}[ch]));
        }

        let adminDbConnected = <%= Boolean(typeof dbConnected !== 'undefined' && dbConnected) %>;

        function hideAdminDbWarning() {
            const toast = document.getElementById('adminDbWarningToast');
            if (toast) toast.remove();
            clearTimeout(window.__adminDbWarningTimer);
        }

        async function refreshAdminDbHealth() {
            try {
                const response = await fetch('/api/health/database', { cache: 'no-store' });
                const data = await response.json().catch(() => ({}));
                adminDbConnected = Boolean(response.ok && data.success && data.database?.connected);
                if (adminDbConnected) hideAdminDbWarning();
                return adminDbConnected;
            } catch (_) { return false; }
        }

        function showAdminDbWarning(message) {
            if (adminDbConnected) { hideAdminDbWarning(); return; }
            const text = message || 'Database not connected. Please set DATABASE_URL in Render environment.';
            let toast = document.getElementById('adminDbWarningToast');
            if (!toast) {
                toast = document.createElement('div');
                toast.id = 'adminDbWarningToast';
                toast.className = 'alert alert-warning shadow position-fixed top-0 end-0 m-3';
                toast.style.zIndex = '99999';
                toast.style.maxWidth = '420px';
                document.body.appendChild(toast);
            }
            toast.innerHTML = '<i class="bi bi-database-exclamation me-2"></i>' + escapeHtml(text);
            toast.style.display = 'block';
            clearTimeout(window.__adminDbWarningTimer);
            window.__adminDbWarningTimer = setTimeout(() => { toast.style.display = 'none'; }, 6000);
        }

        function showAddCustomerForm() {
            switchView('add-customer');
