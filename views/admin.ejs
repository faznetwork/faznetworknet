          if(!channels.length){if(result){result.className='small mt-3 text-danger';result.textContent='Select WhatsApp, SMS, or both.';}return;}
          if(!Number.isFinite(count)||count<1){if(result){result.className='small mt-3 text-danger';result.textContent='No eligible recipients are available. Refresh the audience count.';}return;}
          if(!window.confirm('Send this message to '+count+' unique recipients via '+channels.join(' + ').toUpperCase()+'? Delivery will be paced at 1.5–3 seconds between recipients. This may send real customer messages.'))return;
