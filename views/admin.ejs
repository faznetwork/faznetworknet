            name=String(localUser?.full_name||localUser?.fullName||localUser?.name||localUser?.username||name);
            if(!Number.isFinite(price)||price<=0){try{const details=await jsonFetch('/api/customers/'+encodeURIComponent(id)+'/profile');price=Number(details.package?.price||details.customer?.monthly_bill||0);name=String(details.customer?.fullName||details.customer?.full_name||details.customer?.name||details.customer?.username||name);}catch(error){alert(error.message||'Unable to load customer package price.');return false;}}
            if(!Number.isFinite(price)||price<=0){alert('Package price is unavailable.');return false;}
            if(!opts.skipConfirm&&!confirm('Renew '+name+' for 1 Month (৳'+price.toFixed(2)+')?'))return false;
            const row=Array.from(document.querySelectorAll('#customerFilterBody tr[data-customer-row]')).find(function(el){return String(el.dataset.id||'')===id;});
            const button=opts.button||row?.querySelector('.action-renew-btn, .mc-pay');if(button?.disabled)return false;if(button)button.disabled=true;
            try{const data=await jsonFetch('/api/customers/'+encodeURIComponent(id)+'/renew',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({amount:price,paymentMethod:'CASH',trxId:'CASH-RENEW-'+Date.now()})});await refreshCustomerSection();if(typeof showCustomerActionToast==='function')showCustomerActionToast(data.message||'Customer renewed successfully.');else alert(data.message||'Customer renewed successfully.');return true;}
            catch(error){alert(error.message||'Unable to renew customer.');return false;}
            finally{if(button&&button.isConnected)button.disabled=false;}
        }

