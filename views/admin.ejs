        function emergencyUiUnfreeze() {
            document.querySelectorAll('.modal-backdrop, .offcanvas-backdrop').forEach(function(el) { el.remove(); });
            document.body.classList.remove('modal-open');
            document.body.style.overflow = '';
            document.body.style.paddingRight = '';
            document.body.style.pointerEvents = 'auto';
        }

        // Heal stale invisible Bootstrap backdrops that can intercept sidebar clicks.
        // Only clean overlays when no modal/offcanvas is actually open.
        function recoverStaleNavigationOverlay() {
            if (document.querySelector('.modal.show, .offcanvas.show, .offcanvas.showing')) return;
            const stale = document.querySelectorAll('.modal-backdrop, .offcanvas-backdrop');
            if (!stale.length) return;
            stale.forEach(function (el) { el.remove(); });
            if (document.body) {
                document.body.classList.remove('modal-open', 'offcanvas-open');
                document.body.style.removeProperty('overflow');
                document.body.style.removeProperty('padding-right');
                document.body.style.pointerEvents = 'auto';
            }
        }

        function purgeStuckBackdrops() {
            document.querySelectorAll('.modal-backdrop').forEach(function(el) { el.remove(); });
            document.querySelectorAll('.offcanvas-backdrop').forEach(function(el) { el.remove(); });
            document.querySelectorAll('.sidebar-backdrop:not(#sidebarBackdrop)').forEach(function(el) { el.classList.remove('show'); el.remove(); });
            document.querySelectorAll('.offcanvas.show, .offcanvas.showing, .offcanvas.hiding').forEach(function(el) {
                el.classList.remove('show', 'showing', 'hiding');
                el.setAttribute('aria-hidden', 'true');
            });
            if (document.body) {
                document.body.classList.remove('modal-open', 'offcanvas-open', 'sidebar-open');
                document.body.style.overflow = '';
                document.body.style.paddingRight = '';
                document.body.removeAttribute('data-bs-overflow');
                document.body.removeAttribute('data-bs-padding-right');
            }
            var sidebar = document.getElementById('sidebar');
            if (sidebar && window.innerWidth < 768) sidebar.classList.remove('show');
            var sidebarButton = document.getElementById('mobileSidebarToggle');
            if (sidebarButton) sidebarButton.setAttribute('aria-expanded', 'false');
            document.body.style.pointerEvents = 'auto';
        }

        window.navigateToCustomerProfile = function(customerId){
            const id=String(customerId||'').trim();
            if(!id)return;
            purgeStuckBackdrops();
            const target='/admin/customers/'+encodeURIComponent(id);
            if(window.location.pathname===target)return;
            window.history.pushState({customer360:true,customerId:id},'',target);
            window.location.replace(target);
        };

        // Bootstrap should remove these itself; this observer handles orphaned backdrops
        // left behind by interrupted modal transitions, without polling RouterOS or APIs.
        if (!window.__sidebarOverlayRecoveryBound) {
            window.__sidebarOverlayRecoveryBound = true;
            const overlayObserver = new MutationObserver(function () {
                recoverStaleNavigationOverlay();
            });
            overlayObserver.observe(document.body, { childList: true, subtree: true });
            document.addEventListener('hidden.bs.modal', function () {
                window.setTimeout(recoverStaleNavigationOverlay, 80);
            }, true);
            document.addEventListener('hidden.bs.offcanvas', function () {
                window.setTimeout(recoverStaleNavigationOverlay, 80);
            }, true);
        }

        function syncMobileSidebarState(){const sidebar=document.getElementById('sidebar'),backdrop=document.getElementById('sidebarBackdrop'),button=document.getElementById('mobileSidebarToggle');const open=Boolean(sidebar&&sidebar.classList.contains('show')&&window.innerWidth<768);if(backdrop)backdrop.classList.toggle('show',open);document.body.classList.toggle('sidebar-open',open);if(button)button.setAttribute('aria-expanded',open?'true':'false');}
        function closeSidebarMobile(){purgeStuckBackdrops();const sidebar=document.getElementById('sidebar');if(sidebar)sidebar.classList.remove('show');const backdrop=document.getElementById('sidebarBackdrop');if(backdrop)backdrop.classList.remove('show');if(document.body)document.body.classList.remove('sidebar-open');syncMobileSidebarState();}
        function toggleSidebar(){const sidebar=document.getElementById('sidebar');if(!sidebar||window.innerWidth>=768)return;sidebar.classList.toggle('show');syncMobileSidebarState();}

        function toggleSubmenu(event, button) {
            if (event) {
                event.preventDefault();
                event.stopPropagation();
            }
            if (!button) return;
            const submenu = button.nextElementSibling;
            const isOpen = Boolean(submenu && !submenu.classList.contains('show'));
            if (submenu) submenu.classList.toggle('show', isOpen);
            button.setAttribute('aria-expanded', isOpen ? 'true' : 'false');
            const arrow = button.querySelector('.arrow-icon');
            if (arrow) {
                arrow.classList.toggle('bi-chevron-up', isOpen);
                arrow.classList.toggle('bi-chevron-down', !isOpen);
            }
        }
        document.addEventListener('click', function(event) {
            if (window.innerWidth >= 768) return;
            const sidebar = document.getElementById('sidebar');
            if (!sidebar || !sidebar.classList.contains('show')) return;
            const link = event.target.closest('#sidebar .submenu a, #sidebar .sidebar-menu > .menu-item > a');
            if (!link) return;
            // Inline handlers execute before this bubbling listener. Keep them intact,
            // prevent the javascript:void(0) pseudo-navigation, then close the drawer.
            if ((link.getAttribute('href') || '').trim().toLowerCase().startsWith('javascript:')) {
                event.preventDefault();
            }
            closeSidebarMobile();
        });
        window.addEventListener('resize',function(){if(window.innerWidth>=768){closeSidebarMobile();purgeStuckBackdrops();}else{syncMobileSidebarState();}});

