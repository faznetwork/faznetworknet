            const caller = user.session_caller_id || user.caller_id || '-';
            const expiryRaw = String(user?.expiry_date || user?.expiration_date || '').trim();
            const displayExp = formatDhakaExpiration(expiryRaw, metadata.rawComment);
            const expiryDateMatch = expiryRaw.match(/^\d{4}-\d{2}-\d{2}$/);
            let validityLabel = displayExp.replace(/^EXP:\s*/i, '');
            let daysLabel = '';
            let daysClass = 'days-positive';
            if (expiryDateMatch) {
                const todayDhaka = new Intl.DateTimeFormat('en-CA', { timeZone: 'Asia/Dhaka', year: 'numeric', month: '2-digit', day: '2-digit' }).format(new Date());
                const todayStart = new Date(todayDhaka + 'T00:00:00+06:00');
                const expiryEnd = new Date(expiryRaw + 'T23:59:59+06:00');
                const diffDays = Math.ceil((expiryEnd.getTime() - todayStart.getTime()) / 86400000);
                validityLabel = new Intl.DateTimeFormat('en-GB', { timeZone: 'Asia/Dhaka', day: '2-digit', month: 'short', year: 'numeric' }).format(new Date(expiryRaw + 'T00:00:00+06:00'));
                if (diffDays < 0) { daysLabel = 'Expired'; daysClass = 'days-expired'; }
                else if (diffDays === 0) { daysLabel = 'Expires today'; daysClass = 'days-today'; }
                else { daysLabel = diffDays + ' day' + (diffDays === 1 ? '' : 's') + ' left'; }
