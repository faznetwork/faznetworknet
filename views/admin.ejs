        .ipam-shell .ipam-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:12px}
        .ipam-shell .ipam-pool-card{display:flex;flex-direction:column;min-width:0;border:1px solid #e2e8f0;border-top:3px solid var(--ipam-accent);border-radius:12px;background:#fff!important;padding:14px;box-shadow:0 1px 3px rgba(15,23,42,.035);transition:transform .16s ease,box-shadow .16s ease,border-color .16s ease}
