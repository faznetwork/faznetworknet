                <div class="noc-hardware-stack"><section class="card card-custom noc-panel"><div class="card-custom-header"><span><i class="bi bi-router text-success me-2"></i>MikroTik Core Health</span><span id="dashboardRouterStatus" class="badge bg-secondary">Checking…</span></div><div class="card-body p-3"><strong id="nocRouterModel">RouterOS device</strong><div id="nocRouterUptime" class="small text-muted">Uptime pending</div><div class="noc-progress-row"><div><span>CPU LOAD</span><strong id="metricCpu">—</strong></div><div class="progress"><div id="cpuBar" class="progress-bar bg-success" style="width:0%"></div></div></div><div class="noc-progress-row"><div><span>RAM USED</span><strong id="metricRam">—</strong></div><div class="progress"><div id="ramBar" class="progress-bar bg-info" style="width:0%"></div></div></div></div></section>
                <section class="card card-custom noc-panel"><div class="card-custom-header"><span><i class="bi bi-hdd-network text-primary me-2"></i>OLT Status</span><span id="nocOltStatus" class="badge bg-secondary">Checking…</span></div><div class="card-body p-3"><strong id="nocOltName">V-SOL V1600D4</strong><div id="nocOltAddress" class="small text-muted">IP not reported by telemetry</div><div class="noc-olt-stats"><div><strong id="nocOnuTotal">—</strong><span>Registered ONUs</span></div><div><strong id="nocPonActive">—</strong><span>Active PON ports</span></div></div><div id="nocOltSeen" class="small text-muted mt-2">Telemetry freshness pending</div></div></section></div>
              </div>
