                    '/admin/hotspot/sales': { view: 'hotspot', section: 'sales' },
                    '/admin/network/mikrotik-devices': { view: 'devices' },
                    '/admin/packages': { view: 'packages' },
                    '/admin/network/ip-pools': { view: 'ip-pools' },
                    '/admin/network/olt': { view: 'olt', mode: 'overview' },
                    '/admin/network/olt/onts': { view: 'olt', mode: 'onts' },
                    '/admin/network/olt/topology': { view: 'olt', mode: 'topology' },
                    '/admin/staff': { view: 'staff' },
                    '/admin/audit-logs': { view: 'audit' },
                    '/admin/network/maps': { view: 'maps' },
                    '/admin/support/tickets': { view: 'support', category: 'all' },
                    '/admin/settings': { view: 'page', page: 'general-settings' },
                    '/admin/monitor/usage': { view: 'module', module: 'usage' },
                    '/admin/monitor/online': { view: 'module', module: 'monitor-online' },
                    '/admin/network/diagram': { view: 'module', module: 'network-diagram' },
                    '/admin/vpn': { view: 'module', module: 'vpn' },
                    '/admin/vpn/port-forwarding': { view: 'module', module: 'vpn-port-forwarding' },
                    '/admin/account/dashboard': { view: 'module', module: 'account-dashboard' },
                    '/admin/account/manage': { view: 'module', module: 'account-manage' },
                    '/admin/support/software': { view: 'support', category: 'software' },
                    '/admin/support/website': { view: 'support', category: 'website' },
                    '/admin/hr/departments': { view: 'module', module: 'hr-departments' },
                    '/admin/hr/employees': { view: 'module', module: 'hr-employees' },
                    '/admin/hr/employees/added': { view: 'module', module: 'hr-added-employees' },
                    '/admin/resellers/sub-staff': { view: 'module', module: 'sub-staff' }
                };
                return Object.prototype.hasOwnProperty.call(routes, path) ? cleanRoute(routes[path]) : null;
            }
            function readRoute() {
                const path = window.location.pathname.replace(/\/+$/, '') || '/admin';
                const pathRoute = routeFromPath(path);
                if (pathRoute) return pathRoute;
                if (path === '/admin' && window.location.hash === '#hotspot-webhook') return { view: 'page', page: 'general-settings' };

                // Backward compatibility: older shared links with ?view=... resolve once,
                // then commitRoute replaces them with the canonical path-based URL.
                const params = new URLSearchParams(window.location.search);
                const view = params.get('view');
                if (!view) return { view: 'dashboard' };
                if (view === 'page') return cleanRoute({ view, page: params.get('page'), channel: params.get('channel') });
                if (view === 'customers') return cleanRoute({ view, filter: params.get('filter'), title: params.get('title') });
                if (view === 'payments') return cleanRoute({ view, filter: params.get('filter'), title: params.get('title') });
                if (view === 'hotspot') return cleanRoute({ view, section: params.get('section'), filter: params.get('filter'), title: params.get('title') });
                if (view === 'olt') return cleanRoute({ view, mode: params.get('mode') });
                return cleanRoute({ view });
            }
            function routeUrl(route) {
                const normalized = cleanRoute(route);
                if (normalized.view === 'dashboard') return '/admin/dashboard';
                if (normalized.view === 'page') {
                    if (normalized.page === 'add-customer') return '/admin/customers/add';
                    if (normalized.page === 'general-settings') return '/admin/settings';
                    if (normalized.page === 'all-customer') return '/admin/customers/all';
                    if (normalized.page === 'payments') return '/admin/payments/' + (normalized.channel || 'all');
                }
                if (normalized.view === 'customers') {
                    const paths = {
                        all: 'all', online: 'online', offline: 'offline', active: 'active',
                        expire: 'expired', expire_today_yesterday: 'expiring-today-yesterday',
                        expire_7_days: 'expiring-next-7-days', new: 'new', due: 'due'
                    };
                    return '/admin/customers/' + (paths[normalized.filter] || 'all');
                }
                if (normalized.view === 'payments') return '/admin/payments/' + (normalized.filter || 'all');
                if (normalized.view === 'hotspot') {
                    if (normalized.section === 'dashboard') return '/admin/hotspot/dashboard';
                    if (normalized.section === 'add-user') return '/admin/hotspot/add-user';
                    if (normalized.section === 'users') return '/admin/hotspot/users/' + (normalized.filter || 'all');
                    if (normalized.section === 'profiles') return '/admin/hotspot/profiles';
                    if (normalized.section === 'voucher-generator') return '/admin/hotspot/vouchers/generate';
                    if (normalized.section === 'vouchers') return '/admin/hotspot/vouchers/' + (normalized.filter === 'cleanup' ? 'cleanup' : 'manage');
                    if (normalized.section === 'sales') return '/admin/hotspot/sales';
                }
                if (normalized.view === 'devices') return '/admin/network/mikrotik-devices';
                if (normalized.view === 'packages') return '/admin/packages';
                if (normalized.view === 'ip-pools') return '/admin/network/ip-pools';
                if (normalized.view === 'olt') {
                    if (normalized.mode === 'onts') return '/admin/network/olt/onts';
                    if (normalized.mode === 'topology') return '/admin/network/olt/topology';
                    return '/admin/network/olt';
                }
                if (normalized.view === 'staff') return '/admin/staff';
                if (normalized.view === 'audit') return '/admin/audit-logs';
                if (normalized.view === 'maps') return '/admin/network/maps';
                if (normalized.view === 'support') return normalized.category === 'software' ? '/admin/support/software' : normalized.category === 'website' ? '/admin/support/website' : '/admin/support/tickets';
                if (normalized.view === 'module' && Object.prototype.hasOwnProperty.call(moduleTitles, normalized.module)) {
                    const modulePaths = {
                        'usage': '/admin/monitor/usage',
                        'monitor-online': '/admin/monitor/online',
                        'network-diagram': '/admin/network/diagram',
                        'vpn': '/admin/vpn',
                        'vpn-port-forwarding': '/admin/vpn/port-forwarding',
                        'account-dashboard': '/admin/account/dashboard',
                        'account-manage': '/admin/account/manage',
                        'software-support-tickets': '/admin/support/software',
                        'website-support-tickets': '/admin/support/website',
                        'hr-departments': '/admin/hr/departments',
                        'hr-employees': '/admin/hr/employees',
                        'hr-added-employees': '/admin/hr/employees/added',
                        'sub-staff': '/admin/resellers/sub-staff'
                    };
                    return modulePaths[normalized.module];
                }
                return '/admin/dashboard';
            }
            function commitRoute(route, replace) {
                const normalized = cleanRoute(route);
                const url = routeUrl(normalized);
                if (window.location.pathname + window.location.search !== url) {
                    const method = replace ? 'replaceState' : 'pushState';
                    window.history[method]({ fazAdminRoute: normalized }, '', url);
                } else if (replace) {
                    window.history.replaceState({ fazAdminRoute: normalized }, '', url);
                }
                state.current = normalized;
                return normalized;
            }
            function callIfAvailable(name, args) {
                const fn = window[name];
                if (typeof fn !== 'function') {
                    console.error('[Admin Routing] Required view handler is unavailable:', name);
                    return false;
                }
                return fn.apply(window, args || []);
            }
            function dispatchRoute(route) {
                const r = cleanRoute(route);
                switch (r.view) {
                    case 'dashboard':
                        return callIfAvailable('switchView', ['dashboard']);
                    case 'page':
                        if (r.page === 'add-customer') return callIfAvailable('showAddCustomerForm');
                        if (r.page === 'all-customer') return callIfAvailable('loadCustomerSection', ['all', 'all_customer']);
                        if (r.page === 'payments') return callIfAvailable('loadPaymentsSection', [r.channel || 'all', 'all_payments']);
                        return callIfAvailable('switchView', [r.page, r.channel || '']);
                    case 'customers':
                        return callIfAvailable('loadCustomerSection', [r.filter, r.title]);
                    case 'payments':
                        return callIfAvailable('loadPaymentsSection', [r.filter, r.title]);
                    case 'hotspot':
                        if (r.section === 'dashboard') return callIfAvailable('loadHotspotDashboard');
                        if (r.section === 'users') return callIfAvailable('loadHotspotSection', [r.filter, r.title]);
                        if (r.section === 'add-user') return callIfAvailable('loadAddHotspotUserView');
                        if (r.section === 'profiles') return callIfAvailable('loadHotspotProfiles', ['hotspot_profile']);
                        if (r.section === 'voucher-generator') return callIfAvailable('loadVoucherGeneratorSection');
                        if (r.section === 'vouchers') return callIfAvailable('loadHotspotVoucherRecords', [r.filter, r.filter === 'cleanup' ? 'Expired & Cleanup' : 'Voucher Management']);
                        if (r.section === 'sales') return callIfAvailable('loadHotspotVoucherSales');
                        break;
                    case 'devices': return callIfAvailable('loadDevices');
                    case 'packages': return callIfAvailable('loadPlanPackages');
                    case 'ip-pools': return callIfAvailable('loadIpPools');
                    case 'olt': return callIfAvailable('loadOltManagement', [r.mode]);
                    case 'staff': return callIfAvailable('loadStaffManagement');
                    case 'audit': return callIfAvailable('loadAuditLogs');
                    case 'maps': return callIfAvailable('loadGoogleMapTracking');
                    case 'support': return callIfAvailable('loadSupportTickets', [r.category || 'all']);
                    case 'module': return showAdminModulePlaceholder(r.module);
                }
                return false;
            }
            function showAdminModulePlaceholder(moduleKey) {
                const title = moduleTitles[moduleKey];
                const dynamic = document.getElementById('dynamicPageContent');
                if (!title || !dynamic) return false;
                if (typeof purgeStuckBackdrops === 'function') purgeStuckBackdrops();
                if (typeof setPageTitleSafe === 'function') setPageTitleSafe(title);
                dynamic.innerHTML = `
                    <section class="admin-view p-2 p-md-3">
                        <div class="card border-0 shadow-sm rounded-4 overflow-hidden">
                            <div class="card-body p-3 p-md-5">
                                <div class="d-flex flex-wrap align-items-center gap-3 mb-3">
                                    <div class="rounded-4 d-flex align-items-center justify-content-center flex-shrink-0" style="width:52px;height:52px;background:#ecfdf5;color:#065f46;font-size:24px"><i class="bi bi-cone-striped"></i></div>
                                    <div><div class="small text-success fw-bold text-uppercase">FAZ NETWORK · Admin Module</div><h3 class="h5 fw-bold mb-0">${escapeHtml(title)}</h3></div>
                                </div>
                                <div class="alert alert-info d-flex align-items-start gap-2 mb-3" role="status">
                                    <i class="bi bi-info-circle-fill mt-1"></i>
                                    <div><strong>এই মডিউলটি এখনো কার্যকরভাবে তৈরি হয়নি।</strong><div class="small mt-1">URL ও navigation প্রস্তুত করা হয়েছে, কিন্তু data/API ও save/edit functionality যুক্ত না হওয়া পর্যন্ত এখানে কোনো তথ্য পরিবর্তন হবে না।</div></div>
                                </div>
                                <p class="text-muted mb-4">মোবাইল ও ডেস্কটপ—দুই স্ক্রিনেই ব্যবহারযোগ্য করে পরবর্তী ধাপে এই মডিউলটি বাস্তব কার্যকারিতাসহ তৈরি করা হবে।</p>
                                <a href="/admin/dashboard" class="btn btn-success"><i class="bi bi-grid me-2"></i>ড্যাশবোর্ডে ফিরুন</a>
                            </div>
                        </div>
                    </section>`;
                return true;
            }

            function restoreRoute(route, replace) {
                const normalized = commitRoute(route, Boolean(replace));
                state.restoring = true;
                try {
                    const result = dispatchRoute(normalized);
                    if (result && typeof result.catch === 'function') {
                        result.catch(error => console.error('[Admin Routing] View restore failed:', error));
                    }
                    return result;
                } catch (error) {
                    console.error('[Admin Routing] View restore failed:', error);
                    return false;
                } finally {
                    state.restoring = false;
                }
            }
            function routeForCall(name, args) {
                switch (name) {
                    case 'switchView': {
                        const page = String(args[0] || 'dashboard');
                        if (page === 'dashboard') return { view: 'dashboard' };
                        if (page === 'add-customer') return { view: 'page', page: 'add-customer' };
                        if (page === 'all-customer') return { view: 'customers', filter: 'all', title: 'all_customer' };
                        if (page === 'payments') return { view: 'payments', filter: args[1] || 'all', title: paymentTitleByFilter[args[1] || 'all'] || 'all_payments' };
                        if (page === 'general-settings') return { view: 'page', page };
                        return null;
                    }
                    case 'showAddCustomerForm': return { view: 'page', page: 'add-customer' };
                    case 'loadCustomerSection': {
                        const filter = has(allowed.customerFilters, args[0]) ? args[0] : 'all';
                        return { view: 'customers', filter, title: has(allowed.customerTitles, args[1]) ? args[1] : customerTitleByFilter[filter] };
                    }
                    case 'loadPaymentsSection': {
                        const filter = has(allowed.paymentFilters, args[0]) ? args[0] : 'all';
                        return { view: 'payments', filter, title: has(allowed.paymentTitles, args[1]) ? args[1] : paymentTitleByFilter[filter] };
                    }
                    case 'loadHotspotDashboard': return { view: 'hotspot', section: 'dashboard' };
                    case 'loadHotspotSection': {
                        const filter = has(allowed.hotspotFilters, args[0]) ? args[0] : 'all';
                        return { view: 'hotspot', section: 'users', filter, title: has(allowed.hotspotTitles, args[1]) ? args[1] : (filter === 'active' ? 'active_user' : filter === 'offline' ? 'offline_user' : 'all_user') };
                    }
                    case 'loadAddHotspotUserView': return { view: 'hotspot', section: 'add-user' };
                    case 'loadHotspotProfiles': return { view: 'hotspot', section: 'profiles' };
                    case 'loadVoucherGeneratorSection': return { view: 'hotspot', section: 'voucher-generator' };
                    case 'loadHotspotVoucherRecords': {
                        const filter = has(allowed.voucherFilters, args[0]) ? args[0] : 'all';
                        return { view: 'hotspot', section: 'vouchers', filter };
                    }
                    case 'loadHotspotVoucherSales': return { view: 'hotspot', section: 'sales' };
                    case 'loadDevices': return { view: 'devices' };
                    case 'loadPlanPackages': return { view: 'packages' };
                    case 'loadIpPools': return { view: 'ip-pools' };
                    case 'loadOltManagement': return { view: 'olt', mode: args[0] || 'overview' };
                    case 'loadStaffManagement': return { view: 'staff' };
                    case 'loadAuditLogs': return { view: 'audit' };
                    case 'loadGoogleMapTracking': return { view: 'maps' };
                    case 'loadSupportTickets': return { view: 'support', category: ['all','general','software','website'].includes(String(args[0] || 'all')) ? String(args[0] || 'all') : 'all' };
                    default: return null;
                }
            }
            function closeDrawerAfterNavigation() {
                if (window.innerWidth < 768 && typeof window.closeSidebarMobile === 'function') {
                    window.closeSidebarMobile();
                }
            }
            function wrapNavigation(name) {
                const original = window[name];
                if (typeof original !== 'function' || original.__fazRouteWrapped) return;
                const wrapped = function() {
                    const args = Array.prototype.slice.call(arguments);
                    const isTopLevel = state.depth === 0;
                    const route = routeForCall(name, args);
                    if (isTopLevel && route && !state.restoring) commitRoute(route, false);
                    state.depth++;
                    let result;
                    try {
                        result = original.apply(this, args);
                    } catch (error) {
                        state.depth--;
                        throw error;
                    }
                    state.depth--;
                    if (isTopLevel && !state.restoring) closeDrawerAfterNavigation();
                    return result;
                };
                wrapped.__fazRouteWrapped = true;
                window[name] = wrapped;
            }
            [
                'switchView', 'showAddCustomerForm', 'loadCustomerSection', 'loadPaymentsSection',
                'loadHotspotDashboard', 'loadHotspotSection', 'loadAddHotspotUserView',
                'loadHotspotProfiles', 'loadVoucherGeneratorSection', 'loadHotspotVoucherRecords',
                'loadHotspotVoucherSales', 'loadDevices', 'loadPlanPackages', 'loadIpPools',
                'loadOltManagement', 'loadStaffManagement', 'loadAuditLogs',
                'loadGoogleMapTracking', 'loadSupportTickets'
            ].forEach(wrapNavigation);

            window.__fazRestoreAdminRoute = function() {
                restoreRoute(readRoute(), true);
            };
            window.addEventListener('popstate', function() {
                restoreRoute(readRoute(), true);
                closeDrawerAfterNavigation();
            });
        })();

        function initializeAdminRuntime() {
            try { initializeCustomerDateFormatGuard(); }
            catch (error) { console.error('[Customer Date Format] guard initialization failed:', error); }
            try {
                const dashboardInterface = document.getElementById('dashboardInterface');
                if (dashboardInterface && !dashboardInterface.dataset.runtimeBound) {
                    dashboardInterface.dataset.runtimeBound = '1';
                    dashboardInterface.addEventListener('change', function() {
                        try {
                            if (trafficChart) {
                                trafficChart.data.labels = [];
                                trafficChart.data.datasets.forEach(d => d.data = []);
                                trafficChart.update('none');
                            }
                            void safeAdminBootStep('traffic refresh', () => pollTraffic());
                        } catch (error) {
                            console.error('[Admin Boot] traffic change handler failed:', error);
                        }
                    });
                }
            } catch (error) {
                console.error('[Admin Boot] event binding failed:', error);
            }

            // Restore the URL-selected view on first load; dashboard is only the default.
            // The selected loader owns its existing data fetches and polling behavior.
            try { void safeAdminBootStep('restore URL-selected view', () => window.__fazRestoreAdminRoute ? window.__fazRestoreAdminRoute() : switchView('dashboard')); }
            catch (error) { console.error('[Admin Boot] switch dashboard failed:', error); }

            try {
                if (metricsTimer) clearInterval(metricsTimer);
                metricsTimer = setInterval(() => {
                    if (metricsPollInFlight) return;
                    metricsPollInFlight = true;
                    (async () => {
                        try {
                            if (document.getElementById('view-dashboard')?.style.display !== 'none') {
                                // refreshDashboard also updates router metrics; call it once per cycle.
                                await safeAdminBootStep('dashboard refresh', () => refreshDashboard());
                            }
                            if (currentHotspotMode === 'dashboard' && document.getElementById('hotspotDashboardSessions')) {
                                await safeAdminBootStep('hotspot metrics', () => refreshHotspotDashboardMetrics());
                            }
                            if (currentPaymentTitleKey && document.getElementById('view-payment-ledger')) {
                                await safeAdminBootStep('payment refresh', () => fetchPaymentsSection());
                            }
                        } catch (error) {
                            console.error('[Admin Poll] metrics cycle failed:', error);
                        } finally {
                            metricsPollInFlight = false;
                        }
                    })();
                }, 15000);
            } catch (error) {
                console.error('[Admin Boot] metrics timer failed:', error);
            }
        }

        if (document.readyState === 'loading') {
            document.addEventListener('DOMContentLoaded', initializeAdminRuntime, { once: true });
        } else {
            initializeAdminRuntime();
        }
    </script>
    <script src="/js/rbac-sidebar.js?v=staff-actions-20261010" defer></script>
</body>
