        function ipPoolDefaultModalHtml() {
            return '<div class="modal fade ip-pool-modal" id="ipPoolModal" tabindex="-1" aria-hidden="true"><div class="modal-dialog modal-dialog-centered modal-lg"><div class="modal-content border-0"><div class="modal-header"><div><h5 class="modal-title fw-bold" id="ipPoolModalTitle">Add IP Pool</h5><small class="text-muted">MikroTik /ip/pool configuration</small></div><button type="button" class="btn-close" data-bs-dismiss="modal"></button></div><form id="ipPoolForm"><div class="modal-body"><input id="ipPoolMikrotikId" type="hidden"><div class="row g-3"><div class="col-md-6"><label class="form-label">Pool Name <span class="text-danger">*</span></label><input id="ipPoolName" class="form-control" required maxlength="100" placeholder="100 mbps"></div><div class="col-md-6"><label class="form-label">Subnet (CIDR)</label><input id="ipPoolSubnet" class="form-control font-monospace" maxlength="50" placeholder="10.81.0.1/24"></div><div class="col-md-6"><label class="form-label">Local Address / Gateway <span class="text-danger">*</span></label><input id="ipPoolLocalAddress" class="form-control font-monospace" required placeholder="10.81.0.1"></div><div class="col-md-6"><label class="form-label">Pool Range (Usable Range) <span class="text-danger">*</span></label><input id="ipPoolRanges" class="form-control font-monospace" required maxlength="1000" placeholder="10.81.0.2-10.81.0.254"></div><div class="col-12"><label class="form-label">Next Pool <span class="text-muted fw-normal">(Optional)</span></label><select id="ipPoolNext" class="form-select"><option value="none">None</option></select><div id="ipPoolFormHint" class="form-text mt-2"><i class="bi bi-magic me-1"></i>Enter a CIDR such as <span class="font-monospace">10.81.0.1/24</span> to auto-fill the gateway and usable range.</div></div></div></div><div class="modal-footer"><button type="button" class="btn btn-light border" data-bs-dismiss="modal">Cancel</button><button id="ipPoolSaveBtn" type="submit" class="btn btn-primary px-4 ip-pool-save"><i class="bi bi-check2-circle me-1"></i>Save IP Pool</button></div></form></div></div></div>';
