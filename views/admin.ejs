        async function savePlan(e){
            e.preventDefault();
            const button=document.getElementById('planSaveBtn');
            const old=button.innerHTML;
            button.disabled=true;
            button.innerHTML='<span class="spinner-border spinner-border-sm me-1"></span>Saving & Syncing...';
            try{
                const rawId=document.getElementById('planId')?.value ?? currentPackageEdit?.id ?? null;
                const cleanId=(rawId && rawId!=='undefined' && rawId!=='null' && String(rawId).trim()!=='') ? String(rawId).trim() : null;
                const payload={
                    id:cleanId,
                    planName:document.getElementById('planName').value.trim(),
                    price:document.getElementById('planPrice').value.trim(),
                    durationMonths:document.getElementById('planDuration')?.value || 1,
                    rateLimit:document.getElementById('planRateLimit')?.value?.trim() || null,
                    localAddress:document.getElementById('planLocalAddress')?.value?.trim() || null,
                    remoteAddress:document.getElementById('planRemoteAddress')?.value?.trim() || null,
                    dnsServer:document.getElementById('planDnsServer')?.value?.trim() || null,
                    changeTcpMss:document.getElementById('planChangeTcpMss')?.value || 'yes'
                };
                const response=await fetch('/api/packages/save',{
                    method:'POST',
                    headers:{'Content-Type':'application/json'},
                    body:JSON.stringify(payload)
                });
                const data=await response.json().catch(()=>({}));
                if(!response.ok||data.success===false)throw new Error(data.message||'Failed to save and synchronize plan.');
                bootstrap.Modal.getInstance(document.getElementById('planModal'))?.hide();
                purgeStuckBackdrops();
                currentPackageEdit=null;
                await loadPlanPackages();
                alert(data.message||'Plan saved and synchronized with MikroTik.');
            }catch(error){
                console.error('[PLAN UI] Save & Sync error:',error);
                alert(error.message||'Failed to save plan.');
            }finally{
                button.disabled=false;
                button.innerHTML=old;
            }
        }

async function deletePlan(id,name){
            if(!id&&!name)return;
            if(!confirm('Are you sure you want to delete "'+(name||'')+'"?'))return;
            try{
                const res=await fetch('/api/packages/delete',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({id:id||null,name:name||''})});
                const data=await res.json().catch(()=>({}));
                if(!res.ok||!data.success){alert('Delete Failed: '+(data.message||res.statusText||'Server error'));return;}
                alert(data.message||('Plan "'+(name||'')+'" deleted successfully'));
                if(typeof window.loadPlans==='function')await window.loadPlans();else await loadPlanPackages();
            }catch(err){alert('Network error while deleting plan: '+(err?.message||'Unknown error'));}
        }

        async function syncPlansFromMikrotik() {
            const syncBtn = document.getElementById('syncPlansBtn') || document.querySelector('.sync-plans-btn');
            const origHtml = syncBtn ? syncBtn.innerHTML : '';
            if (syncBtn) {
                syncBtn.disabled = true;
                syncBtn.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span> Syncing...';
            }

            try {
                const data = await window.jsonFetch('/api/packages/sync', { method: 'POST' });
                if (!data.success) {
                    throw new Error(data.message || 'Sync failed');
                }

                alert(data.message || 'Sync completed successfully!');
                if (typeof window.loadPlans === 'function') {
                    await window.loadPlans();
                } else {
                    window.location.reload();
                }
            } catch (err) {
                alert('Failed to sync plans from MikroTik: ' + (err?.message || 'Unknown error'));
            } finally {
                if (syncBtn) {
                    syncBtn.disabled = false;
                    syncBtn.innerHTML = origHtml;
                }
            }
        }

