            if (accountsHeading) accountsHeading.textContent = currentStaffMode === 'sub-staff' ? 'Sub-Staff Accounts' : currentStaffMode === 'account-manage' ? 'Managed Accounts' : 'Accounts';
            if (invitesHeading) invitesHeading.textContent = currentStaffMode === 'sub-staff' ? 'Sub-Staff Invitations' : currentStaffMode === 'account-manage' ? 'Account Invitations' : 'Pending Invitations';
