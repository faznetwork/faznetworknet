                document.getElementById('ipamSearch').addEventListener('input',renderAllocations);document.getElementById('ipamTypeFilter').addEventListener('change',renderAllocations);document.getElementById('ipamStatusFilter').addEventListener('change',renderAllocations);renderAllocations();
