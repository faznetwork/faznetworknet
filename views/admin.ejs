      else if(typeof window.openHotspotKpiUsers==='function') await window.openHotspotKpiUsers('all');
    }else if(card.id==='active-users'){
      if(typeof window.loadHotspotSection==='function') await window.loadHotspotSection('active','active_user');
      else if(typeof window.openHotspotKpiUsers==='function') await window.openHotspotKpiUsers('active');
    }else if(card.id==='expired-users'){
      if(typeof window.loadHotspotVoucherRecords==='function') await window.loadHotspotVoucherRecords('cleanup','Expired & Cleanup');
