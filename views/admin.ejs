        .ipam-shell .ipam-metrics{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:12px;margin:14px 0 18px}
        .ipam-shell .ipam-metric{background:#fff!important;border:1px solid rgba(226,232,240,.9);border-left:3px solid var(--ipam-metric-accent);border-radius:12px;padding:14px 15px;min-width:0;box-shadow:0 1px 2px rgba(15,23,42,.04);transition:box-shadow .18s ease,transform .18s ease}
        .ipam-shell .ipam-metric:hover{box-shadow:0 5px 14px rgba(15,23,42,.07);transform:translateY(-1px)}
        .ipam-shell .ipam-metric span{font-size:12px;line-height:1.4;font-weight:700;color:#475569!important}
        .ipam-shell .ipam-metric strong{display:block;font-family:'Inter',ui-sans-serif,system-ui,sans-serif;font-size:24px;font-weight:800;letter-spacing:-.035em;line-height:1.25;color:#0f172a!important;margin-top:7px;font-variant-numeric:tabular-nums;overflow-wrap:anywhere}
        .ipam-shell .ipam-metric small{display:block;font-size:11px;line-height:1.45;color:#64748b!important;margin-top:5px}
        .ipam-shell .ipam-metric-sky{--ipam-metric-accent:#0ea5e9}.ipam-shell .ipam-metric-amber{--ipam-metric-accent:#f59e0b}.ipam-shell .ipam-metric-green{--ipam-metric-accent:#10b981}.ipam-shell .ipam-metric-util{--ipam-metric-accent:#8b5cf6}
        .ipam-shell .ipam-util-line{display:flex;align-items:center;justify-content:space-between;gap:8px}.ipam-shell .ipam-util-line b{font-size:11px;font-weight:700}
        .ipam-shell .ipam-section{background:#fff!important;border:1px solid rgba(226,232,240,.95);border-radius:13px;padding:15px;margin-top:15px;min-width:0;box-shadow:0 1px 3px rgba(15,23,42,.035)}
        .ipam-shell .ipam-section-head{display:flex;justify-content:space-between;align-items:center;gap:12px;margin-bottom:13px;flex-wrap:wrap}
        .ipam-shell .ipam-section-head h4{font-family:'Plus Jakarta Sans',sans-serif;font-size:15px;line-height:1.4;font-weight:800;color:#0f172a!important;margin:0;letter-spacing:-.015em}
