<style id="mobile-all-customers-layout">
/* Keep the full desktop table, but turn All Customers rows into readable cards on phones. */
@media (max-width: 767.98px) {
  #view-customer-filter .customer-live-table { width:100%; min-width:0 !important; table-layout:fixed; border-collapse:separate; border-spacing:0 10px; }
  #view-customer-filter .customer-live-table thead { display:none; }
  #view-customer-filter .customer-live-table tbody { display:block; padding:0 10px 12px; }
  #view-customer-filter .customer-live-table tbody tr[data-customer-row] {
    display:block; width:100%; overflow:hidden; background:#fff; border:1px solid #e2e8f0;
    border-radius:14px; box-shadow:0 2px 8px rgba(15,23,42,.05); margin:0 0 12px;
  }
  #view-customer-filter .customer-live-table tbody tr[data-customer-row] > td {
    display:flex; align-items:center; justify-content:space-between; gap:12px;
    width:100%; min-width:0; padding:10px 12px !important; border:0;
    border-bottom:1px solid #edf2f7; text-align:right; white-space:normal;
    overflow-wrap:anywhere; vertical-align:middle;
  }
  #view-customer-filter .customer-live-table tbody tr[data-customer-row] > td:last-child { border-bottom:0; }
  #view-customer-filter .customer-live-table tbody tr[data-customer-row] > td::before {
    flex:0 0 102px; color:#64748b; font-size:11px; font-weight:700;
    letter-spacing:.035em; text-align:left; text-transform:uppercase;
  }
  #view-customer-filter .customer-live-table tbody tr[data-customer-row] > td:nth-child(1) { display:none; }
  #view-customer-filter .customer-live-table tbody tr[data-customer-row] > td:nth-child(2) {
    justify-content:flex-start; text-align:left; padding:14px 12px !important;
    background:#f8fafc; border-bottom:1px solid #e2e8f0;
  }
  #view-customer-filter .customer-live-table tbody tr[data-customer-row] > td:nth-child(2)::before { content:none; }
  #view-customer-filter .customer-live-table tbody tr[data-customer-row] > td:nth-child(2) .customer-identity-cell,
  #view-customer-filter .customer-live-table .customer-identity-cell > .d-flex { min-width:0; max-width:100%; }
  #view-customer-filter .customer-profile-link { white-space:normal; overflow-wrap:anywhere; }
  #view-customer-filter .customer-live-table tbody tr[data-customer-row] > td:nth-child(3)::before { content:"PPPoE"; }
  #view-customer-filter .customer-live-table tbody tr[data-customer-row] > td:nth-child(4)::before { content:"Package"; }
  #view-customer-filter .customer-live-table tbody tr[data-customer-row] > td:nth-child(5)::before { content:"Connection"; }
  #view-customer-filter .customer-live-table tbody tr[data-customer-row] > td:nth-child(6)::before { content:"Status"; }
  #view-customer-filter .customer-live-table tbody tr[data-customer-row] > td:nth-child(7)::before { content:"Validity"; }
  #view-customer-filter .customer-live-table tbody tr[data-customer-row] > td:nth-child(8)::before { content:"Actions"; }
  #view-customer-filter .customer-live-table .customer-username { display:inline-block; max-width:calc(100% - 112px); min-width:0; overflow-wrap:anywhere; word-break:break-word; }
  #view-customer-filter .customer-live-table .customer-connection-value,
  #view-customer-filter .customer-live-table .customer-connection-meta,
  #view-customer-filter .customer-live-table .customer-validity-date { min-width:0; overflow-wrap:anywhere; }
  #view-customer-filter .customer-live-table .customer-action-group { display:flex; flex-wrap:wrap; justify-content:flex-end; gap:6px; }
  #view-customer-filter .customer-live-table .customer-action-group .btn { min-width:36px; min-height:36px; }
  #view-customer-filter .customer-live-table .customer-status-cell { flex-wrap:wrap; }
  #view-customer-filter .customer-live-table .customer-session { width:100%; text-align:right; }
  #view-customer-filter .customer-live-table tbody > tr:not([data-customer-row]) { display:table-row; }
  #view-customer-filter .customer-live-table tbody > tr:not([data-customer-row]) > td { display:table-cell; }
  #view-customer-filter .customer-live-table tbody > tr:not([data-customer-row]) > td::before { content:none; }
  #view-customer-filter .card-custom-header { flex-wrap:wrap; gap:8px; padding:14px 12px; }
  #view-customer-filter .card-custom-header > span:first-of-type { flex:1 1 100%; }
  #view-customer-filter .customer-search-wrap { flex:1 1 100%; width:100%; min-width:0; margin:0 !important; }
  #view-customer-filter .customer-search-wrap .input-group { width:100%; }
  #view-customer-filter .card-custom-header > button { flex:1 1 auto; margin-top:0 !important; min-height:38px; }
  #view-customer-filter #customerBillingTabs { padding:12px !important; gap:7px !important; }
  #view-customer-filter #customerBillingTabs .btn { flex:1 1 calc(50% - 7px); min-width:0; white-space:normal; line-height:1.25; padding:8px 6px; }
  #view-customer-filter .card-body.table-responsive { overflow-x:visible; }
}
@media (max-width: 380px) {
  #view-customer-filter .customer-live-table tbody { padding-left:7px; padding-right:7px; }
  #view-customer-filter .customer-live-table tbody tr[data-customer-row] > td { padding:9px !important; gap:8px; }
  #view-customer-filter .customer-live-table tbody tr[data-customer-row] > td::before { flex-basis:82px; }
  #view-customer-filter .customer-live-table .customer-username { max-width:calc(100% - 90px); }
  #view-customer-filter .card-custom-header > button { font-size:12px; }
}
</style>

