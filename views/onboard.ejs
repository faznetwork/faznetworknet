<!doctype html>
<html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Set Up Your ISP · FAZ NETWORK</title><link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet"><style>body{min-height:100vh;background:linear-gradient(135deg,#062e25,#0b7051);display:grid;place-items:center;padding:18px;font-family:system-ui,sans-serif}.panel{width:min(100%,540px);background:#fff;border-radius:22px;padding:30px;box-shadow:0 25px 70px #001c153d}.brand{color:#087f5b;font-weight:900;letter-spacing:-.04em}.form-control{min-height:46px}.hint{color:#64748b;font-size:.85rem}.readonly{background:#f1f5f9;border-radius:10px;padding:10px 12px}</style></head>
<body><main class="panel"><div class="brand fs-3">FAZ NETWORK</div><h1 class="h4 fw-bold mt-3">Set up your ISP account</h1><p class="hint mb-4">Create your tenant administrator login. This invitation expires 48 hours after it was issued and can be used once.</p>
<% if(error){ %><div class="alert alert-danger"><%= error %></div><% } %>
<% if(tenant && token){ %><div class="row g-2 mb-3"><div class="col-sm-6"><div class="hint">Tenant Name</div><div class="readonly fw-semibold"><%= tenant.name %></div></div><div class="col-sm-6"><div class="hint">Tenant Number</div><div class="readonly fw-semibold"><%= tenant.id %></div></div></div><div class="mb-3"><label class="form-label fw-semibold">Email (read-only)</label><input class="form-control" readonly value="<%= tenant.contact_email %>"></div>
<form id="onboardForm"><input type="hidden" name="token" value="<%= token %>"><div class="mb-3"><label class="form-label fw-semibold" for="username">Set Admin Username</label><input class="form-control" id="username" name="username" required minlength="3" maxlength="60" pattern="[A-Za-z0-9._-]+" autocomplete="username"></div><div class="mb-3"><label class="form-label fw-semibold" for="password">Set Password</label><input class="form-control" id="password" name="password" type="password" required minlength="10" maxlength="128" autocomplete="new-password"></div><div class="mb-4"><label class="form-label fw-semibold" for="confirmPassword">Confirm Password</label><input class="form-control" id="confirmPassword" name="confirmPassword" type="password" required minlength="10" maxlength="128" autocomplete="new-password"></div><div id="formError" class="alert alert-danger d-none"></div><button id="submitBtn" class="btn btn-success w-100 py-3 fw-bold" type="submit">Create Account &amp; Open Dashboard</button></form><script>document.getElementById('onboardForm').addEventListener('submit',async e=>{e.preventDefault();const f=e.currentTarget,b=document.getElementById('submitBtn'),err=document.getElementById('formError');err.classList.add('d-none');b.disabled=true;try{const r=await fetch('/onboard',{method:'POST',headers:{'Content-Type':'application/json','Accept':'application/json'},body:JSON.stringify(Object.fromEntries(new FormData(f)))});const d=await r.json();if(!r.ok||!d.success)throw new Error(d.message||'Unable to complete onboarding.');location.assign(d.redirect||'/tenant/dashboard');}catch(x){err.textContent=x.message;err.classList.remove('d-none');b.disabled=false;}});</script><% } %></main></body></html>
