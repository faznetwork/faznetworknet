<!DOCTYPE html>
<html lang="en"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><meta name="robots" content="noindex,nofollow"><meta http-equiv="Cache-Control" content="no-store"><title>Accept Invitation | FAZ NETWORK</title>
<style>:root{color-scheme:light}*{box-sizing:border-box}body{margin:0;min-height:100vh;display:grid;place-items:center;padding:clamp(12px,3vw,28px);background:radial-gradient(circle at 15% 10%,#166b50 0,#052e2b 48%,#031f1d 100%);font-family:Inter,system-ui,-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif;color:#0f172a}.card{width:min(100%,520px);background:#fff;border:1px solid #d1fae5;border-radius:22px;padding:clamp(20px,5vw,34px);box-shadow:0 24px 70px #0004}h1{text-align:center;font-size:clamp(25px,6vw,30px);letter-spacing:-.04em;margin:4px 0 8px}h1 span{color:#059669}.muted{color:#64748b;line-height:1.65;font-size:14px}.alert{padding:12px 14px;border:1px solid #fecaca;border-radius:11px;background:#fef2f2;color:#b91c1c;margin:18px 0;line-height:1.5}.success-note{padding:10px 12px;border-radius:10px;background:#ecfdf5;color:#047857;font-size:13px;margin-top:10px}label{display:block;font-weight:700;font-size:13px;margin:17px 0 7px;color:#334155}input{width:100%;padding:13px 14px;border:1px solid #cbd5e1;border-radius:10px;font-size:16px;background:#fff;transition:border-color .15s,box-shadow .15s}input:focus{outline:none;border-color:#10b981;box-shadow:0 0 0 3px #10b98124}button{padding:13px 16px;border:0;border-radius:10px;background:#047857;color:white;font-size:15px;font-weight:750;cursor:pointer;transition:background .15s,transform .15s}button:hover{background:#065f46}button:focus-visible{outline:3px solid #6ee7b7;outline-offset:2px}button:disabled{opacity:.55;cursor:not-allowed;transform:none}.wide{width:100%;margin-top:20px;min-height:48px}.info{padding:14px;border:1px solid #a7f3d0;background:#ecfdf5;border-radius:12px;color:#065f46;line-height:1.8;overflow-wrap:anywhere}.field-hint{font-size:12px;color:#64748b;margin-top:6px}#passwordMatch{font-size:13px;margin-top:7px;min-height:18px}#passwordMatch.match{color:#047857}#passwordMatch.mismatch{color:#b91c1c}.brand-mark{display:flex;justify-content:center;margin:0 auto 12px;color:#047857;font-size:11px;font-weight:800;letter-spacing:.18em;text-transform:uppercase}.form-actions{margin-top:8px}@media(max-width:420px){.card{border-radius:17px}.info{font-size:13px}}</style></head>
<body><main class="card"><h1>FAZ <span>NETWORK</span></h1>
<% if (error) { %><div class="alert" role="alert"><%= error %></div><% } %>
<% if (invitation && token) { %>
<div class="brand-mark"><span>Secure account setup</span></div>
<% if (invitation.self_service_signup) { %>
<p class="muted">You have been invited to join FAZ NETWORK as Sub-Staff. Choose your own username and password below. Email OTP is not required for this invitation.</p>
<div class="info"><b>Email:</b> <%= invitation.email || '' %><br><b>Role:</b> Sub-Staff</div>
<form method="post" action="/invite/<%= encodeURIComponent(token) %>/accept" autocomplete="on">
<label for="username">Choose username</label><input id="username" name="username" minlength="3" maxlength="60" pattern="[A-Za-z0-9._-]{3,60}" autocomplete="username" required>
<label for="password">Create password</label><input id="password" name="password" type="password" minlength="12" maxlength="128" autocomplete="new-password" required>
<label for="confirmPassword">Confirm password</label><input id="confirmPassword" name="confirmPassword" type="password" minlength="12" maxlength="128" autocomplete="new-password" required>
<p class="muted">Username may contain letters, numbers, dot, underscore or hyphen. Password must be 12–128 characters. Your account is created after this invitation link is validated.</p><button class="wide" type="submit">Create account</button></form>
<% } else { %>
<p class="muted">You have been invited to join FAZ NETWORK. Verify this email with a one-time code, then set your password.</p>
<div class="info"><b>Username:</b> <%= invitation.username || '' %><br><b>Email:</b> <%= invitation.email || '' %><br><b>Role:</b> <%= invitation.role || '' %></div>
<button class="wide" type="button" id="sendOtp">Send OTP to this email</button><p id="otpResult" class="muted" aria-live="polite"></p>
<form method="post" action="/invite/<%= encodeURIComponent(token) %>/accept" autocomplete="on">
<label for="otp">6-digit email OTP</label><input id="otp" name="otp" inputmode="numeric" pattern="[0-9]{6}" minlength="6" maxlength="6" required>
<label for="password">Create password</label><input id="password" name="password" type="password" minlength="12" maxlength="128" autocomplete="new-password" required>
<label for="confirmPassword">Confirm password</label><input id="confirmPassword" name="confirmPassword" type="password" minlength="12" maxlength="128" autocomplete="new-password" required>
<p class="muted">Password must be 12–128 characters. The account will not be created until the OTP and password are accepted.</p><button class="wide" type="submit">Verify and create account</button></form>
<script>document.getElementById('sendOtp').addEventListener('click',async function(){const b=this,r=document.getElementById('otpResult');b.disabled=true;r.textContent='Sending OTP…';try{const x=await fetch('/invite/<%= encodeURIComponent(token) %>/send-otp',{method:'POST',headers:{Accept:'application/json'},credentials:'same-origin'});const d=await x.json();if(!x.ok||!d.success)throw new Error(d.message||'Could not send OTP');r.textContent=d.message;}catch(e){r.textContent=e.message;}finally{b.disabled=false;}});</script>
<% } %>
<% } else { %><p class="muted">This invitation link is not available.</p><% } %>
<script>
(function(){
  const forms=Array.from(document.querySelectorAll('form[action*="/accept"]'));
  forms.forEach(form=>{
    const password=form.querySelector('#password');
    const confirm=form.querySelector('#confirmPassword');
    const submit=form.querySelector('button[type="submit"]');
    if(!password||!confirm||!submit)return;
    const selfService=!!form.querySelector('#username');
    const match=document.createElement('div');
    match.id='passwordMatch';match.setAttribute('aria-live','polite');
    confirm.insertAdjacentElement('afterend',match);
    function validate(){
      const same=confirm.value.length>0&&password.value===confirm.value;
      const filled=password.value.length>=12&&password.value.length<=128&&confirm.value.length>0;
      match.className=same?'match':(confirm.value?'mismatch':'');
      match.textContent=!confirm.value?'':(same?'Passwords match.': 'Passwords do not match.');
      confirm.setCustomValidity(confirm.value&&!same?'Passwords do not match.':'');
      submit.disabled=!filled||!same;
    }
    password.addEventListener('input',validate);
    confirm.addEventListener('input',validate);
    form.addEventListener('submit',function(event){
      validate();
      if(!form.reportValidity()||password.value!==confirm.value){event.preventDefault();confirm.focus();}
    });
    validate();
  });
})();
</script>
</main></body></html>