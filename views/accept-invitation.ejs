<!DOCTYPE html>
<html lang="en"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><meta name="robots" content="noindex,nofollow"><meta http-equiv="Cache-Control" content="no-store"><title>Accept Invitation | FAZ NETWORK</title>
<style>body{margin:0;min-height:100vh;display:grid;place-items:center;padding:20px;background:#052e2b;font-family:Arial,sans-serif;color:#0f172a}.card{width:min(100%,520px);box-sizing:border-box;background:#fff;border-radius:20px;padding:30px;box-shadow:0 20px 60px #0003}h1{text-align:center;font-size:28px}h1 span{color:#059669}.muted{color:#64748b;line-height:1.6}.alert{padding:12px;border-radius:10px;background:#fef2f2;color:#b91c1c;margin:18px 0}label{display:block;font-weight:700;margin:16px 0 7px}input{box-sizing:border-box;width:100%;padding:12px;border:1px solid #cbd5e1;border-radius:9px;font-size:15px}button{padding:12px 16px;border:0;border-radius:9px;background:#047857;color:white;font-weight:700;cursor:pointer}.wide{width:100%;margin-top:20px}.line{display:flex;gap:8px;align-items:end}.line input{flex:1}.info{padding:14px;background:#ecfdf5;border-radius:10px;color:#065f46;line-height:1.7}</style></head>
<body><main class="card"><h1>FAZ <span>NETWORK</span></h1>
<% if (error) { %><div class="alert" role="alert"><%= error %></div><% } %>
<% if (invitation && token) { %>
<p class="muted">You have been invited to join FAZ NETWORK. This secure invitation link verifies your email. Choose your username and password to activate your account.</p>
<div class="info"><b>Email:</b> <%= invitation.email || '' %><br><b>Role:</b> <%= invitation.role || '' %></div>
<form method="post" action="/invite/<%= encodeURIComponent(token) %>/accept" autocomplete="on">
<label for="username">Choose username</label><input id="username" name="username" minlength="3" maxlength="60" pattern="[A-Za-z0-9._-]+" autocomplete="username" required>
<label for="password">Create password</label><input id="password" name="password" type="password" minlength="12" maxlength="128" autocomplete="new-password" required>
<label for="confirmPassword">Confirm password</label><input id="confirmPassword" name="confirmPassword" type="password" minlength="12" maxlength="128" autocomplete="new-password" required>
<p class="muted">Password must be 12–128 characters. Username must be 3–60 characters using letters, numbers, dot, underscore or hyphen. Your account will be activated after the invitation token and password are validated.</p><button class="wide" type="submit">Activate account and sign in</button></form>

<% } else { %><p class="muted">This invitation link is not available.</p><% } %>
</main></body></html>