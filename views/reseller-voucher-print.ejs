<!doctype html>
<%
const brand=typeof brandSettings!=='undefined'&&brandSettings?brandSettings:{};
const brandName=String(brand.company_name||'FAZ NETWORK');
const safeResellerName=String(resellerName||'Reseller');
const loginHost=String(batch.dnsName||'login.hotspot');
const formatDate=value=>value?new Intl.DateTimeFormat('en-GB',{timeZone:'Asia/Dhaka',dateStyle:'medium',timeStyle:'short'}).format(new Date(value)):'—';
%>
<html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><meta name="robots" content="noindex,nofollow"><title><%= brandName %> · Voucher Batch <%= batch.batchKey %></title><script src="https://cdnjs.cloudflare.com/ajax/libs/qrcodejs/1.0.0/qrcode.min.js" defer></script>
<style>
@import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=Outfit:wght@500;600;700;800&display=swap');:root{--body-font:Inter,Arial,sans-serif;--heading-font:Outfit,Inter,sans-serif;font-family:var(--body-font);color:#0f172a}*{box-sizing:border-box}body{margin:0;background:#f1f5f9;padding:22px}.toolbar{max-width:1200px;margin:0 auto 16px;display:flex;justify-content:space-between;gap:10px;flex-wrap:wrap}.toolbar a,.toolbar button{border:0;border-radius:8px;padding:10px 14px;text-decoration:none;font-weight:700;cursor:pointer;background:#e2e8f0;color:#0f172a}.toolbar button{background:#166534;color:#fff}.sheet{max-width:1200px;margin:auto;background:#fff;padding:26px;border:1px solid #e2e8f0;border-radius:14px}.heading{display:flex;justify-content:space-between;gap:18px;border-bottom:2px solid #166534;padding-bottom:14px;margin-bottom:16px}.brand{font-size:20px;font-weight:800;color:#166534}.muted{font-size:11px;color:#64748b}h1{font-family:var(--heading-font);font-size:20px;margin:5px 0}.meta{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:8px;margin:14px 0}.meta div{background:#f8fafc;border:1px solid #e2e8f0;padding:9px;border-radius:7px}.meta small{display:block;color:#64748b;font-size:9px;text-transform:uppercase;font-weight:700}.meta strong{font-size:12px;overflow-wrap:anywhere;word-break:break-word}.voucher-grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:10px}.voucher{display:grid;grid-template-columns:minmax(56px,72px) minmax(0,1fr);align-items:center;gap:10px;min-width:0;border:1px dashed #64748b;border-radius:8px;padding:10px;min-height:130px;break-inside:avoid}.voucher>div:last-child,.voucher-head,.credential,.credential b{min-width:0;max-width:100%;overflow-wrap:anywhere;word-break:break-word}.qr{width:72px;height:72px;max-width:100%;display:grid;place-items:center}.qr *{display:block;max-width:100%!important;width:100%!important;height:auto!important}.voucher-head{font-size:10px;font-weight:800;color:#166534;margin-bottom:6px}.credential{font-size:10px;margin:4px 0;overflow-wrap:anywhere}.credential span{display:block;color:#64748b}.credential b{display:block;font-family:Consolas,monospace}.footer{margin-top:18px;padding-top:10px;border-top:1px solid #e2e8f0;text-align:center;color:#64748b;font-size:10px}@media(max-width:760px){body{padding:10px}.sheet{padding:14px}.voucher-grid{grid-template-columns:repeat(2,minmax(0,1fr));gap:8px}.voucher{grid-template-columns:60px minmax(0,1fr);gap:8px;padding:8px}.qr{width:60px;height:60px}.meta{grid-template-columns:repeat(2,minmax(0,1fr))}}@media(max-width:520px){.heading{flex-direction:column;align-items:flex-start}.heading>div:last-child{text-align:left!important}.voucher-grid{grid-template-columns:minmax(0,1fr)}.voucher{grid-template-columns:64px minmax(0,1fr);gap:10px;padding:10px}.qr{width:64px;height:64px}}
@page thermal58{size:58mm auto;margin:2mm}@page thermal80{size:80mm auto;margin:3mm}@media print{@page{size:A4;margin:8mm}body{background:#fff;padding:0}.toolbar{display:none}.sheet{max-width:none;border:0;border-radius:0;padding:0}.voucher-grid{grid-template-columns:repeat(4,minmax(0,1fr));gap:4mm}.voucher{min-height:30mm;padding:5px;grid-template-columns:52px minmax(0,1fr)}.voucher>div:last-child,.voucher-head,.credential,.credential b{min-width:0;overflow-wrap:anywhere;word-break:break-word}.qr{width:58px;height:58px}.qr img{max-width:58px}body.print-thermal-58{page:thermal58}body.print-thermal-80{page:thermal80}body.print-thermal-58 .heading,body.print-thermal-80 .heading{display:block;text-align:center}body.print-thermal-58 .meta,body.print-thermal-80 .meta{grid-template-columns:1fr 1fr}body.print-thermal-58 .voucher-grid,body.print-thermal-80 .voucher-grid{display:block}body.print-thermal-58 .voucher,body.print-thermal-80 .voucher{display:grid;grid-template-columns:48px minmax(0,1fr);border:0;border-bottom:1px dashed #64748b;min-height:0;padding:7px 0}body.print-thermal-58 .qr{width:46px;height:46px}body.print-thermal-80 .qr{width:58px;height:58px}}
</style></head><body>
<nav class="toolbar"><a href="/reseller/vouchers/history">← Voucher history</a><div><button data-print-format="thermal-58" type="button">Print 58mm</button> <button data-print-format="thermal-80" type="button">Print 80mm</button> <button data-print-format="a4" type="button">Print A4 cut sheet</button></div></nav>
<main class="sheet" data-login-host="<%= loginHost %>"><header class="heading"><div><div class="brand"><%= brandName %></div><div class="muted">Authorized reseller voucher issuance</div><h1>Hotspot Voucher Batch</h1></div><div style="text-align:right"><strong><%= safeResellerName %></strong><div class="muted">Issued: <%= formatDate(batch.createdAt) %></div></div></header>
<section class="meta"><div><small>Batch reference</small><strong><%= batch.batchKey %></strong></div><div><small>Package / Profile</small><strong><%= batch.packageName||batch.profileKey %></strong></div><div><small>Quantity</small><strong><%= batch.quantity %></strong></div><div><small>Validity</small><strong><%= batch.validity||'As configured' %></strong></div></section>
<section class="voucher-grid"><% vouchers.forEach((v,i)=>{ %><article class="voucher" data-username="<%= v.username %>" data-password="<%= v.password %>"><div class="qr" id="qr<%= i %>"></div><div><div class="voucher-head"><%= brandName %> · VOUCHER <%= i+1 %></div><div class="credential"><span><%= v.password===v.username?'PIN':'Username / PIN' %></span><b><%= v.username %></b></div><% if(v.password!==v.username){ %><div class="credential"><span>Password</span><b><%= v.password %></b></div><% } %><div class="credential"><span>Validity</span><b><%= v.validity||batch.validity||'—' %></b></div></div></article><% }); %></section><footer class="footer">Keep voucher credentials secure. Voucher lifecycle is managed by FAZ NETWORK.</footer></main>
<script src="/js/reseller-voucher-print.js?v=20261101-1" defer></script></body></html>