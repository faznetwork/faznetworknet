<!doctype html>
<%
const brand=typeof brandSettings!=='undefined'&&brandSettings?brandSettings:{};
const brandName=String(brand.company_name||'FAZ NETWORK');
const safeResellerName=String(resellerName||'Reseller');
const loginHost=String(batch.dnsName||'login.hotspot');
const formatDate=value=>value?new Intl.DateTimeFormat('en-GB',{timeZone:'Asia/Dhaka',dateStyle:'medium',timeStyle:'short'}).format(new Date(value)):'—';
%>
<html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><meta name="robots" content="noindex,nofollow"><title><%= brandName %> · Voucher Batch <%= batch.batchKey %></title><script src="https://cdnjs.cloudflare.com/ajax/libs/qrcodejs/1.0.0/qrcode.min.js"></script>
<style>
:root{font-family:Arial,Helvetica,sans-serif;color:#0f172a}*{box-sizing:border-box}body{margin:0;background:#f1f5f9;padding:22px}.toolbar{max-width:1200px;margin:0 auto 16px;display:flex;justify-content:space-between;gap:10px;flex-wrap:wrap}.toolbar a,.toolbar button{border:0;border-radius:8px;padding:10px 14px;text-decoration:none;font-weight:700;cursor:pointer;background:#e2e8f0;color:#0f172a}.toolbar button{background:#166534;color:#fff}.sheet{max-width:1200px;margin:auto;background:#fff;padding:26px;border:1px solid #e2e8f0;border-radius:14px}.heading{display:flex;justify-content:space-between;gap:18px;border-bottom:2px solid #166534;padding-bottom:14px;margin-bottom:16px}.brand{font-size:20px;font-weight:800;color:#166534}.muted{font-size:11px;color:#64748b}h1{font-size:20px;margin:5px 0}.meta{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:8px;margin:14px 0}.meta div{background:#f8fafc;border:1px solid #e2e8f0;padding:9px;border-radius:7px}.meta small{display:block;color:#64748b;font-size:9px;text-transform:uppercase;font-weight:700}.meta strong{font-size:12px;overflow-wrap:anywhere}.voucher-grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:8px}.voucher{border:1px dashed #64748b;padding:9px;min-height:130px;break-inside:avoid;display:grid;grid-template-columns:76px 1fr;gap:8px;align-items:center}.qr{width:76px;height:76px}.qr img{max-width:76px}.voucher-head{font-size:10px;font-weight:800;color:#166534;margin-bottom:6px}.credential{font-size:10px;margin:4px 0;overflow-wrap:anywhere}.credential span{display:block;color:#64748b}.credential b{font-family:Consolas,monospace}.footer{margin-top:18px;padding-top:10px;border-top:1px solid #e2e8f0;text-align:center;color:#64748b;font-size:10px}@media(max-width:760px){body{padding:8px}.sheet{padding:12px}.voucher-grid{grid-template-columns:repeat(2,minmax(0,1fr))}.meta{grid-template-columns:repeat(2,minmax(0,1fr))}}
@page thermal58{size:58mm auto;margin:2mm}@page thermal80{size:80mm auto;margin:3mm}@media print{@page{size:A4;margin:8mm}body{background:#fff;padding:0}.toolbar{display:none}.sheet{max-width:none;border:0;border-radius:0;padding:0}.voucher-grid{grid-template-columns:repeat(4,minmax(0,1fr));gap:4mm}.voucher{min-height:30mm;padding:5px;grid-template-columns:60px 1fr}.qr{width:58px;height:58px}.qr img{max-width:58px}body.print-thermal-58{page:thermal58}body.print-thermal-80{page:thermal80}body.print-thermal-58 .heading,body.print-thermal-80 .heading{display:block;text-align:center}body.print-thermal-58 .meta,body.print-thermal-80 .meta{grid-template-columns:1fr 1fr}body.print-thermal-58 .voucher-grid,body.print-thermal-80 .voucher-grid{display:block}body.print-thermal-58 .voucher,body.print-thermal-80 .voucher{display:grid;grid-template-columns:56px 1fr;border:0;border-bottom:1px dashed #64748b;min-height:0;padding:7px 0}body.print-thermal-58 .qr{width:54px;height:54px}body.print-thermal-80 .qr{width:66px;height:66px}}
</style></head><body>
<nav class="toolbar"><a href="/reseller/vouchers/history">← Voucher history</a><div><button onclick="printVoucher('thermal-58')" type="button">Print 58mm</button> <button onclick="printVoucher('thermal-80')" type="button">Print 80mm</button> <button onclick="printVoucher('a4')" type="button">Print A4 cut sheet</button></div></nav>
<main class="sheet"><header class="heading"><div><div class="brand"><%= brandName %></div><div class="muted">Authorized reseller voucher issuance</div><h1>Hotspot Voucher Batch</h1></div><div style="text-align:right"><strong><%= safeResellerName %></strong><div class="muted">Issued: <%= formatDate(batch.createdAt) %></div></div></header>
<section class="meta"><div><small>Batch reference</small><strong><%= batch.batchKey %></strong></div><div><small>Package / Profile</small><strong><%= batch.packageName||batch.profileKey %></strong></div><div><small>Quantity</small><strong><%= batch.quantity %></strong></div><div><small>Validity</small><strong><%= batch.validity||'As configured' %></strong></div></section>
<section class="voucher-grid"><% vouchers.forEach((v,i)=>{ %><article class="voucher"><div class="qr" id="qr<%= i %>"></div><div><div class="voucher-head"><%= brandName %> · VOUCHER <%= i+1 %></div><div class="credential"><span><%= v.password===v.username?'PIN':'Username / PIN' %></span><b><%= v.username %></b></div><% if(v.password!==v.username){ %><div class="credential"><span>Password</span><b><%= v.password %></b></div><% } %><div class="credential"><span>Validity</span><b><%= v.validity||batch.validity||'—' %></b></div></div></article><% }); %></section><footer class="footer">Keep voucher credentials secure. Voucher lifecycle is managed by FAZ NETWORK.</footer></main>
<script>(function(){var host=<%- JSON.stringify(loginHost).replace(/</g,'\\u003c') %>;var vouchers=<%- JSON.stringify(vouchers.map(v=>({username:v.username,password:v.password}))).replace(/</g,'\\u003c') %>;function makeUrl(v){var origin=/^https?:\/\//i.test(host)?host:'http://'+host;return origin.replace(/\/+$/,'')+'/login?username='+encodeURIComponent(v.username)+'&password='+encodeURIComponent(v.password);}vouchers.forEach(function(v,i){var n=document.getElementById('qr'+i);if(window.QRCode)new QRCode(n,{text:makeUrl(v),width:88,height:88});else n.textContent='QR unavailable';});window.printVoucher=function(mode){document.body.classList.remove('print-thermal-58','print-thermal-80');if(mode!=='a4')document.body.classList.add('print-'+mode);window.print();};window.addEventListener('afterprint',function(){document.body.classList.remove('print-thermal-58','print-thermal-80');});})();</script></body></html>