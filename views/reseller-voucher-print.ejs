<!doctype html>
<%
  const brand = typeof brandSettings !== 'undefined' && brandSettings ? brandSettings : {};
  const brandName = String(brand.company_name || 'FAZ NETWORK');
  const safeResellerName = String(resellerName || 'Reseller');
  const formatDate = value => value ? new Intl.DateTimeFormat('en-GB', { timeZone: 'Asia/Dhaka', dateStyle: 'medium', timeStyle: 'short' }).format(new Date(value)) : '—';
%>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <meta name="robots" content="noindex,nofollow">
  <title><%= brandName %> · Voucher Batch <%= batch.batchKey %></title>
  <style>
    :root{font-family:Arial,Helvetica,sans-serif;color:#0f172a}
    *{box-sizing:border-box}
    body{margin:0;background:#f1f5f9;padding:24px}
    .toolbar{max-width:1100px;margin:0 auto 18px;display:flex;justify-content:space-between;align-items:center;gap:12px}
    .toolbar a,.toolbar button{border:0;border-radius:8px;padding:10px 14px;text-decoration:none;font-weight:700;cursor:pointer}
    .toolbar a{background:#e2e8f0;color:#0f172a}.toolbar button{background:#0a3d2e;color:#fff}
    .sheet{max-width:1100px;margin:0 auto;background:#fff;padding:28px;border:1px solid #e2e8f0;border-radius:14px}
    .heading{display:flex;justify-content:space-between;gap:18px;align-items:flex-start;border-bottom:2px solid #0a3d2e;padding-bottom:16px;margin-bottom:18px}
    .brand{font-size:20px;font-weight:800;color:#0a3d2e}.muted{color:#64748b;font-size:12px}
    h1{font-size:20px;margin:4px 0}.meta{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:10px;margin:18px 0}
    .meta div{background:#f8fafc;border:1px solid #e2e8f0;border-radius:8px;padding:10px}
    .meta small{display:block;color:#64748b;font-size:10px;text-transform:uppercase;font-weight:700;margin-bottom:4px}
    .meta strong{font-size:13px;overflow-wrap:anywhere}
    .voucher-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:12px}
    .voucher{border:1px dashed #94a3b8;border-radius:10px;padding:14px;break-inside:avoid;min-height:124px}
    .voucher-head{display:flex;justify-content:space-between;gap:8px;border-bottom:1px solid #e2e8f0;padding-bottom:7px;margin-bottom:8px}
    .voucher-head strong{font-size:12px;color:#0a3d2e}.voucher-head span{font-size:10px;color:#64748b}
    .credential{display:flex;justify-content:space-between;gap:8px;margin:6px 0;font-size:12px}
    .credential span{color:#64748b}.credential b{font-family:Consolas,monospace;overflow-wrap:anywhere;text-align:right}
    .footer{margin-top:22px;padding-top:12px;border-top:1px solid #e2e8f0;text-align:center;color:#64748b;font-size:10px}
    @media(max-width:700px){body{padding:8px}.sheet{padding:14px}.voucher-grid{grid-template-columns:repeat(2,minmax(0,1fr))}.meta{grid-template-columns:repeat(2,minmax(0,1fr))}}
    @page thermal{size:80mm auto;margin:3mm}
    @media print{
      @page{size:A4;margin:10mm}
      body{background:#fff;padding:0}
      .toolbar{display:none!important}
      .sheet{max-width:none;border:0;border-radius:0;padding:0}
      .voucher-grid{grid-template-columns:repeat(3,minmax(0,1fr));gap:8px}
      .voucher{min-height:112px;padding:10px}
      .meta{margin:12px 0}
      body.print-thermal{page:thermal;padding:0}
      body.print-thermal .sheet{width:74mm;max-width:74mm;padding:0;margin:0}
      body.print-thermal .heading{display:block;text-align:center;border-bottom:1px dashed #64748b;padding-bottom:8px;margin-bottom:8px}
      body.print-thermal .heading>div:last-child{text-align:center!important;margin-top:8px}
      body.print-thermal .brand{font-size:16px}
      body.print-thermal h1{font-size:15px}
      body.print-thermal .meta{grid-template-columns:1fr 1fr;gap:5px;margin:8px 0}
      body.print-thermal .meta div{padding:6px}
      body.print-thermal .voucher-grid{grid-template-columns:1fr;gap:6px}
      body.print-thermal .voucher{min-height:0;padding:8px;border-radius:0}
      body.print-thermal .voucher-head{margin-bottom:5px;padding-bottom:5px}
      body.print-thermal .credential{font-size:11px;margin:4px 0}
      body.print-thermal .footer{margin-top:10px}
    }
  </style>
</head>
<body>
  <nav class="toolbar">
    <a href="/reseller/dashboard">← Back to Reseller Portal</a>
    <div class="d-flex gap-2"><button type="button" onclick="printVoucher('a4')">Print A4 sheet</button><button type="button" onclick="printVoucher('thermal')">Print 80mm receipt</button></div>
  </nav>
  <main class="sheet">
    <header class="heading">
      <div><div class="brand"><%= brandName %></div><div class="muted">Authorized reseller voucher issuance</div><h1>Hotspot Voucher Batch</h1></div>
      <div style="text-align:right"><strong><%= safeResellerName %></strong><div class="muted">Reseller account</div><div class="muted">Issued: <%= formatDate(batch.createdAt) %></div></div>
    </header>
    <section class="meta">
      <div><small>Batch reference</small><strong><%= batch.batchKey %></strong></div>
      <div><small>Package / Profile</small><strong><%= batch.profileKey %></strong></div>
      <div><small>Quantity</small><strong><%= batch.quantity %></strong></div>
      <div><small>Validity</small><strong><%= batch.validity || 'As configured' %></strong></div>
    </section>
    <section class="voucher-grid">
      <% vouchers.forEach((voucher, index) => { %>
        <article class="voucher">
          <div class="voucher-head"><strong><%= brandName %> · HOTSPOT</strong><span>#<%= index + 1 %></span></div>
          <div class="credential"><span>Username / PIN</span><b><%= voucher.username %></b></div>
          <div class="credential"><span>Password</span><b><%= voucher.password %></b></div>
          <div class="credential"><span>Package</span><b><%= voucher.profile %></b></div>
          <div class="credential"><span>Validity</span><b><%= voucher.validity || batch.validity || '—' %></b></div>
        </article>
      <% }); %>
    </section>
    <footer class="footer">Please keep voucher credentials secure. Voucher lifecycle is managed by FAZ NETWORK.</footer>
  </main>
  <script>
    function printVoucher(format){
      document.body.classList.toggle('print-thermal',format==='thermal');
      window.print();
    }
    window.addEventListener('afterprint',()=>document.body.classList.remove('print-thermal'));
  </script>
</body>
</html>
