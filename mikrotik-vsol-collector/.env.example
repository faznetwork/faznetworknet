# V-SOL OLT management interface reachable from the MikroTik container LAN
OLT_HOST=192.0.2.10
OLT_PORT=23
OLT_PROTOCOL=telnet
OLT_USERNAME=readonly-user
OLT_PASSWORD=replace-me
# Optional; only used if the CLI initially presents OLT> and requires enable mode
OLT_ENABLE_PASSWORD=

# Render ingest endpoint and the SAME secret configured as Render OLT_COLLECTOR_TOKEN
RENDER_INGEST_URL=https://faznetwork-web.onrender.com/api/olt/sync-telemetry
OLT_COLLECTOR_TOKEN=replace-with-render-secret
OLT_ID=vsol-v1601e04-dp
COLLECTOR_ID=mikrotik-vsol-container
POLL_INTERVAL_SECONDS=300
CONNECT_TIMEOUT_SECONDS=8
COMMAND_TIMEOUT_SECONDS=20
LOG_LEVEL=INFO
